// Backends de LLM e adapter Writer usados por Wiki/Discovery/Delivery.
// Claude recebe o schema inline; Codex recebe o caminho por
// `--output-schema`. Writer normaliza essa diferenca para os workflows.
//
// `--disallowed-tools` e a mitigacao obrigatoria de C2 (nenhum agente pode
// ler/escrever fora do que o proprio prompt manda) — testada de verdade
// (FASE2-ACHADOS.md §1): `--allowed-tools ""` NAO bloqueia nada, so a lista
// explicita em `--disallowed-tools` bloqueia de verdade.
//
// Nenhum dos dois agentes declara `after`, de proposito: `after` so pode
// devolver uma string (ou nada) — confirmado por spike, `after` devolvendo
// `{content, tokens_in, tokens_out}` falha em runtime com "Codex.after must
// return a string (or nothing), got object" — e so enxerga variaveis do
// STEP de pipeline que fez a chamada, nao de um `tool` intermediario
// (confirmado por outro spike: um `tool Caller { go() -> Agent.run(...) }`
// chamado por um step faz `after` falhar com "undefined variable" ao tentar
// atribuir numa var do step por efeito colateral). Como `Writer.generate`
// (abaixo) e um `tool` — nao um step — chamando `.run()`, nenhuma das duas
// tecnicas de `after` funciona aqui. Sem `after`, `.run()` devolve o stdout
// cru do CLI (confirmado por spike); `Writer.generate` extrai uso (C5) e
// normaliza o conteudo (`UsageParser`/`StructuredOutput`) explicitamente,
// depois de receber essa string de volta — nenhum lugar mágico "ve" nada.

import { Usage, UsageParser, PromptLog } from "usage.mh"
import { StructuredOutput } from "structured_output.mh"
import { WorkflowsRoot } from "../core/workflows_root.mh"
import { Paths } from "../core/paths.mh"

// Backend usado no ambiente alvo. O Devin CLI nao oferece uma flag de
// JSON Schema equivalente a `codex --output-schema`/`claude --json-schema`;
// por isso o contrato e incluido no prompt e validado pelo passo seguinte.
// A configuracao dedicada bloqueia todas as ferramentas do Devin: ele recebe
// todo o contexto no prompt e so deve produzir dados, sem explorar o CWD do
// mhl (que contem todos os work-items).
tool DevinConfig {
    path(): string -> WorkflowsRoot.resolve("shared/agents/devin-generator.json")
}

export agent Devin {
    description: "Gera conteudo estruturado com Devin CLI sem acesso a ferramentas."
    command: "devin"
    // TEMPORARIO: --config removido pq estava causando falha
    // ("connection error"/"unavailable") em combinacao com --permission-mode.
    // Sem --config, o Devin roda SEM o deny-list de devin-generator.json —
    // ou seja, ele pode ler/executar/fazer fetch no CWD do mhl (que contem
    // work-items de outros projetos), furando a mitigacao C1/C2 documentada
    // acima. Restaurar --config assim que os logs (em andamento) mostrarem a
    // causa raiz real.
    args: [
        "--model", env("SENPAI_DEVIN_MODEL", "swe-1-6-slow"),
        "--respect-workspace-trust", "false",
        "--permission-mode", "auto",
        "--prompt-file", "${prompt}",
        "--export", "${schema}",
        "--print"
    ]
    retry: {
        max_attempts: 5
        delay: 5s
        // O Devin CLI devolve falhas transitorias do backend como exit 1,
        // mas inclui cognition.ai/retryable:true no stderr. Esse marcador e
        // mais confiavel que depender apenas de HTTP 500/503, que o CLI nao
        // preserva necessariamente na mensagem externa.
        retry_on: [500, 503, "timeout", "rate_limit", "empty response", "retryable", "unavailable", "Connection error"]
    }
}

// Prompt vai por `stdin:` de novo — as duas tentativas anteriores falharam
// nao porque o mecanismo nao funciona, mas porque a frase posicional pedia
// pro modelo falar SOBRE o stdin em si ("Execute as instrucoes recebidas
// pela entrada padrao" / "Repita o texto recebido pela entrada padrao"):
// isso e uma pergunta de introspeccao, e o Claude respondeu com uma frase
// generica de treino ("nao tenho um stream de stdin separado") em vez de
// checar o proprio contexto. Confirmado com 2 chamadas reais via CLI direto
// (fora do mhl, isolando so o comportamento do `claude`): uma instrucao
// posicional que aponta pra uma TAREFA concreta sobre "o conteudo abaixo"
// (em vez de sobre o mecanismo em si) faz o modelo processar o stdin pipado
// de verdade — testado com e sem `--disallowed-tools`, resposta refletiu com
// precisao o conteudo que so existia no stdin. `--json-schema` continua SEM
// alternativa a inline (residual conhecido pra schemas excepcionalmente
// grandes); o prompt (que pode incluir wiki inteira) agora sai do argv de
// verdade, igual ao Codex.
export agent Claude {
    command: "claude"
    args: [
        "-p",
        "Leia o conteúdo abaixo e responda exatamente como ele pede.",
        "--output-format", "json",
        "--json-schema", "${schema}",
        "--disallowed-tools", "Bash,Read,Write,Edit,MultiEdit,NotebookEdit,WebFetch,WebSearch,Glob,Grep,Task"
    ]
    stdin: "${prompt}"

    retry: {
        max_attempts: 3
        delay: 2s
        retry_on: [500, 503, "timeout", "rate_limit"]
    }
}

// Codex herda o CWD do proprio `mhl` como seu "working root" (nao ha um
// `cwd:`/`workdir:` proprio de `agent` no MHL) — e por padrao RECUSA rodar
// fora de um repositorio git ("Not inside a trusted directory"), e o que
// enxerga dali é tudo que `--sandbox read-only` deixa ler, nao só o que o
// prompt pede (mesma classe de risco do achado FASE0-ACHADOS.md §9 pro
// `claude` sem `--disallowed-tools`). Isso importa de verdade na Fase 5: o
// bridge Go roda `mhl` com CWD = diretorio de dados do usuario, que contem
// `projects/` de TODOS os work-items — sem isolar o `--cd` do Codex disso
// separadamente, ele enxergaria (leitura, nao escrita) work-items alem do
// que o prompt de uma chamada especifica pediu, furando C1/C2.
//
// `-C/--cd <DIR>` resolve isso — CWD do Codex, independente do CWD de
// `mhl`. `env("SENPAI_CODEX_CWD", ".")` — a forma de 2 argumentos, mhl
// 1.4.0-beta.7+ — resolve isso direto em `args:`, sem precisar de um `tool`
// indireto: ausente SENPAI_CODEX_CWD (uso manual via CLI, como em toda fase
// ate aqui), cai em "." (mesmo comportamento de sempre — nenhuma regressao
// pro uso via terminal); o bridge Go seta a var pra um diretorio de scratch
// dedicado, sem nenhum dado de projeto dentro (app/mhlbridge.Start,
// FASE5-ACHADOS.md). A forma de 1 argumento (`env("X")`) usada direto em
// `agent.command`/`args` falha fechado se a var nao existir e sai redigida
// ([REDACTED]) de qualquer log/saida do mhl (tratada como credencial) — a
// forma de 2 argumentos e reconhecida pela propria aridade e nunca entra
// nesse tratamento, em lugar nenhum da linguagem (MHL-Melhorias.md #18,
// corrigido depois do achado original desta fase — a solucao via `tool
// CodexCwd` que o achado documentava nao e mais necessaria).
// Prompt vai por `stdin:` (ver comentario equivalente no agent Claude,
// acima) em vez de "${prompt}" como ultimo argumento posicional. Pro Codex
// isso e o mecanismo OFICIALMENTE documentado, nao um contorno: `codex exec`
// aceita "-" no lugar de PROMPT com o sentido exato de "leia o prompt do
// stdin" (learn.chatgpt.com/docs/developer-commands — "Use `-` to pipe the
// prompt from stdin"). `--output-schema` ja era um caminho de arquivo, entao
// so o prompt (o lado que podia crescer sem limite via wiki_content) estava
// no argv — com "-" + stdin, nenhum conteudo de tamanho variavel entra mais
// na linha de comando.
export agent Codex {
    description: "Gera conteúdo estruturado com Codex em sandbox somente leitura."
    command: "codex"
    args: [
        "exec",
        "--sandbox", "read-only",
        "--cd", env("SENPAI_CODEX_CWD", "."),
        "--skip-git-repo-check",
        "--ephemeral",
        "--ignore-user-config",
        "--ignore-rules",
        "--color", "never",
        "--json",
        "--output-schema", "${schema}",
        "-"
    ]
    stdin: "${prompt}"
    retry: {
        max_attempts: 3
        delay: 2s
        retry_on: [500, 503, "timeout", "rate_limit"]
    }
}

// AgentSelector decide qual backend atende um prompt — hoje sempre Codex
// (unico caminho validado ponta a ponta nesta fase); pronto pra crescer com
// selecao por ambiente/prompt sem mudar a assinatura de Writer.generate.
//
// Deliberadamente NAO um `router` (Docs-Reference §"router"): um `router` so
// expoe `.delegate(prompt:, schema:)` publicamente — `select` e um hook
// interno, nunca um metodo chamavel de fora. Confirmado por spike isolado
// (2 arquivos minimos, mesmo `.mh`, tool chamando `Router.select(...)`):
// falha em runtime com `undefined variable "Router"`, mesmo sem nenhum
// import — `select` so roda dentro do proprio `.delegate()`, nunca antes
// dele. Isso importa aqui porque Claude e Codex exigem formas DIFERENTES do
// schema pro mesmo argumento reservado `schema:` de `agent.run(...)`: Claude
// quer o JSON inline (`--json-schema`, confirmado recusando um caminho de
// arquivo com "not valid JSON"); Codex quer um caminho de arquivo real
// (`--output-schema <FILE>`). `Writer.generate` precisa saber qual formato
// montar ANTES de rodar o agente — e `router.delegate()` nao deixa consultar
// essa decisao de fora. `tool AgentSelector` + `match` + `.run()` direto em
// cada agente resolve isso sem esbarrar nesse limite.
tool AgentSelector {
    pick(prompt: string): string -> {
        var selected = match env("SENPAI_AGENT", "codex") {
            "devin" -> nameof(Devin)
            "claude" -> nameof(Claude)
            "codex" -> nameof(Codex)
            _ -> nameof(Codex)
        }

        return selected
    }
}

// Adapter consumido pelos workflows. Ele absorve a diferenca de contrato do
// Codex e mantem cada schema como {content, path}: Claude usa
// `schema_file.content` (JSON inline); Codex usa `schema_file.path`
// (caminho de arquivo).
export tool Writer {
    // Mantido como metodo de Writer (em vez de um tool auxiliar) porque
    // Writer e chamado por modulos importadores. `self` preserva o escopo do
    // adapter em runtime e evita que Discovery/Wiki/Delivery tentem resolver
    // um simbolo auxiliar como DevinPromptFile no proprio modulo.
    generate_devin(instruction: string, schema: string, project_id: string): {
        raw: string, exported: string
    } -> {
        var prompt = 
        """
        ${instruction}

        Responda somente com um objeto JSON valido, sem Markdown, comentarios ou texto adicional.
        O objeto deve obedecer exatamente a este JSON Schema:
        ${schema}
        """

        

        // Windows limita a linha de comando criada por CreateProcess a cerca
        // de 32K caracteres. Os dois arquivos ficam estritamente no work-item,
        // compartilham um UUID para chamadas concorrentes e sao removidos ate
        // quando o CLI falha. O placeholder reservado `${schema}` transporta
        // o caminho do export porque o Devin nao usa schema nativo e o MHL so
        // interpola `${prompt}`/`${schema}` nos argumentos de um agent.
        var id = uuid.v4()
        var root = Paths.root(Paths.ensure_valid(project_id))
        var prompt_path = root + "/.devin-prompt-" + id + ".txt"
        var export_path = root + "/.devin-export-" + id + ".json"
        fs.write(prompt_path, prompt)
        var raw = ""
        var exported = ""
        try {
            raw = Devin.run(prompt: prompt_path, schema: export_path)
            if (fs.exists(export_path)) {
                try {
                    exported = fs.read(export_path)
                } catch (err) {
                    exported = ""
                }
            }
        } catch (err) {
            fail(err)
        } finally {
            fs.delete(prompt_path)
            if (fs.exists(export_path)) fs.delete(export_path)
        }
        return {raw: raw, exported: exported}
    }

    generate(prompt: string, schema_file: {content: string, path: string}, project_id: string, artifact: string): {
        content: string, tokens_in: number, tokens_out: number,
        cache_creation_tokens: number, cache_read_tokens: number, cost_usd: number
    } -> {
        var picked = AgentSelector.pick(prompt: prompt)
        var devin_raw = ""
        var devin_exported = ""
        if (picked == nameof(Devin)) {
            var devin_result = self.generate_devin(
                instruction: prompt,
                schema: schema_file.content,
                project_id: project_id
            )
            devin_raw = devin_result.raw
            devin_exported = devin_result.exported
        }
        var raw = match picked {
            nameof(Devin) -> devin_raw
            nameof(Claude) -> Claude.run(prompt: prompt, schema: schema_file.content)
            nameof(Codex) -> Codex.run(prompt: prompt, schema: schema_file.path)
        }
        var usage = match picked {
            nameof(Devin) -> UsageParser.extract_devin(raw, devin_exported)
            nameof(Claude) -> UsageParser.extract_claude(raw)
            nameof(Codex) -> UsageParser.extract_codex(raw)
        }

        Usage.append({
            artifact: artifact,
            tokens_in: usage.tokens_in,
            tokens_out: usage.tokens_out,
            cache_creation_tokens: usage.cache_creation_tokens,
            cache_read_tokens: usage.cache_read_tokens,
            cost_usd: usage.cost_usd,
        })

        // `raw` (nao `usage.content`) de proposito: e a resposta crua do CLI,
        // antes de UsageParser.extract_* desembrulhar/normalizar — o que
        // auditoria/depuracao de uma geracao especifica precisa ver. Os
        // campos de consumo sao duplicados de Usage.append (mesmos valores)
        // pra esta linha ser auto-suficiente — quem le prompt_log.jsonl pra
        // depurar uma geracao nao precisa tambem abrir usage.jsonl e juntar
        // os dois por artifact/timestamp.
        PromptLog.append({
            artifact: artifact,
            backend: picked,
            prompt: prompt,
            response: raw,
            tokens_in: usage.tokens_in,
            tokens_out: usage.tokens_out,
            cache_creation_tokens: usage.cache_creation_tokens,
            cache_read_tokens: usage.cache_read_tokens,
            cost_usd: usage.cost_usd,
        })

        return {
            content: StructuredOutput.normalize_json(usage.content),
            tokens_in: usage.tokens_in,
            tokens_out: usage.tokens_out,
            cache_creation_tokens: usage.cache_creation_tokens,
            cache_read_tokens: usage.cache_read_tokens,
            cost_usd: usage.cost_usd,
        }
    }
}

agent MockCodexSchemaPath {
    command: "echo"
    args: ["exec", "--ignore-user-config", "--ignore-rules", "--output-schema", "${schema}", "${prompt}"]
}

agent MockDevinExportPath {
    command: "echo"
    args: ["--prompt-file", "${prompt}", "--export", "${schema}", "--print"]
}

tool MockWriter {
    generate(prompt: string, schema_file: {content: string, path: string}, project_id: string, artifact: string): string -> {
        return MockCodexSchemaPath.run(prompt: prompt, schema: schema_file.path)
    }

    generate_devin(prompt_path: string, export_path: string): string -> {
        return MockDevinExportPath.run(prompt: prompt_path, schema: export_path)
    }
}

test WriterAdapterSpec {
    describe forwards_schema_path_as_a_distinct_codex_argument {
        var result = MockWriter.generate(
            prompt: "gere o brief",
            schema_file: {content: "{\"type\":\"object\"}", path: "workflows/shared/artifacts/schemas/brief.schema.json"},
            project_id: "test-project",
            artifact: "brief"
        )
        are_equal(result, "exec --ignore-user-config --ignore-rules --output-schema workflows/shared/artifacts/schemas/brief.schema.json gere o brief")
    }

    describe forwards_the_per_call_export_path_to_devin {
        var result = MockWriter.generate_devin(
            prompt_path: "projects/wi_1/.devin-prompt-id.txt",
            export_path: "projects/wi_1/.devin-export-id.json"
        )
        are_equal(result, "--prompt-file projects/wi_1/.devin-prompt-id.txt --export projects/wi_1/.devin-export-id.json --print")
    }
}
