{
  "$defs": {
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto",
        "fontes"
      ],
      "properties": {
        "texto": {
          "type": "string"
        },
        "fontes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abordagem",
    "abordagem_fontes",
    "componentes",
    "adrs",
    "dados",
    "fluxo",
    "fluxo_fontes",
    "erros",
    "seguranca",
    "observabilidade",
    "tarefas",
    "testes",
    "riscos"
  ],
  "properties": {
    "abordagem": {
      "type": "string",
      "description": "Como a história será implementada, em um parágrafo."
    },
    "abordagem_fontes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "componentes": {
      "type": "array",
      "description": "Onde o código muda: contêiner do C4 e o componente/módulo dentro dele.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conteiner",
          "componente",
          "mudanca",
          "fontes"
        ],
        "properties": {
          "conteiner": {
            "type": "string",
            "description": "Nome exato do contêiner no diagrama C4."
          },
          "componente": {
            "type": "string"
          },
          "mudanca": {
            "type": "string",
            "description": "O que muda nele."
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "adrs": {
      "type": "array",
      "description": "Decisões que a implementação precisa seguir.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adr",
          "aplicacao",
          "fontes"
        ],
        "properties": {
          "adr": {
            "type": "string",
            "description": "ID da ADR (ex.: ADR-002)."
          },
          "aplicacao": {
            "type": "string",
            "description": "Como a decisão se aplica a esta história."
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "dados": {
      "type": "array",
      "description": "Entidades do DER que a história toca.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entidade",
          "operacao",
          "detalhe",
          "fontes"
        ],
        "properties": {
          "entidade": {
            "type": "string",
            "description": "Nome exato da entidade no DER."
          },
          "operacao": {
            "type": "string",
            "enum": [
              "cria",
              "le",
              "atualiza",
              "remove"
            ]
          },
          "detalhe": {
            "type": "string",
            "description": "Campos/regras envolvidos; migração necessária, se houver."
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "fluxo": {
      "type": "array",
      "description": "Passos do fluxo principal, em ordem, entre participantes (pessoa, contêiner, componente, sistema externo). Vira um diagrama de sequência.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "de",
          "para",
          "mensagem",
          "retorno"
        ],
        "properties": {
          "de": {
            "type": "string"
          },
          "para": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "retorno": {
            "type": "boolean",
            "description": "true para uma resposta (seta tracejada)."
          }
        }
      }
    },
    "fluxo_fontes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "erros": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedText"
      },
      "description": "Falhas previstas e como tratar cada uma."
