    "seguranca": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedText"
      },
      "description": "Autenticação, autorização, dados sensíveis, validações."
    },
    "observabilidade": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedText"
      },
      "description": "Logs, métricas, traces e alertas."
    },
    "tarefas": {
      "type": "array",
      "minItems": 1,
      "description": "Passos pequenos, ordenados e verificáveis — testes antes da implementação que eles cobrem.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "descricao",
          "tipo",
          "criterios",
          "depende_de",
          "fontes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "T1, T2, … na ordem de execução."
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "teste",
              "implementacao",
              "migracao",
              "configuracao",
              "documentacao"
            ]
          },
          "criterios": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Critérios de aceite da história cobertos, como CA1, CA2… (CAn = n-ésimo item de criterios_aceite)."
          },
          "depende_de": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs de tarefas anteriores."
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "testes": {
      "type": "array",
      "description": "Estratégia de testes por nível.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nivel",
          "descricao",
          "criterios",
          "fontes"
        ],
        "properties": {
          "nivel": {
            "type": "string",
            "enum": [
              "unitario",
              "integracao",
              "contrato",
              "e2e"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "criterios": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Critérios de aceite da história cobertos, como CA1, CA2… (CAn = n-ésimo item de criterios_aceite)."
          },
          "fontes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "riscos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedText"
      },
      "description": "Riscos técnicos e questões em aberto que podem bloquear a implementação."
    }
  }
}
