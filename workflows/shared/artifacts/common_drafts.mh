// CommonDrafts gera os artefatos que Discovery e Delivery compartilham. Cada
// metodo recebe ja resolvido o contexto que exige — o que e obrigatorio,
// opcional ou substituido por texto fixo muda por workflow (DiscoveryDrafts,
// DeliveryDrafts); a instrucao, o schema e as verificacoes, nao.

import { Context } from "context.mh"
import { ChangesBlock } from "changes_log.mh"
import { Drafts, Draft } from "draft.mh"
import { AutoReview } from "auto_review.mh"
import { ArtifactChecks } from "artifact_checks.mh"
import { C4Diagram } from "c4_diagram.mh"
import { ArchModel } from "arch_model.mh"
import { Traceability } from "historia_spec.mh"
import { PlanoPrep } from "plano_model.mh"
import { RadahnAssess } from "../radahn/radahn_assess.mh"
import {
    ArtifactSchema, SpecConventions, BriefSchema, RequisitosSchema, AdrSchema, DerSchema, ModeloSchema, DiagramasSchema, HistoriasSchema, PlanoSchema,
    BriefInstruction, RequisitosInstruction, AdrInstruction, DerInstruction, ModeloInstruction, DiagramasInstruction,
    HistoriasInstruction, PlanoInstruction
} from "artifacts_common.mh"

// Contexto tecnico de uma historia ou de um plano, ja recortado pelo que o
// item cita (ContextSlice) e com texto fixo no lugar do que falta.
export type TechContext = {requisitos: string, atributos: string, adr: string, der: string, diagramas: string}

export tool CommonDrafts {
    brief(project_id: string): Draft -> Drafts.generate(
        BriefInstruction(
            schema_conventions: ArtifactSchema(),
            wiki_content: Context.wiki(project_id),
            feedback_content: ChangesBlock.for_artifact(project_id, "brief", "")
        ),
        BriefSchema, project_id, "brief"
    )

    requisitos(project_id: string, brief: string): Draft -> Drafts.generate(
        RequisitosInstruction(
            schema_conventions: ArtifactSchema(),
            brief_content: brief,
            wiki_content: Context.wiki(project_id),
            feedback_content: ChangesBlock.for_artifact(project_id, "requisitos", "")
        ),
        RequisitosSchema, project_id, "requisitos"
    )

    adr(project_id: string, requisitos: string, atributos: string): Draft -> Drafts.generate(
        AdrInstruction(
            schema_conventions: ArtifactSchema(),
            requisitos_content: requisitos,
            atributos_content: atributos,
            feedback_content: ChangesBlock.for_artifact(project_id, "adr", "")
        ),
        AdrSchema, project_id, "adr"
    )

    der(project_id: string, autorrevisao: bool, requisitos: string, atributos: string, adr: string): Draft -> Drafts.reviewed(AutoReview.generate(
        enabled: autorrevisao,
        prompt: DerInstruction(
            schema_conventions: ArtifactSchema(),
            requisitos_content: requisitos,
            atributos_content: atributos,
            adr_content: adr,
            feedback_content: ChangesBlock.for_artifact(project_id, "der", "")
        ),
        schema_file: DerSchema, project_id:, artifact: "der",
        prepare: (raw) -> json.parse(raw),
        check: (d) -> ArtifactChecks.der(d)
    ))

    // Modelo arquitetural: o catalogo que contexto e conteiner projetam
    // (ArchModel). Revisado e aprovado antes dos diagramas.
    modelo(project_id: string, autorrevisao: bool, requisitos: string, atributos: string, adr: string): Draft -> Drafts.reviewed(AutoReview.generate(
        enabled: autorrevisao,
        prompt: ModeloInstruction(
            schema_conventions: ArtifactSchema(),
            requisitos_content: requisitos,
            atributos_content: atributos,
            adr_content: adr,
            feedback_content: ChangesBlock.for_artifact(project_id, "modelo", "")
        ),
        schema_file: ModeloSchema, project_id:, artifact: "modelo",
        prepare: (raw) -> json.parse(raw),
        check: (d) -> ArtifactChecks.modelo(d)
    ))

    // `modelo` e o JSON do modelo aprovado (modelo.json). Contexto e
    // conteiner abrem o lote, projetados dele por codigo; a LLM so gera os
    // diagramas opcionais. C4Diagram.annotate anexa a cada diagrama os avisos
    // que so o lote inteiro revela (nomes divergentes do modelo, falta de
    // implantacao).
    diagramas(project_id: string, autorrevisao: bool, requisitos: string, atributos: string, adr: string, modelo: string): Draft {
        var modelo_data = json.parse(modelo)
        var views = ArchModel.views(modelo_data)
        return Drafts.reviewed_items(AutoReview.generate(
            enabled: autorrevisao,
            prompt: DiagramasInstruction(
                schema_conventions: ArtifactSchema(),
                modelo_content: modelo,
                requisitos_content: requisitos,
                atributos_content: atributos,
                adr_content: adr,
                feedback_content: ChangesBlock.for_artifact(project_id, "diagramas", "")
            ),
            schema_file: DiagramasSchema, project_id:, artifact: "diagramas",
            prepare: (raw) -> C4Diagram.annotate({diagramas: views + ArchModel.optional_diagrams(json.parse(raw)?.diagramas ?? [], modelo_data)}, C4Diagram.infra_hint(adr)),
            check: (d) -> ArtifactChecks.diagramas(d)
        ), "diagramas")
    }

    // `scope` separa o historico de pedidos de mudanca de cada feature.
    // `propostas` sao as historias_propostas do item ({tipo, titulo,
    // resultado}): o roteiro da quebra, detalhado em paginas (ver paginate).
    historias(project_id: string, autorrevisao: bool, feature: string, tech: TechContext, propostas: any[], scope: string): Draft {
        var known = Traceability.known(project_id)
        return self.paginate(propostas, (anteriores, pagina) -> Drafts.reviewed_items(AutoReview.generate(
            enabled: autorrevisao,
            prompt: HistoriasInstruction(
                schema_conventions: ArtifactSchema(),
                spec_conventions: SpecConventions(),
                feature_content: feature,
                requisitos_content: tech.requisitos,
                atributos_content: tech.atributos,
                adr_content: tech.adr,
                der_content: tech.der,
                diagramas_content: tech.diagramas,
                lote_content: self.lote(anteriores, pagina),
                feedback_content: ChangesBlock.for_artifact(project_id, "historias", scope)
            ),
            schema_file: HistoriasSchema, project_id:, artifact: "historias",
            prepare: (raw) -> Traceability.annotate(json.parse(raw), known),
            check: (d) -> ArtifactChecks.historias(d)
        ), "historias"))
    }

    // As historias de um item numa resposta so passam do limite de tokens de
    // saida do modelo em itens grandes (~1.500 tokens por historia, ate
    // ~3.000; ja houve item com 16) — o Devin corta a resposta no meio.
    // Cada chamada detalha no maximo historias_por_pagina historias, o que
    // cabe com folga inclusive na autorrevisao, que reescreve a resposta.
    //
    // Com propostas, o codigo sabe quais e quantas sao: cada pagina detalha
    // exatamente a sua fatia. Sem elas (item antigo ou sem propostas), o
    // modelo decide a quebra e diz em `mais_historias` se ela continua; o
    // teto de paginas limita o custo se ele nunca disser que terminou.
    // `fetch(anteriores, pagina)` gera uma pagina; `pagina` e a fatia de
    // propostas, vazia no modo aberto.
    internal paginate(propostas: any[], fetch: any): Draft {
        var historias = []
        var tokens_in = 0
        var tokens_out = 0
        var inicio = 0
        var paginas = 0
        var continuar = true
        while (continuar) {
            var fim = inicio + self.historias_por_pagina()
            if (fim > propostas.size()) fim = propostas.size()
            var fatia = propostas[inicio..fim]
            var draft = fetch(historias, fatia)
            var novas = draft.data?.historias ?? []
            historias += novas
            tokens_in += draft.tokens_in
            tokens_out += draft.tokens_out
            inicio += fatia.size()
            paginas += 1
            continuar = if (propostas.is_empty())
                (draft.data?.mais_historias ?? false) && !novas.is_empty() && paginas < self.max_paginas()
            else
                inicio < propostas.size()
        }
        return {data: {historias}, tokens_in, tokens_out}
    }

    internal historias_por_pagina(): number -> 4
    internal max_paginas(): number -> 8

    // Bloco do prompt de cada pagina: as propostas a detalhar (ou o limite
    // de tamanho, no modo aberto) e, da segunda pagina em diante, o que ja
    // foi gerado, para o modelo continuar sem repetir.
    internal lote(anteriores: any[], pagina: any[]): string {
        var geradas = if (anteriores.is_empty()) "" else
            "## Histórias já geradas para este item\n\nEstas já existem: não as repita nem as reescreva; cite-as pelo título em dependências.\n\n${anteriores.map((h) -> "- ${h.titulo}").join("\n")}\n\n"
        if (pagina.is_empty()) {
            return "${geradas}## Tamanho da resposta\n\nGere no máximo ${self.historias_por_pagina()} histórias nesta resposta, na ordem em que devem ser implementadas. Se a quebra completa do item precisar de mais, marque `mais_historias: true`; se estas a completam, `false`."
        }
        var lista = pagina.map((p) -> "- ${p?.titulo ?? ""} (${p?.tipo ?? ""}) — ${p?.resultado ?? ""}").join("\n")
        return "${geradas}## Histórias a detalhar nesta resposta\n\nO item já propôs as histórias da quebra (`historias_propostas`). Detalhe exatamente estas, uma para cada proposta, com o mesmo título e o mesmo tipo (`story_type`); as demais propostas são detalhadas em outras respostas. Se a fonte mostrar que uma proposta não se sustenta, registre isso em `gaps`/`questoes_abertas` da história em vez de trocá-la. Marque `mais_historias: false`.\n\n${lista}"
    }

    // Duas etapas: o plano e, com ele pronto, a aderencia ao Radahn
    // (data.radahn). `titulo` identifica a historia no cabecalho do plano.
    plano(project_id: string, autorrevisao: bool, historia: any, historia_content: string, feature: string, titulo: string, tech: TechContext, scope: string): Draft {
        var known = Traceability.known(project_id)
        var draft = Drafts.reviewed(AutoReview.generate(
            enabled: autorrevisao,
            prompt: PlanoInstruction(
                schema_conventions: ArtifactSchema(),
                historia_content:,
                feature_content: feature,
                requisitos_content: tech.requisitos,
                atributos_content: tech.atributos,
                adr_content: tech.adr,
                der_content: tech.der,
                diagramas_content: tech.diagramas,
                feedback_content: ChangesBlock.for_artifact(project_id, "plano", scope)
            ),
            schema_file: PlanoSchema, project_id:, artifact: "plano",
            prepare: (raw) -> PlanoPrep.annotate(json.parse(raw), historia, titulo, known),
            check: (d) -> ArtifactChecks.plano(d)
        ))
        return Drafts.followed_by(draft, RadahnAssess.annotate(draft.data, historia_content, tech.der, tech.adr, autorrevisao, project_id))
    }
}

test CommonDraftsSpec {
    // Paginas ate o modelo dizer que terminou: junta as historias na ordem e
    // soma o consumo de todas as chamadas.
    // Lambdas nao alteram variaveis de fora: o falso modelo escolhe a pagina
    // pelo que ja foi gerado e registra cada chamada num arquivo.
    describe with_proposals_each_page_details_its_own_slice {
        var log_path = "spec-test-paginate-proposals.log"
        if (fs.exists(log_path)) fs.delete(log_path)
        var propostas = ["A", "B", "C", "D", "E", "F"].map((t) -> {titulo: t, tipo: "historia_usuario", resultado: "r"})
        var draft = CommonDrafts.paginate(propostas, (anteriores, pagina) -> {
            fs.append(log_path, "${anteriores.size()}:${pagina.map((p) -> p.titulo).join("")}\n")
            return {data: {historias: pagina.map((p) -> {titulo: p.titulo}), mais_historias: true}, tokens_in: 10, tokens_out: 5}
        })
        are_equal(draft.data.historias.map((h) -> h.titulo), ["A", "B", "C", "D", "E", "F"])
        are_equal(fs.read(log_path), "0:ABCD\n4:EF\n")
        are_equal(draft.tokens_in, 20)
        fs.delete(log_path)
    }

    describe without_proposals_pages_until_the_model_says_it_is_done {
        var log_path = "spec-test-paginate-open.log"
        if (fs.exists(log_path)) fs.delete(log_path)
        var pages = {
            "0": {data: {historias: [{titulo: "A"}, {titulo: "B"}], mais_historias: true}, tokens_in: 10, tokens_out: 5},
            "2": {data: {historias: [{titulo: "C"}], mais_historias: false}, tokens_in: 12, tokens_out: 3},
        }
        var draft = CommonDrafts.paginate([], (anteriores, pagina) -> {
            fs.append(log_path, "${anteriores.size()}\n")
            return pages["${anteriores.size()}"]
        })
        are_equal(draft.data.historias.map((h) -> h.titulo), ["A", "B", "C"])
        are_equal(draft.tokens_out, 8)
        are_equal(fs.read(log_path), "0\n2\n")
        fs.delete(log_path)
    }

    describe without_proposals_stops_at_the_page_limit_and_on_an_empty_page {
        var endless = CommonDrafts.paginate([], (anteriores, pagina) -> ({data: {historias: [{titulo: "x"}], mais_historias: true}, tokens_in: 1, tokens_out: 1}))
        are_equal(endless.data.historias.size(), CommonDrafts.max_paginas())
        var empty = CommonDrafts.paginate([], (anteriores, pagina) -> ({data: {historias: [], mais_historias: true}, tokens_in: 1, tokens_out: 1}))
        are_equal(empty.data.historias.size(), 0)
    }

    describe lote_names_the_proposals_of_the_page_and_what_was_already_generated {
        var first = CommonDrafts.lote([], [{titulo: "Cadastrar investidor", tipo: "historia_usuario", resultado: "investidor cadastrado"}])
        is_true(first.contains("- Cadastrar investidor (historia_usuario) — investidor cadastrado"))
        is_false(first.contains("já geradas"))
        var next = CommonDrafts.lote([{titulo: "Cadastrar investidor"}], [{titulo: "Validar KYC", tipo: "historia_habilitadora", resultado: "KYC validado"}])
        is_true(next.contains("- Cadastrar investidor\n"))
        is_true(next.contains("- Validar KYC"))
        is_true(CommonDrafts.lote([], []).contains("no máximo 4 histórias"))
    }
}
