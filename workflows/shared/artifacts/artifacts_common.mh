// artifacts_common.mh — schema/prompt/template dos 6 artefatos conceitualmente
// iguais em qualquer nivel (Oportunidade, Feature ou Historia): brief,
// atributos, requisitos, adr, der, diagramas. Fase 3 (Discovery) declarava
// isso dentro de discovery.mh; extraido pra ca na Fase 4 porque Delivery
// reaproveita exatamente a mesma coisa (C7 — nenhuma duplicacao de
// schema/template/tool entre os 4 workflows) em vez de duplicar os 6 pares
// de arquivo.
//
// So declaracoes aqui (prompt/schema-file/template-file) — nenhum `workflow`
// neste arquivo, de proposito: um step *Generate/*Commit continua vivendo em
// cada workflow que o usa (MHL nao tem como compartilhar corpo de step por
// import), mas a parte cara — texto de instrucao, contrato de schema,
// template de renderizacao — mora em um lugar so.

import { WorkflowsRoot } from "../core/workflows_root.mh"

export prompt ArtifactSchema() from "artifact_schema.prompt.md"

// feedback_content on every *Instruction prompt below is filled by
// ChangesBlock.for_artifact (workflows/shared/artifacts/changes_log.mh),
// not a single "latest comment" string — see that file's own doc comment
// for the two approaches that were tried here first and why both broke on
// a real test before this one. The parameter name stayed the same (every
// *.prompt.md below still just does `${feedback_content}`) — only what
// computes its value, at each *Generate call site, changed.

export prompt BriefInstruction(schema_conventions: prompt, wiki_content: string, feedback_content: string) from "prompts/brief.prompt.md"
export prompt AtributosInstruction(schema_conventions: prompt, brief_content: string, wiki_content: string, feedback_content: string) from "prompts/atributos.prompt.md"
export prompt RequisitosInstruction(schema_conventions: prompt, brief_content: string, wiki_content: string, feedback_content: string) from "prompts/requisitos.prompt.md"
// Adr/Der/Diagramas/Historias nao recebem `wiki_content`, de proposito: sao
// artefatos derivados de requisitos/atributos/feature ja sintetizados, nao
// do material bruto da wiki (so brief/atributos/requisitos leem a wiki
// diretamente). Alem de ser redundante (o que a wiki tem de relevante ja foi
// destilado pelos artefatos predecessores), Context.wiki(project_id)
// concatena TODAS as paginas da wiki do projeto — pode facilmente passar de
// dezenas de KB. Devin recebe o prompt via `--prompt-file`, mas Claude/Codex
// nao tem um flag equivalente (so leem argv ou stdin, e o bloco `agent` do
// mhl nao suporta redirecionar stdin) — um prompt desse tamanho no argv
// estoura o limite de ~32K caracteres de linha de comando do Windows
// (CreateProcess), derrubando a chamada com "O nome do arquivo ou a extensao
// e muito grande" (Windows error 206) antes mesmo de chegar no backend.
export prompt AdrInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, feedback_content: string) from "prompts/adr.prompt.md"
export prompt DerInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, feedback_content: string) from "prompts/der.prompt.md"
export prompt DiagramasInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, feedback_content: string) from "prompts/diagramas.prompt.md"

// Gera historias pra UMA feature — usado por Discovery (feature dentro do
// backlog de uma Oportunidade) e por Delivery (a unica feature implicita de
// um projeto standalone). `feature_content` e o feature.html de qualquer um
// dos dois casos — a instrucao nao muda, so quem fornece o conteudo muda.
export prompt HistoriasInstruction(schema_conventions: prompt, feature_content: string, feedback_content: string) from "prompts/historias.prompt.md"

prompt HistoriasSchemaContent() from "schemas/historias.schema.json"
prompt BriefSchemaContent() from "schemas/brief.schema.json"
prompt AtributosSchemaContent() from "schemas/atributos.schema.json"
prompt RequisitosSchemaContent() from "schemas/requisitos.schema.json"
prompt AdrSchemaContent() from "schemas/adr.schema.json"
prompt DerSchemaContent() from "schemas/der.schema.json"
prompt DiagramasSchemaContent() from "schemas/diagramas.schema.json"

export tool HistoriasSchemaFile { get(): {content: string, path: string} -> {content: HistoriasSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/historias.schema.json")} }
export tool BriefSchemaFile { get(): {content: string, path: string} -> {content: BriefSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/brief.schema.json")} }
export tool AtributosSchemaFile { get(): {content: string, path: string} -> {content: AtributosSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/atributos.schema.json")} }
export tool RequisitosSchemaFile { get(): {content: string, path: string} -> {content: RequisitosSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/requisitos.schema.json")} }
export tool AdrSchemaFile { get(): {content: string, path: string} -> {content: AdrSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/adr.schema.json")} }
export tool DerSchemaFile { get(): {content: string, path: string} -> {content: DerSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/der.schema.json")} }
export tool DiagramasSchemaFile { get(): {content: string, path: string} -> {content: DiagramasSchemaContent(), path: WorkflowsRoot.resolve("shared/artifacts/schemas/diagramas.schema.json")} }

export prompt BriefBody(resumo_executivo: string, resumo_fontes: string, contexto_negocio: string, contexto_fontes: string, objetivos_tabela: string, em_escopo_lista: string, fora_escopo_lista: string, stakeholders_tabela: string, metricas_tabela: string, marcos_tabela: string, riscos_tabela: string, perguntas_lista: string) from "templates/brief_body.html"
export prompt AtributosBody(contexto: string, contexto_fontes: string, requisitos_tabela: string, restricoes_tabela: string, compliance_tabela: string, exclusoes_lista: string, perguntas_lista: string) from "templates/atributos_body.html"
export prompt RequisitosBody(contexto: string, contexto_fontes: string, funcionais_tabela: string, integracoes_tabela: string, dados_tabela: string, negocio_tabela: string, regras_tabela: string, exclusoes_lista: string, gaps_lista: string, perguntas_lista: string) from "templates/requisitos_body.html"
export prompt AdrBody(
    status: string,
    contexto_e_problema: string, contexto_fontes: string,
    fatores_decisao_lista: string,
    opcoes_consideradas_lista: string,
    decisao_final: string, decisao_final_fontes: string,
    consequencias_positivas_lista: string, consequencias_negativas_lista: string,
    opcoes_pros_contras: string,
    links_lista: string
) from "templates/adr_body.html"
export prompt DerBody(modo: string, contexto: string, contexto_fontes: string, diagrama_mermaid: string, entidades_tabela: string, confirmados_tabela: string, inferidos_tabela: string, atributos_tabela: string, delta_lista: string, gaps_lista: string, questoes_lista: string) from "templates/der_body.html"
export prompt DiagramaBody(diagram_type: string, hierarchy_level: string, descricao: string, descricao_fontes: string, diagrama_mermaid: string) from "templates/diagrama_body.html"

// FeatureBody/HistoriaBody sao o corpo de UM item de feature/historia — o
// mesmo formato serve tanto pro item dentro do backlog do Discovery quanto
// pro detalhamento final do Delivery (a diferenca entre os dois nunca esta
// na FORMA renderizada, so em quais dados entram e onde o arquivo e gravado).
export prompt FeatureBody(classificacao_lista: string, hipotese_beneficio: string, hipotese_beneficio_fontes: string, itens_habilitados_lista: string, resumo: string, resumo_fontes: string, objetivo: string, objetivo_fontes: string, personas_tabela: string, em_escopo_lista: string, fora_escopo_lista: string, regras_lista: string, interacoes_lista: string, criterios_lista: string, historias_lista: string, dependencias_lista: string, dependencias_sistema_lista: string, gaps_lista: string, questoes_lista: string) from "templates/feature_body.html"
export prompt HistoriaBody(statement: string, statement_fontes: string, atributos_lista: string, contexto_negocio: string, contexto_fontes: string, criterios_lista: string, cenarios_gherkin: string, cenarios_fontes: string, regras_lista: string, dod_lista: string, dependencias_lista: string, fora_escopo_lista: string, exemplo_uso: string, exemplo_fontes: string, contratos_interface: string, contratos_fontes: string, questoes_lista: string) from "templates/historia_body.html"

// DependenciasBody — Discovery-only (a "dependência entre features" só faz
// sentido quando o work-item tem um backlog de mais de uma feature; Delivery
// nunca gera isso), mas o template de renderização mora aqui junto dos
// outros pela mesma razão que FeatureBody/HistoriaBody moram: é a única
// parte compartilhável entre o que gera o artefato (discovery.partial.
// backlog.mh, ao lado de Features) e como ele vira HTML.
export prompt DependenciasBody(mapa_tabela: string, ordem_tabela: string, diagrama_mermaid: string, gaps_lista: string) from "templates/dependencias_body.html"

test SchemaFileSpec {
    describe exposes_schema_content_and_codex_file_path {
        var schema_file = AtributosSchemaFile.get()
        var parsed = json.parse(schema_file.content)
        are_equal(parsed.type, "object")
        are_equal(schema_file.path, "workflows/shared/artifacts/schemas/atributos.schema.json")
    }
}
