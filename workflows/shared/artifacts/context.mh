// tool Context — unico ponto de leitura de contexto para gerar um artefato
// (C2, PLANO-MACRO-MHL-SENPAI.md §2.1): Discovery/Delivery so podem ler
// wiki/** e artifacts/** do mesmo project_id, nunca raw/, nunca outro
// projeto. Nenhum step de artefato chama fs.read/dir.* solto pra montar o
// prompt — sempre atraves daqui, do mesmo jeito que WikiContext e o unico
// ponto de leitura de wiki/** para query/lint.

import { Paths } from "../core/paths.mh"
import { WikiContext } from "../wiki/wiki_context.mh"
import { DirText } from "../core/dir_text.mh"
import { ArtifactData } from "artifact_data.mh"

export tool Context {
    wiki(project_id: string): string -> WikiContext.all_pages(project_id)

    // Le um artefato predecessor ja gerado (ex. "requisitos.html"). O HTML
    // continua sendo o marcador de commit e a projecao visual do frontend,
    // mas o contexto do LLM prefere o JSON estruturado adjacente. Artefatos
    // legados sem JSON continuam funcionando pelo fallback ao body do HTML.
    artifact(project_id: string, relative: string): string -> {
        var html_path = Paths.artifact(project_id, relative)
        if (!fs.exists(html_path)) return ""
        var json_path = Paths.artifact(project_id, ArtifactData.json_relative(relative))
        if (fs.exists(json_path)) return fs.read(json_path)
        return DirText.body_only(fs.read(html_path))
    }

    // Mesma coisa, mas para um predecessor que e uma PASTA com varios
    // arquivos (ex. "adr", "diagramas") — concatena todos. Vazio se a pasta
    // nao existir ou nao tiver nenhum arquivo ainda. Cabecalho de cada item
    // vira uma referencia curta relativa a artifacts/ (ex. "adr/ADR-001-x").
    artifact_dir(project_id: string, relative_dir: string): string ->
        DirText.concat_artifacts(Paths.artifact(project_id, relative_dir), Paths.artifacts_dir(project_id))
}
