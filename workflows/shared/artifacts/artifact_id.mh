// tool ArtifactId — geracao de id sequencial (FT00N/US00N/ADR-00N) + nome de
// pasta (id + slug). E trabalho deterministico (C3): a LLM nunca decide um
// id ou conta quantas features ja existem — sempre este tool.
//
// O contador vive no proprio sistema de arquivos (dir.list().size() da
// pasta-alvo) em vez de um `memory` a parte — nao ha risco de o contador
// dessincronizar do que realmente existe em disco, e nao precisa de mais um
// arquivo de estado pra manter consistente.

import { Paths } from "paths.mh"
import { Slug } from "slug.mh"

export tool ArtifactId {
    next_sequential(dir_path: string, prefix: string): string -> {
        var n = self.count_existing(dir_path) + 1
        return prefix + self.pad3(n)
    }

    count_existing(dir_path: string): number -> {
        if (!dir.exists(dir_path)) return 0
        return dir.list(dir_path).size()
    }

    pad3(n: number): string -> {
        if (n < 10) return "00${n}"
        if (n < 100) return "0${n}"
        return "${n}"
    }

    next_feature_id(project_id: string): string ->
        self.next_sequential(Paths.artifact(project_id, "features"), "FT")

    // feature_dir default "" = historias de uma feature standalone do
    // Delivery (artifacts/historias/US00N-slug/, sem prefixo de feature —
    // so existe uma feature implicita nesse projeto). Discovery passa o
    // feature_dir de verdade pra numerar historias por feature dentro do
    // backlog de uma Oportunidade.
    next_historia_id(project_id: string, feature_dir: string = ""): string -> {
        var historias_dir = if (feature_dir.is_empty()) "historias" else "historias/" + feature_dir
        return self.next_sequential(Paths.artifact(project_id, historias_dir), "US")
    }

    // ADRs seguem a convencao usual de Architecture Decision Records
    // ("ADR-001-titulo"), distinta de FT/US porque e um formato de terceiros
    // bem estabelecido, nao uma convencao que este plano esta inventando.
    next_adr_id(project_id: string): string ->
        self.next_sequential(Paths.artifact(project_id, "adr"), "ADR-")

    folder_name(id: string, title: string): string ->
        id + "-" + Slug.from_title(title)

    // Resolve "FT001" pro nome real da pasta ("FT001-nome-da-feature") —
    // quem pede historias de uma feature so sabe o id curto, nao o slug.
    // Usado pelo Discovery (`historias` de uma feature especifica do backlog).
    find_feature_dir(project_id: string, feature_id: string): string -> {
        var base_dir = Paths.artifact(project_id, "features")
        if (!dir.exists(base_dir)) fail("nenhuma feature encontrada em artifacts/features/ (gere 'features' primeiro)")
        for (var entry in dir.list(base_dir)) {
            var name = entry.replace(base_dir + "/", "")
            if (name.starts_with(feature_id + "-")) return name
        }
        fail("feature '" + feature_id + "' nao encontrada em artifacts/features/")
    }
}

test ArtifactIdSpec {
    describe pad3_zero_fills_to_three_digits {
        are_equal(ArtifactId.pad3(1), "001")
        are_equal(ArtifactId.pad3(9), "009")
        are_equal(ArtifactId.pad3(10), "010")
        are_equal(ArtifactId.pad3(99), "099")
        are_equal(ArtifactId.pad3(100), "100")
        are_equal(ArtifactId.pad3(999), "999")
    }

    describe folder_name_combines_id_and_slug {
        are_equal(ArtifactId.folder_name("FT001", "Checkout em uma etapa"), "FT001-checkout-em-uma-etapa")
        are_equal(ArtifactId.folder_name("ADR-001", "Usar tokenização via PSP"), "ADR-001-usar-tokenizacao-via-psp")
    }
}
