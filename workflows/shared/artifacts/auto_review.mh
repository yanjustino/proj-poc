// tool AutoReview — autorrevisao: quando as verificacoes deterministicas de
// um artefato (C4Diagram, DerModel, FeatureRules, StoryRules/Scenarios/
// Contracts/Traceability, PlanoModel) encontram problemas na geracao, pede
// UMA correcao ao modelo, com os avisos e a propria resposta anterior, antes
// de o rascunho pausar para revisao humana.
//
// Por que nao vira loop — garantido pela forma do codigo, nao pelo modelo:
//   - no maximo DUAS chamadas de Writer.generate por execucao de generate():
//     a segunda e codigo sequencial, sem goto, sem recursao, sem laco;
//   - quem decide se revisa e o codigo (avisos das verificacoes), nunca o
//     modelo julgando se "ficou bom";
//   - a versao revisada so e usada se tiver MENOS avisos que a primeira —
//     o pior caso e exatamente o resultado de hoje, sem revisao;
//   - uma resposta revisada que nem e JSON valido e descartada.
// O "Regerar"/"Solicitar mudanca" do Gate continua como sempre: cada
// execucao de *Generate que ele dispara tem, ela propria, o mesmo teto de 2.

import { Writer } from "../agents/agents.mh"
import { SchemaFile } from "../core/workflows_root.mh"

export tool AutoReview {
    // generate: `prepare(raw)` transforma a resposta crua no dado do
    // artefato (parse + anotacoes deterministicas); `check(data)` devolve os
    // avisos. Devolve o dado escolhido, o consumo somado das chamadas e o
    // registro da revisao (exibido na pagina — ver note_html).
    generate(enabled: bool, prompt: string, schema_file: SchemaFile, project_id: string, artifact: string, prepare: any, check: any): any ->
        self.execute((p) -> Writer.generate(prompt: p, schema_file: schema_file, project_id: project_id, artifact: artifact), enabled, prompt, prepare, check)

    // execute: o nucleo (nao "run": nome reservado do mhl para Workflow.run), com a chamada ao modelo injetada (`call(prompt)`) — e o
    // que o teste usa para provar o teto de duas chamadas com um modelo falso
    // que sempre devolve uma resposta com avisos.
    execute(call: any, enabled: bool, prompt: string, prepare: any, check: any): any -> {
        var first = call(prompt)
        var data = prepare(first.content)
        var avisos = check(data)
        var tokens_in = first.tokens_in
        var tokens_out = first.tokens_out
        var revisao = {tentada: false, aplicada: false, avisos_antes: avisos.size(), avisos_depois: avisos.size()}

        if (enabled && !avisos.is_empty()) {
            var second = call(prompt + self.block(avisos, first.content))
            tokens_in = tokens_in + second.tokens_in
            tokens_out = tokens_out + second.tokens_out
            var revised = null
            var avisos_revisados = avisos
            try {
                revised = prepare(second.content)
                avisos_revisados = check(revised)
            } catch (err) {
                revised = null
            }
            var melhorou = revised != null && avisos_revisados.size() < avisos.size()
            if (melhorou) data = revised
            revisao = {
                tentada: true,
                aplicada: melhorou,
                avisos_antes: avisos.size(),
                avisos_depois: if (melhorou) avisos_revisados.size() else avisos.size(),
            }
        }
        return {data: data, tokens_in: tokens_in, tokens_out: tokens_out, revisao: revisao}
    }

    // Os avisos (sem repeticao, no maximo 40) e a resposta anterior — o
    // modelo corrige o que foi apontado em vez de gerar do zero.
    block(avisos: string[], previous: string): string -> {
        var unicos = []
        for (var a in avisos) {
            if (!unicos.contains(a) && unicos.size() < 40) unicos += [a]
        }
        return "\n\n## Revisão automática da sua resposta anterior\n\n" +
            "Sua resposta anterior (JSON abaixo) foi verificada automaticamente e tem estes problemas:\n\n" +
            unicos.map((a) -> "- " + a).join("\n") +
            "\n\nProduza a resposta completa novamente, no mesmo schema, corrigindo esses problemas e mantendo todo o resto. " +
            "Não remova conteúdo correto só para eliminar um aviso; se um problema não puder ser corrigido com as fontes disponíveis, " +
            "mantenha-o e registre a razão em gaps ou questões abertas.\n\n### Resposta anterior\n\n" + previous + "\n"
    }

    // with_review: copia o registro da revisao para cada item de uma colecao
    // (diagramas, features, historias) — o preview e a pagina de UM item
    // mostram a nota sem precisar do lote.
    tag_items(items: any[], revisao: any): any[] -> {
        var out = []
        for (var item in items) {
            item["autorrevisao"] = revisao
            out += [item]
        }
        return out
    }

    note_html(data: any): string -> {
        var r = data?.autorrevisao
        if (r == null || !(r?.tentada ?? false)) return ""
        if (r?.aplicada ?? false) {
            return "<p class=\"autorrevisao\">Revisado automaticamente: ${r.avisos_antes} aviso(s) na geração → ${r.avisos_depois} depois da revisão.</p>"
        }
        return "<p class=\"autorrevisao\">Revisão automática tentada, sem melhora — mantida a versão original (${r.avisos_antes} aviso(s)).</p>"
    }
}

test AutoReviewSpec {
    // O teto de duas chamadas, com um modelo falso que NUNCA corrige nada:
    // cada chamada grava uma linha num arquivo; a geracao termina com
    // exatamente 2 linhas e a versao original (a revisada nao melhorou).
    describe never_calls_the_model_more_than_twice_even_if_warnings_persist {
        var log_path = "spec-test-auto-review-calls.log"
        if (fs.exists(log_path)) fs.delete(log_path)
        var result = AutoReview.execute(
            (p) -> {
                fs.append(log_path, "call\n")
                return {content: "{\"ok\": false}", tokens_in: 10, tokens_out: 5}
            },
            true, "gere", (raw) -> json.parse(raw), (data) -> ["sempre um aviso"]
        )
        are_equal(fs.read(log_path).split("\n").filter((l) -> l == "call").size(), 2)
        is_true(result.revisao.tentada)
        is_true(!result.revisao.aplicada)
        are_equal(result.tokens_in, 20)
        fs.delete(log_path)
    }

    describe a_revision_with_fewer_warnings_replaces_the_original {
        var log_path = "spec-test-auto-review-better.log"
        if (fs.exists(log_path)) fs.delete(log_path)
        var result = AutoReview.execute(
            (p) -> {
                fs.append(log_path, "call\n")
                return {content: if (p.contains("Revisão automática")) "{\"v\": 2}" else "{\"v\": 1}", tokens_in: 1, tokens_out: 1}
            },
            true, "gere", (raw) -> json.parse(raw), (data) -> if (data.v == 1) ["a", "b"] else []
        )
        are_equal(result.data.v, 2)
        is_true(result.revisao.aplicada)
        are_equal(result.revisao.avisos_depois, 0)
        fs.delete(log_path)
    }

    describe disabled_or_clean_generation_calls_the_model_once {
        var log_path = "spec-test-auto-review-once.log"
        if (fs.exists(log_path)) fs.delete(log_path)
        var call = (p) -> {
            fs.append(log_path, "call\n")
            return {content: "{}", tokens_in: 1, tokens_out: 1}
        }
        AutoReview.execute(call, false, "gere", (raw) -> json.parse(raw), (data) -> ["aviso"])
        AutoReview.execute(call, true, "gere", (raw) -> json.parse(raw), (data) -> [])
        are_equal(fs.read(log_path).split("\n").filter((l) -> l == "call").size(), 2)
        fs.delete(log_path)
    }

    describe an_invalid_revised_answer_keeps_the_original {
        var result = AutoReview.execute(
            (p) -> ({content: if (p.contains("Revisão automática")) "isto não é json" else "{\"v\": 1}", tokens_in: 1, tokens_out: 1}),
            true, "gere", (raw) -> json.parse(raw), (data) -> ["a"]
        )
        are_equal(result.data.v, 1)
        is_true(!result.revisao.aplicada)
    }

    describe block_lists_unique_warnings_and_the_previous_answer {
        var b = AutoReview.block(["A falta", "A falta", "B errado"], "{\"x\":1}")
        is_true(b.contains("- A falta\n- B errado\n"))
        is_true(!b.contains("- A falta\n- A falta"))
        is_true(b.contains("### Resposta anterior\n\n{\"x\":1}"))
    }

    describe note_reports_the_outcome {
        is_true(AutoReview.note_html({autorrevisao: {tentada: true, aplicada: true, avisos_antes: 5, avisos_depois: 1}}).contains("5 aviso(s) na geração → 1"))
        is_true(AutoReview.note_html({autorrevisao: {tentada: true, aplicada: false, avisos_antes: 3, avisos_depois: 3}}).contains("sem melhora"))
        are_equal(AutoReview.note_html({autorrevisao: {tentada: false}}), "")
        are_equal(AutoReview.note_html({}), "")
    }

    describe tag_items_copies_the_review_record {
        var items = AutoReview.tag_items([{a: 1}, {a: 2}], {tentada: true})
        is_true(items[1].autorrevisao.tentada)
    }
}
