// PageShell e o chrome HTML de todo artefato (titulo + corpo + rodape); cada
// template so declara o corpo. ArtifactMeta monta o rodape sempre em codigo,
// nunca pela LLM (C3): data/hora, backend e tokens sao fatos da execucao.

import { AgentSelector } from "../agents/agents.mh"

export prompt PageShell(title: string, body: prompt, meta: string) from "page_shell.prompt.md"

export tool ArtifactMeta {
    // O backend vem do mesmo seletor que Writer.generate usa, entao o rodape
    // nomeia quem de fato gerou o rascunho.
    line(path: string, tokens_in: number, tokens_out: number): string ->
        self.format(time.format(time.now(), "yyyy-MM-dd HH:mm"), path, AgentSelector.pick().to_lower(), tokens_in, tokens_out)

    internal format(generated_at: string, path: string, backend: string, tokens_in: number, tokens_out: number): string ->
        "gerado em ${generated_at} · ${path} · ${backend} · ${tokens_in} → ${tokens_out} tokens"
}

test ArtifactMetaSpec {
    describe names_the_backend_that_generated_the_draft {
        are_equal(ArtifactMeta.format("2026-10-01 10:00", "artifacts/brief.html", "devin", 3, 4), "gerado em 2026-10-01 10:00 · artifacts/brief.html · devin · 3 → 4 tokens")
        is_false(ArtifactMeta.line("artifacts/brief.html", 1, 2).contains("· claude ·") && AgentSelector.pick() != "Claude")
    }
}
