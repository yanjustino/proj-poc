// memory Usage + tool UsageParser — ledger de consumo de token por work-item
// (C5, PLANO-MACRO-MHL-SENPAI.md §2.1). Todo `agent` que gera artefato ou
// pagina de wiki declara um hook `after` que chama UsageParser.extract_<backend>
// sobre a resposta crua do CLI e grava o resultado aqui.
//
// `path_guard: "no_traversal"` (mhl 1.4.0-beta.6+) e defesa em profundidade —
// o mecanismo primario continua sendo `Paths.ensure_valid(project_id)` chamado
// no primeiro step de todo workflow, antes de qualquer var `project_id` ser
// usada aqui ou em qualquer outro lugar (ver FASE0-ACHADOS.md §10).

export memory Usage {
    type: "jsonl"
    path: "projects/${project_id}/usage.jsonl"
    path_guard: "no_traversal"
}

// Formato do envelope de --output-format json do Claude Code CLI, confirmado
// por spike real (FASE0-ACHADOS.md §5): usage.input_tokens/output_tokens
// junto do conteudo pedido, duplicado em `result` (string JSON) e
// `structured_output` (ja objeto). Devolvemos `result` porque e exatamente a
// string que o `json.parse` do passo seguinte espera.
export tool UsageParser {
    extract_claude(raw: string): {tokens_in: number, tokens_out: number, content: string} -> {
        var envelope = json.parse(raw)
        return {
            tokens_in: envelope.usage.input_tokens,
            tokens_out: envelope.usage.output_tokens,
            content: envelope.result,
        }
    }

    // `codex exec --json` emite JSONL. A resposta final vem no evento
    // item.completed/agent_message e o consumo no turn.completed.
    extract_codex(raw: string): {tokens_in: number, tokens_out: number, content: string} -> {
        var tokens_in = 0
        var tokens_out = 0
        var content = ""
        for (var event in json.parse_lines(raw)) {
            if (event.type == "item.completed" && event.item.type == "agent_message") {
                content = event.item.text
            }
            if (event.type == "turn.completed") {
                tokens_in = event.usage.input_tokens
                tokens_out = event.usage.output_tokens
            }
        }
        return {tokens_in: tokens_in, tokens_out: tokens_out, content: content}
    }
}

test UsageParserSpec {
    describe extracts_codex_final_message_and_usage_from_jsonl {
        var raw = "{\"type\":\"thread.started\",\"thread_id\":\"t1\"}\n" +
            "{\"type\":\"item.completed\",\"item\":{\"id\":\"i1\",\"type\":\"agent_message\",\"text\":\"{\\\"ok\\\":true}\"}}\n" +
            "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":12,\"cached_input_tokens\":3,\"output_tokens\":7}}"
        var parsed = UsageParser.extract_codex(raw)
        are_equal(parsed.tokens_in, 12)
        are_equal(parsed.tokens_out, 7)
        are_equal(parsed.content, "{\"ok\":true}")
    }
}
