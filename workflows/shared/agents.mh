// agent Writer — backend de LLM usado por Wiki/Discovery/Delivery para gerar
// conteudo (C4). Uma unica declaracao hoje porque so o `claude` CLI foi
// validado ponta a ponta com `schema:` (FASE0-ACHADOS.md §4/§5) — trocar para
// `codex`/`devin` em producao nao e so mudar `command:` (que agora aceita
// `env(...)`, achado #1 do MHL-Melhorias.md): a FORMA de `args` diverge
// estruturalmente entre os tres CLIs (schema inline vs. arquivo vs.
// inexistente — MHL-Melhorias.md #11), entao produzir os agentes de
// codex/devin fica para quando esses backends entrarem em uso real, nao
// antes (§2.1/C4 do plano macro).
//
// `--disallowed-tools` e a mitigacao obrigatoria de C2 (nenhum agente pode
// ler/escrever fora do que o proprio prompt manda) — testada de verdade
// (FASE2-ACHADOS.md §1): `--allowed-tools ""` NAO bloqueia nada, so a lista
// explicita em `--disallowed-tools` bloqueia de verdade.
//
// O hook `after` (C5) roda para toda chamada deste agente: separa o
// envelope de uso do conteudo de verdade e grava no ledger `Usage`. Steps que
// chamam `Writer.run(...)` precisam ter, no escopo do pipeline, `var
// tokens_in = 0`, `var tokens_out = 0` e `var current_artifact = "..."`
// (rotulo do que esta sendo gerado) declarados ANTES da chamada — `after`
// "ve as variaveis do step que chamou" (Docs-Reference §05), nao tem
// parametros proprios.

import { Usage, UsageParser } from "usage.mh"

export agent Writer {
    command: "claude"
    args: [
        "-p", "${prompt}",
        "--output-format", "json",
        "--json-schema", "${schema}",
        "--disallowed-tools", "Bash,Read,Write,Edit,MultiEdit,NotebookEdit,WebFetch,WebSearch,Glob,Grep,Task"
    ]
    after: () -> {
        var usage = UsageParser.extract_claude(result)
        Usage.append({
            artifact: current_artifact,
            tokens_in: usage.tokens_in,
            tokens_out: usage.tokens_out,
        })
        tokens_in = usage.tokens_in
        tokens_out = usage.tokens_out
        return usage.content
    }
}
