// WorkflowsRoot resolve um caminho sob workflows/ para um SUBPROCESSO (o
// `--output-schema` do Codex), que o interpreta contra a propria CWD — a do
// mhl, nao a do .mh. O app roda o mhl com CWD no diretorio de dados do
// usuario e define SENPAI_WORKFLOWS_ROOT; sem a variavel (uso pela CLI na
// raiz do repo), o caminho relativo "workflows/..." ja resolve certo.

// Contrato de schema que Writer.generate recebe: Claude/Devin usam o
// conteudo inline; Codex, o caminho do arquivo.
export type SchemaFile = {content: string, path: string}

export tool WorkflowsRoot {
    resolve(relative: string): string -> {
        var root = env("SENPAI_WORKFLOWS_ROOT")
        if (root.is_empty()) return "workflows/" + relative
        return root + "/" + relative
    }

    // `relative` e relativo a workflows/, o mesmo arquivo que o `prompt ...
    // from` de `content` le.
    schema(content: string, relative: string): SchemaFile -> {content: content, path: self.resolve(relative)}
}

test WorkflowsRootSpec {
    describe falls_back_to_the_relative_literal_when_the_env_var_is_unset {
        are_equal(WorkflowsRoot.resolve("shared/artifacts/schemas/brief.schema.json"), "workflows/shared/artifacts/schemas/brief.schema.json")
    }
}
