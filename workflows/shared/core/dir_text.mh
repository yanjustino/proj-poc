// tool DirText — concatena todo o conteudo de texto de um diretorio, um
// arquivo apos o outro, com um separador + cabecalho de proveniencia. Usado
// por WikiContext (wiki/entities, wiki/concepts, ...) para texto generico.
// `concat_artifacts` e a variante de Context para predecessores estruturados
// em pastas (artifacts/adr, artifacts/diagramas).
//
// `base_dir` e removido do cabecalho de cada arquivo, virando uma referencia
// curta e estavel (ex. "entities/time-de-pagamentos", "adr/ADR-001-titulo")
// em vez do caminho inteiro do disco — e essa referencia que a LLM cita
// quando ancora uma informacao do artefato numa fonte (ver Cite, tool
// compartilhado de citacao).

export tool DirText {
    concat_all(dir_path: string, base_dir: string): string -> {
        if (!dir.exists(dir_path)) return ""
        var out = ""
        for (var file_path in dir.list(dir_path)) {
            var label = file_path.replace(base_dir + "/", "").replace(".md", "").replace(".html", "")
            out = out + "\n\n---\n\n# " + label + "\n\n" + self.body_only(fs.read(file_path))
        }
        return out
    }

    // Variante para colecoes de artefatos, onde cada documento novo possui
    // um par .json + .html. Envia somente o JSON ao LLM; para documentos
    // legados sem JSON, preserva o fallback ao body do HTML. Um JSON orfao
    // sem o HTML correspondente e ignorado porque o HTML e o marcador de
    // disponibilidade do artefato (ArtifactData grava JSON primeiro).
    concat_artifacts(dir_path: string, base_dir: string): string -> {
        if (!dir.exists(dir_path)) return ""
        var out = ""
        for (var file_path in dir.list(dir_path)) {
            if (file_path.ends_with(".json")) {
                var html_path = file_path.substring(0, file_path.size() - 5) + ".html"
                if (fs.exists(html_path)) {
                    var label = file_path.replace(base_dir + "/", "").replace(".json", "")
                    out = out + "\n\n---\n\n# " + label + "\n\n" + fs.read(file_path)
                }
            } else if (file_path.ends_with(".html")) {
                var json_path = file_path.substring(0, file_path.size() - 5) + ".json"
                if (!fs.exists(json_path)) {
                    var label = file_path.replace(base_dir + "/", "").replace(".html", "")
                    out = out + "\n\n---\n\n# " + label + "\n\n" + self.body_only(fs.read(file_path))
                }
            }
        }
        return out
    }

    // body_only strips a generated legacy artifact page down to what's
    // inside its <body> — the doctype/<head>/inline <style> every
    // PageShell-rendered page carries (page_shell.prompt.md) is pure
    // presentation. New artifacts use their adjacent JSON for LLM context;
    // this remains as the backward-compatible fallback for old projects.
    //
    // Falls back to the input unchanged when there's no <body> tag —
    // wiki pages (sources/entities/concepts/answers) go through this same
    // concat_all as plain markdown, never HTML, and must pass through
    // untouched.
    body_only(page: string): string -> {
        if (!page.contains("<body>") || !page.contains("</body>")) return page
        var span = page.extract_content(from: "<body>", to: "</body>")
        return span.substring("<body>".size(), span.size() - "</body>".size())
    }
}

test DirTextSpec {
    describe body_only_strips_doctype_head_and_style_keeping_just_the_content {
        are_equal(
            DirText.body_only("<!doctype html><html><head><style>body{color:#000}</style></head><body><h1>ADR-001</h1><p>Contexto.</p></body></html>"),
            "<h1>ADR-001</h1><p>Contexto.</p>"
        )
    }

    describe body_only_passes_through_content_with_no_body_tag_unchanged {
        are_equal(DirText.body_only("# Entidade\n\nDescrição em markdown."), "# Entidade\n\nDescrição em markdown.")
    }

    describe body_only_passes_through_an_empty_string_unchanged {
        are_equal(DirText.body_only(""), "")
    }
}
