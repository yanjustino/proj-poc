// tool WikiContext — unico ponto de leitura de conteudo da wiki para
// query/lint (C2: essas acoes so podem ler wiki/**, nunca raw/). Como o
// agente roda com ferramentas de arquivo desligadas (C2, ver
// FASE2-ACHADOS.md §1), ele nao pode "abrir paginas por conta propria" —
// este tool le tudo antes da chamada e entrega como texto no prompt.
//
// v1: concatena index.md + todo o conteudo de sources/entities/concepts/
// answers. Funciona na escala que docs/wiki-llm.md descreve como confortavel
// (~100 fontes); ficar de olho no tamanho do prompt se a wiki crescer muito
// além disso (fora do escopo do v1, ja registrado no plano macro).

import { Paths } from "paths.mh"

export tool WikiContext {
    all_pages(project_id: string): string -> {
        var content = "# index.md\n\n" + self.read_file_if_exists(Paths.wiki(project_id, "index.md"))
        content = content + self.read_subdir(project_id, "sources")
        content = content + self.read_subdir(project_id, "entities")
        content = content + self.read_subdir(project_id, "concepts")
        content = content + self.read_subdir(project_id, "answers")
        return content
    }

    read_subdir(project_id: string, subdir: string): string -> {
        var full_dir = Paths.wiki_dir(project_id) + "/" + subdir
        if (!dir.exists(full_dir)) return ""
        var out = ""
        for (var file_path in dir.list(full_dir)) {
            out = out + "\n\n---\n\n# " + file_path + "\n\n" + fs.read(file_path)
        }
        return out
    }

    read_file_if_exists(path: string): string -> {
        if (!fs.exists(path)) return "(vazio)"
        return fs.read(path)
    }
}
