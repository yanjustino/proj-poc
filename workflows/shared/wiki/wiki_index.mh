// tool WikiIndex — mantem wiki/index.md deterministicamente (C3: a LLM nunca
// reescreve o indice, so devolve titulo/resumo/slug via schema; inserir,
// ordenar e dedupe e sempre codigo). Renderiza o arquivo inteiro do zero a
// cada upsert, a partir de um estado interno (`Paths.index_state_file`) —
// evita ter que reler/parsear o markdown ja escrito (fragil sem regex).
// Chamadas entre metodos-irmaos usam `self.` (MHL-Melhorias.md #6).

import { Paths } from "../core/paths.mh"
import { Slug } from "../core/slug.mh"
import { Fixture } from "../core/fixture.mh"

export tool WikiIndex {
    // So a fonte carrega `natureza` (ingest.schema.json); por isso
    // render_section le o campo com `?? ""`. Entidades e conceitos entram por
    // WikiActions.upsert_fact.
    upsert_source(project_id: string, entry: {slug: string, title: string, summary: string, natureza: string}) ->
        self.upsert(project_id, "sources", entry)

    upsert_answer(project_id: string, entry: {slug: string, title: string, summary: string}) ->
        self.upsert(project_id, "answers", entry)

    // Uma pagina que ja existe mantem o resumo original (o primeiro fato que
    // a definiu) e acumula os aliases de cada ingestao.
    upsert(project_id: string, category: string, entry: any) -> {
        var state = self.load(project_id)
        var list = state.get(category, [])
        var existing = list.find((e) -> e.slug == entry.slug)
        if (existing != null) {
            entry["summary"] = existing.summary
            entry["aliases"] = self.merge_aliases(entry.title, existing?.aliases ?? [], entry?.aliases ?? [])
        } else {
            entry["aliases"] = self.merge_aliases(entry.title, [], entry?.aliases ?? [])
        }
        list = list.filter((e) -> e.slug != entry.slug)
        list += [entry]
        list = list.sort_by((existing) -> existing.title)
        state[category] = list
        self.save(project_id, state)
        self.render(project_id, state)
    }

    // Sem repeticao e sem o proprio titulo, comparando pelo slug (ignora
    // caixa, acento e pontuacao).
    merge_aliases(title: string, current: string[], incoming: string[]): string[] -> {
        var seen = [Slug.from_title(title)]
        var out = []
        for (var alias in current + incoming) {
            var key = Slug.from_title(alias)
            if (!alias.trim().is_empty() && !seen.contains(key)) {
                seen += [key]
                out += [alias.trim()]
            }
        }
        return out
    }

    // Titulo canonico de uma entidade/conceito: o da pagina existente cujo
    // titulo ou alias tem o mesmo slug; senao, o proprio titulo recebido.
    // E a rede de seguranca deterministica para a LLM que nao reaproveitou
    // o titulo do catalogo.
    canonical_title(project_id: string, category: string, title: string): string -> {
        var key = Slug.from_title(title)
        var match = self.load(project_id).get(category, []).find((e) ->
            e.slug == key || (e?.aliases ?? []).any((a) -> Slug.from_title(a) == key)
        )
        return match?.title ?? title
    }

    // Catalogo de entidades e conceitos para o prompt de ingestao: a LLM
    // reaproveita estes titulos em vez de criar uma pagina por variacao.
    catalog(project_id: string): string -> {
        var state = self.load(project_id)
        var out = self.catalog_section("Entidades", state.get("entities", [])) + self.catalog_section("Conceitos", state.get("concepts", []))
        return if (out.is_empty()) "(nenhuma página ainda — todas as entidades e conceitos desta fonte são novos)" else out
    }

    catalog_section(label: string, entries: any[]): string -> {
        if (entries.is_empty()) return ""
        var lines = entries.map((e) -> {
            var aliases = e?.aliases ?? []
            return "- ${e.title}" + (if (aliases.is_empty()) "" else " (também: ${aliases.join(", ")})")
        })
        return "### ${label}\n\n${lines.join("\n")}\n\n"
    }

    load(project_id: string): any -> {
        var path = Paths.index_state_file(project_id)
        if (!fs.exists(path)) return {sources: [], entities: [], concepts: [], answers: []}
        return json.parse(fs.read(path))
    }

    save(project_id: string, state: any) ->
        fs.write(Paths.index_state_file(project_id), json.stringify(state))

    render(project_id: string, state: any) -> {
        var body = "# Índice da Wiki\n\n"
        body = body + self.render_section("Fontes", "sources", state.get("sources", []))
        body = body + self.render_section("Entidades", "entities", state.get("entities", []))
        body = body + self.render_section("Conceitos", "concepts", state.get("concepts", []))
        body = body + self.render_section("Respostas arquivadas", "answers", state.get("answers", []))
        fs.write(Paths.wiki(project_id, "index.md"), body)
    }

    render_section(title: string, dir: string, entries: any[]): string -> {
        if (entries.is_empty()) return ""
        var lines = "## " + title + "\n\n"
        for (var entry in entries) {
            lines = lines + "- [" + entry.title + "](" + dir + "/" + entry.slug + ".md)" + self.natureza_badge(entry) + " — " + entry.summary + "\n"
        }
        return lines + "\n"
    }

    natureza_badge(entry: any): string -> {
        var n = entry?.natureza ?? ""
        if (n.is_empty()) return ""
        return " `[" + self.natureza_label(n) + "]`"
    }

    natureza_label(natureza: string): string -> match natureza {
        "sistema_atual" -> "sistema atual"
        "pedido_novo"   -> "pedido novo"
        "ambos"         -> "ambos"
        _               -> natureza
    }
}

test WikiIndexSpec {
    describe render_section_lists_entries_alphabetically_pre_sorted {
        var section = WikiIndex.render_section("Fontes", "sources", [
            {slug: "a", title: "Ata", summary: "resumo a"},
            {slug: "b", title: "Benchmark", summary: "resumo b"},
        ])
        are_equal(section, "## Fontes\n\n- [Ata](sources/a.md) — resumo a\n- [Benchmark](sources/b.md) — resumo b\n\n")
    }

    describe render_section_of_empty_list_is_empty_string {
        are_equal(WikiIndex.render_section("Fontes", "sources", []), "")
    }

    describe render_section_shows_the_natureza_badge_only_when_the_entry_has_one {
        var section = WikiIndex.render_section("Fontes", "sources", [
            {slug: "a", title: "Ata", summary: "resumo a", natureza: "sistema_atual"},
            {slug: "b", title: "Benchmark", summary: "resumo b"},
        ])
        are_equal(section, "## Fontes\n\n- [Ata](sources/a.md) `[sistema atual]` — resumo a\n- [Benchmark](sources/b.md) — resumo b\n\n")
    }

    describe merge_aliases_drops_repeats_and_the_title_ignoring_case_and_accents {
        are_equal(WikiIndex.merge_aliases("Compliance regulatório", ["LGPD"], ["lgpd", "Compliance Regulatorio", "Conformidade", " "]), ["LGPD", "Conformidade"])
    }

    describe catalog_lists_titles_with_their_aliases {
        var id = Fixture.project("spec-test-wiki-catalog")
        are_equal(WikiIndex.catalog(id), "(nenhuma página ainda — todas as entidades e conceitos desta fonte são novos)")
        dir.create(Paths.wiki_dir(id))
        WikiIndex.upsert(id, "concepts", {slug: "compliance-regulatorio", title: "Compliance regulatório", summary: "x", aliases: ["Conformidade"]})
        are_equal(WikiIndex.catalog(id), "### Conceitos\n\n- Compliance regulatório (também: Conformidade)\n\n")
        Fixture.drop(id)
    }

    describe canonical_title_matches_an_existing_title_or_alias {
        var id = Fixture.project("spec-test-wiki-canonical")
        dir.create(Paths.wiki_dir(id))
        WikiIndex.upsert(id, "concepts", {slug: "compliance-regulatorio", title: "Compliance regulatório", summary: "x", aliases: ["Conformidade regulatória"]})
        are_equal(WikiIndex.canonical_title(id, "concepts", "COMPLIANCE REGULATORIO"), "Compliance regulatório")
        are_equal(WikiIndex.canonical_title(id, "concepts", "conformidade regulatoria"), "Compliance regulatório")
        are_equal(WikiIndex.canonical_title(id, "concepts", "Observabilidade"), "Observabilidade")
        are_equal(WikiIndex.canonical_title(id, "entities", "Conformidade regulatória"), "Conformidade regulatória")
        Fixture.drop(id)
    }

    describe upsert_keeps_the_first_summary_and_accumulates_aliases {
        var id = Fixture.project("spec-test-wiki-upsert")
        dir.create(Paths.wiki_dir(id))
        WikiIndex.upsert(id, "concepts", {slug: "kyc", title: "KYC", summary: "primeiro", aliases: ["Conheça seu cliente"]})
        WikiIndex.upsert(id, "concepts", {slug: "kyc", title: "KYC", summary: "segundo", aliases: ["Know your customer"]})
        var entry = WikiIndex.load(id).concepts[0]
        are_equal(entry.summary, "primeiro")
        are_equal(entry.aliases, ["Conheça seu cliente", "Know your customer"])
        Fixture.drop(id)
    }
}
