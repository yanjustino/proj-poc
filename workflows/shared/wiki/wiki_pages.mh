// tool WikiPages — grava as paginas de wiki/sources|entities|concepts/*.md.
// A LLM devolve titulo/resumo/fatos via schema (C3); quem decide o nome do
// arquivo (Slug), a formatacao da lista (Markdown.list) e onde/como escrever
// e sempre este tool.
//
// v1 (deliberado): uma pagina de entidade/conceito acumula blocos de fatos
// datados (append-only) em vez de reescrever uma lista unica deduplicada —
// evita parsear markdown ja escrito pra fazer merge. O mesmo fato pode
// aparecer em mais de um bloco ao longo do tempo; sintese/dedupe fica pra
// uma fase futura do workflow Wiki (nao bloqueia o v1). Paginas de fonte, ao
// contrario, sao escritas uma unica vez (uma fonte so e ingerida uma vez).

import { Paths } from "../core/paths.mh"
import { Slug } from "../core/slug.mh"
import { Markdown } from "../core/markdown.mh"
import { WikiAlerts } from "wiki_alerts.mh"

export tool WikiPages {
    // natureza (ingest.schema.json) entra como uma linha logo apos o titulo,
    // nao so no indice — e o proprio conteudo da fonte que WikiContext.
    // all_pages concatena pra brief/atributos/requisitos, entao o rotulo
    // precisa estar aqui pra chegar citavel a esses artefatos mesmo quando
    // ninguem le o indice separadamente.
    write_source(project_id: string, slug: string, title: string, summary: string, natureza: string) ->
        fs.write(Paths.wiki(project_id, "sources/" + slug + ".md"), "# " + title + "\n\n" + self.natureza_line(natureza) + summary + "\n")

    // Texto puro, sem `**negrito**`: WikiHtmlExport.md_to_html so interpreta
    // #/##/listas — negrito dentro de paragrafo sairia como asteriscos
    // literais no visualizador estatico da wiki (ver o proprio comentario de
    // topo desse tool).
    natureza_line(natureza: string): string -> match natureza {
        "sistema_atual" -> "Natureza: Sistema atual — já existe e roda hoje.\n\n"
        "pedido_novo"   -> "Natureza: Pedido novo — ainda não implementado.\n\n"
        "ambos"         -> "Natureza: Sistema atual e pedido novo — descreve o que existe e propõe uma mudança.\n\n"
        _               -> ""
    }

    upsert_fact_page(project_id: string, dir: string, title: string, facts: string[]) -> {
        var slug = Slug.from_title(title)
        var path = Paths.wiki(project_id, dir + "/" + slug + ".md")
        if (!fs.exists(path)) fs.write(path, "# " + title + "\n\n")
        // Fato novo pode resolver um alerta da revisão — ver WikiAlerts.
        fs.write(path, WikiAlerts.strip(fs.read(path)))
        var block = "## Fatos (" + time.format(time.now(), "yyyy-MM-dd") + ")\n\n" + Markdown.list(facts) + "\n\n"
        fs.append(path, block)
    }

    write_answer(project_id: string, slug: string, title: string, body: string) ->
        fs.write(Paths.wiki(project_id, "answers/" + slug + ".md"), "# " + title + "\n\n" + body + "\n")
}

// memory WikiLog — log.md, append-only (padrao docs/wiki-llm.md: prefixo
// "## [YYYY-MM-DD] <acao> | <descricao>" torna o arquivo grep-avel). Nunca
// formatado pela LLM (C3) — sempre time.format + os campos do schema.
export memory WikiLog {
    type: "append_log"
    path: "projects/${project_id}/wiki/log.md"
    path_guard: "no_traversal"
}

// Sem `test` pro resto do tool: cada outro metodo e I/O (fs.write/fs.append)
// sobre um caminho real — cobertura fica pro `mhl run` de ponta a ponta do
// workflow Wiki (mesmo padrao do WorkItem na Fase 1), nao um `test` fingindo
// I/O. natureza_line e a unica logica pura aqui, entao ganha teste normal.
test WikiPagesSpec {
    describe natureza_line_labels_each_known_value {
        is_true(WikiPages.natureza_line("sistema_atual").contains("Sistema atual"))
        is_true(WikiPages.natureza_line("pedido_novo").contains("Pedido novo"))
        is_true(WikiPages.natureza_line("ambos").contains("Sistema atual e pedido novo"))
    }

    describe natureza_line_is_empty_for_an_unknown_or_missing_value {
        are_equal(WikiPages.natureza_line(""), "")
        are_equal(WikiPages.natureza_line("bogus"), "")
    }
}
