        is_true(run.ok)
        is_true(run.vars.preview_html.contains("A"))
        is_true(run.vars.preview_html.contains("B"))
    }

    describe dependencias_renders_the_map_ordem_and_diagram {
        var run = ArtifactPreview.run(inputs: {
            artifact: "dependencias",
            data: {
                features: [
                    {feature_codigo: "FT001", feature_titulo: "Cadastro", depende_de: []},
                    {feature_codigo: "FT002", feature_titulo: "Pagamentos", depende_de: [
                        {feature_codigo: "FT001", justificativa: "precisa do cadastro", fontes: ["features/FT001-cadastro"]}
                    ]},
                ],
                ordem_execucao: [
                    {feature_codigo: "FT001", feature_titulo: "Cadastro"},
                    {feature_codigo: "FT002", feature_titulo: "Pagamentos"},
                ],
                diagrama_mermaid: "graph LR; FT001 --> FT002;",
                gaps: [],
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("Mapa de Dependências"))
        is_true(run.vars.preview_html.contains("FT002"))
        is_true(run.vars.preview_html.contains("graph LR"))
    }

    describe enabler_feature_renders_classification_benefit_and_enabled_items {
        var run = ArtifactPreview.run(inputs: {
            artifact: "feature",
            data: {
                tipo_item: "enabler",
                subtipo_enabler: "infraestrutura",
                classificacao_fontes: ["requisitos/IR-001"],
                hipotese_beneficio: "Reduzir o tempo para validar entregas.",
                hipotese_beneficio_fontes: ["requisitos/IR-001"],
                itens_habilitados: [{texto: "Cadastro de clientes", fontes: ["requisitos/FR-001"]}],
                resumo: "Caminho mínimo de entrega automatizada.",
                resumo_fontes: ["requisitos/IR-001"],
                objetivo: "Disponibilizar build e deploy verificáveis.",
                objetivo_fontes: ["requisitos/IR-001"],
                personas: [], em_escopo: [], fora_escopo: [], regras_negocio: [],
                interacoes_entidades_dados: [],
                criterios_aceite: [{texto: "Deploy validado por smoke test.", fontes: ["requisitos/IR-001"]}],
                historias_propostas: [], dependencias_integridade: [], dependencias_sistema: [], gaps: [], questoes_abertas: []
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("item-kind-enabler"))
        is_true(run.vars.preview_html.contains(">infraestrutura</span>"))
        is_true(run.vars.preview_html.contains("Cadastro de clientes"))
    }

    describe enabling_story_renders_a_technical_statement_instead_of_como_quero_para {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                como: "", quero: "", para: "",
                resultado_tecnico: "Deploy automatizado em homologação",
                habilita: "Cadastro de clientes",
                evidenciado_por: "Smoke test executado com sucesso",
                fontes: ["features/FT001-fundacao"],
                work_item_type: "historia", story_type: "historia_habilitadora",
                subclassification: "infraestrutura", nature: "tecnica", specialty: "plataforma",
                contexto_negocio: "A entrega precisa de um ambiente verificável.",
                contexto_fontes: ["features/FT001-fundacao"],
                criterios_aceite: [{texto: "Pipeline implanta a versão.", fontes: ["features/FT001-fundacao"]}],
                cenarios_gherkin: "", cenarios_fontes: ["gap"], regras_negocio: [],
                definition_of_done: [], dependencias_impedimentos: [], fora_escopo: [],
                exemplo_uso: "", exemplo_fontes: ["gap"], contratos_interface: "", contratos_fontes: ["gap"],
                questoes_abertas: []
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("Resultado técnico:"))
        is_true(run.vars.preview_html.contains("Smoke test executado com sucesso"))
        is_false(run.vars.preview_html.contains("<strong>Como</strong>"))
    }

    describe unknown_artifact_fails_before_touching_anything {
        var run = ArtifactPreview.run(inputs: {artifact: "bogus", data: {}})
        is_false(run.ok)
        is_true(run.error.contains("artefato desconhecido para preview"))
    }
}
