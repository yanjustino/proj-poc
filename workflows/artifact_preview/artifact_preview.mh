// Renderiza o HTML de pre-visualizacao de um artefato PAUSADO (Modo Buddy),
// com os mesmos templates ArtifactBody/PageShell que os *Commit steps de
// Discovery/Delivery usam pro artefato final — mas sem nenhum efeito
// colateral: nunca grava em disco, nunca chama ArtifactId.next_*_id (o
// contador de sequencia so pode ser consumido no Commit de verdade, depois
// de aprovado — chamar duas vezes, ou chamar pra um rascunho que acaba
// rejeitado, deixaria buracos na numeracao real). Um artefato de colecao
// (adr/diagramas/features/historias) junta o corpo de cada item pendente
// numa unica pagina de preview, sem id/pasta real atribuidos ainda.
//
// Sincrono de proposito (sem chamada de LLM): 'data' e o vars.pending_data
// que um run pausado ja devolve pronto (confirmado por spike contra
// `mhl serve mcp --http` — mhl_run_status expoe todas as vars do workflow
// assim que pausa, nao so o `output:` declarado). O frontend chama isso uma
// vez, sob demanda, so quando o usuario esta olhando pra um artefato
// pausado (reading-pane.js/tab-artefatos.js).

import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { PageShell } from "../shared/artifacts/page_shell.mh"

workflow ArtifactPreview {
    description: "Renderiza o rascunho de um artefato pausado (Modo Buddy) para pre-visualizacao, sem gravar nada em disco."

    input artifact: string // brief | atributos | requisitos | der | feature | historia | decisao | diagrama | adr | diagramas | features | dependencias | historias | plano
    input data: any

    var preview_html = ""

    output: {
        preview_html: preview_html,
    }

    step Dispatch {
        goto match artifact {
            "brief"      -> Brief
            "atributos"  -> Atributos
            "requisitos" -> Requisitos
            "der"        -> Der
            "feature"    -> Feature
            "historia"   -> Historia
            "decisao"    -> Decisao
            "diagrama"   -> Diagrama
            "adr"        -> Adr
            "diagramas"  -> Diagramas
            "features"   -> Features
            "dependencias" -> Dependencias
            "historias"  -> Historias
            "plano"      -> Plano
            _            -> fail(
                "artefato desconhecido para preview: '" + artifact +
                "' (use brief | atributos | requisitos | der | feature | historia | decisao | diagrama | adr | diagramas | features | dependencias | historias | plano)"
            )
        }
    }

    step Brief {
        preview_html = PageShell(title: "Brief", body: ArtifactBody.brief(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Atributos {
        preview_html = PageShell(title: "Atributos de qualidade", body: ArtifactBody.atributos(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Requisitos {
        preview_html = PageShell(title: "Requisitos", body: ArtifactBody.requisitos(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Der {
        preview_html = PageShell(title: "DER", body: ArtifactBody.der(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Feature {
        preview_html = PageShell(title: "Detalhamento do item de backlog", body: ArtifactBody.feature(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Dependencias {
        preview_html = PageShell(title: "Mapa de Dependências", body: ArtifactBody.dependencias(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    // Plano de implementacao de uma historia (plano_model.mh). O caminho dos
    // assets nao importa aqui: o app injeta o mermaid no preview.
    step Plano {
        preview_html = PageShell(title: "Plano de implementação — " + html.escape(data?.historia_titulo ?? ""), body: ArtifactBody.plano(data, "../"), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Historia {
        preview_html = PageShell(title: "Detalhamento da história", body: ArtifactBody.historia(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    // Decisao/Diagrama render ONE item of a collection artifact (adr/
    // diagramas) as its own standalone page — same ArtifactBody as the item's
    // eventual real file, just without an id/folder assigned yet. The
    // frontend (tab-artefatos.js's appendPausedPreview) calls these once per
    // pending item instead of the whole-collection Adr/Diagramas steps below,
    // so a paused batch reviews as N separate documents, not one page with
    // every item run together — see the same split already used for
    // Feature/Historia above (Delivery's own single-item artifacts).
    step Decisao {
        preview_html = PageShell(title: html.escape(data.titulo), body: ArtifactBody.adr(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Diagrama {
        preview_html = PageShell(title: html.escape(data.titulo), body: ArtifactBody.diagrama(data), meta: "Rascunho — ainda não gravado")
        goto Done
    }

    // Adr/Diagramas/Features/Historias below join every pending item into one
    // page — kept as tab-artefatos.js's fallback for when `data` doesn't have
    // the expected array (so preview still shows *something*), but the normal
    // path is the per-item steps above (Decisao/Diagrama) and Feature/Historia.
    step Adr {
        var body = ""
        for (var decision in data.decisions) {
            body = body + "<h2>" + html.escape(decision.titulo) + "</h2>" + ArtifactBody.adr(decision)
        }
        preview_html = PageShell(title: "ADRs", body: body, meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Diagramas {
        var body = ""
        for (var diagrama in data.diagramas) {
            body = body + "<h2>" + html.escape(diagrama.titulo) + "</h2>" + ArtifactBody.diagrama(diagrama)
        }
        preview_html = PageShell(title: "Diagramas C4", body: body, meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Features {
        var body = ""
        for (var feature in data.features) {
            body = body + "<h2>" + html.escape(feature.titulo) + "</h2>" + ArtifactBody.feature(feature)
        }
        preview_html = PageShell(title: "Backlog da solução", body: body, meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Historias {
        var body = ""
        for (var historia in data.historias) {
            body = body + "<h2>" + html.escape(historia.titulo) + "</h2>" + ArtifactBody.historia(historia)
        }
        preview_html = PageShell(title: "Histórias", body: body, meta: "Rascunho — ainda não gravado")
        goto Done
    }

    step Done {
        // ponto de convergencia unico — mesmo padrao de Discovery/Delivery/WorkItem.
    }
}

test ArtifactPreviewSpec {
    describe diagrama_item_renders_standalone_with_its_own_title {
        var run = ArtifactPreview.run(inputs: {
            artifact: "diagrama",
            data: {
                titulo: "Contexto do Checkout",
                diagram_type: "C4 Contexto",
                hierarchy_level: "1",
                descricao: "Descricao de teste",
                descricao_fontes: [],
                fontes: [],
                diagrama_mermaid: "graph TD; A-->B;"
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("Contexto do Checkout"))
    }

    describe structured_c4_item_renders_generated_mermaid_legend_tables_and_warnings {
        var run = ArtifactPreview.run(inputs: {
            artifact: "diagrama",
            data: {
                titulo: "Contêineres do Checkout",
                diagram_type: "c4-container",
                descricao: "Contêineres do checkout",
                descricao_fontes: ["requisitos"],
                escopo: {nome: "Checkout", descricao: "Fecha pedidos", fontes: ["brief"]},
                ambiente: "",
                elementos: [
                    {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "Compra", no_pai: "", fontes: ["requisitos/FR-001"]},
                    {id: "api", nome: "API", tipo: "container", tecnologia: "", descricao: "Recebe pedidos", no_pai: "", fontes: ["gap"]},
                ],
                relacoes: [{de: "cliente", para: "api", descricao: "Envia pedidos para", tecnologia: "HTTPS", fontes: ["inferência"]}],
                diagrama_mermaid: "",
                avisos_lote: ["O lote não tem diagrama de contexto de sistema (C4) — recomendado para todo sistema."],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("<strong>Tipo:</strong> Contêiner (C4) · <strong>Nível:</strong> Strategic"))
        is_true(page.contains("<strong>Escopo:</strong> Checkout — Fecha pedidos"))
        is_true(page.contains("<strong>Público:</strong> Pessoas técnicas"))
        is_true(page.contains("subgraph b0"))
        is_true(page.contains("<h2>Legenda</h2>"))
        is_true(page.contains("<h2>Elementos</h2>"))
        is_true(page.contains("<h2>Relações</h2>"))
        is_true(page.contains("Contêiner sem tecnologia definida: API"))
        is_true(page.contains("O lote não tem diagrama de contexto"))
    }

    describe structured_der_renders_generated_er_diagram_tables_and_warnings {
        var run = ArtifactPreview.run(inputs: {
            artifact: "der",
            data: {
                modo: "greenfield",
                nivel: "logico",
                contexto: "Checkout",
                contexto_fontes: ["requisitos"],
                areas: [],
                entidades: [
                    {id: "cliente", nome: "Cliente", tipo: "forte", area: "", descricao: "Quem compra", fontes: ["requisitos/FR-001"]},
                    {id: "pedido", nome: "Pedido", tipo: "forte", area: "", descricao: "Compra", fontes: ["requisitos/FR-002"]},
                ],
                atributos: [
                    {entidade: "cliente", nome: "CPF", chave: "pk", classificacao: "simples", obrigatorio: true, tipo_dado: "", descricao: "", regras_negocio: "", fontes: ["requisitos/FR-001"]},
                ],
                relacionamentos: [
                    {de: "cliente", para: "pedido", verbo: "faz", min_de: "1", max_de: "1", min_para: "0", max_para: "N", identificador: false, evidencia: "confirmado", atributos_descritivos: [], fontes: ["requisitos/FR-002"]},
                ],
                delta_modelo: [],
                gaps: [],
                questoes_abertas: [],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("<strong>Nível:</strong> Lógico"))
        is_true(page.contains("erDiagram"))
        is_true(page.contains("d0e0 ||..o{ d0e1 : &#34;faz&#34;"))
        is_true(page.contains("<h2>Legenda</h2>"))
        is_true(page.contains("Entidade sem chave primária: Pedido"))
    }

    describe legacy_der_still_renders_with_a_regeneration_notice {
        var run = ArtifactPreview.run(inputs: {
            artifact: "der",
            data: {
                modo: "greenfield",
                contexto: "Checkout",
                contexto_fontes: ["requisitos"],
                diagrama_mermaid: "erDiagram\n CLIENTE ||--o{ PEDIDO : faz",
                entidades: [{entidade: "Cliente", descricao: "", fontes: ["requisitos"]}],
                relacionamentos_confirmados: [],
                relacionamentos_inferidos: [],
                atributos: [],
                delta_modelo: [],
                gaps: [],
                questoes_abertas: [],
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("DER no formato anterior"))
        is_true(run.vars.preview_html.contains("CLIENTE ||--o{ PEDIDO"))
    }

    describe structured_story_renders_traceability_contracts_and_numbered_criteria {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                titulo: "Consultar ordem", como: "investidor", quero: "consultar", para: "acompanhar",
                resultado_tecnico: "", habilita: "", evidenciado_por: "", fontes: ["requisitos/FR-005"],
                work_item_type: "historia", story_type: "historia_usuario", subclassification: "backend", nature: "funcional", specialty: "backend",
                contexto_negocio: "x", contexto_fontes: ["requisitos"],
                criterios_aceite: [{texto: "retorna a ordem", fontes: ["requisitos/FR-005"]}, {texto: "404 se não existe", fontes: ["inferência"]}],
                cenarios_gherkin: "", cenarios_fontes: ["inferência"], regras_negocio: [], definition_of_done: [], dependencias_impedimentos: [], fora_escopo: [],
                exemplo_uso: "", exemplo_fontes: ["gap"],
                rastreabilidade: {requisitos: ["FR-005"], atributos: [], adrs: ["ADR-001"], entidades: ["Ordem"], conteineres: ["API de Ordens"]},
                contratos: {endpoints: [{id: "consultarOrdem", metodo: "GET", caminho: "/ordens/{id}", resumo: "Consulta", autenticacao: "JWT",
                    parametros: [{nome: "id", tipo: "uuid", obrigatorio: true, descricao: "", local: "path"}], corpo: [],
                    respostas: [{status: "200", descricao: "ok", campos: [{nome: "numero", tipo: "string", obrigatorio: true, descricao: "", local: ""}]}], fontes: ["requisitos/FR-005"]}], eventos: []},
                contratos_fontes: ["requisitos/FR-005"],
                questoes_abertas: [],
                avisos_rastreabilidade: ["Entidade do DER citado que não existe nos artefatos: Ordem."],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("CA1 — retorna a ordem"))
        is_true(page.contains("CA2 — 404 se não existe"))
        is_true(page.contains("<h2>Rastreabilidade</h2>"))
        is_true(page.contains("<code>GET /ordens/{id}</code>"))
        is_true(page.contains("OpenAPI 3.1 (openapi.json)"))
        is_true(page.contains("Conformidade da especificação"))
        is_true(page.contains("citado que não existe nos artefatos: Ordem"))
    }

    describe legacy_story_still_renders_its_free_text_contract {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                titulo: "Antiga", como: "a", quero: "b", para: "c", fontes: ["x"], work_item_type: "historia", story_type: "historia_usuario",
                subclassification: "backend", nature: "funcional", specialty: "x", contexto_negocio: "", contexto_fontes: ["x"],
                criterios_aceite: [{texto: "ok", fontes: ["x"]}], cenarios_gherkin: "", cenarios_fontes: ["x"], regras_negocio: [], definition_of_done: [],
                dependencias_impedimentos: [], fora_escopo: [], exemplo_uso: "", exemplo_fontes: ["x"],
                contratos_interface: "POST /pedidos", contratos_fontes: ["x"], questoes_abertas: [],
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("POST /pedidos"))
        is_true(!run.vars.preview_html.contains("Rastreabilidade"))
    }

    describe plano_renders_sequence_tasks_and_coverage {
        var run = ArtifactPreview.run(inputs: {
            artifact: "plano",
            data: {
                historia_titulo: "US0001 — Consultar ordem",
                criterios_total: 2,
                abordagem: "Endpoint na API de Ordens", abordagem_fontes: ["inferência"],
                componentes: [{conteiner: "API de Ordens", componente: "OrdemController", mudanca: "novo endpoint", fontes: ["inferência"]}],
                adrs: [], dados: [{entidade: "Ordem", operacao: "le", detalhe: "", fontes: ["der"]}],
                fluxo: [{de: "Investidor", para: "API de Ordens", mensagem: "GET /ordens/{id}", retorno: false}, {de: "API de Ordens", para: "Investidor", mensagem: "200", retorno: true}],
                fluxo_fontes: ["inferência"],
                erros: [], seguranca: [], observabilidade: [],
                tarefas: [{id: "T1", titulo: "Teste", descricao: "", tipo: "teste", criterios: ["CA1"], depende_de: [], fontes: ["inferência"]},
                          {id: "T2", titulo: "Implementar", descricao: "", tipo: "implementacao", criterios: ["CA1", "CA2"], depende_de: ["T1"], fontes: ["inferência"]}],
                testes: [], riscos: [],
                avisos_contexto: [],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("Plano de implementação — US0001 — Consultar ordem"))
        is_true(page.contains("sequenceDiagram"))
        is_true(page.contains("<h2>Cobertura dos critérios de aceite</h2>"))
        is_true(page.contains("Critério de aceite sem teste: CA2"))
    }

    describe incoherent_story_is_flagged_and_empty_sections_are_omitted {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                titulo: "Migrar base", como: "desenvolvedor", quero: "migrar", para: "x",
                resultado_tecnico: "", habilita: "", evidenciado_por: "", fontes: ["inferência"],
                work_item_type: "historia", story_type: "historia_habilitadora", subclassification: "dados", nature: "funcional", specialty: "dados",
                contexto_negocio: "", contexto_fontes: [],
                criterios_aceite: [{texto: "dados migrados", fontes: ["inferência"]}],
                cenarios_gherkin: "", cenarios_fontes: [], regras_negocio: [], definition_of_done: [], dependencias_impedimentos: [], fora_escopo: [],
                exemplo_uso: "", exemplo_fontes: [],
                rastreabilidade: {requisitos: [], atributos: [], adrs: [], entidades: [], conteineres: []},
                contratos: {endpoints: [], eventos: []}, contratos_fontes: [],
                gaps: [{texto: "Volume da base atual desconhecido", fontes: ["gap"]}],
                questoes_abertas: [],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("exige nature &#34;tecnica&#34;"))
        is_true(page.contains("não usa Como/Quero/Para"))
        is_true(page.contains("<h2>Lacunas</h2>"))
        is_true(!page.contains("Exemplo de Uso"))
        is_true(!page.contains("Cenários Gherkin"))
        is_true(!page.contains("Regras de Negócio"))
    }

    describe structured_spike_and_scenarios_render {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                titulo: "Escolher banco de eventos", como: "", quero: "", para: "",
                resultado_tecnico: "", habilita: "", evidenciado_por: "",
                spike: {pergunta: "MongoDB ou EventStoreDB?", timebox: "2 dias", metodo: "benchmark", evidencia_saida: "relatório", decisao_habilitada: "ADR-004", criterio_encerramento: "resposta ou timebox"},
                fontes: ["adr/ADR-002-nosql"], work_item_type: "historia", story_type: "spike", subclassification: "exploracao", nature: "pesquisa", specialty: "arquitetura",
                contexto_negocio: "", contexto_fontes: [],
                criterios_aceite: [{texto: "relatório comparativo publicado", fontes: ["inferência"]}],
                cenarios: [{titulo: "Comparação concluída", dado: ["os dois bancos instalados"], quando: ["o benchmark roda"], entao: ["o relatório compara latência e custo"], criterios: ["CA1"], fontes: ["inferência"]}],
                regras_negocio: [], definition_of_done: [], dependencias_impedimentos: [], fora_escopo: [],
                exemplo_uso: "", exemplo_fontes: [],
                rastreabilidade: {requisitos: [], atributos: [], adrs: ["ADR-002"], entidades: [], conteineres: []},
                contratos: {endpoints: [], eventos: []}, contratos_fontes: [],
                gaps: [], questoes_abertas: [],
            }
        })
        is_true(run.ok)
        var page = run.vars.preview_html
        is_true(page.contains("<strong>Pergunta de investigação:</strong> MongoDB ou EventStoreDB?"))
        is_true(page.contains("<strong>Timebox:</strong> 2 dias"))
        is_true(page.contains("<h2>Cenários de Aceite</h2>"))
        is_true(page.contains("@CA1"))
        is_true(page.contains("Cenário: Comparação concluída"))
        is_true(!page.contains("Conformidade da especificação"))
    }

    describe incoherent_feature_is_flagged {
        var run = ArtifactPreview.run(inputs: {
            artifact: "feature",
            data: {
                tipo_item: "enabler", subtipo_enabler: "nao_aplicavel", classificacao_fontes: ["x"], hipotese_beneficio: "x", hipotese_beneficio_fontes: ["x"],
                itens_habilitados: [], resumo: "x", resumo_fontes: ["x"], objetivo: "x", objetivo_fontes: ["x"], personas: [], em_escopo: [], fora_escopo: [],
                regras_negocio: [], interacoes_entidades_dados: [], criterios_aceite: [{texto: "x", fontes: ["x"]}], historias_propostas: [],
                dependencias_integridade: [], dependencias_sistema: [], gaps: [], questoes_abertas: [],
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("Enabler sem subtipo"))
        is_true(run.vars.preview_html.contains("Enabler sem itens habilitados"))
    }

    describe auto_review_note_is_shown {
        var run = ArtifactPreview.run(inputs: {
            artifact: "der",
            data: {
                modo: "greenfield", nivel: "conceitual", contexto: "x", contexto_fontes: ["requisitos"], areas: [],
                entidades: [{id: "a", nome: "A", tipo: "forte", area: "", descricao: "", fontes: ["x"]}],
                atributos: [], relacionamentos: [], delta_modelo: [], gaps: [], questoes_abertas: [],
                autorrevisao: {tentada: true, aplicada: true, avisos_antes: 4, avisos_depois: 1},
            }
        })
        is_true(run.ok)
        is_true(run.vars.preview_html.contains("Revisado automaticamente: 4 aviso(s) na geração → 1 depois da revisão."))
    }

    describe decisao_item_renders_standalone_with_its_own_title {
        var run = ArtifactPreview.run(inputs: {
            artifact: "decisao",
            data: {
                titulo: "Usar Postgres",
                status: "aceita",
                contexto_e_problema: "ctx",
                contexto_fontes: [],
                fatores_decisao: [{texto: "fator", fontes: []}],
