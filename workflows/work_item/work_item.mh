// Orquestra o ciclo de vida de um work-item. Políticas, persistência e
// agregações ficam concentradas em WorkItemActions.

import { WorkItemActions } from "actions.mh"

workflow WorkItem {
    description: "Ciclo de vida de um work-item do Senpai: create, list, get, archive, usage, prompt_log."

    input action: string             // "create" | "list" | "get" | "archive" | "usage" | "prompt_log"
    input name: string = ""          // obrigatorio (valor) so para action:"create"
    input item_type: string = ""     // "oportunidade" | "feature" | "historia"; so para action:"create"
    input project_id: string = ""    // obrigatorio (valor) para get/archive/usage/prompt_log

    var project = null
    var projects = []
    var usage = null
    var prompt_log = []
    var error_message = ""

    output: {
        action: action,
        project: project,
        projects: projects,
        usage: usage,
        prompt_log: prompt_log,
        error: error_message,
    }

    step Dispatch {
        if (action == "create") goto Create
        if (action == "list") goto List
        if (action == "get") goto Get
        if (action == "archive") goto Archive
        if (action == "usage") goto Usage
        if (action == "prompt_log") goto PromptLog
        fail(
            "acao desconhecida: '" + action +
            "' (use create | list | get | archive | usage | prompt_log)"
        )
    }

    step Create {
        project = WorkItemActions.create(name, item_type)
        goto Done
    }

    step List {
        projects = WorkItemActions.list()
        goto Done
    }

    step Get {
        project = WorkItemActions.get(project_id)
        goto Done
    }

    step Archive {
        project = WorkItemActions.archive(project_id)
        goto Done
    }

    step Usage {
        usage = WorkItemActions.usage(project_id)
        goto Done
    }

    step PromptLog {
        prompt_log = WorkItemActions.prompt_log(project_id)
        goto Done
    }

    step Done {
        // ponto de convergencia unico — mantem `reached` enxuto para a UI
        // (ex.: ["Dispatch","Create","Done"]), nunca os 5 branches inteiros.
    }
}

// WorkItemWorkflowSpec testa o workflow INTEIRO (Dispatch + goto), nao so
// WorkItemActions isolado (ja coberto por actions.mh :: WorkItemActionsSpec)
// — via `Name.run(inputs:)`, novo em mhl 1.4.0-beta.7 (MHL-Melhorias.md
// #13), que fecha a lacuna registrada desde a Fase 1 ("create/list/get/
// archive/usage do WorkItem em si foram validados via mhl run manual, nao
// via bloco test").
//
// Escopo deliberado — SO os caminhos de falha rapida (Dispatch/validacao),
// nenhum action:"create"/"archive" de verdade: `Name.run(...)` NAO isola
// `fs`/`dir` num diretorio temporario descartavel, apesar do que a nota de
// status do item 13 sugere ("sandbox isolado... diretorio temporario") —
// confirmado por spike, um `fs.write` dentro de um `Name.run()` grava no
// CWD real de quem roda `mhl test`, nao em lugar nenhum descartado (nem
// mesmo isolado entre chamadas/describes diferentes no mesmo arquivo — o
// mesmo `fs.write` de uma chamada e visto pela proxima). Testar
// action:"create" aqui deixaria uma pasta `projects/<uuid-real>/` de
// verdade a cada `mhl test workflows` — poluicao de disco a cada rodada,
// inaceitavel num bloco test versionado. Ver FASE5-ACHADOS.md.
test WorkItemWorkflowSpec {
    describe rejects_an_unknown_action_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "bogus"})
        is_false(run.ok)
        are_equal(run.state, "failed")
        is_true(run.error.contains("acao desconhecida"))
        are_equal(run.executed, ["Dispatch"])
    }

    describe create_rejects_an_empty_name_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "create", name: "", item_type: "feature"})
        is_false(run.ok)
        is_true(run.error.contains("'name' e obrigatorio"))
    }

    describe create_rejects_an_invalid_item_type_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "create", name: "Projeto valido", item_type: "epico"})
        is_false(run.ok)
        is_true(run.error.contains("'item_type' invalido"))
    }

    describe get_on_a_nonexistent_project_id_fails_without_writing_anything {
        var run = WorkItem.run(inputs: {action: "get", project_id: "spec-nao-existe-de-verdade"})
        is_false(run.ok)
        is_true(run.error.contains("work-item nao encontrado"))
    }

    describe archive_on_a_nonexistent_project_id_fails_without_writing_anything {
        var run = WorkItem.run(inputs: {action: "archive", project_id: "spec-nao-existe-de-verdade"})
        is_false(run.ok)
        is_true(run.error.contains("work-item nao encontrado"))
    }

    // Documenta comportamento real, nao presumido: `usage` nunca falha por
    // project_id inexistente — le o ledger se existir, devolve zerado se
    // nao (WorkItemActions.usage). Diferente de get/archive de proposito.
    describe usage_on_a_nonexistent_project_id_returns_a_zeroed_ledger_not_a_failure {
        var run = WorkItem.run(inputs: {action: "usage", project_id: "spec-nao-existe-de-verdade"})
        is_true(run.ok)
        are_equal(run.vars.usage.total_tokens_in, 0)
        are_equal(run.vars.usage.total_tokens_out, 0)
        are_equal(run.vars.usage.by_artifact, [])
    }
}
