{
  "type": "object",
  "additionalProperties": false,
  "required": ["historias"],
  "properties": {
    "historias": {
      "type": "array",
      "minItems": 1,
      "description": "Histórias de usuário desta feature, uma por item.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "como", "quero", "para", "fontes", "criterios_aceite"],
        "properties": {
          "titulo": { "type": "string", "description": "Nome curto da história." },
          "como": { "type": "string", "description": "O persona/papel do usuário (\"Como <persona>\")." },
          "quero": { "type": "string", "description": "A ação desejada (\"quero <ação>\")." },
          "para": { "type": "string", "description": "O benefício (\"para <benefício>\")." },
          "fontes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Referências que sustentam esta história (como/quero/para)."
          },
          "criterios_aceite": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["texto", "fontes"],
              "properties": {
                "texto": { "type": "string" },
                "fontes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "description": "Referências que sustentam este critério."
                }
              }
            },
            "minItems": 1,
            "description": "Critérios de aceite, um por item, cada um com suas fontes."
          }
        }
      }
    }
  }
}
