{
  "$defs": {
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texto", "fontes"],
      "properties": {
        "texto": {"type": "string"},
        "fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "papel", "interacao", "fontes"],
      "properties": {
        "persona": {"type": "string"},
        "papel": {"type": "string"},
        "interacao": {"type": "string"},
        "fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo", "tipo_item", "subtipo_enabler", "classificacao_fontes", "hipotese_beneficio", "hipotese_beneficio_fontes",
        "itens_habilitados", "resumo", "resumo_fontes", "objetivo", "objetivo_fontes", "personas",
        "em_escopo", "fora_escopo", "regras_negocio", "interacoes_entidades_dados", "criterios_aceite",
        "historias_propostas", "dependencias_integridade", "dependencias_sistema", "gaps", "questoes_abertas"
      ],
      "properties": {
        "titulo": {"type": "string"},
        "tipo_item": {"type": "string", "enum": ["feature_negocio", "enabler"]},
        "subtipo_enabler": {"type": "string", "enum": ["nao_aplicavel", "exploracao", "arquitetura", "infraestrutura", "conformidade"]},
        "classificacao_fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "hipotese_beneficio": {"type": "string"},
        "hipotese_beneficio_fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "itens_habilitados": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "resumo": {"type": "string"},
        "resumo_fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "objetivo": {"type": "string"},
        "objetivo_fontes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "personas": {"type": "array", "items": {"$ref": "#/$defs/persona"}},
        "em_escopo": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "fora_escopo": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "regras_negocio": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "interacoes_entidades_dados": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "criterios_aceite": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourcedText"}},
        "historias_propostas": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "dependencias_integridade": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "dependencias_sistema": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}},
        "questoes_abertas": {"type": "array", "items": {"$ref": "#/$defs/sourcedText"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}
  }
}
