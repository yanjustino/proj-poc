// Fragmento `partial workflow Discovery` — a quebra do backlog em si:
// features (o backlog inteiro, varios itens de uma vez) e historias (uma
// feature ja identificada quebrada em historias). Mesclado em discovery.mh
// via `import "discovery.backlog.mh"` (por extenso).

import { Paths } from "../shared/core/paths.mh"
import { Writer } from "../shared/agents/agents.mh"
import { Context } from "../shared/artifacts/context.mh"
import { ArtifactData } from "../shared/artifacts/artifact_data.mh"
import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { ArtifactId } from "../shared/artifacts/artifact_id.mh"
import { PageShell, ArtifactMeta } from "../shared/artifacts/page_shell.mh"
import { WorkflowsRoot } from "../shared/core/workflows_root.mh"
import { DirClear } from "../shared/core/dir_clear.mh"
import { ChangesBlock } from "../shared/artifacts/changes_log.mh"
import { ArtifactSchema, SpecConventions, HistoriasInstruction, HistoriasSchemaFile, PlanoInstruction, PlanoSchemaFile } from "../shared/artifacts/artifacts_common.mh"
import { Traceability, SpecFiles } from "../shared/artifacts/historia_spec.mh"
import { PlanoModel, PlanoPrep } from "../shared/artifacts/plano_model.mh"
import { ContextSlice } from "../shared/artifacts/context_slice.mh"
import { AutoReview } from "../shared/artifacts/auto_review.mh"
import { ArtifactChecks } from "../shared/artifacts/artifact_checks.mh"

// O SCHEMA de features (o backlog inteiro, varios itens de uma vez) e
// especifico de Discovery — Delivery nao gera um backlog, gera o
// detalhamento final de UMA feature/historia ja identificada, com seu proprio
// schema de item unico (workflows/delivery/). HistoriasInstruction/
// HistoriasSchemaFile ja sao compartilhados (artifacts_common.mh) porque
// "quebrar uma feature em historias" e a mesma operacao nos dois workflows.
// Sem `wiki_content` (ver comentario acima de AdrInstruction em
// artifacts_common.mh) — o backlog deriva de atributos/requisitos/adr/der/
// diagramas ja sintetizados, nao da wiki bruta.
prompt FeaturesInstruction(
    schema_conventions: prompt,
    atributos_content: string,
    requisitos_content: string,
    adr_content: string,
    der_content: string,
    diagramas_content: string,
    feedback_content: string
) from "prompts/features.prompt.md"

prompt FeaturesSchemaContent() from "schemas/features.schema.json"

tool FeaturesSchemaFile {
    get(): {content: string, path: string} -> {
        content: FeaturesSchemaContent(),
        path: WorkflowsRoot.resolve("discovery/schemas/features.schema.json")
    }
}

// dependencias e Discovery-only pelo mesmo motivo que features e: so um
// backlog com mais de um item tem dependencias ENTRE itens pra
// mapear. `features_content` chega ja com o codigo FT00N real de cada uma
// no cabecalho (montado abaixo, em DependenciasGenerate, via
// Context.artifact_dir_of_dirs — features/ e uma pasta de pastas, uma a
// mais de profundidade do que Context.artifact_dir sabe percorrer sozinho)
// — diferente de quando as proprias features foram geradas, quando nenhum
// codigo existia ainda e dependencias_integridade so podia referenciar
// outra feature pelo titulo.
prompt DependenciasInstruction(
    schema_conventions: prompt,
    features_content: string,
    feedback_content: string
) from "prompts/dependencias.prompt.md"

prompt DependenciasSchemaContent() from "schemas/dependencias.schema.json"

tool DependenciasSchemaFile {
    get(): {content: string, path: string} -> {
        content: DependenciasSchemaContent(),
        path: WorkflowsRoot.resolve("discovery/schemas/dependencias.schema.json")
    }
}

partial workflow Discovery {

    step FeaturesGenerate {
        self.current_artifact = "features"

        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'features'")

        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'features'")
        requisitos_content = Context.dedupe_shared_fields(atributos_content, requisitos_content)

        var adr_content = Context.adr_context(project_id)
        if (adr_content.is_empty()) fail("gere 'adr' antes de 'features'")

        var der_content = Context.artifact(project_id, "der.html")
        if (der_content.is_empty()) der_content = "(não gerado para esta oportunidade)"

        var diagramas_content = Context.artifact_dir(project_id, "diagramas")
        if (diagramas_content.is_empty()) fail("gere 'diagramas' antes de 'features'")

        var review = AutoReview.generate(
            enabled: autorrevisao,
            prompt: FeaturesInstruction(
                schema_conventions: ArtifactSchema(),
                atributos_content: atributos_content,
                requisitos_content: requisitos_content,
                adr_content: adr_content,
                der_content: der_content,
                diagramas_content: diagramas_content,
                feedback_content: ChangesBlock.for_artifact(project_id, "features", "")
            ),
            schema_file: FeaturesSchemaFile.get(),
            project_id: project_id,
            artifact: self.current_artifact,
            prepare: (raw) -> json.parse(raw),
            check: (d) -> ArtifactChecks.features(d)
        )

        self.tokens_in = review.tokens_in
        self.tokens_out = review.tokens_out
        var data = review.data
        data["features"] = AutoReview.tag_items(data.features, review.revisao)
        self.pending_data = data

        goto Gate
    }

    step FeaturesCommit {
        var data = self.pending_data
        var written = []
        var features_dir = Paths.artifact(project_id, "features")
        // *Generate sempre devolve o LOTE INTEIRO atual, nunca um delta —
        // uma regeneracao ("Solicitar mudanca"/"Atualizar" num features/ ja
        // aprovado, tab-artefatos.js) precisa SUBSTITUIR o lote antigo, nao
        // somar a ele. Sem isto, ArtifactId.next_feature_id (que so conta
        // pastas ja existentes) continuava cunhando FT00N novos em cima dos
        // antigos — duplicando em vez de regenerar. Zerar historias/ junto
        // (nao so features/) e o que fecha a lacuna de verdade: os
        // historias/ de uma feature antiga ficam orfaos no instante em que
        // essa feature deixa de existir com aquele id/pasta — iam continuar
        // em disco como lixo pra sempre, sem nenhuma feature atual
        // apontando pra eles.
        //
        // DirClear.clear (nao dir.delete direto): dir.delete e
        // deliberadamente nao-recursivo no mhl-runtime, entao so remove um
        // diretorio ja VAZIO — contra um features_dir/historias_dir com
        // conteudo real (o caso normal aqui, ja que isto so roda numa
        // regeneracao de algo ja gerado antes) ele falhava com "directory
        // not empty" (bug real, batido em producao via o botao
        // "Atualizar"). Ver dir_clear.mh's own comment.
        DirClear.clear(features_dir)
        var historias_dir = Paths.artifact(project_id, "historias")
        DirClear.clear(historias_dir)
        dir.create(features_dir)

        for (var feature in data.features) {
            var id = ArtifactId.next_feature_id(project_id)
            var folder = ArtifactId.folder_name(id, feature.titulo)
            var body = ArtifactBody.feature(feature)
            var rendered = PageShell(
                title: html.escape(id + " — " + feature.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/features/" + folder + "/feature.html", self.tokens_in, self.tokens_out)
            )
            dir.create(Paths.artifact(project_id, "features/" + folder))
            var relative = "features/" + folder + "/feature.html"
            ArtifactData.write(project_id, relative, feature)
            fs.write(Paths.artifact(project_id, relative), rendered)
            written += [folder]
        }

        self.discovery_result = {artifact: "features", written: written}

        goto Done
    }

    step DependenciasGenerate {
        self.current_artifact = "dependencias"
        var features_dir = Paths.artifact(project_id, "features")
        if (!dir.exists(features_dir)) fail("gere 'features' antes de 'dependencias'")

        // Context.artifact_dir_of_dirs, nao Context.artifact_dir: features/
        // e uma pasta de pastas (features/FT001-slug/feature.html, um nivel
        // a mais do que artifact_dir sabe percorrer sozinho) — mesmo motivo
        // pelo qual HistoriasGenerate le uma feature por vez via
        // ArtifactId.find_feature_dir + Context.artifact. Cabecalho
        // "# features/<pasta>" no mesmo formato que DirText.concat_all usa,
        // pra ArtifactSchema regra 4 (citar a fonte pelo identificador do
        // cabecalho) valer aqui tambem.
        var features_content = Context.artifact_dir_of_dirs(project_id, "features", "feature.html")

        var response = Writer.generate(
            prompt: DependenciasInstruction(
                schema_conventions: ArtifactSchema(),
                features_content: features_content,
                feedback_content: ChangesBlock.for_artifact(project_id, "dependencias", "")
            ),
            schema_file: DependenciasSchemaFile.get(),
            project_id: project_id,
            artifact: self.current_artifact
        )

        self.tokens_in = response.tokens_in
        self.tokens_out = response.tokens_out
        self.pending_data = json.parse(response.content)

        goto Gate
    }

    step DependenciasCommit {
        var data = self.pending_data
        var body = ArtifactBody.dependencias(data)
        var rendered = PageShell(
            title: "Mapa de Dependências",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/dependencias.html", self.tokens_in, self.tokens_out)
        )
        ArtifactData.write(project_id, "dependencias.html", data)
        fs.write(Paths.artifact(project_id, "dependencias.html"), rendered)
        self.discovery_result = {artifact: "dependencias", path: "artifacts/dependencias.html"}
        goto Done
    }

    step HistoriasGenerate {
        if (feature_id.is_empty()) fail("'feature_id' e obrigatorio para artifact: \"historias\"")
        self.current_artifact = "historias"
        var feature_dir = ArtifactId.find_feature_dir(project_id, feature_id)
        var feature_content = Context.artifact(project_id, "features/" + feature_dir + "/feature.html")
        // Contexto tecnico da oportunidade — ver o comentario de
        // HistoriasInstruction — recortado pelo que a feature cita
        // (ContextSlice). Todos ja existem quando ha features (que os
        // exigem), exceto o DER, opcional.
        var refs = ContextSlice.refs(ContextSlice.read(project_id, "features/" + feature_dir + "/feature.json"))
        var der_content = Context.artifact(project_id, "der.html")
        if (der_content.is_empty()) der_content = "(não gerado para esta oportunidade)"
        var known = Traceability.known(project_id)
        var review = AutoReview.generate(
            enabled: autorrevisao,
            prompt: HistoriasInstruction(
                schema_conventions: ArtifactSchema(),
                spec_conventions: SpecConventions(),
                feature_content: feature_content,
                requisitos_content: ContextSlice.requisitos(project_id, refs),
                atributos_content: ContextSlice.atributos(project_id, refs),
                adr_content: ContextSlice.adrs(project_id, refs),
                der_content: der_content,
                diagramas_content: ContextSlice.diagramas(project_id, refs),
                feedback_content: ChangesBlock.for_artifact(project_id, "historias", feature_id)
            ),
            schema_file: HistoriasSchemaFile.get(), project_id: project_id, artifact: self.current_artifact,
            prepare: (raw) -> Traceability.annotate(json.parse(raw), known),
            check: (d) -> ArtifactChecks.historias(d)
        )
        self.tokens_in = review.tokens_in
        self.tokens_out = review.tokens_out
        var data = review.data
        data["historias"] = AutoReview.tag_items(data.historias, review.revisao)
        data["feature_dir"] = feature_dir
        self.pending_data = data
        goto Gate
    }

    step HistoriasCommit {
        var data = self.pending_data
        var feature_dir = data.feature_dir
        var historias_base = Paths.artifact(project_id, "historias/" + feature_dir)
        var written = []

        // Mesmo motivo do wipe em FeaturesCommit: *Generate devolve o lote
        // inteiro de historias DESSA feature, nao um delta — uma
        // regeneracao (linha "Histórias — X", tab-artefatos.js) precisa
        // substituir, nao somar (ArtifactId.next_historia_id so conta o que
        // ja existe nesta pasta). DirClear.clear, nao dir.delete direto —
        // ver seu comentario em FeaturesCommit acima / dir_clear.mh.
        DirClear.clear(historias_base)
        dir.create(historias_base)

        for (var historia in data.historias) {
            var id = ArtifactId.next_historia_id(project_id, feature_dir)
            var folder = ArtifactId.folder_name(id, historia.titulo)
            var body = ArtifactBody.historia(historia)

            var rendered = PageShell(
                title: html.escape(id + " — " + historia.titulo),
                body: body,
                meta: ArtifactMeta.line(
                    time.format(time.now(), "yyyy-MM-dd HH:mm"),
                    "artifacts/historias/" + feature_dir + "/" + folder + "/historia.html",
                    self.tokens_in,
                    self.tokens_out
                )
            )

            dir.create(historias_base + "/" + folder)
            var relative = "historias/" + feature_dir + "/" + folder + "/historia.html"
            ArtifactData.write(project_id, relative, historia)
            SpecFiles.write(project_id, "historias/" + feature_dir + "/" + folder, historia)
            fs.write(Paths.artifact(project_id, relative), rendered)
            written += [folder]
        }
        self.discovery_result = {artifact: "historias", feature_id: feature_id, written: written}
        goto Done
    }

    // PlanoGenerate/PlanoCommit — plano de implementacao de UMA historia
    // (plano_model.mh), gravado ao lado dela: historias/<feature>/<USxxx>/
    // plano.html. Recebe a historia e todo o contexto tecnico da
    // oportunidade; o que depende desse contexto (conteineres, ADRs e
    // entidades citados que nao existem) e calculado aqui e guardado em
    // avisos_contexto, como as historias fazem com a rastreabilidade.
    step PlanoGenerate {
        if (feature_id.is_empty() || historia_id.is_empty()) fail("'feature_id' e 'historia_id' sao obrigatorios para artifact: \"plano\"")
        self.current_artifact = "plano"
        var feature_dir = ArtifactId.find_feature_dir(project_id, feature_id)
        var historias_rel = "historias/" + feature_dir
        var historia_rel = historias_rel + "/" + ArtifactId.find_historia_dir(project_id, historias_rel, historia_id)
        var historia_json = Paths.artifact(project_id, historia_rel + "/historia.json")
        if (!fs.exists(historia_json)) fail("gere as historias de '" + feature_id + "' antes do plano de '" + historia_id + "'")
        var historia = json.parse(fs.read(historia_json))
        // Recorte pelo que a historia cita (rastreabilidade + fontes).
        var refs = ContextSlice.refs(historia)
        var der_content = Context.artifact(project_id, "der.html")
        if (der_content.is_empty()) der_content = "(não gerado para esta oportunidade)"

        var known = Traceability.known(project_id)
        var review = AutoReview.generate(
            enabled: autorrevisao,
            prompt: PlanoInstruction(
                schema_conventions: ArtifactSchema(),
                historia_content: Context.artifact(project_id, historia_rel + "/historia.html"),
                feature_content: Context.artifact(project_id, "features/" + feature_dir + "/feature.html"),
                requisitos_content: ContextSlice.requisitos(project_id, refs),
                atributos_content: ContextSlice.atributos(project_id, refs),
                adr_content: ContextSlice.adrs(project_id, refs),
                der_content: der_content,
                diagramas_content: ContextSlice.diagramas(project_id, refs),
                feedback_content: ChangesBlock.for_artifact(project_id, "plano", feature_id + "/" + historia_id)
            ),
            schema_file: PlanoSchemaFile.get(), project_id: project_id, artifact: self.current_artifact,
            prepare: (raw) -> PlanoPrep.annotate(json.parse(raw), historia, historia_id + " — " + historia.titulo, known),
            check: (d) -> ArtifactChecks.plano(d)
        )
        self.tokens_in = review.tokens_in
        self.tokens_out = review.tokens_out
        var data = review.data
        data["autorrevisao"] = review.revisao
        data["historia_dir"] = historia_rel
        self.pending_data = data
        goto Gate
    }

    step PlanoCommit {
        var data = self.pending_data
        var relative = data.historia_dir + "/plano.html"
        var rendered = PageShell(
            title: "Plano de implementação — " + html.escape(data.historia_titulo),
            body: ArtifactBody.plano(data, "../../../"),
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/" + relative, self.tokens_in, self.tokens_out)
        )
        ArtifactData.write(project_id, relative, data)
        fs.write(Paths.artifact(project_id, relative), rendered)
        self.discovery_result = {artifact: "plano", feature_id: feature_id, historia_id: historia_id, path: "artifacts/" + relative}
        goto Done
    }
}
