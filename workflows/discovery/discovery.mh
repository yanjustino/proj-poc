// Orquestra a geracao dos artefatos de oportunidade. Contexto, geracao,
// apresentacao e persistencia permanecem em componentes especializados.
//
// O workflow em si e um `partial workflow Discovery`: este arquivo e so o
// nucleo (entrada, gate compartilhado, rotas de despacho) — os pares
// Generate/Commit de cada familia de artefato ficam em
// discovery.documento.mh, discovery.tecnicos.mh e discovery.backlog.mh,
// trazidos por `import "..."` por extenso (mescla o arquivo inteiro; um
// fragmento partial nao precisa de `export` individual). `entry step
// Dispatch` marca o ponto de entrada real porque, com steps vindo de varios
// arquivos, "o primeiro step declarado" deixa de fazer sentido.
import "discovery.partial.backlog.mh"
import "discovery.partial.documento.mh"
import "discovery.partial.tecnicos.mh"

import { Paths } from "../shared/core/paths.mh"

partial workflow Discovery {
    description: "Artefatos de nivel Oportunidade: brief, atributos, requisitos, adr, der, diagramas, features, historias."

    input project_id: string
    input artifact: string        // brief | atributos | requisitos | adr | der | diagramas | features | historias
    input feature_id: string = "" // obrigatorio (valor) so para artifact:"historias"
    input buddy: bool = false
    input approved: bool = false
    // Passado no resume junto com approved:false (Modo Buddy's "Solicitar
    // mudancas" — reading-pane.js/tab-artefatos.js), nunca em StartRun.
    input feedback: string = ""

    var discovery_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var pending_data = null
    var pending_feedback = ""
    // Gate usa isto (nao um "feedback = ''" dentro do proprio Gate) pra
    // saber se o `feedback` atual ja foi consumido — spike real confirmou
    // que reatribuir uma variavel `input` NAO sobrevive a um goto pra outro
    // step: ela e re-vinculada ao valor original do resume toda vez que o
    // step e reexecutado, entao "limpar" `feedback` assim nunca gruda e o
    // Gate reentraria em *Generate pra sempre. `feedback_consumed` e uma
    // `var` normal (essas sim persistem entre steps, como `pending_data` ja
    // prova) — vira true no exato momento em que o comentario e consumido,
    // volta a false bem antes do proximo pause(), liberando o PROXIMO
    // resume com um `feedback` novo a reentrar no laco de novo.
    var feedback_consumed = false

    output: {
        artifact: artifact,
        result: discovery_result,
        tokens_in: tokens_in,
        tokens_out: tokens_out,
    }

    //before_start: () -> {}

    route CommitRouter(artifact: string) {
        "brief"      -> BriefCommit
        "atributos"  -> AtributosCommit
        "requisitos" -> RequisitosCommit
        "adr"        -> AdrCommit
        "der"        -> DerCommit
        "diagramas"  -> DiagramasCommit
        "features"   -> FeaturesCommit
        "historias"  -> HistoriasCommit
        _ -> fail("invariante violado: artefato desconhecido chegou ao Gate")
    }

    route GenerateRouter(artifact: string) {
        "brief"      -> BriefGenerate
        "atributos"  -> AtributosGenerate
        "requisitos" -> RequisitosGenerate
        "der"        -> DerGenerate
        "adr"        -> AdrGenerate
        "diagramas"  -> DiagramasGenerate
        "features"   -> FeaturesGenerate
        "historias"  -> HistoriasGenerate
        _ -> fail("artefato desconhecido: '" + artifact +
                "' (use brief | atributos | requisitos | adr | der | diagramas | features | historias)"
        )
    }

    entry step Dispatch {
        project_id = Paths.ensure_valid(project_id)
        goto GenerateRouter(artifact)
    }

    // Gate e compartilhado por todo artefato — pausar (Modo Buddy) nunca
    // custa uma nova chamada de LLM no resume, porque cada *Generate ja
    // terminou e gravou o resultado em `pending_data` (pipeline-scoped)
    // antes de chegar aqui.
    //
    // Um resume com approved:false + feedback preenchido (Modo Buddy's
    // "Solicitar mudancas") e diferente de um resume comum: em vez de
    // pausar de novo com o MESMO pending_data, volta pro *Generate do
    // artefato — refaz a chamada de LLM, desta vez com o comentario do
    // revisor anexado a instrucao (ver FeedbackBlock/feedback_content nas
    // *Instruction). Ver a nota de feedback_consumed acima pra por que o
    // guard usa aquela var, nao `feedback` diretamente — confirmado por
    // spike isolado (LoopProbe) que a versao anterior deste Gate (que
    // tentava `feedback = ""`) entrava num laco infinito de verdade: um
    // resume real bateu em produção, cada volta era uma chamada de LLM
    // nova. Corrigido e revalidado (3 ciclos: regenerar, regenerar de novo,
    // aprovar) antes desta versao.
    step Gate {
        if (buddy && !approved) {
            if (!feedback.is_empty() && !feedback_consumed) {
                feedback_consumed = true
                pending_feedback = feedback

                goto GenerateRouter(artifact)
            }

            feedback_consumed = false
            pause("revise o conteudo de '" + artifact + "' antes de gravar em artifacts/")
        }

        goto CommitRouter(artifact)
    }

    // Done e o ponto de convergencia unico de todo Commit. Usa `complete()`
    // (nao um corpo vazio) pra encerrar a run explicitamente aqui, entao
    // nao importa em qual arquivo/posicao este step acaba ficando depois de
    // todos os fragmentos mesclados — sem isso, um step sem `goto` no fim
    // simplesmente cai (fallthrough) pro proximo item fisico da lista
    // mesclada, e isso ja causou um bug real em producao (Done "vazando"
    // pra dentro do proximo Generate, disparando uma chamada de LLM
    // indevida) quando este workflow foi dividido em fragmentos e Done
    // deixou de ser, por acaso, o ultimo step do arquivo unico original.
    step Done { complete() }
}

// DiscoveryWorkflowSpec — mesmo padrao de work_item.mh :: WorkItemWorkflowSpec
// / wiki.mh :: WikiWorkflowSpec: `Name.run(inputs:)` (mhl 1.4.0-beta.7+,
// MHL-Melhorias.md #13) testando o workflow inteiro, escopado aos gates de
// dependencia da matriz §4.1 do plano — cada um falha ANTES de chamar
// `Writer.generate` (zero custo de LLM) porque o `project_id` usado nunca
// existiu de verdade, entao `Context.artifact(...)` sempre devolve "" e o
// primeiro `fail()` de predecessor dispara. So exercita o PRIMEIRO gate de
// cada artefato (o unico alcancavel sem escrever um artefato predecessor de
// verdade primeiro — `Name.run()` nao isola `fs`/`dir`, ver FASE5-ACHADOS.md
// e a nota equivalente em work_item.mh) — nao substitui a validacao real de
// ponta a ponta com `claude`/`codex` já feita na Fase 3, so cobre a parte
// determinística (a matriz de dependência em si) que antes só era
// verificada manualmente / de relance durante uma chamada real.
//
// Vive aqui (nao num dos fragmentos) porque este e o arquivo que faz o
// `import` por extenso dos tres fragmentos — so ele enxerga o workflow
// Discovery completo, com todos os steps mesclados.
test DiscoveryWorkflowSpec {
    describe rejects_an_unknown_artifact_before_touching_anything {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "bogus"})
        is_false(run.ok)
        is_true(run.error.contains("artefato desconhecido"))
    }

    describe atributos_requires_brief_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "atributos"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'brief' antes de 'atributos'"))
    }

    describe requisitos_requires_brief_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "requisitos"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'brief' antes de 'requisitos'"))
    }

    describe adr_requires_requisitos_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "adr"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'adr'"))
    }

    describe der_requires_requisitos_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "der"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'der'"))
    }

    describe diagramas_requires_requisitos_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "diagramas"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'diagramas'"))
    }

    describe features_requires_requisitos_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "features"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'features'"))
    }

    describe historias_requires_a_feature_id {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "historias"})
        is_false(run.ok)
        is_true(run.error.contains("'feature_id' e obrigatorio"))
    }
}
