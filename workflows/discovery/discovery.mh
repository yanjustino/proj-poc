// workflow Discovery — artefatos de nivel Oportunidade (ver
// PLANO-MACRO-MHL-SENPAI.md §4, Fase 3). Um par Generate/Commit por
// artefato + um `Gate` compartilhado pro Modo Buddy (mesmo padrao da Fase 2:
// pausar nao deve custar reexecutar a chamada de LLM no resume).
//
// C2: todo contexto vem de `tool Context` (wiki/** + artifacts/** do mesmo
// project_id) — nenhum step le raw/ ou outro projeto. C3: a LLM so devolve
// campos via schema; Cite.list/Cite.sections/ArtifactId decidem formatacao,
// selo de citacao e id, nunca a LLM. Schemas carregam via `prompt ... from`
// sem parametros (FASE2-ACHADOS.md §2) — fs.read quebraria se o mhl rodasse
// de outro CWD.
//
// Toda informacao devolvida pela LLM carrega uma `fonte`/`fontes` (pagina
// da wiki, artefato predecessor, "gap" ou "inferência" — ver
// schema.prompt.md e tool Cite) — nao existe campo de conteudo sem
// proveniencia declarada.

import { Paths } from "../shared/paths.mh"
import { Writer } from "../shared/agents.mh"
import { Context } from "../shared/context.mh"
import { Cite } from "../shared/cite.mh"
import { Slug } from "../shared/slug.mh"
import { ArtifactId } from "../shared/artifact_id.mh"
import { PageShell, ArtifactMeta } from "../shared/page_shell.mh"
import { ClaudeQuirks } from "../shared/claude_quirks.mh"
import {
    ArtifactSchema,
    BriefInstruction, AtributosInstruction, RequisitosInstruction, AdrInstruction, DerInstruction, DiagramasInstruction,
    BriefSchemaFile, AtributosSchemaFile, RequisitosSchemaFile, AdrSchemaFile, DerSchemaFile, DiagramasSchemaFile,
    BriefBody, AtributosBody, RequisitosBody, AdrBody, DerBody, DiagramaBody
} from "../shared/artifacts_common.mh"

// features/historias sao especificos de Discovery (Delivery nao os tem —
// gera o detalhamento final de UMA feature/historia ja identificada, nao um
// backlog inteiro) — por isso continuam declarados aqui, nao em
// artifacts_common.mh.
prompt FeaturesInstruction(schema_conventions: prompt, requisitos_content: string, adr_content: string, der_content: string, diagramas_content: string, wiki_content: string) from "prompts/features.prompt.md"
prompt HistoriasInstruction(schema_conventions: prompt, feature_content: string, wiki_content: string) from "prompts/historias.prompt.md"

prompt FeaturesSchemaFile() from "schemas/features.schema.json"
prompt HistoriasSchemaFile() from "schemas/historias.schema.json"

prompt FeatureBody(descricao: string, fontes_nota: string, criterios_lista: string) from "templates/feature_body.html"
prompt HistoriaBody(como: string, quero: string, para: string, fontes_nota: string, criterios_lista: string) from "templates/historia_body.html"

workflow Discovery {
    description: "Artefatos de nivel Oportunidade: brief, atributos, requisitos, adr, der, diagramas, features, historias."

    input project_id: string
    input artifact: string        // brief | atributos | requisitos | adr | der | diagramas | features | historias
    input feature_id: string = "" // obrigatorio (valor) so para artifact:"historias"
    input buddy: bool = false
    input approved: bool = false

    var discovery_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var pending_data = null

    output: {
        artifact: artifact,
        result: discovery_result,
        tokens_in: tokens_in,
        tokens_out: tokens_out,
    }

    step Dispatch {
        project_id = Paths.ensure_valid(project_id)
        if (artifact == "brief") goto BriefGenerate
        if (artifact == "atributos") goto AtributosGenerate
        if (artifact == "requisitos") goto RequisitosGenerate
        if (artifact == "adr") goto AdrGenerate
        if (artifact == "der") goto DerGenerate
        if (artifact == "diagramas") goto DiagramasGenerate
        if (artifact == "features") goto FeaturesGenerate
        if (artifact == "historias") goto HistoriasGenerate
        fail("artefato desconhecido: '" + artifact + "' (use brief | atributos | requisitos | adr | der | diagramas | features | historias)")
    }

    // Gate e compartilhado por todo artefato — pausar (Modo Buddy) nunca
    // custa uma nova chamada de LLM no resume, porque cada *Generate ja
    // terminou e gravou o resultado em `pending_data` (pipeline-scoped)
    // antes de chegar aqui.
    step Gate {
        if (buddy && !approved) pause("revise o conteudo de '" + artifact + "' antes de gravar em artifacts/")
        if (artifact == "brief") goto BriefCommit
        if (artifact == "atributos") goto AtributosCommit
        if (artifact == "requisitos") goto RequisitosCommit
        if (artifact == "adr") goto AdrCommit
        if (artifact == "der") goto DerCommit
        if (artifact == "diagramas") goto DiagramasCommit
        if (artifact == "features") goto FeaturesCommit
        if (artifact == "historias") goto HistoriasCommit
        fail("invariante violado: artefato desconhecido chegou ao Gate")
    }

    step BriefGenerate {
        current_artifact = "brief"
        var raw = Writer.run(
            prompt: BriefInstruction(schema_conventions: ArtifactSchema(), wiki_content: Context.wiki(project_id)),
            schema: BriefSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step BriefCommit {
        var data = pending_data
        var body = BriefBody(
            problema: html.escape(data.problema),
            problema_fontes: Cite.note(data.problema_fontes),
            objetivos_lista: Cite.list(data.objetivos),
            stakeholders_lista: Cite.list(data.stakeholders)
        )
        var rendered = PageShell(
            title: "Brief",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/brief.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "brief.html"), rendered)
        discovery_result = {artifact: "brief", path: "artifacts/brief.html"}
        goto Done
    }

    step AtributosGenerate {
        current_artifact = "atributos"
        var brief_content = Context.artifact(project_id, "brief.html")
        if (brief_content.is_empty()) fail("gere 'brief' antes de 'atributos'")
        var raw = Writer.run(
            prompt: AtributosInstruction(schema_conventions: ArtifactSchema(), brief_content: brief_content, wiki_content: Context.wiki(project_id)),
            schema: AtributosSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step AtributosCommit {
        var data = pending_data
        var secoes_items = []
        for (var item in data.atributos) {
            secoes_items += [{titulo: item.categoria, corpo: item.descricao, fontes: item.fontes}]
        }
        var body = AtributosBody(secoes: Cite.sections(secoes_items))
        var rendered = PageShell(
            title: "Atributos de Qualidade",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/atributos.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "atributos.html"), rendered)
        discovery_result = {artifact: "atributos", path: "artifacts/atributos.html"}
        goto Done
    }

    step RequisitosGenerate {
        current_artifact = "requisitos"
        var brief_content = Context.artifact(project_id, "brief.html")
        if (brief_content.is_empty()) fail("gere 'brief' antes de 'requisitos'")
        var raw = Writer.run(
            prompt: RequisitosInstruction(schema_conventions: ArtifactSchema(), brief_content: brief_content, wiki_content: Context.wiki(project_id)),
            schema: RequisitosSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step RequisitosCommit {
        var data = pending_data
        var body = RequisitosBody(
            funcionais_lista: Cite.list(data.funcionais),
            nao_funcionais_lista: Cite.list(data.nao_funcionais)
        )
        var rendered = PageShell(
            title: "Requisitos",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/requisitos.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "requisitos.html"), rendered)
        discovery_result = {artifact: "requisitos", path: "artifacts/requisitos.html"}
        goto Done
    }

    step AdrGenerate {
        current_artifact = "adr"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'adr'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'adr'")
        var raw = Writer.run(
            prompt: AdrInstruction(schema_conventions: ArtifactSchema(), requisitos_content: requisitos_content, atributos_content: atributos_content, wiki_content: Context.wiki(project_id)),
            schema: AdrSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step AdrCommit {
        var data = pending_data
        var written = []
        dir.create(Paths.artifact(project_id, "adr"))
        for (var decision in data.decisions) {
            var id = ArtifactId.next_adr_id(project_id)
            var folder = ArtifactId.folder_name(id, decision.titulo)
            var body = AdrBody(
                contexto: html.escape(decision.contexto),
                decisao: html.escape(decision.decisao),
                consequencias: html.escape(decision.consequencias),
                fontes_nota: Cite.note(decision.fontes)
            )
            var rendered = PageShell(
                title: html.escape(id + " — " + decision.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/adr/" + folder + ".html", tokens_in, tokens_out)
            )
            fs.write(Paths.artifact(project_id, "adr/" + folder + ".html"), rendered)
            written += [folder]
        }
        discovery_result = {artifact: "adr", written: written}
        goto Done
    }

    step DerGenerate {
        current_artifact = "der"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'der'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'der'")
        var raw = Writer.run(
            prompt: DerInstruction(schema_conventions: ArtifactSchema(), requisitos_content: requisitos_content, atributos_content: atributos_content, wiki_content: Context.wiki(project_id)),
            schema: DerSchemaFile()
        )
        var data = json.parse(raw)
        data["diagrama_mermaid"] = ClaudeQuirks.strip_trailing_tag_leak(data.diagrama_mermaid, "diagrama_mermaid")
        pending_data = data
        goto Gate
    }

    step DerCommit {
        var data = pending_data
        var body = DerBody(
            descricao: html.escape(data.descricao),
            fontes_nota: Cite.note(data.fontes),
            diagrama_mermaid: html.escape(data.diagrama_mermaid)
        )
        var rendered = PageShell(
            title: "DER",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/der.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "der.html"), rendered)
        discovery_result = {artifact: "der", path: "artifacts/der.html"}
        goto Done
    }

    step DiagramasGenerate {
        current_artifact = "diagramas"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'diagramas'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'diagramas'")
        var raw = Writer.run(
            prompt: DiagramasInstruction(schema_conventions: ArtifactSchema(), requisitos_content: requisitos_content, atributos_content: atributos_content, wiki_content: Context.wiki(project_id)),
            schema: DiagramasSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step DiagramasCommit {
        var data = pending_data
        var written = []
        dir.create(Paths.artifact(project_id, "diagramas"))
        for (var diagrama in data.diagramas) {
            var slug = Slug.from_title(diagrama.titulo)
            var body = DiagramaBody(
                descricao: html.escape(diagrama.descricao),
                fontes_nota: Cite.note(diagrama.fontes),
                diagrama_mermaid: html.escape(diagrama.diagrama_mermaid)
            )
            var rendered = PageShell(
                title: html.escape(diagrama.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/diagramas/" + slug + ".html", tokens_in, tokens_out)
            )
            fs.write(Paths.artifact(project_id, "diagramas/" + slug + ".html"), rendered)
            written += [slug]
        }
        discovery_result = {artifact: "diagramas", written: written}
        goto Done
    }

    step FeaturesGenerate {
        current_artifact = "features"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'features'")

        var adr_content = Context.artifact_dir(project_id, "adr")
        if (adr_content.is_empty()) fail("gere 'adr' antes de 'features'")

        // der e opcional: nem toda oportunidade tem um modelo de dados
        // formal que valha a pena diagramar — features usa o conteudo
        // quando existe, mas nao bloqueia na ausencia dele.
        var der_content = Context.artifact(project_id, "der.html")
        if (der_content.is_empty()) der_content = "(não gerado para esta oportunidade)"

        var diagramas_content = Context.artifact_dir(project_id, "diagramas")
        if (diagramas_content.is_empty()) fail("gere 'diagramas' antes de 'features'")

        var raw = Writer.run(
            prompt: FeaturesInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                adr_content: adr_content,
                der_content: der_content,
                diagramas_content: diagramas_content,
                wiki_content: Context.wiki(project_id)
            ),
            schema: FeaturesSchemaFile()
        )
        pending_data = json.parse(raw)
        goto Gate
    }

    step FeaturesCommit {
        var data = pending_data
        var written = []
        dir.create(Paths.artifact(project_id, "features"))
        for (var feature in data.features) {
            var id = ArtifactId.next_feature_id(project_id)
            var folder = ArtifactId.folder_name(id, feature.titulo)
            var body = FeatureBody(
                descricao: html.escape(feature.descricao),
                fontes_nota: Cite.note(feature.fontes),
                criterios_lista: Cite.list(feature.criterios_aceite)
            )
            var rendered = PageShell(
                title: html.escape(id + " — " + feature.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/features/" + folder + "/feature.html", tokens_in, tokens_out)
            )
            dir.create(Paths.artifact(project_id, "features/" + folder))
            fs.write(Paths.artifact(project_id, "features/" + folder + "/feature.html"), rendered)
            written += [folder]
        }
        discovery_result = {artifact: "features", written: written}
        goto Done
    }

    step HistoriasGenerate {
        if (feature_id.is_empty()) fail("'feature_id' e obrigatorio para artifact: \"historias\"")
        current_artifact = "historias"
        var feature_dir = ArtifactId.find_feature_dir(project_id, feature_id)
        var feature_content = Context.artifact(project_id, "features/" + feature_dir + "/feature.html")
        var raw = Writer.run(
            prompt: HistoriasInstruction(schema_conventions: ArtifactSchema(), feature_content: feature_content, wiki_content: Context.wiki(project_id)),
            schema: HistoriasSchemaFile()
        )
        var data = json.parse(raw)
        data["feature_dir"] = feature_dir
        pending_data = data
        goto Gate
    }

    step HistoriasCommit {
        var data = pending_data
        var feature_dir = data.feature_dir
        var historias_base = Paths.artifact(project_id, "historias/" + feature_dir)
        dir.create(historias_base)
        var written = []
        for (var historia in data.historias) {
            var id = ArtifactId.next_historia_id(project_id, feature_dir)
            var folder = ArtifactId.folder_name(id, historia.titulo)
            var body = HistoriaBody(
                como: html.escape(historia.como),
                quero: html.escape(historia.quero),
                para: html.escape(historia.para),
                fontes_nota: Cite.note(historia.fontes),
                criterios_lista: Cite.list(historia.criterios_aceite)
            )
            var rendered = PageShell(
                title: html.escape(id + " — " + historia.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/historias/" + feature_dir + "/" + folder + "/historia.html", tokens_in, tokens_out)
            )
            dir.create(historias_base + "/" + folder)
            fs.write(historias_base + "/" + folder + "/historia.html", rendered)
            written += [folder]
        }
        discovery_result = {artifact: "historias", feature_id: feature_id, written: written}
        goto Done
    }

    step Done {
        // ponto de convergencia unico — mantem `reached` enxuto (C7/Fase 1).
    }
}
