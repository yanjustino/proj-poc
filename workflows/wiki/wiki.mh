// Orquestra ingestao, consulta e saneamento da wiki. A LLM produz apenas
// dados estruturados; componentes determinísticos cuidam de arquivos e índice.

import { Paths } from "../shared/paths.mh"
import { Writer } from "../shared/agents.mh"
import { RawExtract } from "../shared/raw_extract.mh"
import { WikiContext } from "../shared/wiki_context.mh"
import { WikiActions } from "actions.mh"
import { IngestSchemaFile, QuerySchemaFile, LintSchemaFile } from "schema_files.mh"

prompt WikiSchema() from "schema.prompt.md"
prompt IngestInstruction(schema_conventions: prompt, source_name: string, source_text: string) from "prompts/ingest.prompt.md"
prompt QueryInstruction(schema_conventions: prompt, question: string, wiki_content: string) from "prompts/query.prompt.md"
prompt LintInstruction(schema_conventions: prompt, wiki_content: string) from "prompts/lint.prompt.md"

workflow Wiki {
    description: "Ingestao, consulta e saneamento da wiki de um work-item (padrao wiki-llm.md)."

    input project_id: string
    input action: string             // "ingest" | "query" | "lint"
    input raw_paths: string[] = []   // ingest: exatamente 1 elemento nesta versao (v1)
    input question: string = ""      // query
    input file_answer: bool = false  // query
    input buddy: bool = false        // ingest: true pausa pra revisao antes de gravar (Modo Buddy)
    input approved: bool = false     // ingest: "yes" da revisao, passado no mhl_run_resume

    var wiki_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var ingest_data = null

    output: {
        action: action,
        result: wiki_result,
        tokens_in: tokens_in,
        tokens_out: tokens_out,
    }

    step Dispatch {
        project_id = Paths.ensure_valid(project_id)
        if (action == "ingest") goto IngestGenerate
        if (action == "query") goto Query
        if (action == "lint") goto Lint
        fail("acao desconhecida: '" + action + "' (use ingest | query | lint)")
    }

    // Ingest e 3 steps, nao 1, especificamente pra Modo Buddy (pause/resume)
    // ser barato: IngestGenerate faz a parte cara (le a fonte, chama a LLM) e
    // guarda o resultado em `ingest_data` (pipeline-scoped, sobrevive a um
    // checkpoint); IngestGate so pausa; IngestCommit grava os arquivos. Um
    // `mhl_run_resume` reentra so no step onde parou — nunca refaz a
    // chamada a LLM so porque o usuario demorou pra aprovar.
    step IngestGenerate {
        // v1: uma fonte por chamada (padrao docs/wiki-llm.md — "ingerir e
        // revisar uma de cada vez"). Lote/menos supervisao fica pra Fase 6.
        if (raw_paths.size() != 1) {
            // `+` nao coage number pra string (achado antigo, reintroduzido
            // aqui numa refatoracao — ver a mesma classe de bug documentada
            // no historico do projeto) — interpolacao `${...}` e a forma
            // segura, nao `+` com um `number` de um dos lados.
            fail("ingest processa uma fonte por vez nesta versao (v1) — recebido ${raw_paths.size()} caminho(s)")
        }
        var source_name = raw_paths[0]
        var abs_path = Paths.raw(project_id, source_name)
        if (!fs.exists(abs_path)) fail("fonte nao encontrada em raw/: '" + source_name + "'")

        var source_text = RawExtract.text(abs_path)
        current_artifact = "ingest:" + source_name

        var response = Writer.generate(
            prompt: IngestInstruction(
                schema_conventions: WikiSchema(),
                source_name: source_name,
                source_text: source_text
            ),
            schema_file: IngestSchemaFile.get(),
            project_id: project_id,
            artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        ingest_data = json.parse(raw)
        goto IngestGate
    }

    step IngestGate {
        if (buddy && !approved) {
            pause(
                "revise o conteudo extraido de '" + ingest_data.source_title +
                "' antes de gravar na wiki"
            )
        }
        goto IngestCommit
    }

    step IngestCommit {
        wiki_result = WikiActions.commit_ingest(project_id, ingest_data)
        goto Done
    }

    step Query {
        if (question.is_empty()) fail("'question' e obrigatorio para action: \"query\"")
        current_artifact = "query"
        var wiki_content = WikiContext.all_pages(project_id)

        var response = Writer.generate(
            prompt: QueryInstruction(
                schema_conventions: WikiSchema(),
                question: question,
                wiki_content: wiki_content
            ),
            schema_file: QuerySchemaFile.get(),
            project_id: project_id,
            artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        var data = json.parse(raw)
        var answer_body = data.answer_body

        var filed_as = null
        if (file_answer) {
            filed_as = WikiActions.file_answer(
                project_id,
                data.answer_title,
                answer_body,
                question
            )
        }

        wiki_result = {
            answer_title: data.answer_title,
            answer_body: answer_body,
            filed_as: filed_as,
        }
        goto Done
    }

    step Lint {
        current_artifact = "lint"
        var wiki_content = WikiContext.all_pages(project_id)

        var response = Writer.generate(
            prompt: LintInstruction(
                schema_conventions: WikiSchema(),
                wiki_content: wiki_content
            ),
            schema_file: LintSchemaFile.get(),
            project_id: project_id,
            artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        wiki_result = json.parse(raw)

        WikiActions.record_lint(project_id)
        goto Done
    }

    step Done {
        // ponto de convergencia unico — mantem `reached` enxuto (C7/Fase 1).
    }
}

// WikiWorkflowSpec — mesmo padrao de work_item.mh :: WorkItemWorkflowSpec:
// `Name.run(inputs:)` (mhl 1.4.0-beta.7+, MHL-Melhorias.md #13) testando o
// workflow inteiro, escopado SO aos caminhos de falha rapida que nunca
// chegam a chamar `Writer.generate` (sem custo de LLM) nem a escrever em
// disco (`Name.run()` nao isola `fs`/`dir` num sandbox descartavel — ver
// FASE5-ACHADOS.md e a nota equivalente em work_item.mh).
test WikiWorkflowSpec {
    describe rejects_an_unknown_action_before_touching_anything {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "bogus"})
        is_false(run.ok)
        is_true(run.error.contains("acao desconhecida"))
    }

    describe rejects_an_invalid_project_id_before_touching_anything {
        var run = Wiki.run(inputs: {project_id: "../../etc/passwd", action: "query", question: "oi"})
        is_false(run.ok)
        is_true(run.error.contains("project_id invalido"))
    }

    describe ingest_rejects_zero_raw_paths_before_reading_anything {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: []})
        is_false(run.ok)
        is_true(run.error.contains("uma fonte por vez"))
    }

    describe ingest_rejects_more_than_one_raw_path_before_reading_anything {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: ["a.md", "b.md"]})
        is_false(run.ok)
        is_true(run.error.contains("uma fonte por vez"))
    }

    describe ingest_of_a_source_that_does_not_exist_fails_without_calling_the_llm {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: ["nao-existe.md"]})
        is_false(run.ok)
        is_true(run.error.contains("fonte nao encontrada"))
    }

    describe query_rejects_an_empty_question_before_calling_the_llm {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "query", question: ""})
        is_false(run.ok)
        is_true(run.error.contains("'question' e obrigatorio"))
    }
}
