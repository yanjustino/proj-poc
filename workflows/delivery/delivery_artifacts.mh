// O que muda por artefato no Delivery: quais predecessores cada um exige,
// como e gerado e onde e gravado. O fluxo (pausa, aprovacao, pedido de
// mudanca) fica em delivery.mh.
//
// Um projeto de Delivery tipicamente evolui um sistema em producao: as
// instrucoes de feature/historia classificam cada item por `mudanca`
// (as_is/modificado/novo/removido) e nunca assumem greenfield.

import { Paths } from "../shared/core/paths.mh"
import { Closed } from "../shared/core/closed_set.mh"
import { WorkflowsRoot, SchemaFile } from "../shared/core/workflows_root.mh"
import { Context } from "../shared/artifacts/context.mh"
import { ContextSlice } from "../shared/artifacts/context_slice.mh"
import { Require } from "../shared/artifacts/require.mh"
import { ArtifactData } from "../shared/artifacts/artifact_data.mh"
import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { ArtifactId } from "../shared/artifacts/artifact_id.mh"
import { ArtifactChecks } from "../shared/artifacts/artifact_checks.mh"
import { ArtifactCommit } from "../shared/artifacts/artifact_commit.mh"
import { AutoReview } from "../shared/artifacts/auto_review.mh"
import { ChangesBlock } from "../shared/artifacts/changes_log.mh"
import { CommonDrafts, TechContext } from "../shared/artifacts/common_drafts.mh"
import { Drafts, Draft } from "../shared/artifacts/draft.mh"
import { Traceability, SpecFiles } from "../shared/artifacts/historia_spec.mh"
import { ArtifactSchema, SpecConventions } from "../shared/artifacts/artifacts_common.mh"

export enum DeliveryMode { feature, historia }
export enum DeliveryArtifact { brief, requisitos, adr, der, diagramas, feature, historia, historias, plano }

export tool DeliveryKinds {
    artifact(name: string): DeliveryArtifact -> Closed.parse("artefato desconhecido", name, [
        DeliveryArtifact.brief, DeliveryArtifact.requisitos, DeliveryArtifact.adr, DeliveryArtifact.der,
        DeliveryArtifact.diagramas, DeliveryArtifact.feature, DeliveryArtifact.historia,
        DeliveryArtifact.historias, DeliveryArtifact.plano,
    ])

    mode(name: string): DeliveryMode -> Closed.parse("mode invalido", name, [DeliveryMode.feature, DeliveryMode.historia])

    // O artefato final e o proprio modo; `historias` quebra a feature final.
    check(mode_name: string, artifact_name: string) -> {
        var mode = self.mode(mode_name)
        var artifact = self.artifact(artifact_name)
        var final = artifact == DeliveryArtifact.feature || artifact == DeliveryArtifact.historia
        if (final && artifact_name != mode_name) fail("artifact '${artifact_name}' nao bate com mode '${mode_name}'")
        if (artifact == DeliveryArtifact.historias && mode != DeliveryMode.feature) fail("'historias' so existe quando mode=\"feature\"")
    }

    // Chave que separa o historico (ChangesLog, ActivityLog) de cada plano.
    scope(artifact_name: string, historia_id: string): string -> if (artifact_name == "plano") historia_id else ""
}

// Delivery nao gera atributos de qualidade: este texto fixo ocupa o lugar
// deles nas instrucoes compartilhadas com o Discovery.
tool NoAtributos {
    text(): string -> "(não se aplica neste nível — Delivery não gera atributos de qualidade; considere apenas requisitos)"
}

// Os artefatos finais derivam do que ja foi sintetizado, nao da wiki bruta.
prompt FeatureInstruction(
    schema_conventions: prompt,
    requisitos_content: string,
    adr_content: string,
    der_content: string,
    diagramas_content: string,
    feedback_content: string
) from "prompts/feature.prompt.md"

prompt HistoriaInstruction(
    schema_conventions: prompt,
    spec_conventions: prompt,
    requisitos_content: string,
    adr_content: string,
    der_content: string,
    diagramas_content: string,
    feedback_content: string
) from "prompts/historia.prompt.md"

prompt FeatureSchemaContent() from "schemas/feature.schema.json"
prompt HistoriaSchemaContent() from "schemas/historia.schema.json"

tool DeliverySchemas {
    feature(): SchemaFile -> WorkflowsRoot.schema(FeatureSchemaContent(), "delivery/schemas/feature.schema.json")
    historia(): SchemaFile -> WorkflowsRoot.schema(HistoriaSchemaContent(), "delivery/schemas/historia.schema.json")
}

// Predecessores: brief -> requisitos -> adr -> der | diagramas -> feature |
// historia -> historias. historias e plano recebem o contexto recortado pelo
// que o item cita, com texto fixo no lugar do que nao foi gerado.
export tool DeliveryDrafts {
    of(kind: DeliveryArtifact, project_id: string, mode: string, historia_id: string, autorrevisao: bool): Draft -> match kind {
        DeliveryArtifact.brief      -> self.brief(project_id)
        DeliveryArtifact.requisitos -> self.requisitos(project_id)
        DeliveryArtifact.adr        -> self.adr(project_id)
        DeliveryArtifact.der        -> self.der(project_id, autorrevisao)
        DeliveryArtifact.diagramas  -> self.diagramas(project_id, autorrevisao)
        DeliveryArtifact.feature    -> self.feature(project_id, autorrevisao)
        DeliveryArtifact.historia   -> self.historia(project_id, autorrevisao)
        DeliveryArtifact.historias  -> self.historias(project_id, autorrevisao)
        DeliveryArtifact.plano      -> self.plano(project_id, mode, historia_id, autorrevisao)
    }

    brief(project_id: string): Draft -> CommonDrafts.brief(project_id)

    requisitos(project_id: string): Draft ->
        CommonDrafts.requisitos(project_id, Require.artifact(project_id, "brief", "requisitos"))

    adr(project_id: string): Draft -> {
        Require.artifact(project_id, "brief", "adr")
        return CommonDrafts.adr(project_id, Require.artifact(project_id, "requisitos", "adr"), NoAtributos.text())
    }

    der(project_id: string, autorrevisao: bool): Draft -> {
        var requisitos = Require.artifact(project_id, "requisitos", "der")
        return CommonDrafts.der(project_id, autorrevisao, requisitos, NoAtributos.text(), Require.adr(project_id, "der"))
    }

    diagramas(project_id: string, autorrevisao: bool): Draft -> {
        var requisitos = Require.artifact(project_id, "requisitos", "diagramas")
        return CommonDrafts.diagramas(project_id, autorrevisao, requisitos, NoAtributos.text(), Require.adr(project_id, "diagramas"))
    }

    // O artefato final exige todos os predecessores.
    final_context(project_id: string, before: string): any -> {
        Require.artifact(project_id, "brief", before)
        var requisitos = Require.artifact(project_id, "requisitos", before)
        var adr = Require.adr(project_id, before)
        var der = Require.artifact(project_id, "der", before)
        return {requisitos: requisitos, adr: adr, der: der, diagramas: Require.diagramas(project_id, before)}
    }

    feature(project_id: string, autorrevisao: bool): Draft -> {
        var ctx = self.final_context(project_id, "feature")
        return Drafts.reviewed(AutoReview.generate(
            enabled: autorrevisao,
            prompt: FeatureInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: ctx.requisitos,
                adr_content: ctx.adr,
                der_content: ctx.der,
                diagramas_content: ctx.diagramas,
                feedback_content: ChangesBlock.for_artifact(project_id, "feature", "")
            ),
            schema_file: DeliverySchemas.feature(), project_id: project_id, artifact: "feature",
            prepare: (raw) -> json.parse(raw),
            check: (d) -> ArtifactChecks.feature(d)
        ))
    }

    // A historia unica recebe os mesmos avisos de rastreabilidade de um lote.
    historia(project_id: string, autorrevisao: bool): Draft -> {
        var ctx = self.final_context(project_id, "historia")
        var known = Traceability.known(project_id)
        return Drafts.reviewed(AutoReview.generate(
            enabled: autorrevisao,
            prompt: HistoriaInstruction(
                schema_conventions: ArtifactSchema(),
                spec_conventions: SpecConventions(),
                requisitos_content: ctx.requisitos,
                adr_content: ctx.adr,
                der_content: ctx.der,
                diagramas_content: ctx.diagramas,
                feedback_content: ChangesBlock.for_artifact(project_id, "historia", "")
            ),
            schema_file: DeliverySchemas.historia(), project_id: project_id, artifact: "historia",
            prepare: (raw) -> Traceability.annotate({historias: [json.parse(raw)]}, known).historias[0],
            check: (d) -> ArtifactChecks.historia(d)
        ))
    }

    tech(project_id: string, refs: string[]): TechContext -> {
        requisitos: ContextSlice.requisitos(project_id, refs),
        atributos: NoAtributos.text(),
        adr: Require.optional(ContextSlice.adrs(project_id, refs), "este projeto"),
        der: Require.optional(Context.artifact(project_id, "der.html"), "este projeto"),
        diagramas: Require.optional(ContextSlice.diagramas(project_id, refs), "este projeto"),
    }

    // Quebra a feature final (a unica do projeto) em historias.
    historias(project_id: string, autorrevisao: bool): Draft -> {
        var feature = Require.artifact(project_id, "feature", "historias")
        var feature_data = ContextSlice.read(project_id, "feature.json")
        return CommonDrafts.historias(project_id, autorrevisao, feature, self.tech(project_id, ContextSlice.refs(feature_data)), feature_data?.historias_propostas ?? [], "")
    }

    // Gravado ao lado da historia: historias/<USxxx>/plano.html no modo
    // feature; plano.html na raiz no modo historia, cuja historia e o
    // proprio historia.html do projeto.
    // Pasta da historia ("" no modo historia, cuja historia e a raiz) e o
    // caminho de volta ate artifacts/ a partir dela.
    plano_location(project_id: string, mode: string, historia_id: string): any -> {
        if (mode == "historia") return {folder: "", assets_prefix: "./"}
        if (historia_id.is_empty()) fail("'historia_id' e obrigatorio para artifact: \"plano\" no modo feature")
        return {folder: "historias/${ArtifactId.find_historia_dir(project_id, "historias", historia_id)}/", assets_prefix: "../../"}
    }

    plano(project_id: string, mode: string, historia_id: string, autorrevisao: bool): Draft -> {
        var standalone = mode == "historia"
        var location = self.plano_location(project_id, mode, historia_id)
        var folder = location.folder
        var historia_rel = "${folder}historia.html"
        var historia_json = Paths.artifact(project_id, ArtifactData.json_relative(historia_rel))
        if (!fs.exists(historia_json)) fail("gere a historia antes do plano de implementacao")
        var historia = json.parse(fs.read(historia_json))
        var titulo = (if (standalone) "" else "${historia_id} — ") + (historia?.titulo ?? "História do projeto")
        var feature = if (standalone) "(este projeto é uma história avulsa, sem feature)" else Context.artifact(project_id, "feature.html")
        var draft = CommonDrafts.plano(project_id, autorrevisao, historia, Context.artifact(project_id, historia_rel), feature, titulo, self.tech(project_id, ContextSlice.refs(historia)), historia_id)
        return Drafts.with(draft, {plano_rel: "${folder}plano.html", assets_prefix: location.assets_prefix})
    }
}

export tool DeliveryCommits {
    of(kind: DeliveryArtifact, project_id: string, mode: string, historia_id: string, draft: Draft): any -> match kind {
        DeliveryArtifact.brief      -> ArtifactCommit.brief(project_id, draft)
        DeliveryArtifact.requisitos -> ArtifactCommit.requisitos(project_id, draft)
        DeliveryArtifact.adr        -> ArtifactCommit.adr(project_id, draft)
        DeliveryArtifact.der        -> ArtifactCommit.der(project_id, draft)
        DeliveryArtifact.diagramas  -> ArtifactCommit.diagramas(project_id, draft)
        DeliveryArtifact.feature    -> self.feature(project_id, draft)
        DeliveryArtifact.historia   -> self.historia(project_id, draft)
        DeliveryArtifact.historias  -> ArtifactCommit.historias(project_id, "", draft)
        DeliveryArtifact.plano      -> self.plano(project_id, mode, historia_id, draft)
    }

    // O titulo do artefato final e o nome do projeto.
    final(project_id: string, mode: string, body: string, draft: Draft): any -> {
        var title = html.escape(json.parse(fs.read(Paths.project_file(project_id))).name)
        ArtifactCommit.page(project_id, "${mode}.html", title, body, draft.data, draft)
        return {artifact: mode, path: "artifacts/${mode}.html"}
    }

    feature(project_id: string, draft: Draft): any ->
        self.final(project_id, "feature", ArtifactBody.feature(draft.data), draft)

    historia(project_id: string, draft: Draft): any -> {
        SpecFiles.write(project_id, "", draft.data)
        return self.final(project_id, "historia", ArtifactBody.historia(draft.data), draft)
    }

    // Caminhos do rascunho quando ele os traz; senao recalculados — ver
    // DiscoveryCommits.historias.
    plano(project_id: string, mode: string, historia_id: string, draft: Draft): any -> {
        var plano_rel = draft.data?.plano_rel
        var assets_prefix = draft.data?.assets_prefix
        if (plano_rel == null || assets_prefix == null) {
            var location = DeliveryDrafts.plano_location(project_id, mode, historia_id)
            plano_rel = "${location.folder}plano.html"
            assets_prefix = location.assets_prefix
        }
        var result = ArtifactCommit.plano(project_id, plano_rel, assets_prefix, draft)
        result["historia_id"] = historia_id
        return result
    }
}
