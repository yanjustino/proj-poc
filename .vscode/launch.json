{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Debugs the actual .app bundle's executable (built by the
            // preLaunchTask via `wails build -debug`), not a bare `go build`
            // binary — an unbundled binary has no NSBundle identity, which
            // makes macOS silently no-op native dialogs (e.g. the file
            // picker behind "+ Adicionar fontes") instead of showing them.
            "name": "Run App (macOS)",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/app/build/bin/senpai-app.app/Contents/MacOS/app",
            "cwd": "${workspaceFolder}/app",
            "preLaunchTask": "build app bundle (debug)"
        },
        {
            // Windows doesn't have macOS's NSBundle-identity problem (no
            // cgo in the windows frontend, and native dialogs are plain
            // Win32 calls that work from any .exe) — a bare `go build`
            // binary is enough, no bundle/packaging step needed here.
            "name": "Run App (Windows)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/app",
            "cwd": "${workspaceFolder}/app",
            "buildFlags": "-tags dev",
            "preLaunchTask": "build frontend"
        }
    ]
}