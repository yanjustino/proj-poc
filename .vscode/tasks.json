{
    "version": "2.0.0",
    "tasks": [
        {
            // Keeps app/embedded/bin/mhl-<goos>-<goarch> in sync with the
            // `mhl` on PATH before every local debug build — a stale
            // vendored binary otherwise silently exercises whatever mhl
            // version was last copied there (real incident: it sat on
            // v1.4.0-beta.14, missing `stdin:` support, for a day after the
            // dev `mhl` install moved to v1.4.0-beta.15 — the app kept
            // building and running fine, just against the wrong runtime,
            // with no error pointing at the actual cause). See
            // app/embedded/sync-dev-mhl.sh and README.md. Windows command
            // assumes `bash` is reachable (Git for Windows) — adjust if
            // your Windows dev setup doesn't have it on PATH.
            "label": "sync vendored mhl binary",
            "type": "shell",
            "command": "bash embedded/sync-dev-mhl.sh",
            "windows": {
                "command": "bash embedded/sync-dev-mhl.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "problemMatcher": []
        },
        {
            "label": "build frontend",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/app/frontend"
            },
            "dependsOn": ["sync vendored mhl binary"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            // Builds the real .app bundle (not a bare `go build` binary) in
            // debug mode and re-signs it. A raw unbundled binary has no
            // NSBundle identity, which makes macOS silently no-op native
            // sheets (NSOpenPanel via beginSheetModalForWindow) instead of
            // showing them — e.g. "+ Adicionar fontes" looked completely
            // broken (resolved instantly with an empty selection, no error)
            // when run that way.
            //
            // `wails build`'s own ad-hoc codesign step is flaky here: macOS
            // (Spotlight/LaunchServices) tags the freshly written bundle
            // with xattrs (com.apple.provenance etc.) that codesign then
            // rejects ("resource fork ... not allowed") — happens even with
            // -clean once the bundle has been `open`ed before. `xattr -cr`
            // + a manual ad-hoc re-sign after the fact papers over it
            // unconditionally (the `;` lets this run even when wails
            // build's own signing step already failed).
            //
            // `rm -rf` the previous bundle before building (not just relying
            // on `wails build -clean`, which cleans its own intermediate
            // artifacts, not the output bundle itself): if `wails build`
            // then fails for a real reason (a compile error — e.g. an .mh
            // syntax error the vendored mhl can't parse), there is no old
            // .app left for `xattr`/`codesign` to silently re-sign and hand
            // to the debugger — they fail on the missing path instead, the
            // task exits non-zero (last command in the chain), and VS Code
            // aborts the launch instead of quietly debugging yesterday's
            // stale build.
            //
            // `pkill -f` first, before any of that: this task always builds
            // a genuinely fresh bundle, but if a previous run of the app is
            // still open (its window just never got closed — starting a new
            // debug session here does NOT kill an already-running instance,
            // whether that one was launched by the debugger or by
            // double-clicking the .app), you keep looking at yesterday's
            // frontend/workflow logic in that stale window while a correct
            // new binary sits unused on disk — this bit twice in the same
            // session before the cause was found (stale bundle timestamp,
            // confirmed via `strings` on the binary). Matches by the
            // bundle's own executable path, not a generic process name, so
            // it can never kill something unrelated. `2>/dev/null` +
            // relying on `;` (not `&&`) after it: pkill exits non-zero when
            // nothing matched (nothing was running) — that must never abort
            // the rest of the build.
            "label": "build app bundle (debug)",
            "type": "shell",
            "command": "pkill -f 'senpai-app.app/Contents/MacOS/app' 2>/dev/null; rm -rf build/bin/senpai-app.app; CGO_LDFLAGS=\"-framework UniformTypeIdentifiers\" /Users/yanjustino/go/bin/wails build -debug -clean; xattr -cr build/bin/senpai-app.app && codesign --force --deep -s - build/bin/senpai-app.app",
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "dependsOn": ["sync vendored mhl binary"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$go"]
        }
    ]
}
