// Demonstracao IT26019 — executa o gate de prontidao do SENPAI sobre um
// work-item SINTETICO (nenhum dado real) e deixa o pacote de handoff gerado
// em projects/it26019-demo/handoff para inspecao. Para reproduzir: copie este
// arquivo para workflows/shared/artifacts/ de uma COPIA do repositorio e rode
// `mhl test <copia>/workflows/shared/artifacts/it26019_demo.mh`.

import { Paths } from "../core/paths.mh"
import { Fixture } from "../core/fixture.mh"
import { Readiness } from "readiness.mh"
import { FeatureReview } from "feature_review.mh"
import { Handoff } from "handoff.mh"
import { Require } from "require.mh"

tool Demo {
    internal historia(titulo: string, cas: number, cenarios: any[], deps: string[], gaps: any[]): any -> {
        var criterios = []
        var n = 1
        while (n <= cas) {
            criterios += [{texto: "critério ${n} de " + titulo, fontes: ["requisitos/FR-001"]}]
            n = n + 1
        }
        return {
            titulo, story_type: "historia_usuario", nature: "funcional", work_item_type: "historia",
            como: "investidor", quero: "acompanhar minhas ordens", para: "decidir com informação",
            resultado_tecnico: "", habilita: "", evidenciado_por: "", subclassification: "interface",
            criterios_aceite: criterios, cenarios,
            rastreabilidade: {requisitos: ["FR-001"], atributos: [], adrs: [], entidades: [], conteineres: []},
            contratos: {endpoints: [], eventos: [], integracoes: []},
            dependencias_impedimentos: deps.map((d) -> {tipo: "depende_de", destino: d, descricao: ""}),
            gaps, questoes_abertas: [],
        }
    }

    internal cenario(titulo: string, cas: string[]): any -> {titulo, dado: ["uma ordem registrada"], quando: ["o investidor consulta"], entao: ["a ordem é exibida"], criterios: cas, fontes: []}

    internal plano(cas: number, com_teste: bool): any -> {
        var refs = []
        var n = 1
        while (n <= cas) {
            refs += ["CA${n}"]
            n = n + 1
        }
        var tarefas = [{id: "T1", titulo: "Implementar consulta", tipo: "implementacao", criterios: refs, depende_de: [], descricao: ""}]
        if (com_teste) tarefas = [{id: "T0", titulo: "Testes de aceitação", tipo: "teste", criterios: refs, depende_de: [], descricao: ""}, {id: "T1", titulo: "Implementar consulta", tipo: "implementacao", criterios: refs, depende_de: ["T0"], descricao: ""}]
        return {abordagem: "Consulta síncrona", criterios_total: cas, tarefas, testes: [], avisos_contexto: []}
    }
}

test IT26019Demo {
    describe gate_classifica_bloqueia_e_exporta_com_motivos {
        var id = Fixture.project("it26019-demo")
        fs.write(Paths.project_file(id), json.stringify({id, name: "Demonstração IT26019 (sintético)", type: "oportunidade"}))
        Fixture.artifact(id, "features/FT001-consulta/feature.json", json.stringify({titulo: "Consulta de ordens"}))
        Fixture.artifact(id, "features/FT002-legado/feature.json", json.stringify({titulo: "Relatório legado"}))

        // US001: completa — 2 critérios, 2 cenários, plano com testes.
        Fixture.artifact(id, "historias/FT001-consulta/US001-consultar-ordem/historia.json", json.stringify(Demo.historia("Consultar ordem", 2, [Demo.cenario("Ordem existente", ["CA1"]), Demo.cenario("Ordem filtrada", ["CA2"])], [], [])))
        Fixture.artifact(id, "historias/FT001-consulta/US001-consultar-ordem/plano.json", json.stringify(Demo.plano(2, true)))
        // US002: CA2 sem cenario, cenario citando CA7 inexistente e plano sem tarefa de teste.
        Fixture.artifact(id, "historias/FT001-consulta/US002-cancelar-ordem/historia.json", json.stringify(Demo.historia("Cancelar ordem", 2, [Demo.cenario("Cancelamento", ["CA1", "CA7"])], [], [])))
        Fixture.artifact(id, "historias/FT001-consulta/US002-cancelar-ordem/plano.json", json.stringify(Demo.plano(2, false)))
        // US003: completa, mas com lacuna e dependente de US002 (nao pronta).
        Fixture.artifact(id, "historias/FT001-consulta/US003-notificar-execucao/historia.json", json.stringify(Demo.historia("Notificar execução", 1, [Demo.cenario("Execução", ["CA1"])], ["Cancelar ordem"], [{texto: "canal de notificação não definido", fontes: ["gap"]}])))
        Fixture.artifact(id, "historias/FT001-consulta/US003-notificar-execucao/plano.json", json.stringify(Demo.plano(1, true)))
        // US004: sem plano de implementacao.
        Fixture.artifact(id, "historias/FT001-consulta/US004-exportar-extrato/historia.json", json.stringify(Demo.historia("Exportar extrato", 1, [Demo.cenario("Extrato", ["CA1"])], [], [])))
        // FT002 rejeitada pelo PO: suas historias nao seguem adiante.
        Fixture.artifact(id, "historias/FT002-legado/US001-relatorio/historia.json", json.stringify(Demo.historia("Relatório", 1, [Demo.cenario("R", ["CA1"])], [], [])))
        Fixture.artifact(id, "historias/FT002-legado/US001-relatorio/plano.json", json.stringify(Demo.plano(1, true)))
        FeatureReview.decide(id, "FT001", "aprovar", "")
        FeatureReview.decide(id, "FT002", "rejeitar", "fora do escopo do MVP")

        // 1. Classificacao deterministica (sem LLM).
        var items = Readiness.batch(id)
        fs.write(Paths.root(id) + "/readiness.json", json.stringify(items))
        var by = (t) -> items.filter((i) -> i.titulo == t)[0]
        are_equal(by("Consultar ordem").status, "pronta")
        are_equal(by("Cancelar ordem").status, "nao_pronta")
        are_equal(by("Notificar execução").status, "pronta_com_ressalvas")
        are_equal(by("Exportar extrato").status, "nao_pronta")
        is_true(by("Cancelar ordem").bloqueios.join(" ").contains("Critério de aceite sem cenário: CA2"))
        is_true(by("Cancelar ordem").bloqueios.join(" ").contains("CA7"))
        is_true(by("Cancelar ordem").bloqueios.join(" ").contains("Nenhuma tarefa de teste"))
        is_true(by("Notificar execução").ressalvas.join(" ").contains("Depende de “Cancelar ordem”"))
        is_true(by("Exportar extrato").bloqueios.join(" ").contains("Sem plano"))

        // 2. Feature rejeitada: geracao/aprovacao de historias e planos falha.
        var gate = ""
        try { FeatureReview.ensure_not_rejected(id, "FT002-legado") } catch (e) { gate = "${e}" }
        is_true(gate.contains("foi rejeitada"))

        // 3. Predecessor obrigatorio ausente: falha ANTES de qualquer chamada ao LLM.
        var req = ""
        try { Require.artifact(id, "brief", "requisitos") } catch (e) { req = "${e}" }
        is_true(req.contains("gere 'brief' antes de 'requisitos'"))

        // 4. Handoff: FT002 excluida; nao prontas exportadas com o motivo do bloqueio.
        var r = Handoff.build(id)
        are_equal(r.total, 4)
        are_equal(r.nao_prontas, 2)
        is_false(dir.exists(Paths.root(id) + "/handoff/specs/FT002-legado"))
        is_true(fs.read(Paths.root(id) + "/handoff/specs/FT001-consulta/US002-cancelar-ordem/spec.md").contains("Definition of Ready: **Não pronta**"))
        is_true(fs.read(Paths.root(id) + "/handoff/AGENTS.md").contains("não implemente uma história bloqueada sem essa confirmação"))
        fs.write(Paths.root(id) + "/demo-resultado.json", json.stringify({readiness: items, handoff: r, gate_feature_rejeitada: gate, gate_predecessor: req}))
    }
}
