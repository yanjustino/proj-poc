// tool RepoSnapshot — retrato AS-IS de um repositorio de codigo, gravado em
// raw/ como fontes Markdown comuns (Wiki action snapshot_repo). Nao traz o
// repositorio inteiro: traz o que ele DIZ sobre o sistema que ja existe —
// estrutura e linguagens, stack e dependencias, regras e decisoes — para
// servir de base AS-IS a uma feature nova. O ingest classifica essas fontes
// como `sistema_atual` (ver ingest.prompt.md).
//
// Deterministico, sem LLM: a LLM nunca recebe o caminho do repositorio nem
// ferramentas para explora-lo (agents.mh) — so o texto que este tool monta.
//
// Le via git (`git ls-files`, so arquivos versionados — o .gitignore ja vem
// respeitado de graca) com `cmd.exec`, o mesmo padrao do pdftotext em
// RawExtract: as ops nativas `git.*` do MHL nao tem ls-files nem as opcoes
// de formato que o retrato precisa, e chamam o mesmo binario `git` por baixo.
// Escolher uma subpasta de um monorepo funciona: ls-files com -C nela lista
// so o que esta abaixo dela, com caminhos relativos a ela.
//
// Seguranca:
//   - repo_path tem de ser absoluto: um caminho relativo resolveria contra o
//     CWD do mhl, que e o diretorio de dados com TODOS os work-items. O app
//     (SelectRepoDir em app/repo_source.go) tambem recusa pastas dentro dele;
//   - arquivos com cara de segredo (.env, chaves, credenciais, tfstate) nunca
//     sao lidos, nem aparecem pelo nome;
//   - nos arquivos lidos, uma linha que parece atribuir um segredo e omitida
//     inteira (o MHL so tem `matches`, sem replace por regex).
//
// Cada fonte tem teto de tamanho: o ingest manda o texto inteiro para a LLM.

import { Paths } from "../core/paths.mh"
import { Markdown } from "../core/markdown.mh"
import { LiteralBlocks } from "literal_blocks.mh"

export tool RepoSnapshot {
    internal max_file_chars(): number -> 8000
    internal max_source_chars(): number -> 60000
    internal max_tree_lines(): number -> 120
    internal tree_depth(): number -> 3
    internal log_entries(): number -> 15

    // ---- caminhos ----------------------------------------------------------

    is_absolute(path: string): bool ->
        path.starts_with("/") || path.matches("^[A-Za-z]:[\\\\/].*") || path.starts_with("\\\\")

    base_name(path: string): string -> {
        var parts = path.replace("\\", "/").split("/").filter((p) -> !p.is_empty())
        return if (parts.is_empty()) "" else parts[parts.size() - 1]
    }

    internal lower_base(path: string): string -> self.base_name(path).to_lower()

    internal extension(path: string): string -> {
        var name = self.lower_base(path)
        var parts = name.split(".")
        return if (parts.size() < 2 || name.starts_with(".") && parts.size() == 2) "" else "." + parts[parts.size() - 1]
    }

    // Nome de arquivo seguro para raw/: so letras, digitos, espaco, . _ -
    safe_name(name: string): string -> {
        var out = ""
        for (var ch in name.split("")) {
            out = out + (if (ch.matches("^[A-Za-z0-9 ._-]$")) ch else "-")
        }
        while (out.starts_with(".") || out.starts_with("-")) out = out.substring(1, out.size())
        if (out.size() > 60) out = out.substring(0, 60)
        return if (out.trim().is_empty()) "repositorio" else out.trim()
    }

    // Pastas de terceiros/geradas que, mesmo versionadas, nao dizem nada
    // sobre o sistema — fora das linguagens e das buscas por manifesto/regra.
    is_vendored(path: string): bool -> {
        var p = "/" + path.replace("\\", "/").to_lower()
        for (var seg in ["/node_modules/", "/vendor/", "/dist/", "/build/", "/target/", "/bin/", "/obj/", "/.venv/", "/venv/", "/__pycache__/", "/third_party/", "/wailsjs/"]) {
            if (p.contains(seg)) return true
        }
        return p.ends_with(".min.js") || p.ends_with(".min.css") || p.ends_with(".lock") || p.ends_with("-lock.json") || p.ends_with(".sum")
    }

    is_secret_path(path: string): bool -> {
        var name = self.lower_base(path)
        if (name.starts_with(".env")) return true
        for (var ext in [".pem", ".key", ".p12", ".pfx", ".jks", ".keystore", ".tfstate", ".tfvars", ".kdbx", ".asc", ".gpg"]) {
            if (name.ends_with(ext)) return true
        }
        for (var part in ["id_rsa", "id_ed25519", "id_ecdsa", "credential", "secret", ".npmrc", ".pypirc", ".netrc", ".htpasswd", "kubeconfig"]) {
            if (name.contains(part)) return true
        }
        return false
    }

    // ---- segredos dentro do texto -----------------------------------------

    // `matches` casa a string INTEIRA (ancorado) — por isso o `.*` nas pontas.
    looks_like_secret(line: string): bool -> {
        var lower = line.to_lower()
        if (lower.contains("-----begin") && lower.contains("private key")) return true
        if (line.matches(".*AKIA[0-9A-Z]{16}.*")) return true
        if (line.matches(".*gh[pousr]_[A-Za-z0-9]{20,}.*")) return true
        if (line.matches(".*xox[abpsr]-[A-Za-z0-9-]{10,}.*")) return true
        if (line.matches(".*sk-[A-Za-z0-9_-]{20,}.*")) return true
        // chave = valor literal com cara de segredo; `${{ secrets.X }}`,
        // `$VAR`, `<placeholder>` e `{{ }}` nao contam — nao ha valor ali.
        return lower.matches(".*(api[_-]?key|secret|token|passw(or)?d|pwd|private[_-]?key|access[_-]?key|client[_-]?secret|connection[_-]?string|auth)[a-z_]*[\"']?\\s*[:=]\\s*[\"']?[^\\s\"'$<{%]{8,}.*")
    }

    redact(text: string): string ->
        text.replace("\r\n", "\n").split("\n")
            .map((line) -> if (self.looks_like_secret(line)) "[linha omitida pelo Senpai: possivel segredo]" else line)
            .join("\n")

    capped(text: string, limit: number): string ->
        if (text.size() <= limit) text else text.substring(0, limit) + "\n[... cortado pelo Senpai: arquivo maior que " + limit + " caracteres]"

    // ---- classificacao -----------------------------------------------------

    language_of(path: string): string -> {
        var name = self.lower_base(path)
        if (name == "dockerfile" || name.starts_with("dockerfile.")) return "Dockerfile"
        if (name == "makefile") return "Makefile"
        return match self.extension(path) {
            ".go" -> "Go"
            ".py" -> "Python"
            ".cs" -> "C#"
            ".java" -> "Java"
            ".kt" -> "Kotlin"
            ".kts" -> "Kotlin"
            ".js" -> "JavaScript"
            ".jsx" -> "JavaScript"
            ".mjs" -> "JavaScript"
            ".cjs" -> "JavaScript"
            ".ts" -> "TypeScript"
            ".tsx" -> "TypeScript"
            ".rb" -> "Ruby"
            ".php" -> "PHP"
            ".rs" -> "Rust"
            ".swift" -> "Swift"
            ".c" -> "C"
            ".h" -> "C/C++"
            ".cpp" -> "C++"
            ".hpp" -> "C++"
            ".scala" -> "Scala"
            ".dart" -> "Dart"
            ".ex" -> "Elixir"
            ".exs" -> "Elixir"
            ".sh" -> "Shell"
            ".ps1" -> "PowerShell"
            ".sql" -> "SQL"
            ".html" -> "HTML"
            ".css" -> "CSS"
            ".scss" -> "CSS"
            ".vue" -> "Vue"
            ".svelte" -> "Svelte"
            ".tf" -> "Terraform"
            ".proto" -> "Protocol Buffers"
            ".graphql" -> "GraphQL"
            ".feature" -> "Gherkin"
            ".mh" -> "MHL"
            ".md" -> "Markdown"
            ".yml" -> "YAML"
            ".yaml" -> "YAML"
            ".json" -> "JSON"
            ".xml" -> "XML"
            _ -> ""
        }
    }

    // Linguagens com a contagem de arquivos, da mais presente para a menos.
    // Ordena os nomes e conta sequencias iguais num passo so — repositorios
    // grandes tem dezenas de milhares de arquivos.
    languages(files: string[]): any[] -> {
        var names = files.filter((f) -> !self.is_vendored(f)).map((f) -> self.language_of(f)).filter((l) -> !l.is_empty()).sort_by((l) -> l)
        var out = []
        var current = ""
        var count = 0
        for (var name in names) {
            if (name != current) {
                if (count > 0) out += [{language: current, files: count}]
                current = name
                count = 0
            }
            count = count + 1
        }
        if (count > 0) out += [{language: current, files: count}]
        return out.sort_by((l) -> 0 - l.files)
    }

    internal is_manifest(path: string): bool -> {
        var p = path.replace("\\", "/").to_lower()
        var name = self.lower_base(path)
        if (["go.mod", "package.json", "pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "requirements.txt", "pyproject.toml", "pipfile", "setup.py", "gemfile", "cargo.toml", "composer.json", "mix.exs", "pubspec.yaml", "makefile", "wails.json", "docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml", ".gitlab-ci.yml", "jenkinsfile", "azure-pipelines.yml", "bitbucket-pipelines.yml", "serverless.yml", "chart.yaml"].contains(name)) return true
        if (name == "dockerfile" || name.starts_with("dockerfile.")) return true
        if (name.ends_with(".csproj") || name.ends_with(".sln") || name.ends_with(".fsproj")) return true
        if (p.starts_with(".github/workflows/") && (name.ends_with(".yml") || name.ends_with(".yaml"))) return true
        return name.ends_with(".tf")
    }

    internal is_rule_doc(path: string): bool -> {
        var p = path.replace("\\", "/").to_lower()
        var name = self.lower_base(path)
        var depth = p.split("/").size()
        if (depth <= 3 && ["readme.md", "readme", "readme.txt", "architecture.md", "contributing.md", "agents.md", "claude.md", "gemini.md", "conventions.md", "styleguide.md"].contains(name)) return true
        if ([".editorconfig", ".cursorrules", ".golangci.yml", ".golangci.yaml", ".eslintrc", ".eslintrc.json", ".eslintrc.js", ".eslintrc.cjs", "eslint.config.js", "eslint.config.mjs", ".prettierrc", ".prettierrc.json", "ruff.toml", ".rubocop.yml", "stylecop.json", "checkstyle.xml", "detekt.yml"].contains(name)) return true
        if (p == ".github/copilot-instructions.md" || p.starts_with(".cursor/rules/") || p.starts_with(".devin/")) return true
        if (!name.ends_with(".md")) return false
        return p.contains("/adr/") || p.starts_with("adr/") || p.contains("/adrs/") || p.starts_with("adrs/") || p.contains("/decisions/") || p.contains("architecture")
    }

    internal is_entrypoint(path: string): bool -> {
        var name = self.lower_base(path)
        if (["main.go", "main.py", "app.py", "manage.py", "wsgi.py", "asgi.py", "program.cs", "startup.cs", "main.ts", "main.js", "index.ts", "index.js", "server.ts", "server.js", "app.ts", "app.js", "main.rs", "lib.rs", "main.kt", "application.java", "main.java", "main.swift", "main.dart"].contains(name)) return true
        return name.ends_with("application.java") || name.ends_with("application.kt")
    }

    // ---- arvore ------------------------------------------------------------

    internal prefix(path: string, depth: number): string -> {
        var parts = path.replace("\\", "/").split("/")
        if (parts.size() <= depth) return ""
        return parts[0..depth].join("/") + "/"
    }

    // Pastas ate tree_depth niveis com a contagem de arquivos abaixo de
    // cada uma, mais os arquivos soltos na raiz — em texto puro indentado
    // (como a saida de `tree`), para ir num bloco cercado: o visualizador da
    // wiki (WikiHtmlExport.md_to_html) so entende listas `- ` sem
    // indentacao, e descartaria as subpastas de uma lista aninhada.
    // Caminhos com o mesmo
    // prefixo ficam contiguos numa lista ordenada, entao cada nivel e uma
    // passada de contagem de sequencias (sem mapa por pasta).
    tree(files: string[]): string -> {
        var sorted = files.sort_by((f) -> f)
        var entries = []
        for (var depth in [1, 2, 3].filter((d) -> d <= self.tree_depth())) {
            var current = ""
            var count = 0
            for (var f in sorted) {
                var pre = self.prefix(f, depth)
                if (pre != current) {
                    if (count > 0 && !current.is_empty()) entries += [{path: current, depth, files: count}]
                    current = pre
                    count = 0
                }
                count = count + 1
            }
            if (count > 0 && !current.is_empty()) entries += [{path: current, depth, files: count}]
        }
        var lines = []
        for (var e in entries.sort_by((e) -> e.path).filter((e) -> e.depth == 1 || !self.is_vendored(e.path))) {
            var indent = ""
            var i = 1
            while (i < e.depth) {
                indent = indent + "  "
                i = i + 1
            }
            var segments = e.path.split("/").filter((p) -> !p.is_empty())
            lines += [indent + segments[segments.size() - 1] + "/  (" + e.files + (if (e.files == 1) " arquivo)" else " arquivos)")]
        }
        var root_files = sorted.filter((f) -> !f.replace("\\", "/").contains("/") && !self.is_secret_path(f))
        for (var f in root_files) lines += [f]
        if (lines.size() > self.max_tree_lines()) {
            var hidden = lines.size() - self.max_tree_lines()
            lines = lines[0..self.max_tree_lines()] + ["… mais " + hidden + " entradas (pastas mais profundas omitidas)"]
        }
        return lines.join("\n")
    }

    // ---- git ---------------------------------------------------------------

    internal git(repo: string, args: string[]): string -> {
        var result = cmd.exec(["git", "-C", repo, "-c", "core.quotePath=false"] + args, timeout: 60s)
        if (result.exit_code != 0) fail("git " + args.join(" ") + " falhou em '" + repo + "': " + result.stderr.trim())
        return result.stdout
    }

    // URL do remote `origin` sem credenciais: um clone local pode ter sido
    // feito com `https://token@host/...`, e o retrato vai parar num prompt.
    // A forma SSH curta (git@host:org/repo) nao tem segredo — o "git" e o
    // usuario fixo do servidor.
    public_url(remote: string): string -> {
        var u = remote.trim()
        var parts = u.split("://")
        if (parts.size() != 2) return u
        var rest = parts[1].split("/")
        var authority = rest[0]
        if (authority.contains("@")) {
            var at = authority.split("@")
            authority = at[at.size() - 1]
        }
        return parts[0] + "://" + authority + (if (rest.size() > 1) "/" + rest[1..rest.size()].join("/") else "")
    }

    internal origin(repo: string): string -> {
        var result = cmd.exec(["git", "-C", repo, "remote", "get-url", "origin"], timeout: 10s)
        return if (result.exit_code == 0) self.public_url(result.stdout) else ""
    }

    internal non_empty_lines(text: string): string[] ->
        text.replace("\r\n", "\n").split("\n").filter((l) -> !l.trim().is_empty())

    inspect(repo_path: string): any -> {
        if (!self.is_absolute(repo_path)) fail("repo_path precisa ser um caminho absoluto: '" + repo_path + "'")
        if (repo_path.replace("\\", "/").split("/").contains("..")) fail("repo_path nao pode conter '..': '" + repo_path + "'")
        if (!dir.exists(repo_path)) fail("pasta do repositorio nao encontrada: '" + repo_path + "'")
        try {
            cmd.exec(["git", "--version"], timeout: 10s)
        } catch (err) {
            fail("Git nao encontrado: instale o git para importar um repositorio (" + err + ")")
        }
        var files = self.non_empty_lines(self.git(repo_path, ["ls-files"]))
        if (files.is_empty()) fail("nenhum arquivo versionado em '" + repo_path + "' — a pasta e um repositorio git com commits?")
        return {
            name: self.base_name(repo_path),
            origin: self.origin(repo_path),
            commit: self.git(repo_path, ["rev-parse", "--short", "HEAD"]).trim(),
            branch: self.git(repo_path, ["rev-parse", "--abbrev-ref", "HEAD"]).trim(),
            committed_at: self.git(repo_path, ["log", "-1", "--format=%cI"]).trim(),
            dirty: self.non_empty_lines(self.git(repo_path, ["status", "--porcelain", "--", "."])).size(),
            history: self.non_empty_lines(self.git(repo_path, ["log", "-" + self.log_entries(), "--format=%h %cs %s", "--", "."])),
            files,
        }
    }

    // Percentual inteiro (truncado): o MHL nao tem round/floor para number.
    percent(part: number, total: number): string -> ("" + (part * 100 / total)).split(".")[0]

    // ---- fontes ------------------------------------------------------------

    internal header(info: any, topic: string): string ->
        "# " + info.name + " — " + topic + "\n\n" +
        "> Tipo de fonte: retrato AS-IS de um repositório de código, gerado pelo Senpai a partir dos arquivos versionados. " +
        "Descreve o sistema como ele existe hoje (sistema atual), não um pedido de mudança.\n" +
        "> Repositório: `" + info.name + "`" + (if (info.origin.is_empty()) "" else " (" + info.origin + ")") + " · branch `" + info.branch + "` · commit `" + info.commit + "` de " + info.committed_at +
        (if (info.dirty > 0) " · " + info.dirty + " arquivo(s) com alterações não commitadas não refletidas aqui" else "") + "\n\n"

    structure_source(info: any): string -> {
        var langs = self.languages(info.files)
        var total = langs.map((l) -> l.files).reduce((a, b) -> a + b, 0)
        var lang_lines = langs.map((l) -> "- " + l.language + ": " + l.files + (if (l.files == 1) " arquivo" else " arquivos") + (if (total > 0) " (" + self.percent(l.files, total) + "%)" else ""))
        var entry = info.files.filter((f) -> self.is_entrypoint(f) && !self.is_vendored(f))
        // Tudo abaixo do cabecalho e deterministico e vai literal para a
        // pagina da wiki (LiteralBlocks) — a LLM le para entender e extrair
        // modulos, mas nao precisa (nem consegue) reproduzir a arvore.
        // Sem crases nas listas: o visualizador da wiki nao tem formatacao
        // inline e as mostraria como caractere.
        var body = "## Visão geral\n\n" + info.files.size() + " arquivos versionados.\n\n"
        body = body + "## Linguagens\n\n" + (if (lang_lines.is_empty()) "Nenhuma linguagem reconhecida." else lang_lines.join("\n")) + "\n\n"
        body = body + "## Árvore de pastas\n\n" + Markdown.code_block("text", self.tree(info.files)) + "\n\n"
        if (!entry.is_empty()) {
            var shown = if (entry.size() > 30) entry[0..30] else entry
            body = body + "## Pontos de entrada prováveis\n\n" + Markdown.list(shown) + "\n\n"
        }
        if (!info.history.is_empty()) {
            body = body + "## Atividade recente (últimos commits)\n\n" + Markdown.list(info.history) + "\n"
        }
        return self.header(info, "estrutura") + LiteralBlocks.wrap(body) + "\n"
    }

    // Concatena arquivos do repositorio (redigidos e cortados) ate o teto da
    // fonte; o que nao couber vira so uma lista de nomes no fim.
    files_source(info: any, repo_path: string, topic: string, intro: string, paths: string[]): string -> {
        var out = self.header(info, topic) + intro + "\n\n"
        var skipped = []
        for (var path in paths) {
            // Sem `continue` no MHL: um arquivo ilegivel vira bloco vazio,
            // que cai no mesmo ramo de "nao incluido" do teto de tamanho.
            var block = ""
            try {
                var text = fs.read(fs.join(repo_path, path))
                block = "## `" + path + "`\n\n" + self.embed(path, self.capped(self.redact(text), self.max_file_chars())) + "\n\n"
            } catch (err) {
                block = ""
            }
            if (block.is_empty() || out.size() + block.size() > self.max_source_chars()) {
                skipped += [path]
            } else {
                out = out + block
            }
        }
        if (!skipped.is_empty()) {
            out = out + "## Arquivos não incluídos (limite de tamanho)\n\n" + Markdown.list(skipped.map((p) -> "`" + p + "`")) + "\n"
        }
        return out
    }

    // Documento .md entra como texto, nao como bloco de codigo: o ingest
    // copia blocos de codigo literalmente para code_snippets, e um README nao
    // e codigo. Os titulos descem dois niveis para ficarem abaixo do
    // "## `caminho`" deste retrato. O resto (manifestos, configs) vai cercado.
    embed(path: string, text: string): string ->
        if (self.extension(path) == ".md" || self.extension(path) == ".mdc")
            text.split("\n").map((line) -> if (line.starts_with("#")) "##" + line else line).join("\n").trim()
        else
            Markdown.code_block(self.fence_language(path), text)

    internal fence_language(path: string): string -> {
        var lang = self.language_of(path).to_lower()
        return match lang {
            "c#" -> "csharp"
            "c/c++" -> "c"
            "c++" -> "cpp"
            "protocol buffers" -> "protobuf"
            _ -> lang
        }
    }

    readable(files: string[], predicate: any): string[] ->
        files.filter((f) -> !self.is_vendored(f) && !self.is_secret_path(f) && predicate(f))

    // Nome livre em raw/ — nunca sobrescreve uma fonte (nem um retrato
    // anterior do mesmo repositorio: o ingest e marcado por nome de arquivo).
    internal unique_name(project_id: string, stem: string): string -> {
        var name = stem + ".md"
        var i = 2
        while (fs.exists(Paths.raw(project_id, name))) {
            name = stem + " (" + i + ").md"
            i = i + 1
        }
        return name
    }

    // Grava as fontes do retrato em raw/ e devolve {repo, commit, sources}.
    // Uma fonte sem conteudo (repositorio sem manifestos ou sem documentos
    // de regra) nao e gravada.
    write(project_id: string, repo_path: string): any -> {
        var info = self.inspect(repo_path)
        var stem = self.safe_name(info.name)
        var sources = [{topic: "estrutura", text: self.structure_source(info)}]
        var manifests = self.readable(info.files, (f) -> self.is_manifest(f))
        if (!manifests.is_empty()) {
            sources += [{topic: "stack e dependencias", text: self.files_source(info, repo_path, "stack e dependências",
                "Manifestos de build, dependências, contêineres e pipelines de CI encontrados no repositório.", manifests)}]
        }
        var rules = self.readable(info.files, (f) -> self.is_rule_doc(f))
        if (!rules.is_empty()) {
            sources += [{topic: "regras e decisoes", text: self.files_source(info, repo_path, "regras e decisões",
                "Documentação, convenções do time, instruções para agentes, configurações de lint e registros de decisão (ADRs) do repositório.", rules)}]
        }
        dir.create(Paths.raw_dir(project_id))
        var names = []
        for (var s in sources) {
            var name = self.unique_name(project_id, stem + " — " + s.topic)
            fs.write(Paths.raw(project_id, name), s.text)
            names += [name]
        }
        return {repo: info.name, commit: info.commit, sources: names}
    }
}

test RepoSnapshotSpec {
    describe accepts_only_absolute_paths {
        is_true(RepoSnapshot.is_absolute("/Users/ana/dev/app"))
        is_true(RepoSnapshot.is_absolute("C:\\dev\\app"))
        is_true(RepoSnapshot.is_absolute("D:/dev/app"))
        is_false(RepoSnapshot.is_absolute("projects/outro-id"))
        is_false(RepoSnapshot.is_absolute("./app"))
        is_false(RepoSnapshot.is_absolute(""))
    }

    describe safe_name_keeps_a_readable_filename {
        are_equal(RepoSnapshot.safe_name("checkout-api"), "checkout-api")
        are_equal(RepoSnapshot.safe_name("../etc"), "etc")
        are_equal(RepoSnapshot.safe_name("a/b:c"), "a-b-c")
        are_equal(RepoSnapshot.safe_name(""), "repositorio")
    }

    describe secret_files_are_recognized_by_name {
        for (var p in [".env", "config/.env.production", "certs/server.pem", "deploy/id_rsa", "infra/terraform.tfstate", "aws-credentials.json", "app/secrets.yaml"]) {
            is_true(RepoSnapshot.is_secret_path(p))
        }
        for (var p in ["README.md", "src/main.go", "docs/adr/001.md", ".env-example-guide.txt-not"]) {
            is_true(RepoSnapshot.is_secret_path(p) == p.starts_with(".env"))
        }
    }

    describe redact_drops_only_lines_that_carry_a_secret_value {
        var text = "port: 8080\napi_key: sk_live_1234567890abcdef\npassword = \"hunter2hunter2\"\ntoken: $" + "{{ secrets.GH_TOKEN }}\nDB_PASSWORD=$DB_PASSWORD\naws AKIAABCDEFGHIJKLMNOP"
        var out = RepoSnapshot.redact(text)
        is_true(out.contains("port: 8080"))
        is_false(out.contains("sk_live_1234567890abcdef"))
        is_false(out.contains("hunter2"))
        is_true(out.contains("token: $" + "{{ secrets.GH_TOKEN }}"))
        is_true(out.contains("DB_PASSWORD=$DB_PASSWORD"))
        is_false(out.contains("AKIAABCDEFGHIJKLMNOP"))
    }

    describe public_url_drops_credentials_from_the_remote {
        are_equal(RepoSnapshot.public_url("https://ghp_abc123@github.com/org/repo.git\n"), "https://github.com/org/repo.git")
        are_equal(RepoSnapshot.public_url("https://ana:senha@gitlab.com/g/s/r"), "https://gitlab.com/g/s/r")
        are_equal(RepoSnapshot.public_url("https://github.com/org/repo"), "https://github.com/org/repo")
        are_equal(RepoSnapshot.public_url("git@github.com:org/repo.git"), "git@github.com:org/repo.git")
    }

    describe languages_are_counted_and_sorted_ignoring_vendored_code {
        var langs = RepoSnapshot.languages(["a.go", "b.go", "c/d.go", "web/x.ts", "node_modules/z/i.js", "README.md", "logo.png"])
        are_equal(langs[0].language, "Go")
        are_equal(langs[0].files, 3)
        is_false(langs.any((l) -> l.language == "JavaScript"))
        is_true(langs.any((l) -> l.language == "TypeScript"))
    }

    describe tree_counts_files_per_folder_and_lists_root_files {
        var tree = RepoSnapshot.tree(["go.mod", ".env", "app/main.go", "app/api/h.go", "app/api/r.go", "docs/x.md"])
        is_true(tree.contains("app/  (3 arquivos)"))
        is_true(tree.contains("\n  api/  (2 arquivos)"))
        is_true(tree.contains("docs/  (1 arquivo)"))
        is_true(tree.contains("\ngo.mod"))
        is_false(tree.contains(".env"))
    }

    describe tree_hides_vendored_subfolders_and_caps_its_length {
        var tree = RepoSnapshot.tree(["node_modules/a/b/c.js", "node_modules/a/d.js", "src/x.go"])
        is_true(tree.contains("node_modules/  (2 arquivos)"))
        is_false(tree.contains("  a/"))
        var many = []
        var i = 0
        while (i < 200) {
            many += ["pasta" + i + "/f.go"]
            i = i + 1
        }
        is_true(RepoSnapshot.tree(many).contains("mais 80 entradas"))
    }

    describe manifests_rules_and_entrypoints_are_classified {
        is_true(RepoSnapshot.is_manifest("go.mod"))
        is_true(RepoSnapshot.is_manifest("src/Api/Api.csproj"))
        is_true(RepoSnapshot.is_manifest(".github/workflows/ci.yml"))
        is_false(RepoSnapshot.is_manifest("src/main.go"))
        is_true(RepoSnapshot.is_rule_doc("README.md"))
        is_true(RepoSnapshot.is_rule_doc("docs/adr/0001-use-postgres.md"))
        is_true(RepoSnapshot.is_rule_doc(".cursor/rules/style.mdc"))
        is_false(RepoSnapshot.is_rule_doc("docs/guia.md"))
        is_true(RepoSnapshot.is_entrypoint("cmd/server/main.go"))
    }

    describe write_rejects_a_relative_path_before_touching_anything {
        try {
            RepoSnapshot.write("spec-test-repo-relative", "projects/outro-work-item")
            is_true(false)
        } catch (err) {
            is_true(err.contains("caminho absoluto"))
        }
        is_false(dir.exists("projects/spec-test-repo-relative"))
    }

    describe write_snapshots_a_real_git_repo_into_raw {
        var id = "spec-test-repo-snapshot"
        var base = "projects/" + id
        if (dir.exists(base)) {
            dir.clear(base)
            dir.delete(base)
        }
        var repo_rel = base + "/fixture-repo"
        dir.create(repo_rel + "/docs/adr")
        dir.create(repo_rel + "/cmd/api")
        fs.write(repo_rel + "/go.mod", "module example.com/checkout\n\ngo 1.22\n")
        fs.write(repo_rel + "/cmd/api/main.go", "package main\n\nfunc main() {}\n")
        fs.write(repo_rel + "/README.md", "# Checkout\n\nAPI de pagamentos.\napi_key: sk_live_abcdefghijklmnop\n")
        fs.write(repo_rel + "/docs/adr/0001-postgres.md", "# ADR 1\n\nUsar Postgres.\n")
        fs.write(repo_rel + "/.env", "DB_PASSWORD=supersecretvalue\n")
        var cwd = cmd.exec(["pwd"]).stdout.trim()
        var repo = cwd + "/" + repo_rel
        cmd.exec(["git", "-C", repo, "init", "-q"])
        cmd.exec(["git", "-C", repo, "add", "-A"])
        cmd.exec(["git", "-C", repo, "remote", "add", "origin", "https://ghp_tokenvazado@github.com/org/fixture-repo.git"])
        cmd.exec(["git", "-C", repo, "-c", "user.name=spec", "-c", "user.email=spec@example.com", "commit", "-q", "-m", "inicial"])

        var result = RepoSnapshot.write(id, repo)
        are_equal(result.repo, "fixture-repo")
        are_equal(result.sources.size(), 3)
        are_equal(result.sources[0], "fixture-repo — estrutura.md")

        var structure = fs.read(Paths.raw(id, result.sources[0]))
        is_true(structure.contains("retrato AS-IS"))
        is_true(structure.contains("(https://github.com/org/fixture-repo.git)"))
        is_false(structure.contains("ghp_tokenvazado"))
        is_true(structure.contains("commit `" + result.commit + "`"))
        is_true(structure.contains("- Go: 1 arquivo"))
        is_true(structure.contains("- cmd/api/main.go"))
        var literal = LiteralBlocks.extract(structure)
        is_true(literal.contains("## Árvore de pastas"))
        is_true(literal.contains("```text\ncmd/  (1 arquivo)\n  api/  (1 arquivo)"))
        is_false(literal.contains("retrato AS-IS"))
        is_true(structure.contains("inicial"))

        var stack = fs.read(Paths.raw(id, result.sources[1]))
        is_true(stack.contains("module example.com/checkout"))

        is_true(stack.contains("```\nmodule example.com/checkout"))

        var rules = fs.read(Paths.raw(id, result.sources[2]))
        is_true(rules.contains("Usar Postgres."))
        is_true(rules.contains("### ADR 1"))
        is_true(rules.contains("API de pagamentos."))
        is_false(rules.contains("sk_live_abcdefghijklmnop"))
        is_false(structure.contains("supersecretvalue") || stack.contains("supersecretvalue") || rules.contains("supersecretvalue"))

        // Um segundo retrato nao sobrescreve o primeiro.
        var again = RepoSnapshot.write(id, repo)
        are_equal(again.sources[0], "fixture-repo — estrutura (2).md")

        dir.clear(base)
        dir.delete(base)
    }
}
