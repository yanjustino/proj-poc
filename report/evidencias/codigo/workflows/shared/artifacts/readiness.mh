// tool Readiness — Definition of Ready: se uma historia esta pronta para
// ir ao desenvolvimento. Deterministico (C3), a partir do que ja esta
// gravado — nenhuma chamada de LLM:
//
//   - "nao_pronta": ha bloqueio — historia no formato anterior (sem
//     contratos/cenarios/rastreabilidade), qualquer aviso de conformidade da
//     historia (ArtifactChecks.historia), sem plano de implementacao, ou
//     aviso no plano (criterio sem teste, tarefa fora de ordem, referencia
//     inexistente);
//   - "pronta_com_ressalvas": sem bloqueio, mas com lacunas, questoes em
//     aberto ou dependencia de uma historia do mesmo lote que ainda nao esta
//     pronta — a decisao de puxar para a sprint e de quem le as ressalvas;
//   - "pronta": nada disso.
//
// Plano desatualizado (historia regerada depois dele) e verificado pelo app,
// que conhece o horario dos arquivos (tab-artefatos.js).

import { Paths } from "../core/paths.mh"
import { ArtifactChecks } from "artifact_checks.mh"
import { StoryRules } from "backlog_rules.mh"

export tool Readiness {
    read_json(path: string): any -> {
        if (!fs.exists(path)) return null
        try {
            return json.parse(fs.read(path))
        } catch (err) {
            return null
        }
    }

    // Estruturada = gerada com contratos/cenarios/rastreabilidade.
    internal is_structured(h: any): bool -> h?.contratos != null && h?.cenarios != null && h?.rastreabilidade != null && !StoryRules.is_legacy(h)

    internal evaluate(h: any, plano: any): any -> {
        var bloqueios = []
        var ressalvas = []
        if (!self.is_structured(h)) {
            bloqueios += ["História no formato anterior (sem contratos, cenários ou rastreabilidade estruturados) — regenere as histórias."]
        } else {
            bloqueios = bloqueios + ArtifactChecks.historia(h)
        }
        if (plano == null) bloqueios += ["Sem plano de implementação."]
        else bloqueios = bloqueios + ArtifactChecks.plano(plano).map((a) -> "Plano: " + a)
        ressalvas = ressalvas + (h?.gaps ?? []).map((g) -> "Lacuna: " + g.texto)
        ressalvas = ressalvas + (h?.questoes_abertas ?? []).map((q) -> "Questão em aberto: " + q.texto)
        return {status: self.status_of(bloqueios, ressalvas), bloqueios, ressalvas}
    }

    internal status_of(bloqueios: string[], ressalvas: string[]): string -> {
        if (!bloqueios.is_empty()) return "nao_pronta"
        if (!ressalvas.is_empty()) return "pronta_com_ressalvas"
        return "pronta"
    }

    // item: uma historia avaliada, com onde ela esta (`path` relativo a
    // artifacts/, "" para a historia unica do Delivery na raiz).
    internal item(dir_path: string, relative: string, feature_dir: string): any -> {
        var h = self.read_json(dir_path + "/historia.json")
        if (h == null) return null
        var plano = self.read_json(dir_path + "/plano.json")
        var r = self.evaluate(h, plano)
        var folder = relative.split("/")[relative.split("/").size() - 1]
        return {
            path: relative,
            feature_dir,
            historia_id: if (relative.is_empty()) "" else folder.split("-")[0],
            titulo: h?.titulo ?? "",
            story_type: h?.story_type ?? "",
            tem_plano: plano != null,
            status: r.status,
            bloqueios: r.bloqueios,
            ressalvas: r.ressalvas,
            depende_de: (h?.dependencias_impedimentos ?? []).filter((d) -> d?.tipo == "depende_de").map((d) -> d?.destino ?? ""),
        }
    }

    // batch: todas as historias do work-item — Discovery (historias/<feature>/
    // <historia>/), Delivery em lote (historias/<historia>/) e a historia
    // unica do Delivery (historia.json na raiz de artifacts/).
    batch(project_id: string): any[] -> {
        var base = Paths.artifacts_dir(project_id)
        var out = []
        if (fs.exists(base + "/historia.json")) {
            var root_item = self.item(base, "", "")
            if (root_item != null) out += [root_item]
        }
        var historias = base + "/historias"
        if (!dir.exists(historias)) return out
        for (var entry in dir.list(historias)) {
            var name = entry.replace(historias + "/", "").replace(historias + "\\", "")
            if (fs.exists(entry + "/historia.json")) {
                var flat = self.item(entry, "historias/" + name, "")
                if (flat != null) out += [flat]
            } else if (dir.exists(entry)) {
                for (var sub in dir.list(entry)) {
                    var sub_name = sub.replace(entry + "/", "").replace(entry + "\\", "")
                    var nested = self.item(sub, "historias/" + name + "/" + sub_name, name)
                    if (nested != null) out += [nested]
                }
            }
        }
        return self.with_dependencies(out)
    }

    // Dependencia (depende_de) de uma historia do MESMO lote que ainda nao
    // esta pronta vira ressalva — o desenvolvimento pode comecar, mas a
    // ordem importa.
    internal with_dependencies(items: any[]): any[] -> {
        var out = []
        for (var it in items) {
            var pendentes = []
            for (var destino in it.depende_de) {
                var alvo = destino.to_lower().trim()
                var irmaos = items.filter((x) -> x.feature_dir == it.feature_dir && x.titulo.to_lower().trim() == alvo)
                if (!irmaos.is_empty() && irmaos[0].status == "nao_pronta") pendentes += [destino]
            }
            if (!pendentes.is_empty()) {
                it["ressalvas"] = it.ressalvas + pendentes.map((p) -> "Depende de “" + p + "”, que ainda não está pronta.")
                it["status"] = self.status_of(it.bloqueios, it.ressalvas)
            }
            out += [it]
        }
        return out
    }
}

test ReadinessSpec {
    describe legacy_story_is_not_ready {
        var r = Readiness.evaluate({titulo: "x", como: "a", quero: "b", para: "c", contratos_interface: "POST /x"}, null)
        are_equal(r.status, "nao_pronta")
        is_true(r.bloqueios[0].contains("formato anterior"))
        is_true(r.bloqueios.join(" ").contains("Sem plano"))
    }

    describe complete_story_with_clean_plan_is_ready_and_gaps_make_it_ready_with_notes {
        var h = {
            titulo: "Consultar ordem", story_type: "historia_usuario", nature: "funcional", work_item_type: "historia",
            como: "investidor", quero: "consultar", para: "acompanhar", resultado_tecnico: "", habilita: "", evidenciado_por: "",
            subclassification: "interface",
            criterios_aceite: [{texto: "mostra a ordem", fontes: ["x"]}],
            cenarios: [{titulo: "c", dado: ["d"], quando: ["q"], entao: ["e"], criterios: ["CA1"], fontes: []}],
            rastreabilidade: {requisitos: ["FR-001"], atributos: [], adrs: [], entidades: [], conteineres: []},
            contratos: {endpoints: [], eventos: [], integracoes: []},
            gaps: [], questoes_abertas: [],
        }
        var plano = {criterios_total: 1, tarefas: [{id: "T1", tipo: "teste", criterios: ["CA1"], depende_de: []}], testes: [], avisos_contexto: []}
        are_equal(Readiness.evaluate(h, plano).status, "pronta")
        h["gaps"] = [{texto: "layout não definido", fontes: ["gap"]}]
        var r = Readiness.evaluate(h, plano)
        are_equal(r.status, "pronta_com_ressalvas")
        is_true(r.ressalvas[0].contains("Lacuna: layout não definido"))
        var sem_teste = {criterios_total: 1, tarefas: [{id: "T1", tipo: "implementacao", criterios: ["CA1"], depende_de: []}], testes: [], avisos_contexto: []}
        is_true(Readiness.evaluate(h, sem_teste).bloqueios.join(" ").contains("Plano: Critério de aceite sem teste"))
    }

    describe dependency_on_a_story_that_is_not_ready_becomes_a_note {
        var items = Readiness.with_dependencies([
            {feature_dir: "FT001", titulo: "Gateway", status: "pronta", bloqueios: [], ressalvas: [], depende_de: ["Backend"]},
            {feature_dir: "FT001", titulo: "Backend", status: "nao_pronta", bloqueios: ["x"], ressalvas: [], depende_de: []},
        ])
        are_equal(items[0].status, "pronta_com_ressalvas")
        is_true(items[0].ressalvas[0].contains("Depende de “Backend”"))
        are_equal(items[1].status, "nao_pronta")
    }

    describe batch_finds_discovery_and_delivery_layouts {
        var project_id = "spec-test-readiness"
        var root = Paths.root(project_id)
        dir.create(Paths.artifact(project_id, "historias/FT001-a/US001-b"))
        fs.write(Paths.artifact(project_id, "historias/FT001-a/US001-b/historia.json"), json.stringify({titulo: "B", contratos_interface: "x", como: "a"}))
        fs.write(Paths.artifact(project_id, "historia.json"), json.stringify({titulo: "Única", contratos_interface: "x", como: "a"}))
        var items = Readiness.batch(project_id)
        are_equal(items.size(), 2)
        are_equal(items[0].path, "")
        are_equal(items[1].path, "historias/FT001-a/US001-b")
        are_equal(items[1].feature_dir, "FT001-a")
        are_equal(items[1].historia_id, "US001")
        dir.clear(root)
        dir.delete(root)
    }
}
