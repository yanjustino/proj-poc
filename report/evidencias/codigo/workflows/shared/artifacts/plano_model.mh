// tool PlanoModel — renderizacao e conformidade do plano de implementacao de
// uma historia (o "como" do Spec-Driven Development: a historia e a spec, o
// plano diz onde o codigo muda e em que ordem construir). C3, mesmo padrao
// de C4Diagram/DerModel: a LLM devolve o MODELO; o diagrama de sequencia, a
// matriz de cobertura dos criterios, as tabelas e as verificacoes sao codigo.
//
// Verificacoes:
//   - todo criterio de aceite da historia (CA1..CAn) coberto por ao menos um
//     teste — tarefa do tipo "teste" ou item da estrategia de testes;
//   - referencias a criterios inexistentes (CA9 numa historia com 4);
//   - tarefas: ids repetidos, dependencia de tarefa inexistente ou posterior;
//   - contra o contexto do work-item (calculado no *Generate, avisos_contexto):
//     conteiner fora do C4, ADR inexistente, entidade fora do DER.

import { Cite } from "cite.mh"
import { Traceability } from "historia_spec.mh"

export tool PlanoModel {
    operation_label(op: string): string -> match op {
        "cria"     -> "Cria"
        "le"       -> "Lê"
        "atualiza" -> "Atualiza"
        "remove"   -> "Remove"
        _          -> op
    }

    task_type_label(tipo: string): string -> match tipo {
        "teste"         -> "Teste"
        "implementacao" -> "Implementação"
        "migracao"      -> "Migração"
        "configuracao"  -> "Configuração"
        "documentacao"  -> "Documentação"
        _               -> tipo
    }

    level_label(nivel: string): string -> match nivel {
        "unitario"   -> "Unitário"
        "integracao" -> "Integração"
        "contrato"   -> "Contrato"
        "e2e"        -> "Ponta a ponta"
        _            -> nivel
    }

    // --- Diagrama de sequencia -------------------------------------------------

    // Texto de mensagem/participante no sequenceDiagram: sem quebras, e sem
    // os caracteres que o parser interpreta (";" encerra a instrucao, "#"
    // inicia entidade) — trocados pelas entidades do proprio Mermaid.
    internal mm(text: string): string ->
        text.replace("#", "#35;").replace(";", "#59;").replace("<", "#lt;").replace(">", "#gt;")
            .replace("\r", " ").replace("\n", " ")

    internal participants(fluxo: any[]): string[] -> {
        var out = []
        for (var passo in fluxo) {
            if (!out.contains(passo.de)) out += [passo.de]
            if (!out.contains(passo.para)) out += [passo.para]
        }
        return out
    }

    sequence(data: any): string -> {
        var fluxo = data?.fluxo ?? []
        if (fluxo.is_empty()) return ""
        var nomes = self.participants(fluxo)
        var out = "sequenceDiagram\n"
        var i = 0
        for (var nome in nomes) {
            out = out + "    participant p${i} as " + self.mm(nome).replace(":", " ") + "\n"
            i = i + 1
        }
        for (var passo in fluxo) {
            var seta = if (passo?.retorno ?? false) "-->>" else "->>"
            out = out + "    p${nomes.index_of(passo.de)}" + seta + "p${nomes.index_of(passo.para)}: " + self.mm(passo?.mensagem ?? "") + "\n"
        }
        return out
    }

    // --- Criterios -------------------------------------------------------------

    // Criterios de aceite da historia citados (CA1, CA2…) por tarefas de teste
    // e pela estrategia de testes — o que conta como "coberto por teste".
    internal tested_criteria(data: any): string[] -> {
        var out = []
        for (var t in (data?.tarefas ?? [])) {
            if (t?.tipo == "teste") out = out + (t?.criterios ?? [])
        }
        for (var t in (data?.testes ?? [])) out = out + (t?.criterios ?? [])
        return out.map((c) -> c.to_upper().trim())
    }

    internal all_criteria_refs(data: any): string[] -> {
        var out = []
        for (var t in (data?.tarefas ?? [])) out = out + (t?.criterios ?? [])
        for (var t in (data?.testes ?? [])) out = out + (t?.criterios ?? [])
        return out.map((c) -> c.to_upper().trim())
    }

    coverage_html(data: any): string -> {
        var total = data?.criterios_total ?? 0
        if (total == 0) return ""
        var rows = ""
        var n = 1
        while (n <= total) {
            var ca = "CA${n}"
            var tarefas = (data?.tarefas ?? []).filter((t) -> (t?.criterios ?? []).map((c) -> c.to_upper().trim()).contains(ca)).map((t) -> t.id)
            var testes = (data?.testes ?? []).filter((t) -> (t?.criterios ?? []).map((c) -> c.to_upper().trim()).contains(ca)).map((t) -> self.level_label(t.nivel))
            var tested = self.tested_criteria(data).contains(ca)
            rows = rows + "<tr><td>" + ca + "</td><td>" + (if (tarefas.is_empty()) "—" else html.escape(tarefas.join(", "))) +
                "</td><td>" + (if (testes.is_empty()) "—" else html.escape(testes.join(", "))) +
                "</td><td>" + (if (tested) "Sim" else "<strong>Não</strong>") + "</td></tr>"
            n = n + 1
        }
        return "<h2>Cobertura dos critérios de aceite</h2><table><thead><tr><th>Critério</th><th>Tarefas</th><th>Testes</th><th>Coberto por teste</th></tr></thead><tbody>" + rows + "</tbody></table>"
    }

    // --- Conformidade ------------------------------------------------------------

    check(data: any): string[] -> {
        var out = []
        var total = data?.criterios_total ?? 0
        var tested = self.tested_criteria(data)
        var n = 1
        var sem_teste = []
        while (n <= total) {
            if (!tested.contains("CA${n}")) sem_teste += ["CA${n}"]
            n = n + 1
        }
        if (!sem_teste.is_empty()) out += ["Critério de aceite sem teste: " + sem_teste.join(", ") + "."]
        if (total > 0) {
            var invalidos = []
            for (var ref in self.all_criteria_refs(data)) {
                var num = ref.replace("CA", "")
                var valid = false
                var k = 1
                while (k <= total) {
                    if (num == "${k}") valid = true
                    k = k + 1
                }
                if (!valid && !invalidos.contains(ref)) invalidos += [ref]
            }
            if (!invalidos.is_empty()) out += ["Critério citado que não existe na história (ela tem " + "${total}" + "): " + invalidos.join(", ") + "."]
        }

        var tarefas = data?.tarefas ?? []
        if (!tarefas.any((t) -> t?.tipo == "teste")) out += ["Nenhuma tarefa de teste — escreva os testes antes da implementação que eles cobrem."]
        var ids = []
        for (var t in tarefas) {
            if (ids.contains(t.id)) out += ["Id de tarefa repetido: " + t.id + "."]
            for (var dep in (t?.depende_de ?? [])) {
                if (!tarefas.any((x) -> x.id == dep)) out += ["Tarefa " + t.id + " depende de uma tarefa inexistente: " + dep + "."]
                else if (!ids.contains(dep)) out += ["Tarefa " + t.id + " depende de " + dep + ", que vem depois dela na ordem."]
            }
            ids += [t.id]
        }
        return out
    }

    // check_context: referencias do plano que nao existem nos artefatos do
    // work-item — calculado no *Generate (precisa de Traceability.known) e
    // guardado em avisos_contexto, como Traceability.annotate faz nas historias.
    check_context(data: any, known: any): string[] -> {
        var out = []
        var conteineres = Traceability.missing((data?.componentes ?? []).map((c) -> c.conteiner), known?.conteineres ?? [], false)
        if (!conteineres.is_empty()) out += ["Contêiner que não existe no diagrama C4: " + conteineres.join(", ") + "."]
        var adrs = Traceability.missing((data?.adrs ?? []).map((a) -> a.adr), known?.adrs ?? [], true)
        if (!adrs.is_empty()) out += ["ADR citada que não existe: " + adrs.join(", ") + "."]
        var entidades = Traceability.missing((data?.dados ?? []).map((d) -> d.entidade), known?.entidades ?? [], false)
        if (!entidades.is_empty()) out += ["Entidade que não existe no DER: " + entidades.join(", ") + "."]
        return out
    }

    warnings_html(data: any): string -> {
        var avisos = self.check(data) + (data?.avisos_contexto ?? [])
        if (avisos.is_empty()) return ""
        return "<h2>Conformidade do plano</h2><ul class=\"c4-warnings\">" + avisos.map((a) -> "<li>" + html.escape(a) + "</li>").join("") + "</ul>"
    }

    // --- Tabelas -------------------------------------------------------------------

    components_html(itens: any[]): string -> {
        if (itens.is_empty()) return "<p>—</p>"
        return "<table><thead><tr><th>Contêiner</th><th>Componente</th><th>Mudança</th><th>Fontes</th></tr></thead><tbody>" +
            itens.map((c) -> "<tr><td>" + html.escape(c.conteiner) + "</td><td>" + html.escape(c?.componente ?? "") + "</td><td>" + html.escape(c?.mudanca ?? "") + "</td><td>" + Cite.badges(c?.fontes ?? []) + "</td></tr>").join("") +
            "</tbody></table>"
    }

    adrs_html(itens: any[]): string -> {
        if (itens.is_empty()) return "<p>—</p>"
        return "<table><thead><tr><th>ADR</th><th>Como se aplica</th><th>Fontes</th></tr></thead><tbody>" +
            itens.map((a) -> "<tr><td>" + html.escape(a.adr) + "</td><td>" + html.escape(a?.aplicacao ?? "") + "</td><td>" + Cite.badges(a?.fontes ?? []) + "</td></tr>").join("") +
            "</tbody></table>"
    }

    data_html(itens: any[]): string -> {
        if (itens.is_empty()) return "<p>—</p>"
        return "<table><thead><tr><th>Entidade</th><th>Operação</th><th>Detalhe</th><th>Fontes</th></tr></thead><tbody>" +
            itens.map((d) -> "<tr><td>" + html.escape(d.entidade) + "</td><td>" + self.operation_label(d?.operacao ?? "") + "</td><td>" + html.escape(d?.detalhe ?? "") + "</td><td>" + Cite.badges(d?.fontes ?? []) + "</td></tr>").join("") +
            "</tbody></table>"
    }

    tasks_html(itens: any[]): string -> {
        if (itens.is_empty()) return "<p>—</p>"
        return "<table><thead><tr><th>#</th><th>Tarefa</th><th>Tipo</th><th>Critérios</th><th>Depende de</th><th>Fontes</th></tr></thead><tbody>" +
            itens.map((t) -> "<tr><td>" + html.escape(t.id) + "</td><td><strong>" + html.escape(t.titulo) + "</strong><br>" + html.escape(t?.descricao ?? "") +
                "</td><td>" + self.task_type_label(t?.tipo ?? "") + "</td><td>" + html.escape((t?.criterios ?? []).join(", ")) +
                "</td><td>" + (if ((t?.depende_de ?? []).is_empty()) "—" else html.escape(t.depende_de.join(", "))) +
                "</td><td>" + Cite.badges(t?.fontes ?? []) + "</td></tr>").join("") +
            "</tbody></table>"
    }

    tests_html(itens: any[]): string -> {
        if (itens.is_empty()) return "<p>—</p>"
        return "<table><thead><tr><th>Nível</th><th>O que testa</th><th>Critérios</th><th>Fontes</th></tr></thead><tbody>" +
            itens.map((t) -> "<tr><td>" + self.level_label(t.nivel) + "</td><td>" + html.escape(t?.descricao ?? "") + "</td><td>" + html.escape((t?.criterios ?? []).join(", ")) + "</td><td>" + Cite.badges(t?.fontes ?? []) + "</td></tr>").join("") +
            "</tbody></table>"
    }

    sequence_html(data: any): string -> {
        var mermaid = self.sequence(data)
        if (mermaid.is_empty()) return "<p>—</p>"
        return "<pre class=\"mermaid\">" + html.escape(mermaid) + "</pre>" + Cite.note(data?.fluxo_fontes ?? [])
    }
}

// PlanoPrep — as anotacoes deterministicas de um plano recem-gerado: quantos
// criterios a historia tem (cobertura), o titulo exibido e os avisos que
// dependem do contexto do work-item. Discovery e Delivery acrescentam depois
// so onde o plano e gravado.
export tool PlanoPrep {
    annotate(data: any, historia: any, titulo: string, known: any): any -> {
        data["criterios_total"] = (historia?.criterios_aceite ?? []).size()
        data["historia_titulo"] = titulo
        data["avisos_contexto"] = PlanoModel.check_context(data, known)
        return data
    }
}

tool PlanoFixtures {
    internal plano(): any -> {
        criterios_total: 2,
        abordagem: "x",
        componentes: [{conteiner: "API de Ordens", componente: "OrdemController", mudanca: "novo endpoint", fontes: ["inferência"]}],
        adrs: [{adr: "ADR-001", aplicacao: "Java", fontes: ["adr/ADR-001-java"]}],
        dados: [{entidade: "Ordem", operacao: "le", detalhe: "", fontes: ["der"]}],
        fluxo: [
            {de: "Investidor", para: "API de Ordens", mensagem: "GET /ordens/{id}", retorno: false},
            {de: "API de Ordens", para: "Eventos: Ordens", mensagem: "busca; filtra", retorno: false},
            {de: "API de Ordens", para: "Investidor", mensagem: "200 <ordem>", retorno: true},
        ],
        tarefas: [
            {id: "T1", titulo: "Teste do endpoint", descricao: "", tipo: "teste", criterios: ["CA1", "CA2"], depende_de: [], fontes: ["inferência"]},
            {id: "T2", titulo: "Implementar", descricao: "", tipo: "implementacao", criterios: ["CA1"], depende_de: ["T1"], fontes: ["inferência"]},
        ],
        testes: [{nivel: "contrato", descricao: "OpenAPI", criterios: ["CA1"], fontes: ["inferência"]}],
    }
}

test PlanoModelSpec {
    describe sequence_diagram_uses_aliased_participants_and_return_arrows {
        var m = PlanoModel.sequence(PlanoFixtures.plano())
        is_true(m.starts_with("sequenceDiagram\n"))
        is_true(m.contains("participant p0 as Investidor"))
        is_true(m.contains("participant p2 as Eventos  Ordens"))
        is_true(m.contains("p0->>p1: GET /ordens/{id}"))
        is_true(m.contains("p1->>p2: busca#59; filtra"))
        is_true(m.contains("p1-->>p0: 200 #lt;ordem#gt;"))
    }

    describe a_complete_plan_has_no_warnings {
        are_equal(PlanoModel.check(PlanoFixtures.plano()).size(), 0)
    }

    describe untested_and_unknown_criteria_are_flagged {
        var p = {
            criterios_total: 3,
            tarefas: [
                {id: "T1", tipo: "implementacao", criterios: ["CA1", "CA7"], depende_de: ["T2", "T9"]},
                {id: "T2", tipo: "implementacao", criterios: ["CA2"], depende_de: []},
                {id: "T2", tipo: "configuracao", criterios: [], depende_de: []},
            ],
            testes: [{nivel: "unitario", criterios: ["CA2"]}],
        }
        var avisos = PlanoModel.check(p).join(" | ")
        is_true(avisos.contains("Critério de aceite sem teste: CA1, CA3"))
        is_true(avisos.contains("Critério citado que não existe na história (ela tem 3): CA7"))
        is_true(avisos.contains("Nenhuma tarefa de teste"))
        is_true(avisos.contains("Id de tarefa repetido: T2"))
        is_true(avisos.contains("Tarefa T1 depende de uma tarefa inexistente: T9"))
        is_true(avisos.contains("Tarefa T1 depende de T2, que vem depois dela na ordem"))
    }

    describe context_check_flags_containers_adrs_and_entities_that_do_not_exist {
        var known = {requisitos: [], atributos: [], adrs: ["ADR-002"], entidades: ["Investidor"], conteineres: ["Aplicação Web"]}
        var avisos = PlanoModel.check_context(PlanoFixtures.plano(), known).join(" | ")
        is_true(avisos.contains("Contêiner que não existe no diagrama C4: API de Ordens"))
        is_true(avisos.contains("ADR citada que não existe: ADR-001"))
        is_true(avisos.contains("Entidade que não existe no DER: Ordem"))
    }

    describe coverage_table_marks_untested_criteria {
        var p = PlanoFixtures.plano()
        var html = PlanoModel.coverage_html({criterios_total: 3, tarefas: p.tarefas, testes: p.testes})
        is_true(html.contains("<tr><td>CA1</td><td>T1, T2</td><td>Contrato</td><td>Sim</td></tr>"))
        is_true(html.contains("<tr><td>CA3</td><td>—</td><td>—</td><td><strong>Não</strong></td></tr>"))
    }
}
