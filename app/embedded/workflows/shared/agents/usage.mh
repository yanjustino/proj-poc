// memory Usage + tool UsageParser — ledger de consumo de token por work-item
// (C5, PLANO-MACRO-MHL-SENPAI.md §2.1). Todo `agent` que gera artefato ou
// pagina de wiki declara um hook `after` que chama UsageParser.extract_<backend>
// sobre a resposta crua do CLI e grava o resultado aqui.
//
// `path_guard: "no_traversal"` (mhl 1.4.0-beta.6+) e defesa em profundidade —
// o mecanismo primario continua sendo `Paths.ensure_valid(project_id)` chamado
// no primeiro step de todo workflow, antes de qualquer var `project_id` ser
// usada aqui ou em qualquer outro lugar (ver FASE0-ACHADOS.md §10).

export memory Usage {
    type: "jsonl"
    path: "projects/${project_id}/usage.jsonl"
    path_guard: "no_traversal"
}

// memory PromptLog — mesmo espirito do Usage acima, mas grava o prompt final
// e a resposta crua da chamada (auditoria/depuracao), nao so os numeros de
// consumo. Escrita por Writer.generate (agents.mh), logo apos Usage.append,
// pro mesmo artifact/execucao — nunca formatado pela LLM (C3).
export memory PromptLog {
    type: "jsonl"
    path: "projects/${project_id}/prompt_log.jsonl"
    path_guard: "no_traversal"
}

type UsageRecord = {
    tokens_in: number, 
    tokens_out: number, 
    content: string,
    cache_creation_tokens: number, 
    cache_read_tokens: number, 
    cost_usd: number
}

// Formato do envelope de --output-format json do Claude Code CLI, confirmado
// por spike real (FASE0-ACHADOS.md §5) e reconfirmado numa chamada real
// direta a `claude -p ... --output-format json` (fora do mhl, comparando o
// envelope cru byte a byte): usage.input_tokens/output_tokens junto do
// conteudo pedido em `structured_output` (objeto validado pelo schema). O
// campo `result` pode conter uma explicacao em linguagem natural mesmo quando
// `structured_output` esta correto — comportamento observado no Claude para
// Windows. Preferimos o objeto validado e mantemos `result` apenas como
// fallback para versoes antigas do CLI que nao exponham `structured_output`.
//
// Toda variante de extract_* devolve exatamente as mesmas 6 chaves — mesmo
// quando um backend nao tem o conceito (cache_creation do Devin/Codex, custo
// do Codex) — para Writer.generate/Usage.append nunca precisar checar "esse
// campo existe pra esse backend?" com acesso opcional; so preenche zero.
export tool UsageParser {
    // `devin --print` continua devolvendo apenas a resposta final no stdout,
    // mas `--export <path>` grava uma trajetoria ATIF com os totais em
    // final_metrics. `prompt_tokens` ja inclui `cached_tokens`; cache e uma
    // decomposicao para observabilidade, nao algo a somar de novo na entrada.
    // O export nao traz cache_creation e pode nao trazer custo — esses campos
    // continuam zero quando ausentes. Telemetria e best-effort: export ausente
    // ou invalido nao pode invalidar uma resposta de geracao correta.
    //
    // A CLI pode envolver a resposta em uma cerca Markdown mesmo quando
    // instruida a nao faze-lo; removemos somente a cerca externa, preservando
    // backticks que facam parte de campos internos.
    extract_devin(raw: string, exported: string): UsageRecord -> {
        var content = raw.trim()
        if (content.starts_with("```json")) content = content.substring(7, content.size()).trim()
        else if (content.starts_with("```")) content = content.substring(3, content.size()).trim()
        if (content.ends_with("```")) content = content.substring(0, content.size() - 3).trim()

        var tokens_in = 0
        var tokens_out = 0
        var cache_read_tokens = 0
        var cost_usd = 0
        if (!exported.trim().is_empty()) {
            try {
                var trajectory = json.parse(exported)
                var metrics = trajectory.get("final_metrics", null)
                if (metrics != null) {
                    tokens_in = metrics.get("total_prompt_tokens", 0) ?? 0
                    tokens_out = metrics.get("total_completion_tokens", 0) ?? 0
                    cache_read_tokens = metrics.get("total_cached_tokens", 0) ?? 0
                    cost_usd = metrics.get("total_cost_usd", 0) ?? 0
                }
            } catch (err) {
                tokens_in = 0
                tokens_out = 0
                cache_read_tokens = 0
                cost_usd = 0
            }
        }

        return {
            tokens_in: tokens_in, 
            tokens_out: tokens_out, 
            content: content,
            cache_creation_tokens: 0, 
            cache_read_tokens: cache_read_tokens, 
            cost_usd: cost_usd
        }
    }

    // usage.cache_creation_input_tokens/cache_read_input_tokens e
    // total_cost_usd (custo real ja calculado pela Anthropic, mais direto
    // que converter token->preco a mao) vem no mesmo envelope de
    // usage.input_tokens/output_tokens — so nao eram lidos antes. Uma
    // chamada real (prompt trivial, contexto de sistema grande) confirmou:
    // input_tokens:2, cache_creation_input_tokens:21260 — a maior parte do
    // prompt vira criacao de cache, nao input "novo"; sem esses dois campos,
    // o ledger fazia parecer que a chamada quase nao usou tokens de entrada.
    extract_claude(raw: string): UsageRecord -> {
        var envelope = json.parse(raw)
        var content = envelope.result
        var structured = envelope.get("structured_output", null)
        if (structured != null) content = json.stringify(structured)
        return {
            tokens_in: envelope.usage.input_tokens,
            tokens_out: envelope.usage.output_tokens,
            content: content,
            cache_creation_tokens: envelope.usage.cache_creation_input_tokens,
            cache_read_tokens: envelope.usage.cache_read_input_tokens,
            cost_usd: envelope.total_cost_usd,
        }
    }

    // `codex exec --json` emite JSONL. A resposta final vem no evento
    // item.completed/agent_message e o consumo no turn.completed —
    // cached_input_tokens (quantos dos input_tokens vieram de cache,
    // equivalente ao cache_read_input_tokens do Claude) e
    // cache_write_input_tokens (equivalente ao cache_creation_input_tokens
    // do Claude) no mesmo evento — confirmado numa chamada real ao `codex
    // exec` com os mesmos flags do agent Codex, que devolveu ambos os
    // campos junto de input_tokens/output_tokens. Nenhum custo em dolar
    // exposto por este CLI — cost_usd fica 0 aqui, nao inventado.
    extract_codex(raw: string): UsageRecord -> {
        var tokens_in = 0
        var tokens_out = 0
        var cache_creation_tokens = 0
        var cache_read_tokens = 0
        var content = ""
        for (var event in json.parse_lines(raw)) {
            if (event.type == "item.completed" && event.item.type == "agent_message") {
                content = event.item.text
            }
            if (event.type == "turn.completed") {
                tokens_in = event.usage.input_tokens
                tokens_out = event.usage.output_tokens
                cache_read_tokens = event.usage.cached_input_tokens
                cache_creation_tokens = event.usage.cache_write_input_tokens
            }
        }
        
        return {
            tokens_in: tokens_in, 
            tokens_out: tokens_out, 
            content: content,
            cache_creation_tokens: cache_creation_tokens, 
            cache_read_tokens: cache_read_tokens, 
            cost_usd: 0
        }
    }
}

test UsageParserSpec {
    describe keeps_devin_output_and_marks_usage_unavailable_without_an_export {
        var parsed = UsageParser.extract_devin("{\"ok\":true}", "")
        are_equal(parsed.tokens_in, 0)
        are_equal(parsed.tokens_out, 0)
        are_equal(parsed.content, "{\"ok\":true}")
        are_equal(parsed.cache_creation_tokens, 0)
        are_equal(parsed.cache_read_tokens, 0)
        are_equal(parsed.cost_usd, 0)
    }

    describe removes_only_devins_outer_markdown_fence {
        var parsed = UsageParser.extract_devin("```json\n{\"body\":\"use ``` dentro\"}\n```\n", "")
        are_equal(parsed.content, "{\"body\":\"use ``` dentro\"}")
    }

    describe extracts_devin_totals_from_atif_without_adding_cached_tokens_twice {
        var exported = "{\"schema_version\":\"ATIF-v1.7\",\"steps\":[" +
            "{\"metrics\":{\"prompt_tokens\":12801,\"completion_tokens\":67,\"cached_tokens\":1472}}]," +
            "\"final_metrics\":{\"total_prompt_tokens\":12801,\"total_completion_tokens\":67," +
            "\"total_cached_tokens\":1472,\"total_steps\":9}}"
        var parsed = UsageParser.extract_devin("{\"ok\":true}", exported)
        are_equal(parsed.tokens_in, 12801)
        are_equal(parsed.tokens_out, 67)
        are_equal(parsed.cache_read_tokens, 1472)
        are_equal(parsed.cache_creation_tokens, 0)
        are_equal(parsed.cost_usd, 0)
    }

    describe keeps_the_response_when_devins_export_is_invalid {
        var parsed = UsageParser.extract_devin("{\"ok\":true}", "not-json")
        are_equal(parsed.content, "{\"ok\":true}")
        are_equal(parsed.tokens_in, 0)
        are_equal(parsed.tokens_out, 0)
        are_equal(parsed.cache_read_tokens, 0)
    }

    describe extracts_claude_tokens_cache_and_cost_from_the_real_envelope_shape {
        var raw = "{\"result\":\"Resposta em linguagem natural\",\"structured_output\":{\"ok\":true},\"total_cost_usd\":0.128202,\"usage\":{" +
            "\"input_tokens\":2,\"output_tokens\":4," +
            "\"cache_creation_input_tokens\":21260,\"cache_read_input_tokens\":0}}"
        var parsed = UsageParser.extract_claude(raw)
        are_equal(parsed.tokens_in, 2)
        are_equal(parsed.tokens_out, 4)
        are_equal(parsed.content, "{\"ok\":true}")
        are_equal(parsed.cache_creation_tokens, 21260)
        are_equal(parsed.cache_read_tokens, 0)
        are_equal(parsed.cost_usd, 0.128202)
    }

    describe falls_back_to_claude_result_when_structured_output_is_absent {
        var raw = "{\"result\":\"{\\\"ok\\\":true}\",\"total_cost_usd\":0.01,\"usage\":{" +
            "\"input_tokens\":1,\"output_tokens\":2," +
            "\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":0}}"
        var parsed = UsageParser.extract_claude(raw)
        are_equal(parsed.content, "{\"ok\":true}")
    }

    // Formato confirmado numa chamada real ao `codex exec --json` (mesmos
    // flags do agent Codex): turn.completed.usage traz input_tokens,
    // cached_input_tokens, cache_write_input_tokens, output_tokens e
    // reasoning_output_tokens juntos — o fixture inclui todos pra provar que
    // extract_codex lê os dois campos de cache certos, nao so um.
    describe extracts_codex_final_message_usage_and_both_cache_fields_from_jsonl {
        var raw = "{\"type\":\"thread.started\",\"thread_id\":\"t1\"}\n" +
            "{\"type\":\"item.completed\",\"item\":{\"id\":\"i1\",\"type\":\"agent_message\",\"text\":\"{\\\"ok\\\":true}\"}}\n" +
            "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":14368,\"cached_input_tokens\":10624," +
            "\"cache_write_input_tokens\":512,\"output_tokens\":5,\"reasoning_output_tokens\":0}}"
        var parsed = UsageParser.extract_codex(raw)
        are_equal(parsed.tokens_in, 14368)
        are_equal(parsed.tokens_out, 5)
        are_equal(parsed.content, "{\"ok\":true}")
        are_equal(parsed.cache_creation_tokens, 512)
        are_equal(parsed.cache_read_tokens, 10624)
        are_equal(parsed.cost_usd, 0)
    }
}
