// radahn_prompts.mh — o prompt e o schema do assessment de aderencia ao
// Radahn (motor low-code de APIs REST configurado por radahn.yaml). Os .md em
// prompts/ sao as sources do proprio Radahn — copiadas como estao; aqui so
// se declara como entram no prompt.

import { WorkflowsRoot } from "../core/workflows_root.mh"

prompt RadahnModelo() from "prompts/00-modelo-mental.md"
prompt RadahnSchema() from "prompts/01-schema.md"
prompt RadahnSkills() from "prompts/02-skills.md"
prompt RadahnChecklist() from "prompts/04-checklist.md"

export prompt RadahnInstruction(plano_content: string, historia_content: string, der_content: string, adr_content: string, modelo: prompt, schema: prompt, skills: prompt, checklist: prompt) from "prompts/assessment.prompt.md"

// Prompt pronto: a base de conhecimento do Radahn + o que a LLM avalia.
export tool RadahnPrompt {
    build(plano_content: string, historia_content: string, der_content: string, adr_content: string): string ->
        RadahnInstruction(plano_content: plano_content, historia_content: historia_content, der_content: der_content, adr_content: adr_content,
            modelo: RadahnModelo(), schema: RadahnSchema(), skills: RadahnSkills(), checklist: RadahnChecklist())
}

prompt RadahnSchemaContent() from "schemas/radahn.schema.json"

export tool RadahnSchemaFile { get(): {content: string, path: string} -> {content: RadahnSchemaContent(), path: WorkflowsRoot.resolve("shared/radahn/schemas/radahn.schema.json")} }
