// tool ArchModel — o modelo arquitetural: os diagramas C4 de contexto e de
// conteiner do sistema em escopo, descritos como dados (elementos e
// relacoes) e revisados e aprovados ANTES do lote de diagramas. A LLM gera o
// modelo; o desenho, a legenda e as tabelas sao codigo (C4Diagram).
//
// Por que: cada geracao de diagramas recriava do zero contexto, conteiner e
// os opcionais juntos — um pedido de mudanca num diagrama perturbava os
// outros, e o usuario so descobria o que a LLM entendeu olhando o desenho.
// Com o modelo como artefato proprio:
//   - a revisao acontece em tabelas, uma por diagrama, baratas de julgar;
//   - as tabelas podem ser editadas a mao (ArtifactSave), sem LLM nenhuma, e
//     os dois diagramas sao redesenhados na hora (ArtifactCommit.model_views);
//   - a LLM dos diagramas so gera os tipos opcionais (componente,
//     implantacao, fluxos), tendo o modelo como vocabulario fixo.
//
// Cada diagrama e independente: tem os proprios elementos e relacoes, com
// ids proprios — uma pessoa que aparece nos dois e simplesmente repetida, e
// as relacoes de cada nivel sao escritas para aquele nivel. Uma tentativa
// anterior derivava o contexto do conteiner (conteineres colapsados no
// sistema); na pratica o usuario queria editar as relacoes do contexto
// diretamente, e uma relacao derivada nao se edita. A coerencia entre os
// niveis (mesmas pessoas e sistemas externos, mesmo sistema em escopo) vira
// aviso, nao regra: C4Diagram.annotate ja compara os nomes.
//
// No contexto, o sistema em escopo nao e um elemento: e `sistema` (nome e
// descricao) e as relacoes o citam pelo id reservado "sistema".
//
// No conteiner, `fronteiras` lista as fronteiras de sistema de software (uma
// ou mais) e cada elemento diz em qual esta (`fronteira`, vazio = fora de
// todas). Um modelo sem fronteiras usa a fronteira unica do escopo.
//
// Visoes detalhadas (`detalhes`): diagramas que o usuario cria no editor a
// partir de um elemento da visao de nivel acima — N diagramas de conteiner
// de um sistema do contexto (o sistema em escopo, para recortar uma jornada,
// ou um sistema externo) e diagramas de componente de um conteiner de
// aplicacao (do conteiner principal ou de outra visao detalhada). Cada uma:
//   {id, tipo: "c4-container" | "c4-component", titulo, descricao, fontes,
//    origem: {visao: "contexto" | "conteineres" | <id de outro detalhe>,
//             elemento: <id do elemento>, nome: <nome quando nasceu>},
//    fronteiras (so conteiner), elementos, relacoes}
// O escopo da visao e o elemento de origem, lido na hora: renomear o
// conteiner renomeia a fronteira do diagrama de componente. Um elemento de
// origem que sumiu deixa a visao orfa — aviso, nunca apagada (o nome
// guardado em origem.nome continua desenhando a fronteira). A LLM do modelo
// nao escreve `detalhes`: regerar o modelo preserva os do modelo anterior
// (ArtifactCommit.modelo), e os que perderam a origem viram aviso.
//
// Fora do modelo: nos de implantacao (opcionais, dependem de evidencia) e os
// componentes de conteineres sem visao detalhada — continuam no lote de
// diagramas, gerados pela LLM. Um conteiner detalhado aqui nao recebe
// diagrama de componente da LLM (optional_diagrams).

import { C4Diagram } from "c4_diagram.mh"
import { Cite } from "cite.mh"

export tool ArchModel {
    // Id do sistema em escopo nas relacoes do contexto. Reservado: nenhum
    // elemento pode usa-lo (check).
    internal sistema_id(): string -> "sistema"

    internal sistema(data: any): any -> data?.sistema ?? {nome: "", descricao: "", fontes: []}

    internal vazio(): any -> {elementos: [], relacoes: []}

    // --- Visoes -----------------------------------------------------------

    // Elemento no formato de um diagrama (diagramas.schema.json).
    internal element(el: any): any -> {
        id: el?.id ?? "",
        nome: el?.nome ?? "",
        tipo: el?.tipo ?? "",
        tecnologia: el?.tecnologia ?? "",
        descricao: el?.descricao ?? "",
        no_pai: "",
        fronteira: el?.fronteira ?? "",
        fontes: el?.fontes ?? [],
    }

    internal relation(r: any): any ->
        {de: r?.de ?? "", para: r?.para ?? "", descricao: r?.descricao ?? "", tecnologia: r?.tecnologia ?? "", fontes: r?.fontes ?? []}

    internal view(data: any, diagram_type: string, titulo: string, descricao: string, elementos: any[], relacoes: any[]): any {
        var s = self.sistema(data)
        var nome = (s?.nome ?? "").trim()
        return {
            titulo: if (nome.is_empty()) titulo else titulo + " — " + nome,
            diagram_type,
            descricao,
            descricao_fontes: ["modelo"],
            escopo: {nome: s?.nome ?? "", descricao: s?.descricao ?? "", fontes: s?.fontes ?? []},
            ambiente: "",
            elementos,
            relacoes,
            diagrama_mermaid: "",
            derivado_do_modelo: true,
        }
    }

    // context: os elementos do contexto com o sistema em escopo como caixa
    // central, logo depois das pessoas (a ordem guia o layout do Mermaid).
    context(data: any): any {
        var contexto = data?.contexto ?? self.vazio()
        var s = self.sistema(data)
        var sistema_el = {id: self.sistema_id(), nome: s?.nome ?? "", tipo: "sistema", tecnologia: "", descricao: s?.descricao ?? "", no_pai: "", fontes: s?.fontes ?? []}
        var elementos = contexto?.elementos ?? []
        var pessoas = elementos.filter((el) -> el.tipo == "pessoa").map((el) -> self.element(el))
        var demais = elementos.filter((el) -> el.tipo != "pessoa").map((el) -> self.element(el))
        return self.view(data, "c4-context", "Contexto de sistema",
            "Pessoas e sistemas externos que interagem com o sistema.",
            pessoas + [sistema_el] + demais, (contexto?.relacoes ?? []).map((r) -> self.relation(r)))
    }

    container(data: any): any {
        var conteineres = data?.conteineres ?? self.vazio()
        var v = self.view(data, "c4-container", "Contêineres",
            "Aplicações e armazenamentos de dados do sistema e como se comunicam.",
            (conteineres?.elementos ?? []).map((el) -> self.element(el)), (conteineres?.relacoes ?? []).map((r) -> self.relation(r)))
        v["fronteiras"] = (conteineres?.fronteiras ?? []).map((f) -> {id: f?.id ?? "", nome: f?.nome ?? "", descricao: f?.descricao ?? "", fontes: f?.fontes ?? []})
        return v
    }

    views(data: any): any[] -> [self.context(data), self.container(data)] + self.detail_views(data)

    // Diagramas que a LLM pode devolver no lote: contexto e conteiner vem
    // sempre do modelo, mesmo que a resposta traga um (o schema ja nao
    // aceita esses tipos; isto protege contra um checkpoint antigo). Um
    // diagrama de componente de um conteiner que ja tem visao de componentes
    // no modelo tambem sai — o editado a mao prevalece.
    optional_diagrams(diagramas: any[], modelo: any = null): any[] {
        var detalhados = self.detail_views(modelo ?? {}).filter((v) -> v.diagram_type == "c4-component").map((v) -> self.normalized(v.escopo.nome))
        return diagramas.filter((d) -> d.diagram_type != "c4-context" && d.diagram_type != "c4-container" &&
            !(d.diagram_type == "c4-component" && detalhados.contains(self.normalized(d?.escopo?.nome ?? ""))))
    }

    internal normalized(text: string): string -> text.to_lower().trim()

    // --- Visoes detalhadas ------------------------------------------------

    detalhes(data: any): any[] -> data?.detalhes ?? []

    // origin: o elemento de onde a visao nasceu, como esta hoje no modelo, ou
    // null se ele (ou a visao que o continha) nao existe mais. No contexto, o
    // sistema em escopo responde pelo id reservado.
    origin(data: any, d: any): any {
        var visao = d?.origem?.visao ?? ""
        var elemento = d?.origem?.elemento ?? ""
        var elementos = []
        if (visao == "contexto") {
            if (elemento == self.sistema_id()) {
                var s = self.sistema(data)
                return {id: self.sistema_id(), nome: s?.nome ?? "", tipo: "sistema", tecnologia: "", descricao: s?.descricao ?? ""}
            }
            elementos = data?.contexto?.elementos ?? []
        } else if (visao == "conteineres") {
            elementos = data?.conteineres?.elementos ?? []
        } else {
            var pais = self.detalhes(data).filter((p) -> (p?.id ?? "") == visao)
            if (pais.is_empty()) return null
            elementos = pais[0]?.elementos ?? []
        }
        var achados = elementos.filter((el) -> (el?.id ?? "") == elemento)
        if (achados.is_empty()) return null
        return achados[0]
    }

    // detail_view: a visao no formato de um diagrama. Titulo: "Contêineres —
    // <titulo>" ou "Componentes — <titulo>"; sem titulo, o nome da origem.
    detail_view(data: any, d: any): any {
        var o = self.origin(data, d)
        var nome = if (o == null) (d?.origem?.nome ?? "") else (o?.nome ?? "")
        var descricao_escopo = if (o == null) "" else (o?.descricao ?? "")
        var componente = (d?.tipo ?? "") == "c4-component"
        var rotulo = (d?.titulo ?? "").trim()
        if (rotulo.is_empty()) rotulo = nome
        var v = {
            titulo: (if (componente) "Componentes" else "Contêineres") + " — " + rotulo,
            diagram_type: if (componente) "c4-component" else "c4-container",
            descricao: d?.descricao ?? "",
            descricao_fontes: d?.fontes ?? [],
            escopo: {nome, descricao: descricao_escopo, fontes: d?.fontes ?? []},
            ambiente: "",
            elementos: (d?.elementos ?? []).map((el) -> self.element(el)),
            relacoes: (d?.relacoes ?? []).map((r) -> self.relation(r)),
            diagrama_mermaid: "",
            derivado_do_modelo: true,
        }
        if (!componente) v["fronteiras"] = (d?.fronteiras ?? []).map((f) -> {id: f?.id ?? "", nome: f?.nome ?? "", descricao: f?.descricao ?? "", fontes: f?.fontes ?? []})
        return v
    }

    detail_views(data: any): any[] -> self.detalhes(data).map((d) -> self.detail_view(data, d))

    internal visao_label(data: any, visao: string): string {
        if (visao == "contexto") return "Contexto"
        if (visao == "conteineres") return "Contêineres"
        var pais = self.detalhes(data).filter((p) -> (p?.id ?? "") == visao)
        if (pais.is_empty()) return "visão removida"
        return self.detail_view(data, pais[0]).titulo
    }

    // Avisos que so a visao detalhada tem: origem que sumiu (orfa) ou que
    // mudou de tipo e nao comporta mais o nivel.
    origin_warnings(data: any, d: any): string[] {
        var titulo = self.detail_view(data, d).titulo
        var o = self.origin(data, d)
        if (o == null) {
            var nome = d?.origem?.nome ?? (d?.origem?.elemento ?? "")
            return ["“" + titulo + "”: o elemento de origem (" + nome + ", em " + self.visao_label(data, d?.origem?.visao ?? "") + ") não existe mais — a visão ficou órfã."]
        }
        var tipo = o?.tipo ?? ""
        if ((d?.tipo ?? "") == "c4-component" && tipo != "container") {
            return ["“" + titulo + "”: um diagrama de componentes nasce de um contêiner de aplicação, mas a origem (" + (o?.nome ?? "") + ") agora é do tipo " + tipo + "."]
        }
        if ((d?.tipo ?? "") == "c4-container" && tipo != "sistema" && tipo != "sistema_externo") {
            return ["“" + titulo + "”: um diagrama de contêineres nasce de um sistema de software, mas a origem (" + (o?.nome ?? "") + ") é do tipo " + tipo + "."]
        }
        return []
    }

    // annotated: as visoes do modelo (e `extra`, os diagramas opcionais do
    // lote) anotadas como um lote — a coerencia entre os niveis — com os
    // avisos de origem pendurados em cada visao detalhada.
    annotated(data: any, extra: any[], infra: bool): any[] {
        var lote = C4Diagram.annotate({diagramas: self.views(data) + extra}, infra).diagramas
        var detalhes = self.detalhes(data)
        var out = []
        var i = 0
        for (var d in lote) {
            var item = d
            if (i >= 2 && i < 2 + detalhes.size()) item["avisos_lote"] = item.avisos_lote + self.origin_warnings(data, detalhes[i - 2])
            out += [item]
            i = i + 1
        }
        return out
    }

    // A visao detalhada `id`, anotada (previa de uma aba do editor).
    annotated_detail(data: any, id: string): any {
        var ids = self.detalhes(data).map((d) -> d?.id ?? "")
        var i = ids.index_of(id)
        if (i < 0) fail("visão detalhada inexistente: '" + id + "'")
        return self.annotated(data, [], false)[2 + i]
    }

    // --- Conformidade -----------------------------------------------------

    // check: as regras C4 de cada visao (C4Diagram.check), a coerencia entre
    // as duas (os avisos de lote de C4Diagram.annotate) e o que so o modelo
    // tem — o id reservado. Texto cru; warnings_html escapa.
    check(data: any): string[] {
        var out = []
        if ((self.sistema(data)?.nome ?? "").trim().is_empty()) out += ["Informe o nome do sistema de software em escopo."]
        var reservado = (data?.contexto?.elementos ?? []).filter((el) -> el.id == self.sistema_id()).map((el) -> el.nome).join(", ")
        if (!reservado.is_empty()) out += ["Contexto: o id “sistema” é reservado para o sistema em escopo — use outro id em " + reservado + "."]
        var lote = self.annotated(data, [], false)
        out += C4Diagram.check(lote[0]).map((a) -> "Contexto: " + a) + lote[0].avisos_lote
        out += C4Diagram.check(lote[1]).map((a) -> "Contêineres: " + a) + lote[1].avisos_lote
        var i = 2
        while (i < lote.size()) {
            var v = lote[i]
            out += C4Diagram.check(v).map((a) -> v.titulo + ": " + a) + v.avisos_lote
            i = i + 1
        }
        return out
    }

    warnings_html(data: any): string {
        var avisos = self.check(data)
        if (avisos.is_empty()) return ""
        return "<h2>Conformidade do modelo</h2><ul class=\"c4-warnings\">" + avisos.map((a) -> "<li>" + html.escape(a) + "</li>").join("") + "</ul>"
    }

    // --- Pagina do modelo ---------------------------------------------------

    scope_html(data: any): string {
        var s = self.sistema(data)
        var descricao = s?.descricao ?? ""
        return "<p><strong>Sistema em escopo:</strong> " + html.escape(s?.nome ?? "") +
            (if (descricao.is_empty()) "" else " — " + html.escape(descricao)) + " " + Cite.badges(s?.fontes ?? []) + "</p>"
    }

    // Legenda unica das visoes: os tipos presentes em qualquer uma.
    legend(data: any): string {
        var elementos = []
        var relacoes = []
        for (var v in self.views(data)) {
            elementos = elementos + v.elementos
            relacoes = relacoes + v.relacoes
        }
        return C4Diagram.legend({diagram_type: "c4-container", elementos, relacoes})
    }

    // "Detalha “API de Pedidos” (Contêineres)" — a linha de origem de uma
    // visao detalhada na pagina do modelo.
    origin_html(data: any, d: any): string {
        var o = self.origin(data, d)
        var nome = if (o == null) (d?.origem?.nome ?? "") + " (inexistente)" else (o?.nome ?? "")
        return "<p class=\"fontes\">Detalha “" + html.escape(nome) + "” (" + html.escape(self.visao_label(data, d?.origem?.visao ?? "")) + ") " + Cite.badges(d?.fontes ?? []) + "</p>"
    }
}

tool ArchModelFixtures {
    loja(): any -> {
        sistema: {nome: "Loja", descricao: "Vende online", fontes: ["brief"]},
        contexto: {
            elementos: [
                {id: "erp", nome: "ERP", tipo: "sistema_externo", tecnologia: "", descricao: "Faturamento", fontes: ["requisitos/IR-001"]},
                {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "Compra produtos", fontes: ["requisitos/FR-001"]},
            ],
            relacoes: [
                {de: "cliente", para: "sistema", descricao: "Compra produtos em", tecnologia: "", fontes: ["requisitos/FR-001"]},
                {de: "sistema", para: "erp", descricao: "Envia faturas para", tecnologia: "", fontes: ["requisitos/IR-001"]},
            ],
        },
        conteineres: {
            fronteiras: [{id: "loja", nome: "Loja", descricao: "", fontes: ["brief"]}],
            elementos: [
                {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "Compra produtos", fronteira: "", fontes: ["requisitos/FR-001"]},
                {id: "web", nome: "Loja Web", tipo: "container", tecnologia: "React", descricao: "Vitrine e carrinho", fronteira: "loja", fontes: ["adr/ADR-001-front"]},
                {id: "api", nome: "API de Pedidos", tipo: "container", tecnologia: "Java/Quarkus", descricao: "Recebe pedidos", fronteira: "loja", fontes: ["adr/ADR-002-java"]},
                {id: "db", nome: "Banco de Pedidos", tipo: "banco_dados", tecnologia: "PostgreSQL", descricao: "Guarda pedidos", fronteira: "loja", fontes: ["adr/ADR-003-banco"]},
                {id: "erp", nome: "ERP", tipo: "sistema_externo", tecnologia: "", descricao: "Faturamento", fronteira: "", fontes: ["requisitos/IR-001"]},
            ],
            relacoes: [
                {de: "cliente", para: "web", descricao: "Faz pedidos em", tecnologia: "HTTPS", fontes: ["requisitos/FR-001"]},
                {de: "web", para: "api", descricao: "Envia pedidos para", tecnologia: "HTTPS/JSON", fontes: ["inferência"]},
                {de: "api", para: "db", descricao: "Lê e grava pedidos em", tecnologia: "JDBC", fontes: ["inferência"]},
                {de: "api", para: "erp", descricao: "Envia faturas para", tecnologia: "REST", fontes: ["requisitos/IR-001"]},
            ],
        },
        gaps: [],
    }
}

// Loja com um diagrama de componentes da API e um de conteineres do ERP.
tool ArchDetailFixtures {
    componentes_api(): any -> {
        id: "DET-001", tipo: "c4-component", titulo: "", descricao: "Recebimento de pedidos", fontes: ["inferência"],
        origem: {visao: "conteineres", elemento: "api", nome: "API de Pedidos"},
        fronteiras: [],
        elementos: [
            {id: "web", nome: "Loja Web", tipo: "container", tecnologia: "React", descricao: "Vitrine", fronteira: "", fontes: ["modelo"]},
            {id: "ctrl", nome: "Controlador de Pedidos", tipo: "componente", tecnologia: "JAX-RS", descricao: "Recebe pedidos", fronteira: "", fontes: ["inferência"]},
        ],
        relacoes: [{de: "web", para: "ctrl", descricao: "Envia pedidos para", tecnologia: "HTTPS/JSON", fontes: ["inferência"]}],
    }

    conteineres_erp(): any -> {
        id: "DET-002", tipo: "c4-container", titulo: "ERP por dentro", descricao: "", fontes: ["inferência"],
        origem: {visao: "contexto", elemento: "erp", nome: "ERP"},
        fronteiras: [{id: "erp", nome: "ERP", descricao: "", fontes: ["inferência"]}],
        elementos: [
            {id: "loja", nome: "Loja", tipo: "sistema_externo", tecnologia: "", descricao: "Envia faturas", fronteira: "", fontes: ["modelo"]},
            {id: "fat", nome: "Faturador", tipo: "container", tecnologia: "SAP", descricao: "Emite notas", fronteira: "erp", fontes: ["inferência"]},
        ],
        relacoes: [{de: "loja", para: "fat", descricao: "Envia faturas para", tecnologia: "REST", fontes: ["inferência"]}],
    }

    loja(): any {
        var m = ArchModelFixtures.loja()
        m["detalhes"] = [self.componentes_api(), self.conteineres_erp()]
        return m
    }
}

test ArchModelDetailSpec {
    describe details_become_views_after_context_and_container {
        var views = ArchModel.views(ArchDetailFixtures.loja())
        are_equal(views.map((v) -> v.titulo), ["Contexto de sistema — Loja", "Contêineres — Loja", "Componentes — API de Pedidos", "Contêineres — ERP por dentro"])
        are_equal(views[2].diagram_type, "c4-component")
        are_equal(views[2].escopo.nome, "API de Pedidos")
        are_equal(views[2].escopo.descricao, "Recebe pedidos")
        is_true(views[2].derivado_do_modelo)
        are_equal(views[3].fronteiras.size(), 1)
    }

    describe a_clean_model_with_details_has_no_warnings {
        are_equal(ArchModel.check(ArchDetailFixtures.loja()), [])
    }

    describe renaming_the_origin_renames_the_scope {
        var m = ArchDetailFixtures.loja()
        var conteineres = m.conteineres
        var elementos = []
        for (var el in conteineres.elementos) {
            var e = el
            if (e.id == "api") e["nome"] = "API de Vendas"
            elementos += [e]
        }
        conteineres["elementos"] = elementos
        m["conteineres"] = conteineres
        var v = ArchModel.views(m)[2]
        are_equal(v.titulo, "Componentes — API de Vendas")
        are_equal(v.escopo.nome, "API de Vendas")
    }

    describe a_detail_whose_origin_is_gone_is_orphan_but_still_drawn {
        var m = ArchDetailFixtures.loja()
        var conteineres = m.conteineres
        conteineres["elementos"] = conteineres.elementos.filter((el) -> el.id != "api")
        conteineres["relacoes"] = conteineres.relacoes.filter((r) -> r.de != "api" && r.para != "api")
        m["conteineres"] = conteineres
        var avisos = ArchModel.check(m).join(" | ")
        is_true(avisos.contains("“Componentes — API de Pedidos”: o elemento de origem (API de Pedidos, em Contêineres) não existe mais — a visão ficou órfã."))
        are_equal(ArchModel.views(m)[2].escopo.nome, "API de Pedidos")
        is_true(ArchModel.origin_html(m, m.detalhes[0]).contains("API de Pedidos (inexistente)"))
    }

    describe a_component_view_needs_an_application_container {
        var m = ArchDetailFixtures.loja()
        var d = ArchDetailFixtures.componentes_api()
        d["origem"] = {visao: "conteineres", elemento: "db", nome: "Banco de Pedidos"}
        m["detalhes"] = [d]
        is_true(ArchModel.check(m).join(" | ").contains("nasce de um contêiner de aplicação, mas a origem (Banco de Pedidos) agora é do tipo banco_dados"))
    }

    describe a_container_view_of_an_external_system_is_coherent_with_the_context {
        var lote = ArchModel.annotated(ArchDetailFixtures.loja(), [], false)
        are_equal(lote[3].avisos_lote, [])
    }

    describe a_component_view_can_be_born_from_another_detail {
        var m = ArchDetailFixtures.loja()
        var d = ArchDetailFixtures.componentes_api()
        d["id"] = "DET-003"
        d["origem"] = {visao: "DET-002", elemento: "fat", nome: "Faturador"}
        d["elementos"] = [{id: "nf", nome: "Emissor de NF", tipo: "componente", tecnologia: "ABAP", descricao: "Gera a nota", fronteira: "", fontes: ["inferência"]}]
        d["relacoes"] = []
        m["detalhes"] = m.detalhes + [d]
        var v = ArchModel.views(m)[4]
        are_equal(v.titulo, "Componentes — Faturador")
        is_true(ArchModel.origin_html(m, d).contains("(Contêineres — ERP por dentro)"))
        are_equal(ArchModel.origin_warnings(m, d), [])
    }

    describe annotated_detail_finds_the_view_by_id {
        var v = ArchModel.annotated_detail(ArchDetailFixtures.loja(), "DET-002")
        are_equal(v.titulo, "Contêineres — ERP por dentro")
        var raised = ""
        try { ArchModel.annotated_detail(ArchDetailFixtures.loja(), "DET-999") } catch (e) { raised = "${e}" }
        is_true(raised.contains("visão detalhada inexistente"))
    }

    describe the_llm_component_diagram_of_a_detailed_container_is_dropped {
        var lote = [
            {diagram_type: "c4-component", escopo: {nome: "api de pedidos"}},
            {diagram_type: "c4-component", escopo: {nome: "Loja Web"}},
            {diagram_type: "sequence"},
        ]
        are_equal(ArchModel.optional_diagrams(lote, ArchDetailFixtures.loja()).map((d) -> d?.escopo?.nome ?? d.diagram_type), ["Loja Web", "sequence"])
        are_equal(ArchModel.optional_diagrams(lote).size(), 3)
    }

    describe the_legend_covers_components {
        is_true(ArchModel.legend(ArchDetailFixtures.loja()).contains("Componente"))
    }
}

test ArchModelSpec {
    describe a_clean_model_has_no_warnings {
        are_equal(ArchModel.check(ArchModelFixtures.loja()), [])
    }

    describe context_puts_the_system_after_the_people_and_keeps_its_own_relations {
        var ctx = ArchModel.context(ArchModelFixtures.loja())
        are_equal(ctx.diagram_type, "c4-context")
        are_equal(ctx.titulo, "Contexto de sistema — Loja")
        is_true(ctx.derivado_do_modelo)
        are_equal(ctx.elementos.map((el) -> el.id), ["cliente", "sistema", "erp"])
        are_equal(ctx.elementos[1].tipo, "sistema")
        are_equal(ctx.elementos[1].descricao, "Vende online")
        are_equal(ctx.relacoes.map((r) -> r.descricao), ["Compra produtos em", "Envia faturas para"])
        is_true(C4Diagram.mermaid_source(ctx).contains("n0 -->|\"Compra produtos em\"| n1"))
    }

    describe a_model_without_boundaries_keeps_the_single_scope_boundary {
        var m = ArchModelFixtures.loja()
        var conteineres = m.conteineres
        conteineres["fronteiras"] = []
        m["conteineres"] = conteineres
        var cont = ArchModel.container(m)
        is_true(C4Diagram.mermaid_source(cont).contains("subgraph b0[\"<b>Loja</b><br/>[Sistema de software]\"]"))
        are_equal(ArchModel.check(m), [])
    }

    describe container_is_the_container_diagram_as_written {
        var cont = ArchModel.container(ArchModelFixtures.loja())
        are_equal(cont.titulo, "Contêineres — Loja")
        are_equal(cont.escopo.nome, "Loja")
        are_equal(cont.elementos.size(), 5)
        are_equal(cont.relacoes.size(), 4)
        is_true(C4Diagram.mermaid_source(cont).contains("subgraph b0[\"<b>Loja</b><br/>[Sistema de software]\"]"))
    }

    describe each_view_is_checked_against_its_c4_rules {
        var m = ArchModelFixtures.loja()
        m["contexto"] = {
            elementos: [
                {id: "sistema", nome: "Reservado", tipo: "pessoa", tecnologia: "", descricao: "", fontes: []},
                {id: "erp", nome: "ERP", tipo: "sistema_externo", tecnologia: "SAP", descricao: "", fontes: []},
            ],
            relacoes: [{de: "sistema", para: "zzz", descricao: "Usa", tecnologia: "", fontes: []}],
        }
        m["conteineres"] = {
            elementos: [
                {id: "api", nome: "API", tipo: "container", tecnologia: "", descricao: "", fontes: []},
                {id: "db", nome: "Banco", tipo: "banco_dados", tecnologia: "PG", descricao: "", fontes: []},
            ],
            relacoes: [{de: "api", para: "db", descricao: "Grava em", tecnologia: "", fontes: []}],
        }
        var avisos = ArchModel.check(m).join(" | ")
        is_true(avisos.contains("Contexto: o id “sistema” é reservado"))
        is_true(avisos.contains("Contexto: Contexto não deve mostrar tecnologias: ERP"))
        is_true(avisos.contains("Contexto: Relação aponta para um elemento inexistente: sistema → zzz"))
        is_true(avisos.contains("Contêineres: Contêiner sem tecnologia definida: API"))
        is_true(avisos.contains("Contêineres: Comunicação entre contêineres sem tecnologia/protocolo: API → Banco"))
    }

    // Elementos repetidos entre os niveis sao esperados; nomes que nao batem
    // viram aviso, nunca bloqueio.
    describe levels_that_disagree_only_warn {
        var m = ArchModelFixtures.loja()
        var conteineres = m.conteineres
        conteineres["elementos"] = conteineres.elementos + [{id: "banco-central", nome: "Banco Central", tipo: "sistema_externo", tecnologia: "", descricao: "", fronteira: "", fontes: []}]
        conteineres["relacoes"] = conteineres.relacoes + [{de: "api", para: "banco-central", descricao: "Reporta a", tecnologia: "REST", fontes: []}]
        m["conteineres"] = conteineres
        are_equal(ArchModel.check(m), ["“Banco Central” aparece aqui mas não no diagrama de contexto."])
    }

    describe the_system_name_is_required {
        var m = ArchModelFixtures.loja()
        m["sistema"] = {nome: "", descricao: "", fontes: []}
        is_true(ArchModel.check(m).join(" ").contains("Informe o nome do sistema"))
    }

    describe a_model_without_views_renders_empty_views {
        var vazio = {sistema: {nome: "X", descricao: "", fontes: []}, gaps: []}
        are_equal(ArchModel.context(vazio).elementos.size(), 1)
        are_equal(ArchModel.container(vazio).elementos.size(), 0)
    }

    describe optional_diagrams_drops_context_and_container {
        var lote = [{diagram_type: "c4-context"}, {diagram_type: "sequence"}, {diagram_type: "c4-container"}, {diagram_type: "c4-deployment"}]
        are_equal(ArchModel.optional_diagrams(lote).map((d) -> d.diagram_type), ["sequence", "c4-deployment"])
    }

    describe legend_covers_both_views {
        var legenda = ArchModel.legend(ArchModelFixtures.loja())
        is_true(legenda.contains("Sistema de software"))
        is_true(legenda.contains("Contêiner: banco de dados"))
        is_true(legenda.contains("Fronteira do sistema em escopo"))
    }

    describe warnings_and_scope_escape_names {
        var m = ArchModelFixtures.loja()
        m["sistema"] = {nome: "<x>", descricao: "", fontes: []}
        is_true(ArchModel.scope_html(m).contains("&lt;x&gt;"))
        var conteineres = m.conteineres
        conteineres["elementos"] = conteineres.elementos + [{id: "solto", nome: "<Solto>", tipo: "container", tecnologia: "Go", descricao: "", fronteira: "loja", fontes: []}]
        m["conteineres"] = conteineres
        is_true(ArchModel.warnings_html(m).contains("Elemento sem nenhuma relação no diagrama: &lt;Solto&gt;"))
    }
}
