// Instrucoes, schemas e templates dos artefatos que Discovery e Delivery
// compartilham. A geracao em si esta em common_drafts.mh; a gravacao, em
// artifact_commit.mh.

import { WorkflowsRoot, SchemaFile } from "../core/workflows_root.mh"

export prompt ArtifactSchema() from "artifact_schema.prompt.md"

// `feedback_content` e sempre ChangesBlock.for_artifact: todos os pedidos de
// mudanca ja feitos para o item, nao so o ultimo (ver changes_log.mh).
export prompt BriefInstruction(schema_conventions: prompt, wiki_content: string, feedback_content: string) from "prompts/brief.prompt.md"
export prompt AtributosInstruction(schema_conventions: prompt, brief_content: string, wiki_content: string, feedback_content: string) from "prompts/atributos.prompt.md"
export prompt RequisitosInstruction(schema_conventions: prompt, brief_content: string, wiki_content: string, feedback_content: string) from "prompts/requisitos.prompt.md"
// Daqui em diante nenhuma instrucao recebe a wiki: o que ela tem de
// relevante ja foi destilado em brief/atributos/requisitos, e a wiki inteira
// estoura o limite de linha de comando do Windows (~32K) para backends que
// recebem o prompt por argv.
export prompt AdrInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, feedback_content: string) from "prompts/adr.prompt.md"
// DER e diagramas exigem as ADRs: o nivel fisico do DER so existe depois que
// uma ADR escolheu o banco, e as tecnologias dos conteineres e a
// infraestrutura de implantacao sao decisoes registradas nelas.
export prompt DerInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, adr_content: string, feedback_content: string) from "prompts/der.prompt.md"
export prompt DiagramasInstruction(schema_conventions: prompt, requisitos_content: string, atributos_content: string, adr_content: string, feedback_content: string) from "prompts/diagramas.prompt.md"

// Historias de uma feature e plano de uma historia recebem todo o contexto
// tecnico (TechContext em common_drafts.mh): sem ele a historia nao sabe que
// conteiner altera, que entidades toca nem que decisoes respeitar.
// SpecConventions pede rastreabilidade e contratos estruturados (historia_spec.mh).
export prompt SpecConventions() from "prompts/spec_conventions.prompt.md"
export prompt PlanoInstruction(schema_conventions: prompt, historia_content: string, feature_content: string, requisitos_content: string, atributos_content: string, adr_content: string, der_content: string, diagramas_content: string, feedback_content: string) from "prompts/plano.prompt.md"
export prompt HistoriasInstruction(schema_conventions: prompt, spec_conventions: prompt, feature_content: string, requisitos_content: string, atributos_content: string, adr_content: string, der_content: string, diagramas_content: string, feedback_content: string) from "prompts/historias.prompt.md"

prompt HistoriasSchemaContent() from "schemas/historias.schema.json"
prompt BriefSchemaContent() from "schemas/brief.schema.json"
prompt AtributosSchemaContent() from "schemas/atributos.schema.json"
prompt RequisitosSchemaContent() from "schemas/requisitos.schema.json"
prompt AdrSchemaContent() from "schemas/adr.schema.json"
prompt DerSchemaContent() from "schemas/der.schema.json"
prompt DiagramasSchemaContent() from "schemas/diagramas.schema.json"
prompt PlanoSchemaContent() from "schemas/plano.schema.json"

export tool Schemas {
    brief(): SchemaFile -> WorkflowsRoot.schema(BriefSchemaContent(), "shared/artifacts/schemas/brief.schema.json")
    atributos(): SchemaFile -> WorkflowsRoot.schema(AtributosSchemaContent(), "shared/artifacts/schemas/atributos.schema.json")
    requisitos(): SchemaFile -> WorkflowsRoot.schema(RequisitosSchemaContent(), "shared/artifacts/schemas/requisitos.schema.json")
    adr(): SchemaFile -> WorkflowsRoot.schema(AdrSchemaContent(), "shared/artifacts/schemas/adr.schema.json")
    der(): SchemaFile -> WorkflowsRoot.schema(DerSchemaContent(), "shared/artifacts/schemas/der.schema.json")
    diagramas(): SchemaFile -> WorkflowsRoot.schema(DiagramasSchemaContent(), "shared/artifacts/schemas/diagramas.schema.json")
    historias(): SchemaFile -> WorkflowsRoot.schema(HistoriasSchemaContent(), "shared/artifacts/schemas/historias.schema.json")
    plano(): SchemaFile -> WorkflowsRoot.schema(PlanoSchemaContent(), "shared/artifacts/schemas/plano.schema.json")
}

export prompt BriefBody(resumo_executivo: string, resumo_fontes: string, contexto_negocio: string, contexto_fontes: string, objetivos_tabela: string, em_escopo_lista: string, fora_escopo_lista: string, stakeholders_tabela: string, metricas_tabela: string, marcos_tabela: string, riscos_tabela: string, perguntas_lista: string) from "templates/brief_body.html"
export prompt AtributosBody(contexto: string, contexto_fontes: string, requisitos_tabela: string, restricoes_tabela: string, compliance_tabela: string, exclusoes_lista: string, perguntas_lista: string) from "templates/atributos_body.html"
export prompt RequisitosBody(contexto: string, contexto_fontes: string, funcionais_tabela: string, integracoes_tabela: string, dados_tabela: string, negocio_tabela: string, regras_tabela: string, exclusoes_lista: string, gaps_lista: string, perguntas_lista: string) from "templates/requisitos_body.html"
export prompt AdrBody(
    status: string,
    contexto_e_problema: string, contexto_fontes: string,
    fatores_decisao_lista: string,
    opcoes_consideradas_lista: string,
    decisao_final: string, decisao_final_fontes: string,
    consequencias_positivas_lista: string, consequencias_negativas_lista: string,
    opcoes_pros_contras: string,
    links_lista: string
) from "templates/adr_body.html"
export prompt DerBody(modo: string, nivel: string, contexto: string, contexto_fontes: string, avisos_html: string, diagramas_html: string, legenda_html: string, entidades_tabela: string, atributos_tabela: string, confirmados_tabela: string, inferidos_tabela: string, delta_lista: string, gaps_lista: string, questoes_lista: string) from "templates/der_body.html"
// DER gravado antes do modelo estruturado (DerModel) — Mermaid livre e
// relacionamentos em texto; so renderiza, com um aviso pedindo regeneracao.
export prompt DerLegacyBody(modo: string, contexto: string, contexto_fontes: string, diagrama_mermaid: string, entidades_tabela: string, confirmados_tabela: string, inferidos_tabela: string, atributos_tabela: string, delta_lista: string, gaps_lista: string, questoes_lista: string) from "templates/der_legacy_body.html"
export prompt DiagramaBody(tipo_label: string, hierarchy_level: string, escopo_html: string, descricao: string, descricao_fontes: string, avisos_html: string, diagrama_mermaid: string, legenda_html: string, elementos_html: string, relacoes_html: string) from "templates/diagrama_body.html"

// FeatureBody/HistoriaBody sao o corpo de UM item de feature/historia — o
// mesmo formato serve tanto pro item dentro do backlog do Discovery quanto
// pro detalhamento final do Delivery (a diferenca entre os dois nunca esta
// na FORMA renderizada, so em quais dados entram e onde o arquivo e gravado).
export prompt FeatureBody(avisos_html: string, classificacao_lista: string, hipotese_beneficio: string, hipotese_beneficio_fontes: string, itens_habilitados_lista: string, resumo: string, resumo_fontes: string, objetivo: string, objetivo_fontes: string, personas_tabela: string, em_escopo_lista: string, fora_escopo_lista: string, regras_lista: string, interacoes_lista: string, criterios_lista: string, historias_lista: string, dependencias_lista: string, dependencias_sistema_lista: string, gaps_lista: string, questoes_lista: string) from "templates/feature_body.html"
export prompt HistoriaBody(statement: string, statement_fontes: string, avisos_html: string, atributos_lista: string, contexto_html: string, criterios_lista: string, cenarios_html: string, regras_html: string, dod_html: string, dependencias_html: string, fora_escopo_html: string, exemplo_html: string, rastreabilidade_html: string, contratos_html: string, gaps_html: string, questoes_html: string) from "templates/historia_body.html"

// PlanoBody — o plano mora na pasta da historia (historias/<...>/<USxxx>/
// plano.html), dois ou tres niveis abaixo de artifacts/ conforme o workflow:
// `assets_prefix` e o caminho relativo ate artifacts/ para o mermaid.min.js.
export prompt PlanoBody(historia_titulo: string, radahn_badge: string, avisos_html: string, abordagem: string, abordagem_fontes: string, componentes_tabela: string, adrs_tabela: string, dados_tabela: string, fluxo_html: string, erros_lista: string, seguranca_lista: string, observabilidade_lista: string, tarefas_tabela: string, testes_tabela: string, cobertura_html: string, radahn_html: string, riscos_lista: string, assets_prefix: string) from "templates/plano_body.html"

// DependenciasBody — Discovery-only (a "dependência entre features" só faz
// sentido quando o work-item tem um backlog de mais de uma feature; Delivery
// nunca gera isso), mas o template de renderização mora aqui junto dos
// outros pela mesma razão que FeatureBody/HistoriaBody moram: é a única
// parte compartilhável entre o que gera o artefato (discovery.partial.
// backlog.mh, ao lado de Features) e como ele vira HTML.
export prompt DependenciasBody(mapa_tabela: string, ordem_tabela: string, diagrama_mermaid: string, gaps_lista: string) from "templates/dependencias_body.html"

test SchemaFileSpec {
    describe exposes_schema_content_and_codex_file_path {
        var schema_file = Schemas.atributos()
        var parsed = json.parse(schema_file.content)
        are_equal(parsed.type, "object")
        are_equal(schema_file.path, "workflows/shared/artifacts/schemas/atributos.schema.json")
    }
}
