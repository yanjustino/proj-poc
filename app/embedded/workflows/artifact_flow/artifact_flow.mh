// O fluxo comum de geracao de artefatos: Dispatch -> Generate -> Gate (pausa
// no Modo Buddy) -> Commit. Discovery, Delivery e Comite sao aliases deste
// workflow interno (discovery.mh, delivery.mh, comite.mh), cada um fixando
// `level`; o que muda por artefato mora nas tools de cada nivel, despachadas
// por ArtifactLevels.

import { Paths } from "../shared/core/paths.mh"
import { ChangesBlock } from "../shared/artifacts/changes_log.mh"
import { Activity } from "../shared/artifacts/activity_log.mh"
import { Telemetry } from "../shared/telemetry/telemetry.mh"
import { Draft } from "../shared/artifacts/draft.mh"
import { DiscoveryArtifact, DiscoveryKinds, DiscoveryDrafts, DiscoveryCommits } from "../discovery/discovery_artifacts.mh"
import { DeliveryArtifact, DeliveryMode, DeliveryKinds, DeliveryDrafts, DeliveryCommits } from "../delivery/delivery_artifacts.mh"
import { ComiteArtifact, ComiteKinds, ComiteDrafts, ComiteCommits } from "../comite/comite_artifacts.mh"

export enum Level { discovery, delivery, comite }

// Todo artefato de algum nivel. A entrada recusa qualquer outro nome; cada
// nivel aceita so os seus (DiscoveryArtifact / DeliveryArtifact /
// ComiteArtifact).
export enum Artifact { brief, atributos, requisitos, adr, der, modelo, diagramas, features, feature, historia, historias, plano, demanda, rfc, decisoes, artefatos, metricas }

// Entrada de ArtifactFlow. Campos que um nivel nao usa ficam ausentes, e
// todo campo opcional chega como null: os defaults moram em ArtifactLevels e
// nos `??` dos steps.
//
// - mode: Delivery (obrigatorio la), o modo do projeto (o artefato final e o
//   proprio modo).
// - feature_id: Discovery, a feature das historias e do plano.
// - historia_id: plano de implementacao, a historia (ex.: "US0001"); no
//   Delivery em modo historia, ignorado.
// - approval_data/approval_tokens_*: aprovacao de um rascunho revisado. A UI
//   envia o pending_data de uma run pausada e Dispatch vai direto ao Commit,
//   sem chamar a LLM. Serve tambem para um checkpoint criado por outra versao
//   deste workflow.
// - feedback: pedido de mudanca. Chega no resume de uma run pausada (Gate) ou
//   num StartRun novo sobre um artefato ja aprovado (Dispatch); nos dois
//   casos custa exatamente uma geracao.
// - autorrevisao: (auto_review.mh) com avisos de conformidade na geracao, uma
//   unica chamada extra pede a correcao antes da pausa.
//
// (Os comentarios ficam fora das chaves porque a gramatica do vscode-mhl
// 0.6.9 nao reconhece `//` dentro de um type.)
export type FlowInput = {
    level: Level,
    project_id: string,
    artifact: Artifact,
    mode?: DeliveryMode,
    feature_id?: string,
    historia_id?: string,
    buddy?: bool,
    approved?: bool,
    approval_data?: any,
    approval_tokens_in?: number,
    approval_tokens_out?: number,
    feedback?: string,
    autorrevisao?: bool,
}

export type FlowOutput = {
    artifact: Artifact, 
    result: any, 
    tokens_in: number, 
    tokens_out: number
}

export tool ArtifactLevels {
    // Valida a combinacao de entradas do nivel antes de qualquer geracao.
    check(req: FlowInput) -> match req.level {
        Level.discovery -> DiscoveryKinds.check(self.discovery(req), self.feature_id(req), self.historia_id(req))
        Level.delivery  -> DeliveryKinds.check(self.mode(req), self.delivery(req))
        Level.comite    -> ComiteKinds.check(self.comite(req))
    }

    // Chave que separa o historico (ChangesLog, ActivityLog) de cada item.
    scope(req: FlowInput): string -> match req.level {
        Level.discovery -> DiscoveryKinds.scope(self.discovery(req), self.feature_id(req), self.historia_id(req))
        Level.delivery  -> DeliveryKinds.scope(self.delivery(req), self.historia_id(req))
        Level.comite    -> ComiteKinds.scope(self.comite(req))
    }

    draft(req: FlowInput): Draft -> match req.level {
        Level.discovery -> DiscoveryDrafts.of(self.discovery(req), req.project_id, self.feature_id(req), self.historia_id(req), req.autorrevisao ?? false)
        Level.delivery  -> DeliveryDrafts.of(self.delivery(req), req.project_id, self.mode(req), self.historia_id(req), req.autorrevisao ?? false)
        Level.comite    -> ComiteDrafts.of(self.comite(req), req.project_id, req.autorrevisao ?? false)
    }

    commit(req: FlowInput, draft: Draft): any -> match req.level {
        Level.discovery -> DiscoveryCommits.of(self.discovery(req), req.project_id, self.feature_id(req), self.historia_id(req), draft)
        Level.delivery  -> DeliveryCommits.of(self.delivery(req), req.project_id, self.mode(req), self.historia_id(req), draft)
        Level.comite    -> ComiteCommits.of(self.comite(req), req.project_id, draft)
    }

    internal discovery(req: FlowInput): DiscoveryArtifact -> DiscoveryArtifact.parse("${req.artifact}")
    internal delivery(req: FlowInput): DeliveryArtifact -> DeliveryArtifact.parse("${req.artifact}")
    internal comite(req: FlowInput): ComiteArtifact -> ComiteArtifact.parse("${req.artifact}")

    internal mode(req: FlowInput): DeliveryMode {
        if (req.mode == null) fail("'mode' e obrigatorio no Delivery (use feature | historia)")
        return req.mode
    }
    internal feature_id(req: FlowInput): string -> req.feature_id ?? ""
    internal historia_id(req: FlowInput): string -> req.historia_id ?? ""
}

export internal workflow ArtifactFlow(req: FlowInput): FlowOutput {
    // pending_data/tokens_in/tokens_out/current_artifact sao lidos pelo app
    // numa run pausada (checkpoint-recovery.js, run-tracker.js).
    var result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var pending_data = null
    // Chave do historico deste item (ArtifactLevels.scope), fixada no Dispatch.
    var scope = ""
    // Garante que um pedido de mudanca gera uma unica regeneracao (req e
    // somente leitura). Volta a false antes de cada pausa, liberando o
    // proximo pedido.
    var feedback_consumed = false

    step_end: (ctx) -> Telemetry.step_end(ctx, self.req.project_id, "${self.req.artifact}", self.tokens_in, self.tokens_out)

    step Dispatch {
        Paths.ensure_valid(req.project_id)
        ArtifactLevels.check(req)
        self.current_artifact = "${req.artifact}"
        self.scope = ArtifactLevels.scope(req)
        var approved = req.approved ?? false
        if (approved && req.approval_data != null) {
            self.pending_data = req.approval_data
            self.tokens_in = req.approval_tokens_in ?? 0
            self.tokens_out = req.approval_tokens_out ?? 0
            Activity.record(req.project_id, "approved", current_artifact, scope)
            goto Commit
        }
        var feedback = req.feedback ?? ""
        if ((req.buddy ?? false) && !approved && !feedback.is_empty()) {
            self.feedback_consumed = true
            ChangesBlock.record(req.project_id, current_artifact, scope, feedback)
        }
        Activity.record(req.project_id, "started", current_artifact, scope)
        goto Generate
    }

    step Generate {
        var draft = ArtifactLevels.draft(req)
        self.pending_data = draft.data
        self.{tokens_in, tokens_out} = draft
        goto Gate
    }

    // Pausar nunca custa uma nova chamada de LLM: o rascunho ja esta em
    // pending_data. No resume, approved:true grava; approved:false com
    // feedback registra o pedido (ChangesBlock) e regenera com todo o
    // historico de pedidos deste item; sem feedback, pausa de novo.
    step Gate {
        var buddy = req.buddy ?? false
        if (buddy && !(req.approved ?? false)) {
            var feedback = req.feedback ?? ""
            if (!feedback.is_empty() && !self.feedback_consumed) {
                self.feedback_consumed = true
                ChangesBlock.record(req.project_id, current_artifact, scope, feedback)
                goto Generate
            }
            self.feedback_consumed = false
            Activity.record(req.project_id, "draft_ready", current_artifact, scope)
            pause("revise o conteudo de '${current_artifact}' antes de gravar em artifacts/")
        }
        if (buddy) Activity.record(req.project_id, "approved", current_artifact, scope)
        goto Commit
    }

    step Commit {
        var draft = {data: pending_data, tokens_in, tokens_out}
        self.result = ArtifactLevels.commit(req, draft)
        complete()
    }

    output: {artifact: req.artifact, result, tokens_in, tokens_out}
}

// Artifact e a uniao, mantida a mao, dos artefatos de cada nivel: um
// artefato novo num nivel e esquecido aqui so falharia em runtime.
test ArtifactFlowSpec {
    describe artifact_is_exactly_the_union_of_the_level_artifacts {
        var all = Artifact.values().map((a) -> "${a}")
        var levels = [DiscoveryArtifact.values(), DeliveryArtifact.values(), ComiteArtifact.values()].map((vs) -> vs.map((v) -> "${v}"))
        for (var names in levels) {
            are_equal(names.filter((n) -> !all.contains(n)), [])
        }
        are_equal(all.filter((n) -> levels.filter((names) -> names.contains(n)).size() == 0), [])
    }
}
