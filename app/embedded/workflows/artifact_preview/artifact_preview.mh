    describe incoherent_story_is_flagged_and_empty_sections_are_omitted {
        var run = ArtifactPreview.run(inputs: {
            artifact: "historia",
            data: {
                titulo: "Migrar base", como: "desenvolvedor", quero: "migrar", para: "x",
                resultado_tecnico: "", habilita: "", evidenciado_por: "", fontes: ["inferência"],
