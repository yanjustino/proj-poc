// Gera artefatos para projetos Feature ou Historia standalone. Artefatos
// comuns reutilizam os contratos de shared; feature/historia finais mantêm
// contratos próprios. Requisitos são obrigatórios para o artefato final;
// ADR, DER e diagramas são contextos opcionais.

import { Paths } from "../shared/core/paths.mh"
import { Writer } from "../shared/agents/agents.mh"
import { Context } from "../shared/artifacts/context.mh"
import { Slug } from "../shared/core/slug.mh"
import { ArtifactId } from "../shared/artifacts/artifact_id.mh"
import { PageShell, ArtifactMeta } from "../shared/artifacts/page_shell.mh"
import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { WorkflowsRoot } from "../shared/core/workflows_root.mh"
import {
    ArtifactSchema, FeedbackBlock,
    BriefInstruction, RequisitosInstruction, AdrInstruction, DerInstruction, DiagramasInstruction,
    HistoriasInstruction,
    BriefSchemaFile, RequisitosSchemaFile, AdrSchemaFile, DerSchemaFile, DiagramasSchemaFile,
    HistoriasSchemaFile
} from "../shared/artifacts/artifacts_common.mh"

// Delivery nao tem atributos de qualidade proprio — este texto fixo e o que
// entra no lugar de `atributos_content` ao reaproveitar AdrInstruction/
// DerInstruction/DiagramasInstruction do Discovery (C3: decisao deterministica,
// nunca a LLM escolhendo se "tem ou nao" atributos).
tool NoAtributos {
    placeholder(): string ->
        "(não se aplica neste nível — Delivery não gera atributos de qualidade; considere apenas requisitos e wiki)"
}

// Artefato final — especifico de Delivery, um item so por vez (nao um
// backlog inteiro como o `features`/`historias` do Discovery).
prompt FeatureInstruction(
    schema_conventions: prompt,
    requisitos_content: string,
    adr_content: string,
    der_content: string,
    diagramas_content: string,
    wiki_content: string,
    feedback_content: string
) from "prompts/feature.prompt.md"

prompt HistoriaInstruction(
    schema_conventions: prompt,
    requisitos_content: string,
    adr_content: string,
    der_content: string,
    diagramas_content: string,
    wiki_content: string,
    feedback_content: string
) from "prompts/historia.prompt.md"

prompt FeatureSchemaContent() from "schemas/feature.schema.json"
prompt HistoriaSchemaContent() from "schemas/historia.schema.json"
tool FeatureSchemaFile {
    get(): {content: string, path: string} -> {
        content: FeatureSchemaContent(),
        path: WorkflowsRoot.resolve("delivery/schemas/feature.schema.json"),
    }
}

tool HistoriaSchemaFile {
    get(): {content: string, path: string} -> {
        content: HistoriaSchemaContent(),
        path: WorkflowsRoot.resolve("delivery/schemas/historia.schema.json"),
    }
}

workflow Delivery {
    description: "Gera brief, requisitos, ADR, DER, diagramas, detalhamento final e histórias para Feature ou Historia standalone."

    input project_id: string
    input mode: string        // "feature" | "historia"
    input artifact: string    // brief | requisitos | adr | der | diagramas | feature | historia | historias
    input buddy: bool = false
    input approved: bool = false
    // Passado no resume junto com approved:false (Modo Buddy's "Solicitar
    // mudancas" — reading-pane.js/tab-artefatos.js), nunca em StartRun.
    input feedback: string = ""

    var delivery_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var pending_data = null
    var pending_feedback = ""
    // Gate usa isto (nao um "feedback = ''" dentro do proprio Gate) pra
    // saber se o `feedback` atual ja foi consumido — spike real confirmou
    // que reatribuir uma variavel `input` NAO sobrevive a um goto pra outro
    // step: ela e re-vinculada ao valor original do resume toda vez que o
    // step e reexecutado, entao "limpar" `feedback` assim nunca gruda e o
    // Gate reentraria em *Generate pra sempre. `feedback_consumed` e uma
    // `var` normal (essas sim persistem entre steps, como `pending_data` ja
    // prova) — vira true no exato momento em que o comentario e consumido,
    // volta a false bem antes do proximo pause(), liberando o PROXIMO
    // resume com um `feedback` novo a reentrar no laco de novo.
    var feedback_consumed = false

    output: {
        artifact: artifact,
        result: delivery_result,
        tokens_in: tokens_in,
        tokens_out: tokens_out,
    }

    step Dispatch {
        project_id = Paths.ensure_valid(project_id)
        if (mode != "feature" && mode != "historia") fail("mode invalido: '" + mode + "' (use feature | historia)")

        if (artifact == "brief") goto BriefGenerate
        if (artifact == "requisitos") goto RequisitosGenerate
        if (artifact == "adr") goto AdrGenerate
        if (artifact == "der") goto DerGenerate
        if (artifact == "diagramas") goto DiagramasGenerate
        if (artifact == "feature" || artifact == "historia") {
            if (artifact != mode) fail("artifact '" + artifact + "' nao bate com mode '" + mode + "'")
            goto FinalGenerate
        }
        if (artifact == "historias") {
            if (mode != "feature") fail("'historias' so existe quando mode=\"feature\"")
            goto HistoriasGenerate
        }
        var final_artifacts = mode + (if (mode == "feature") " | historias" else "")
        fail(
            "artefato desconhecido: '" + artifact +
            "' (use brief | requisitos | adr | der | diagramas | " + final_artifacts + ")"
        )
    }

    // Gate compartilhado por todo artefato — mesma razao da Fase 3 (Modo
    // Buddy nunca custa refazer a chamada de LLM no resume).
    //
    // Um resume com approved:false + feedback preenchido (Modo Buddy's
    // "Solicitar mudancas") e diferente de um resume comum: em vez de
    // pausar de novo com o MESMO pending_data, volta pro *Generate do
    // artefato — refaz a chamada de LLM, desta vez com o comentario do
    // revisor anexado a instrucao (ver FeedbackBlock/feedback_content nas
    // *Instruction). Ver a nota de feedback_consumed acima pra por que o
    // guard usa aquela var, nao `feedback` diretamente — confirmado por
    // spike isolado (LoopProbe) que a versao anterior deste Gate (que
    // tentava `feedback = ""`) entrava num laco infinito de verdade: um
    // resume real bateu em produção, cada volta era uma chamada de LLM
    // nova. Corrigido e revalidado (3 ciclos: regenerar, regenerar de novo,
    // aprovar) antes desta versao.
    step Gate {
        if (buddy && !approved) {
            if (!feedback.is_empty() && !feedback_consumed) {
                feedback_consumed = true
                pending_feedback = feedback
                if (artifact == "brief") goto BriefGenerate
                if (artifact == "requisitos") goto RequisitosGenerate
                if (artifact == "adr") goto AdrGenerate
                if (artifact == "der") goto DerGenerate
                if (artifact == "diagramas") goto DiagramasGenerate
                if (artifact == "feature" || artifact == "historia") goto FinalGenerate
                if (artifact == "historias") goto HistoriasGenerate
            }
            feedback_consumed = false
            pause("revise o conteudo de '" + artifact + "' antes de gravar em artifacts/")
        }
        if (artifact == "brief") goto BriefCommit
        if (artifact == "requisitos") goto RequisitosCommit
        if (artifact == "adr") goto AdrCommit
        if (artifact == "der") goto DerCommit
        if (artifact == "diagramas") goto DiagramasCommit
        if (artifact == "feature" || artifact == "historia") goto FinalCommit
        if (artifact == "historias") goto HistoriasCommit
        fail("invariante violado: artefato desconhecido chegou ao Gate")
    }

    step BriefGenerate {
        current_artifact = "brief"
        var response = Writer.generate(
            prompt: BriefInstruction(
                schema_conventions: ArtifactSchema(),
                wiki_content: Context.wiki(project_id),
                feedback_content: FeedbackBlock.render(pending_feedback)
            ),
            schema_file: BriefSchemaFile.get(),
            project_id: project_id,
            artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step BriefCommit {
        var data = pending_data
        var body = ArtifactBody.brief(data)
        var rendered = PageShell(
            title: "Brief",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/brief.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "brief.html"), rendered)
        delivery_result = {artifact: "brief", path: "artifacts/brief.html"}
        goto Done
    }

    // brief e opcional em Delivery (SENPAI-REFINAMENTO-VISAO-GERAL.md): ao
    // contrario do Discovery, 'requisitos' nao falha se 'brief' nao existir —
    // so usa um texto fixo no lugar.
    step RequisitosGenerate {
        current_artifact = "requisitos"
        var brief_content = Context.artifact(project_id, "brief.html")
        if (brief_content.is_empty()) brief_content = "(não gerado para este projeto)"
        var response = Writer.generate(
            prompt: RequisitosInstruction(
                schema_conventions: ArtifactSchema(),
                brief_content: brief_content,
                wiki_content: Context.wiki(project_id),
                feedback_content: FeedbackBlock.render(pending_feedback)
            ),
            schema_file: RequisitosSchemaFile.get(),
            project_id: project_id,
            artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step RequisitosCommit {
        var data = pending_data
        var body = ArtifactBody.requisitos(data)
        var rendered = PageShell(
            title: "Requisitos",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/requisitos.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "requisitos.html"), rendered)
        delivery_result = {artifact: "requisitos", path: "artifacts/requisitos.html"}
        goto Done
    }

    step AdrGenerate {
        current_artifact = "adr"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'adr'")
        var response = Writer.generate(
            prompt: AdrInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: NoAtributos.placeholder(),
                wiki_content: Context.wiki(project_id),
                feedback_content: FeedbackBlock.render(pending_feedback)
            ),
            schema_file: AdrSchemaFile.get(), project_id: project_id, artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step AdrCommit {
        var data = pending_data
        var written = []
        dir.create(Paths.artifact(project_id, "adr"))
        for (var decision in data.decisions) {
            var id = ArtifactId.next_adr_id(project_id)
            var folder = ArtifactId.folder_name(id, decision.titulo)
            var body = ArtifactBody.adr(decision)
            var rendered = PageShell(
                title: html.escape(id + " — " + decision.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/adr/" + folder + ".html", tokens_in, tokens_out)
            )
            fs.write(Paths.artifact(project_id, "adr/" + folder + ".html"), rendered)
            written += [folder]
        }
        delivery_result = {artifact: "adr", written: written}
        goto Done
    }

    step DerGenerate {
        current_artifact = "der"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'der'")
        var response = Writer.generate(
            prompt: DerInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: NoAtributos.placeholder(),
                wiki_content: Context.wiki(project_id),
                feedback_content: FeedbackBlock.render(pending_feedback)
            ),
            schema_file: DerSchemaFile.get(), project_id: project_id, artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step DerCommit {
        var data = pending_data
        var body = ArtifactBody.der(data)
        var rendered = PageShell(
            title: "DER",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/der.html", tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, "der.html"), rendered)
        delivery_result = {artifact: "der", path: "artifacts/der.html"}
        goto Done
    }

    step DiagramasGenerate {
        current_artifact = "diagramas"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'diagramas'")
        var response = Writer.generate(
            prompt: DiagramasInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: NoAtributos.placeholder(),
                wiki_content: Context.wiki(project_id),
                feedback_content: FeedbackBlock.render(pending_feedback)
            ),
            schema_file: DiagramasSchemaFile.get(), project_id: project_id, artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step DiagramasCommit {
        var data = pending_data
        var written = []
        dir.create(Paths.artifact(project_id, "diagramas"))
        for (var diagrama in data.diagramas) {
            var slug = Slug.from_title(diagrama.titulo)
            var body = ArtifactBody.diagrama(diagrama)
            var rendered = PageShell(
                title: html.escape(diagrama.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/diagramas/" + slug + ".html", tokens_in, tokens_out)
            )
            fs.write(Paths.artifact(project_id, "diagramas/" + slug + ".html"), rendered)
            written += [slug]
        }
        delivery_result = {artifact: "diagramas", written: written}
        goto Done
    }

    // FinalGenerate/FinalCommit produzem o detalhamento final (feature ou
    // historia) — unico artefato que nao existe em Discovery. So 'requisitos'
    // e obrigatorio; adr/der/diagramas entram como contexto se existirem, mas
    // nunca bloqueiam (sao "opcional" na sequencia do protocolo original).
    step FinalGenerate {                                            
        current_artifact = mode
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de '" + mode + "'")

        var adr_content = Context.artifact_dir(project_id, "adr")
        if (adr_content.is_empty()) adr_content = "(não gerado para este projeto)"
        var der_content = Context.artifact(project_id, "der.html")
        if (der_content.is_empty()) der_content = "(não gerado para este projeto)"
        var diagramas_content = Context.artifact_dir(project_id, "diagramas")
        if (diagramas_content.is_empty()) diagramas_content = "(não gerado para este projeto)"

        var response = null
        if (mode == "historia") {
            response = Writer.generate(
                prompt: HistoriaInstruction(
                    schema_conventions: ArtifactSchema(),
                    requisitos_content: requisitos_content,
                    adr_content: adr_content,
                    der_content: der_content,
                    diagramas_content: diagramas_content,
                    wiki_content: Context.wiki(project_id),
                    feedback_content: FeedbackBlock.render(pending_feedback)
                ),
                schema_file: HistoriaSchemaFile.get(), project_id: project_id, artifact: current_artifact
            )
        } else {
            response = Writer.generate(
                prompt: FeatureInstruction(
                    schema_conventions: ArtifactSchema(),
                    requisitos_content: requisitos_content,
                    adr_content: adr_content,
                    der_content: der_content,
                    diagramas_content: diagramas_content,
                    wiki_content: Context.wiki(project_id),
                    feedback_content: FeedbackBlock.render(pending_feedback)
                ),
                schema_file: FeatureSchemaFile.get(), project_id: project_id, artifact: current_artifact
            )
        }
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step FinalCommit {
        var data = pending_data
        var project_data = json.parse(fs.read(Paths.project_file(project_id)))
        var title = project_data.name
        var out_path = mode + ".html"

        var body = ""
        if (mode == "historia") {
            body = ArtifactBody.historia(data)
        } else {
            body = ArtifactBody.feature(data)
        }

        var rendered = PageShell(
            title: html.escape(title),
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/" + out_path, tokens_in, tokens_out)
        )
        fs.write(Paths.artifact(project_id, out_path), rendered)
        delivery_result = {artifact: mode, path: "artifacts/" + out_path}
        goto Done
    }

    // Historias — so quando mode="feature": quebra a `feature` final (unica
    // deste projeto) em historias de usuario. Reaproveita a MESMA instrucao/
    // schema/template do `historias` de Discovery (artifacts_common.mh) — so
    // muda de onde vem `feature_content` e onde e gravado (raiz de
    // artifacts/historias/, sem prefixo de feature: so existe uma feature
    // implicita neste projeto standalone).
    step HistoriasGenerate {
        current_artifact = "historias"
        var feature_content = Context.artifact(project_id, "feature.html")
        if (feature_content.is_empty()) fail("gere 'feature' antes de 'historias'")
        var response = Writer.generate(
            prompt: HistoriasInstruction(schema_conventions: ArtifactSchema(), feature_content: feature_content, wiki_content: Context.wiki(project_id), feedback_content: FeedbackBlock.render(pending_feedback)),
            schema_file: HistoriasSchemaFile.get(), project_id: project_id, artifact: current_artifact
        )
        tokens_in = response.tokens_in
        tokens_out = response.tokens_out
        var raw = response.content
        pending_data = json.parse(raw)
        goto Gate
    }

    step HistoriasCommit {
        var data = pending_data
        var historias_base = Paths.artifact(project_id, "historias")
        dir.create(historias_base)
        var written = []
        for (var historia in data.historias) {
            var id = ArtifactId.next_historia_id(project_id)
            var folder = ArtifactId.folder_name(id, historia.titulo)
            var body = ArtifactBody.historia(historia)
            var rendered = PageShell(
                title: html.escape(id + " — " + historia.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/historias/" + folder + "/historia.html", tokens_in, tokens_out)
            )
            dir.create(historias_base + "/" + folder)
            fs.write(historias_base + "/" + folder + "/historia.html", rendered)
            written += [folder]
        }
        delivery_result = {artifact: "historias", written: written}
        goto Done
    }

    step Done {
        // ponto de convergencia unico — mantem `reached` enxuto (C7/Fase 1).
    }
}

// DeliveryWorkflowSpec — mesmo padrao de discovery.mh :: DiscoveryWorkflowSpec:
// `Name.run(inputs:)` (mhl 1.4.0-beta.7+, MHL-Melhorias.md #13) testando o
// workflow inteiro, escopado aos gates de dispatch/dependencia (§4.1.1 do
// plano) que disparam sem nenhuma chamada de LLM nem escrita em disco — o
// `project_id` usado nunca existe de verdade, entao `Context.artifact(...)`
// sempre devolve "" e o primeiro `fail()` de predecessor dispara. Ver a nota
// equivalente em work_item.mh sobre por que isso fica restrito aos
// caminhos de falha (`Name.run()` nao isola `fs`/`dir`, FASE5-ACHADOS.md).
test DeliveryWorkflowSpec {
    describe rejects_an_invalid_mode_before_touching_anything {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "epico", artifact: "requisitos"})
        is_false(run.ok)
        is_true(run.error.contains("mode invalido"))
    }

    describe rejects_a_final_artifact_that_does_not_match_mode {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "historia"})
        is_false(run.ok)
        is_true(run.error.contains("nao bate com mode"))
    }

    describe historias_is_rejected_outside_feature_mode {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "historia", artifact: "historias"})
        is_false(run.ok)
        is_true(run.error.contains("so existe quando mode"))
    }

    describe rejects_an_unknown_artifact_before_touching_anything {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "bogus"})
        is_false(run.ok)
        is_true(run.error.contains("artefato desconhecido"))
    }

    describe adr_requires_requisitos_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "adr"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'adr'"))
    }

    describe der_requires_requisitos_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "der"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'der'"))
    }

    describe diagramas_requires_requisitos_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "diagramas"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'diagramas'"))
    }

    describe feature_final_requires_requisitos_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "feature"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'feature'"))
    }

    describe historia_final_requires_requisitos_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "historia", artifact: "historia"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'requisitos' antes de 'historia'"))
    }

    describe historias_requires_a_feature_artifact_first {
        var run = Delivery.run(inputs: {project_id: "spec-test-project", mode: "feature", artifact: "historias"})
        is_false(run.ok)
        is_true(run.error.contains("gere 'feature' antes de 'historias'"))
    }
}
