// Orquestra o ciclo de vida de um work-item. Políticas, persistência e
// agregações ficam concentradas em WorkItemActions.

import { WorkItemActions } from "actions.mh"
import { Paths } from "../shared/core/paths.mh"
import { Readiness } from "../shared/artifacts/readiness.mh"
import { Handoff } from "../shared/artifacts/handoff.mh"
import { FeatureReview } from "../shared/artifacts/feature_review.mh"

enum WorkItemAction { create, list, get, archive, usage, prompt_log, changes, productivity, readiness, handoff, feature_review }

workflow WorkItem {
    description: "Ciclo de vida de um work-item do Senpai: create, list, get, archive, usage, prompt_log, changes, productivity, readiness, handoff, feature_review."

    input action: WorkItemAction
    input name: string = ""          // obrigatorio (valor) so para action:"create"
    input item_type: string = ""     // "oportunidade" | "feature" | "historia" | "comite"; so para action:"create"
    input continuidade_de: string = "" // opcional, so para action:"create" — sistema existente que este item evolui
    input project_id: string = ""    // obrigatorio (valor) para get/archive/usage/prompt_log/changes
    input feature_id: string = ""    // so para action:"feature_review" — "FT001"
    input decisao: string = ""       // so para action:"feature_review" — "aprovar" | "rejeitar" | "reabrir"
    input motivo: string = ""        // so para action:"feature_review" — obrigatorio ao rejeitar

    var project = null
    var projects = []
    var usage = null
    var prompt_log = []
    var changes = []
    var productivity = null
    var readiness = []
    var handoff = null
    var feature_review = null
    var error_message = ""

    output: {
        action,
        project,
        projects,
        usage,
        prompt_log,
        changes,
        productivity,
        readiness,
        handoff,
        feature_review,
        error: error_message,
    }

    route ActionRouter(action: WorkItemAction) {
        WorkItemAction.create       -> Create
        WorkItemAction.list         -> List
        WorkItemAction.get          -> Get
        WorkItemAction.archive      -> Archive
        WorkItemAction.usage        -> Usage
        WorkItemAction.prompt_log   -> PromptLog
        WorkItemAction.changes      -> Changes
        WorkItemAction.productivity -> Productivity
        WorkItemAction.readiness    -> Readiness
        WorkItemAction.handoff      -> Handoff
        WorkItemAction.feature_review -> FeatureReviewStep
    }

    step Dispatch {
        goto ActionRouter(action)
    }

    step Create {
        self.project = WorkItemActions.create(name, item_type, continuidade_de)
        goto Done
    }

    step List {
        self.projects = WorkItemActions.list()
        goto Done
    }

    step Get {
        self.project = WorkItemActions.get(project_id)
        goto Done
    }

    step Archive {
        self.project = WorkItemActions.archive(project_id)
        goto Done
    }

    step Usage {
        self.usage = WorkItemActions.usage(project_id)
        goto Done
    }

    step PromptLog {
        self.prompt_log = WorkItemActions.prompt_log(project_id)
        goto Done
    }

    step Changes {
        self.changes = WorkItemActions.changes_log(project_id)
        goto Done
    }

    step Productivity {
        self.productivity = WorkItemActions.productivity(project_id)
        goto Done
    }

    // Definition of Ready de cada historia (readiness.mh).
    step Readiness {
        self.readiness = Readiness.batch(Paths.ensure_valid(project_id))
        goto Done
    }

    // Gera o pacote de handoff em projects/<id>/handoff/ (handoff.mh); o app
    // exporta a pasta para onde o usuario escolher.
    step Handoff {
        self.handoff = Handoff.build(project_id)
        goto Done
    }

    // Aprova, rejeita (com motivo) ou reabre uma feature do backlog do
    // Discovery (feature_review.mh).
    step FeatureReviewStep {
        self.feature_review = FeatureReview.decide(project_id, feature_id, decisao, motivo)
        goto Done
    }

    step Done { complete() }
}

// Cobre so caminhos que nao gravam em disco: `Name.run()` roda no CWD real,
// sem sandbox de fs/dir.
test WorkItemWorkflowSpec {
    // O lint nao exige que um route cubra todo o enum; este teste exige.
    // handoff fica de fora porque grava projects/<id>/handoff/.
    describe every_action_reaches_its_own_step {
        for (var name in ["create", "list", "get", "archive", "usage", "prompt_log", "changes", "productivity", "readiness", "feature_review"]) {
            var run = WorkItem.run(inputs: {action: name, project_id: "spec-nao-existe-de-verdade"})
            is_false((run.error ?? "").contains("no arm matched"))
            are_equal(run.executed.size() > 1, true)
        }
    }

    describe rejects_an_unknown_action_before_running {
        var raised = ""
        try { WorkItem.run(inputs: {action: "bogus"}) } catch (e) { raised = "${e}" }
        is_true(raised.contains("\"bogus\" is not a variant of enum WorkItemAction (use create | list | get | archive | usage | prompt_log | changes | productivity | readiness | handoff | feature_review)"))
    }

    describe feature_review_rejects_a_malformed_feature_id_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "feature_review", project_id: "spec-nao-existe-de-verdade", feature_id: "../x", decisao: "aprovar"})
        is_false(run.ok)
        is_true(run.error.contains("'feature_id' invalido"))
    }

    describe create_rejects_an_empty_name_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "create", name: "", item_type: "feature"})
        is_false(run.ok)
        is_true(run.error.contains("'name' e obrigatorio"))
    }

    describe create_rejects_an_invalid_item_type_before_touching_disk {
        var run = WorkItem.run(inputs: {action: "create", name: "Projeto valido", item_type: "epico"})
        is_false(run.ok)
        is_true(run.error.contains("'item_type' invalido"))
    }

    describe get_on_a_nonexistent_project_id_fails_without_writing_anything {
        var run = WorkItem.run(inputs: {action: "get", project_id: "spec-nao-existe-de-verdade"})
        is_false(run.ok)
        is_true(run.error.contains("work-item nao encontrado"))
    }

    describe archive_on_a_nonexistent_project_id_fails_without_writing_anything {
        var run = WorkItem.run(inputs: {action: "archive", project_id: "spec-nao-existe-de-verdade"})
        is_false(run.ok)
        is_true(run.error.contains("work-item nao encontrado"))
    }

    // Documenta comportamento real, nao presumido: `usage` nunca falha por
    // project_id inexistente — le o ledger se existir, devolve zerado se
    // nao (WorkItemActions.usage). Diferente de get/archive de proposito.
    describe productivity_on_a_project_without_history_returns_zeros_not_a_failure {
        var run = WorkItem.run(inputs: {action: "productivity", project_id: "spec-nao-existe-de-verdade"})
        is_true(run.ok)
        are_equal(run.vars.productivity.processing_seconds, 0)
        are_equal(run.vars.productivity.approved_count, 0)
    }

    describe usage_on_a_nonexistent_project_id_returns_a_zeroed_ledger_not_a_failure {
        var run = WorkItem.run(inputs: {action: "usage", project_id: "spec-nao-existe-de-verdade"})
        is_true(run.ok)
        are_equal(run.vars.usage.total_tokens_in, 0)
        are_equal(run.vars.usage.total_tokens_out, 0)
        are_equal(run.vars.usage.by_artifact, [])
    }
}
