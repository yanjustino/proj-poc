// Discovery gera os artefatos de uma Oportunidade. O que muda por artefato
// esta em discovery_artifacts.mh; aqui fica so o fluxo, compartilhado com o
// Delivery: Dispatch -> Generate -> Gate (pausa no Modo Buddy) -> Commit.

import { Paths } from "../shared/core/paths.mh"
import { Fixture } from "../shared/core/fixture.mh"
import { ChangesBlock } from "../shared/artifacts/changes_log.mh"
import { Activity } from "../shared/artifacts/activity_log.mh"
import { Telemetry } from "../shared/telemetry/telemetry.mh"
import { DiscoveryKinds, DiscoveryDrafts, DiscoveryCommits } from "discovery_artifacts.mh"

workflow Discovery {
    description: "Artefatos de nivel Oportunidade: brief, atributos, requisitos, adr, der, diagramas, features, dependencias, historias, plano."

    input project_id: string
    input artifact: string         // DiscoveryArtifact
    input feature_id: string = ""  // obrigatorio para historias e plano
    input historia_id: string = "" // obrigatorio para plano (ex.: "US0001")
    input buddy: bool = false
    input approved: bool = false
    // Aprovacao de um rascunho revisado: a UI envia o pending_data de uma
    // run pausada e Dispatch vai direto ao Commit, sem chamar a LLM. Serve
    // tambem para um checkpoint criado por outra versao deste workflow.
    input approval_data: any = null
    input approval_tokens_in: number = 0
    input approval_tokens_out: number = 0
    // Pedido de mudanca. Chega no resume de uma run pausada (Gate) ou num
    // StartRun novo sobre um artefato ja aprovado (Dispatch); nos dois casos
    // custa exatamente uma geracao.
    input feedback: string = ""
    // Autorrevisao (auto_review.mh): com avisos de conformidade na geracao,
    // uma unica chamada extra pede a correcao antes da pausa.
    input autorrevisao: bool = false

    // pending_data/tokens_in/tokens_out/current_artifact sao lidos pelo app
    // numa run pausada (checkpoint-recovery.js, run-tracker.js).
    var discovery_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var pending_data = null
    // Garante que um pedido de mudanca gera uma unica regeneracao. Uma `var`,
    // e nao `feedback = ""`, porque reatribuir um input nao sobrevive ao
    // proximo resume: o Gate veria o mesmo feedback e regeneraria sem fim.
    // Volta a false antes de cada pausa, liberando o proximo pedido.
    var feedback_consumed = false

    output: {
        artifact: artifact,
        result: discovery_result,
        tokens_in: tokens_in,
        tokens_out: tokens_out,
    }

    step_end: (ctx) -> Telemetry.step_end(ctx, self.project_id, self.artifact, self.tokens_in, self.tokens_out)

    step Dispatch {
        Paths.ensure_valid(project_id)
        var kind = DiscoveryKinds.artifact(artifact)
        DiscoveryKinds.check(kind, feature_id, historia_id)
        self.current_artifact = artifact
        var scope = DiscoveryKinds.scope(kind, feature_id, historia_id)
        if (approved && approval_data != null) {
            self.pending_data = approval_data
            self.tokens_in = approval_tokens_in
            self.tokens_out = approval_tokens_out
            Activity.record(project_id, "approved", artifact, scope)
            goto Commit
        }
        if (buddy && !approved && !feedback.is_empty()) {
            self.feedback_consumed = true
            ChangesBlock.record(project_id, artifact, scope, feedback)
        }
        Activity.record(project_id, "started", artifact, scope)
        goto Generate
    }

    step Generate {
        var draft = DiscoveryDrafts.of(DiscoveryKinds.artifact(artifact), project_id, feature_id, historia_id, autorrevisao)
        self.pending_data = draft.data
        self.tokens_in = draft.tokens_in
        self.tokens_out = draft.tokens_out
        goto Gate
    }

    // Pausar nunca custa uma nova chamada de LLM: o rascunho ja esta em
    // pending_data. No resume, approved:true grava; approved:false com
    // feedback registra o pedido (ChangesBlock) e regenera com todo o
    // historico de pedidos deste item; sem feedback, pausa de novo.
    step Gate {
        var scope = DiscoveryKinds.scope(DiscoveryKinds.artifact(artifact), feature_id, historia_id)
        if (buddy && !approved) {
            if (!feedback.is_empty() && !self.feedback_consumed) {
                self.feedback_consumed = true
                ChangesBlock.record(project_id, artifact, scope, feedback)
                goto Generate
            }
            self.feedback_consumed = false
            Activity.record(project_id, "draft_ready", artifact, scope)
            pause("revise o conteudo de '${artifact}' antes de gravar em artifacts/")
        }
        if (buddy) Activity.record(project_id, "approved", artifact, scope)
        goto Commit
    }

    step Commit {
        var draft = {data: self.pending_data, tokens_in: self.tokens_in, tokens_out: self.tokens_out}
        self.discovery_result = DiscoveryCommits.of(DiscoveryKinds.artifact(artifact), project_id, feature_id, historia_id, draft)
        complete()
    }
}

// Cobre o que e deterministico: validacao de entrada, a cadeia de
// predecessores (cada gate falha antes de qualquer chamada de LLM) e o
// caminho de aprovacao, que grava sem chamar a LLM.
test DiscoveryWorkflowSpec {
    describe rejects_an_unknown_artifact_listing_every_valid_one {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "bogus"})
        is_false(run.ok)
        is_true(run.error.contains("artefato desconhecido: 'bogus' (use brief | atributos | requisitos | adr | der | diagramas | features | dependencias | historias | plano)"))
    }

    describe atributos_and_requisitos_require_brief_first {
        for (var artifact in ["atributos", "requisitos"]) {
            var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: artifact})
            is_true(run.error.contains("gere 'brief' antes de '${artifact}'"))
        }
    }

    describe technical_artifacts_require_requisitos_then_atributos_then_adr {
        var id = Fixture.project("spec-test-discovery-tecnicos")
        for (var artifact in ["adr", "der", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact: artifact})
            is_true(run.error.contains("gere 'requisitos' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "requisitos.html", "<html><body>FR-001</body></html>")
        for (var artifact in ["adr", "der", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact: artifact})
            is_true(run.error.contains("gere 'atributos' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "atributos.html", "<html><body>NFR-001</body></html>")
        for (var artifact in ["der", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact: artifact})
            is_true(run.error.contains("gere 'adr' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "adr/ADR-001-titulo.html", "<html><body>ADR-001</body></html>")
        var features = Discovery.run(inputs: {project_id: id, artifact: "features"})
        is_true(features.error.contains("gere 'diagramas' antes de 'features'"))
        Fixture.drop(id)
    }

    describe dependencias_requires_features_first {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "dependencias"})
        is_true(run.error.contains("gere 'features' antes de 'dependencias'"))
    }

    describe historias_requires_a_feature_id {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "historias"})
        is_true(run.error.contains("'feature_id' e obrigatorio"))
    }

    describe plano_requires_a_feature_and_a_historia_id {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "plano", feature_id: "FT001"})
        is_true(run.error.contains("'feature_id' e 'historia_id' sao obrigatorios"))
    }

    describe the_approval_path_validates_the_required_ids_too {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "historias", approved: true, approval_data: {historias: []}})
        is_true(run.error.contains("'feature_id' e obrigatorio"))
    }

    describe approving_a_document_writes_it_without_calling_the_llm {
        var id = Fixture.project("spec-test-discovery-approve")
        var data = {features: [], ordem_execucao: [], diagrama_mermaid: "graph TD", gaps: []}
        var run = Discovery.run(inputs: {project_id: id, artifact: "dependencias", approved: true, approval_data: data, approval_tokens_in: 3, approval_tokens_out: 4})
        is_true(run.ok)
        are_equal(run.executed, ["Dispatch", "Commit"])
        are_equal(run.vars.discovery_result.path, "artifacts/dependencias.html")
        is_true(fs.read(Paths.artifact(id, "dependencias.html")).contains("3 → 4 tokens"))
        Fixture.drop(id)
    }
}
