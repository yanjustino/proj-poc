// Fragmento `partial workflow Discovery` — artefatos tecnicos de
// arquitetura que se desdobram em varios arquivos por oportunidade: adr,
// der, diagramas. Mesclado em discovery.mh via `import "discovery.tecnicos.mh"`
// (por extenso).

import { Paths } from "../shared/core/paths.mh"
import { Writer } from "../shared/agents/agents.mh"
import { Context, NoAdr } from "../shared/artifacts/context.mh"
import { ArtifactData } from "../shared/artifacts/artifact_data.mh"
import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { Slug } from "../shared/core/slug.mh"
import { ArtifactId } from "../shared/artifacts/artifact_id.mh"
import { DirClear } from "../shared/core/dir_clear.mh"
import { PageShell, ArtifactMeta } from "../shared/artifacts/page_shell.mh"
import { ChangesBlock } from "../shared/artifacts/changes_log.mh"
import { C4Diagram } from "../shared/artifacts/c4_diagram.mh"
import {
    ArtifactSchema,
    AdrInstruction, DerInstruction, DiagramasInstruction,
    AdrSchemaFile, DerSchemaFile, DiagramasSchemaFile
} from "../shared/artifacts/artifacts_common.mh"

partial workflow Discovery {
    step AdrGenerate {
        self.current_artifact = "adr"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'adr'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'adr'")

        var response = Writer.generate(
            prompt: AdrInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: atributos_content,
                feedback_content: ChangesBlock.for_artifact(project_id, "adr", "")
            ),
            schema_file: AdrSchemaFile.get(),
            project_id: project_id,
            artifact: self.current_artifact
        )

        self.tokens_in = response.tokens_in
        self.tokens_out = response.tokens_out

        var raw = response.content
        self.pending_data = json.parse(raw)
        goto Gate
    }

    step AdrCommit {
        var data = self.pending_data
        var written = []
        var adr_dir = Paths.artifact(project_id, "adr")
        // *Generate devolve o lote inteiro de decisoes, nao um delta — uma
        // regeneracao ("Solicitar mudanca"/"Atualizar" num adr/ ja
        // aprovado, tab-artefatos.js) precisa substituir, nao somar
        // (ArtifactId.next_adr_id so conta ADRs ja existentes).
        // DirClear.clear, nao dir.delete direto: dir.delete e
        // deliberadamente nao-recursivo no mhl-runtime (so remove um
        // diretorio ja vazio) — contra um adr_dir com conteudo real (o caso
        // normal aqui) ele falhava com "directory not empty" (bug real,
        // batido em producao via o botao "Atualizar"). Ver dir_clear.mh.
        DirClear.clear(adr_dir)
        dir.create(adr_dir)
        for (var decision in data.decisions) {
            var id = ArtifactId.next_adr_id(project_id)
            var folder = ArtifactId.folder_name(id, decision.titulo)
            var body = ArtifactBody.adr(decision)
            var rendered = PageShell(
                title: html.escape(id + " — " + decision.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/adr/" + folder + ".html", self.tokens_in, self.tokens_out)
            )
            var relative = "adr/" + folder + ".html"
            ArtifactData.write(project_id, relative, decision)
            fs.write(Paths.artifact(project_id, relative), rendered)
            written += [folder]
        }
        self.discovery_result = {artifact: "adr", written: written}
        goto Done
    }

    step DerGenerate {
        self.current_artifact = "der"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'der'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'der'")
        // Contexto opcional — ver o comentario de DerInstruction.
        var adr_content = Context.artifact_dir(project_id, "adr")
        if (adr_content.is_empty()) adr_content = NoAdr.placeholder()
        var response = Writer.generate(
            prompt: DerInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: atributos_content,
                adr_content: adr_content,
                feedback_content: ChangesBlock.for_artifact(project_id, "der", "")
            ),
            schema_file: DerSchemaFile.get(),
            project_id: project_id,
            artifact: self.current_artifact
        )
        self.tokens_in = response.tokens_in
        self.tokens_out = response.tokens_out
        var raw = response.content
        self.pending_data = json.parse(raw)
        goto Gate
    }

    step DerCommit {
        var data = self.pending_data
        var body = ArtifactBody.der(data)
        var rendered = PageShell(
            title: "DER",
            body: body,
            meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/der.html", self.tokens_in, self.tokens_out)
        )
        ArtifactData.write(project_id, "der.html", data)
        fs.write(Paths.artifact(project_id, "der.html"), rendered)
        self.discovery_result = {artifact: "der", path: "artifacts/der.html"}
        goto Done
    }

    step DiagramasGenerate {
        self.current_artifact = "diagramas"
        var requisitos_content = Context.artifact(project_id, "requisitos.html")
        if (requisitos_content.is_empty()) fail("gere 'requisitos' antes de 'diagramas'")
        var atributos_content = Context.artifact(project_id, "atributos.html")
        if (atributos_content.is_empty()) fail("gere 'atributos' antes de 'diagramas'")
        // Contexto opcional — ver o comentario de DiagramasInstruction.
        var adr_content = Context.artifact_dir(project_id, "adr")
        if (adr_content.is_empty()) adr_content = NoAdr.placeholder()

        var response = Writer.generate(
            prompt: DiagramasInstruction(
                schema_conventions: ArtifactSchema(),
                requisitos_content: requisitos_content,
                atributos_content: atributos_content,
                adr_content: adr_content,
                feedback_content: ChangesBlock.for_artifact(project_id, "diagramas", "")
            ),
            schema_file: DiagramasSchemaFile.get(),
            project_id: project_id,
            artifact: self.current_artifact
        )

        self.tokens_in = response.tokens_in
        self.tokens_out = response.tokens_out
        var raw = response.content
        // C4Diagram.annotate anexa a cada diagrama os avisos que so o lote
        // inteiro revela (niveis ausentes, nomes divergentes entre niveis) —
        // o preview de um item e o arquivo final leem daqui.
        self.pending_data = C4Diagram.annotate(json.parse(raw))
        goto Gate
    }

    step DiagramasCommit {
        var data = self.pending_data
        var written = []
        var diagramas_dir = Paths.artifact(project_id, "diagramas")
        // *Generate devolve o lote inteiro de diagramas, nao um delta — uma
        // regeneracao ("Solicitar mudanca" num diagramas/ ja aprovado,
        // tab-artefatos.js) precisa substituir, nao somar. Diferente de
        // adr/features (que usam ArtifactId sequencial), o nome de arquivo
        // aqui e so o slug do titulo — sem o wipe, um diagrama cujo titulo
        // mudou na regeneracao vira um arquivo NOVO ao lado do antigo
        // (slug diferente), e um cujo titulo ficou igual sobrescreve o
        // antigo silenciosamente; nenhum dos dois casos limpa o que nao
        // deveria mais existir. DirClear.clear, nao dir.delete direto — ver
        // o comentario em AdrCommit acima / dir_clear.mh.
        DirClear.clear(diagramas_dir)
        dir.create(diagramas_dir)
        for (var diagrama in data.diagramas) {
            var slug = Slug.from_title(diagrama.titulo)
            var body = ArtifactBody.diagrama(diagrama)
            var rendered = PageShell(
                title: html.escape(diagrama.titulo),
                body: body,
                meta: ArtifactMeta.line(time.format(time.now(), "yyyy-MM-dd HH:mm"), "artifacts/diagramas/" + slug + ".html", self.tokens_in, self.tokens_out)
            )
            var relative = "diagramas/" + slug + ".html"
            ArtifactData.write(project_id, relative, diagrama)
            fs.write(Paths.artifact(project_id, relative), rendered)
            written += [slug]
        }
        self.discovery_result = {artifact: "diagramas", written: written}
        goto Done
    }
}
