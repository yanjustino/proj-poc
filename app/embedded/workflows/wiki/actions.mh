// Casos de uso determinísticos de persistência da Wiki. O workflow decide
// quando executá-los; esta tool concentra páginas, índice, slugs e auditoria.

import { Slug } from "../shared/core/slug.mh"
import { Paths } from "../shared/core/paths.mh"
import { Fixture } from "../shared/core/fixture.mh"
import { WikiIndex } from "../shared/wiki/wiki_index.mh"
import { WikiPages, WikiLog } from "../shared/wiki/wiki_pages.mh"
import { WikiLint } from "../shared/wiki/wiki_lint.mh"
import { WikiHtmlExport } from "../shared/wiki/wiki_html_export.mh"

export tool WikiActions {
    commit_ingest(project_id: string, data: any): {
        source_title: string,
        source_slug: string,
        entities_touched: number,
        concepts_touched: number
    } -> {
        var source_slug = Slug.from_title(data.source_title)
        WikiPages.write_source(project_id, source_slug, data.source_title, data.source_summary, data.natureza)
        WikiIndex.upsert_source(project_id, {
            slug: source_slug,
            title: data.source_title,
            summary: data.index_summary,
            natureza: data.natureza
        })

        for (var entity in data.entities) self.upsert_fact(project_id, "entities", entity)
        for (var concept in data.concepts) self.upsert_fact(project_id, "concepts", concept)

        self.log(project_id, "ingest", data.source_title)
        WikiHtmlExport.sync(project_id)
        return {
            source_title: data.source_title,
            source_slug,
            entities_touched: data.entities.size(),
            concepts_touched: data.concepts.size()
        }
    }

    // Uma entidade/conceito cujo titulo (ou alias) ja tem pagina entra nela;
    // o titulo usado pela fonte vira alias, para a busca e o proximo catalogo.
    internal upsert_fact(project_id: string, category: string, item: any) -> {
        var title = WikiIndex.canonical_title(project_id, category, item.title)
        var aliases = (item?.aliases ?? []) + (if (title == item.title) [] else [item.title])
        WikiPages.upsert_fact_page(project_id, category, title, item.facts)
        WikiIndex.upsert(project_id, category, {slug: Slug.from_title(title), title, summary: item.facts[0], aliases})
    }

    file_answer(project_id: string, title: string, body: string, question: string): string -> {
        var slug = Slug.from_title(title)
        WikiPages.write_answer(project_id, slug, title, body)
        WikiIndex.upsert_answer(project_id, {
            slug,
            title,
            summary: question
        })
        self.log(project_id, "query", title)
        WikiHtmlExport.sync(project_id)
        return slug
    }

    // Verifica o relatorio da LLM, grava os alertas nas paginas afetadas e
    // wiki/lint.md, e regera o HTML (os alertas ficam visiveis la tambem).
    record_lint(project_id: string, report: any): any -> {
        var applied = WikiLint.apply(project_id, report)
        self.log(
            project_id,
            "lint",
            "${applied.contradictions.size()} contradicao(oes), ${applied.stale_claims.size()} alegacao(oes) superada(s), ${applied.discarded} descartado(s)"
        )
        WikiHtmlExport.sync(project_id)
        return applied
    }

    // sync_html regera wiki/html/ sob demanda, sem depender de um novo
    // ingest/query/file_answer — a aba Wiki chama isso ao abrir, pra cobrir
    // work-items cuja wiki existia antes de WikiHtmlExport existir.
    sync_html(project_id: string) -> WikiHtmlExport.sync(project_id)

    // project_id precisa ser parametro aqui, nao so dos metodos chamadores
    // (commit_ingest/file_answer/record_lint) — `self.<metodo>(...)` e uma
    // chamada de metodo de verdade, com seu proprio escopo local; nao
    // herda as vars do metodo que chamou (confirmado por spike ao caçar este
    // bug — mesma classe de limite de escopo que derrubou o uso de `after`
    // em workflows/shared/agents/agents.mh, ver FASE5-ACHADOS.md). Sem isso,
    // `WikiLog.append` (que interpola `${project_id}` no seu `path:`) falha
    // com "undefined variable" — reproduzido de verdade em todo `ingest`.
    internal log(project_id: string, action: string, description: string) ->
        WikiLog.append(
            "## [" + time.format(time.now(), "yyyy-MM-dd") + "] " +
            action + " | " + description
        )
}

test WikiActionsSpec {
    // Os alertas ficam até a próxima verificação decidir se o fato novo os
    // resolveu — e continuam no fim, depois do bloco de fatos novo.
    describe ingest_keeps_the_review_alerts_after_the_new_facts {
        var id = Fixture.project("spec-test-wiki-ingest-alerts")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        fs.write(Paths.wiki(id, "concepts/aplicativo.md"), "# Aplicativo\n\n## Fatos (2026-01-01)\n\n- Será mobile\n\n## Alertas da revisão\n\n- Contradição com sources/ata-2: mobile × webapp\n")
        WikiActions.commit_ingest(id, {
            source_title: "Ata 3", source_summary: "Resumo 3", natureza: "pedido_novo", index_summary: "ata 3",
            entities: [],
            concepts: [{title: "Aplicativo", aliases: [], facts: ["Decidido: será webapp"]}],
        })
        var page = fs.read(Paths.wiki(id, "concepts/aplicativo.md"))
        is_true(page.contains("- Será mobile"))
        is_true(page.contains("- Decidido: será webapp"))
        is_true(page.trim().ends_with("- Contradição com sources/ata-2: mobile × webapp"))
        Fixture.drop(id)
    }

    // Uma segunda fonte que chama o mesmo conceito por um alias ja conhecido
    // acrescenta fatos a pagina existente em vez de criar outra, e o indice
    // de busca do app traz o titulo, os aliases e o texto.
    describe ingest_reuses_the_page_of_a_known_alias_and_feeds_the_search_index {
        var id = Fixture.project("spec-test-wiki-ingest-alias")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        WikiActions.commit_ingest(id, {
            source_title: "Ata 1", source_summary: "Resumo 1", natureza: "pedido_novo", index_summary: "ata 1",
            entities: [],
            concepts: [{title: "Compliance regulatório", aliases: ["Conformidade"], facts: ["Exige trilha de auditoria"]}],
        })
        WikiActions.commit_ingest(id, {
            source_title: "Ata 2", source_summary: "Resumo 2", natureza: "pedido_novo", index_summary: "ata 2",
            entities: [],
            concepts: [{title: "conformidade", aliases: ["Regulação CVM"], facts: ["Relatórios mensais à CVM"]}],
        })
        are_equal(dir.list(Paths.wiki(id, "concepts")).size(), 1)
        var page = fs.read(Paths.wiki(id, "concepts/compliance-regulatorio.md"))
        is_true(page.contains("Exige trilha de auditoria"))
        is_true(page.contains("Relatórios mensais à CVM"))

        var search = json.parse(fs.read(Paths.wiki(id, "html/search.json")))
        var concept = search.find((e) -> e.group == "concepts")
        are_equal(concept.title, "Compliance regulatório")
        are_equal(concept.aliases, ["Conformidade", "Regulação CVM"])
        is_true(concept.text.contains("Relatórios mensais à CVM"))
        are_equal(search.filter((e) -> e.group == "sources").size(), 2)
        Fixture.drop(id)
    }
}
