// Casos de uso determinísticos de persistência da Wiki. O workflow decide
// quando executá-los; esta tool concentra páginas, índice, slugs e auditoria.

import { Slug } from "../shared/core/slug.mh"
import { Paths } from "../shared/core/paths.mh"
import { Fixture } from "../shared/core/fixture.mh"
import { WikiIndex } from "../shared/wiki/wiki_index.mh"
import { WikiPages, WikiLog } from "../shared/wiki/wiki_pages.mh"
import { WikiLint } from "../shared/wiki/wiki_lint.mh"
import { WikiHtmlExport } from "../shared/wiki/wiki_html_export.mh"

export type IngestResult = {
    source_title: string, source_slug: string,
    entities_touched: number, concepts_touched: number
}

export type ConceptResult = {slug: string, title: string, facts_added: number}

export tool WikiActions {
    commit_ingest(project_id: string, data: any): IngestResult {
        var source_slug = Slug.from_title(data.source_title)
        // `?? []`: um ingest pausado no Modo Buddy antes de code_snippets
        // existir retoma com o ingest_data antigo.
        WikiPages.write_source(project_id, source_slug, data.source_title, data.source_summary, data.natureza, data?.code_snippets ?? [], data?.literal ?? "")
        WikiIndex.upsert_source(project_id, {
            slug: source_slug,
            title: data.source_title,
            summary: data.index_summary,
            natureza: data.natureza
        })

        for (var entity in data.entities) self.upsert_fact(project_id, "entities", entity)
        for (var concept in data.concepts) self.upsert_fact(project_id, "concepts", concept)

        self.log(project_id, "ingest", data.source_title)
        WikiHtmlExport.sync(project_id)
        return {
            source_title: data.source_title,
            source_slug,
            entities_touched: data.entities.size(),
            concepts_touched: data.concepts.size()
        }
    }

    // Uma entidade/conceito cujo titulo (ou alias) ja tem pagina entra nela;
    // o titulo usado pela fonte vira alias, para a busca e o proximo catalogo.
    internal upsert_fact(project_id: string, category: string, item: any) {
        var title = WikiIndex.canonical_title(project_id, category, item.title)
        var aliases = (item?.aliases ?? []) + (if (title == item.title) [] else [item.title])
        WikiPages.upsert_fact_page(project_id, category, title, item.facts)
        WikiIndex.upsert(project_id, category, {slug: Slug.from_title(title), title, summary: item.facts[0], aliases})
    }

    file_answer(project_id: string, title: string, body: string, question: string): string {
        var slug = Slug.from_title(title)
        WikiPages.write_answer(project_id, slug, title, body)
        WikiIndex.upsert_answer(project_id, {
            slug,
            title,
            summary: question
        })
        self.log(project_id, "query", title)
        WikiHtmlExport.sync(project_id)
        return slug
    }

    // Verifica o relatorio da LLM, grava os alertas nas paginas afetadas e
    // wiki/lint.md, e regera o HTML (os alertas ficam visiveis la tambem).
    record_lint(project_id: string, report: any): any {
        var applied = WikiLint.apply(project_id, report)
        self.log(
            project_id,
            "lint",
            "${applied.contradictions.size()} contradicao(oes), ${applied.stale_claims.size()} alegacao(oes) superada(s), ${applied.discarded} descartado(s)"
        )
        WikiHtmlExport.sync(project_id)
        return applied
    }

    // Grava a pagina de conceito aprovada (acao create_concept), pelo mesmo
    // caminho do ingest: um titulo ou alias ja conhecido recebe os fatos na
    // pagina existente em vez de ganhar outra.
    commit_concept(project_id: string, data: any): ConceptResult {
        self.upsert_fact(project_id, "concepts", data)
        var title = WikiIndex.canonical_title(project_id, "concepts", data.title)
        self.log(project_id, "concept", title)
        WikiHtmlExport.sync(project_id)
        return {slug: Slug.from_title(title), title, facts_added: data.facts.size()}
    }

    // Apaga o que a wiki derivou das fontes (fontes, entidades, conceitos,
    // verificacao e HTML) para o app reingerir as fontes restantes do zero.
    // Respostas arquivadas nao vem de nenhuma fonte, entao ficam, com um
    // aviso de que citam a wiki anterior; log.md tambem fica (e historico).
    reset(project_id: string): any {
        for (var folder in ["sources", "entities", "concepts", "html"]) {
            var folder_path = Paths.wiki(project_id, folder)
            if (dir.exists(folder_path)) {
                dir.clear(folder_path)
                dir.delete(folder_path)
            }
        }
        for (var file in ["index.md", "lint.md", "lint.json"]) {
            var file_path = Paths.wiki(project_id, file)
            if (fs.exists(file_path)) fs.delete(file_path)
        }
        var answers = WikiIndex.load(project_id).get("answers", [])
        WikiIndex.reset(project_id, answers)
        var answers_dir = Paths.wiki(project_id, "answers")
        if (dir.exists(answers_dir)) {
            var today = time.format(time.now(), "yyyy-MM-dd")
            for (var answer_path in dir.list(answers_dir)) {
                fs.write(answer_path, self.with_rebuild_notice(fs.read(answer_path), today))
            }
        }
        self.log(project_id, "rebuild", "wiki apagada para reprocessar as fontes")
        WikiHtmlExport.sync(project_id)
        return {answers_kept: answers.size()}
    }

    // O aviso vai logo abaixo do titulo, como paragrafo — nao no bloco de
    // alertas, que a verificacao apaga e regrava inteiro. Uma reconstrucao
    // nova troca o aviso anterior em vez de empilhar outro.
    internal with_rebuild_notice(page: string, date: string): string {
        var prefix = "Aviso: resposta arquivada antes da reconstrução da wiki"
        var parts = page.split("\n\n").filter((part) -> !part.starts_with(prefix))
        var notice = prefix + " em " + date + " — as páginas que ela cita podem ter mudado ou deixado de existir."
        return ([parts[0], notice] + parts[1..parts.size()]).join("\n\n")
    }

    // sync_html regera wiki/html/ sob demanda, sem depender de um novo
    // ingest/query/file_answer — a aba Wiki chama isso ao abrir, pra cobrir
    // work-items cuja wiki existia antes de WikiHtmlExport existir.
    sync_html(project_id: string) -> WikiHtmlExport.sync(project_id)

    // project_id precisa ser parametro aqui, nao so dos metodos chamadores
    // (commit_ingest/file_answer/record_lint) — `self.<metodo>(...)` e uma
    // chamada de metodo de verdade, com seu proprio escopo local; nao
    // herda as vars do metodo que chamou (confirmado por spike ao caçar este
    // bug — mesma classe de limite de escopo que derrubou o uso de `after`
    // em workflows/shared/agents/agents.mh, ver FASE5-ACHADOS.md). Sem isso,
    // `WikiLog.append` (que interpola `${project_id}` no seu `path:`) falha
    // com "undefined variable" — reproduzido de verdade em todo `ingest`.
    internal log(project_id: string, action: string, description: string) ->
        WikiLog.append(
            "## [" + time.format(time.now(), "yyyy-MM-dd") + "] " +
            action + " | " + description
        )
}

test WikiActionsSpec {
    // Reprocessar a wiki: some tudo o que veio das fontes; a resposta
    // arquivada fica, avisando que cita a wiki anterior.
    describe reset_drops_what_came_from_the_sources_and_keeps_the_answers {
        var id = Fixture.project("spec-test-wiki-reset")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        WikiActions.commit_ingest(id, {
            source_title: "Ata 1", source_summary: "Resumo 1", natureza: "pedido_novo", index_summary: "ata 1",
            entities: [{title: "Backoffice", aliases: [], facts: ["Faz a liquidação"]}],
            concepts: [{title: "Settlement", aliases: [], facts: ["Acontece em D+1"]}],
        })
        WikiActions.file_answer(id, "Quem liquida", "O backoffice (ver entities/backoffice).", "quem liquida?")
        fs.write(Paths.wiki(id, "lint.md"), "# Verificação da wiki\n")

        var r = WikiActions.reset(id)
        are_equal(r.answers_kept, 1)
        is_false(dir.exists(Paths.wiki(id, "sources")))
        is_false(dir.exists(Paths.wiki(id, "entities")))
        is_false(dir.exists(Paths.wiki(id, "concepts")))
        is_false(fs.exists(Paths.wiki(id, "lint.md")))
        is_false(fs.exists(Paths.wiki(id, "html/sources/ata-1.html")))
        var state = WikiIndex.load(id)
        is_true(state.sources.is_empty())
        is_true(state.entities.is_empty())
        are_equal(state.answers.size(), 1)
        var answer = fs.read(Paths.wiki(id, "answers/quem-liquida.md"))
        is_true(answer.starts_with("# Quem liquida\n\nAviso: resposta arquivada antes da reconstrução da wiki em "))
        is_true(answer.contains("O backoffice (ver entities/backoffice)."))
        is_true(fs.exists(Paths.wiki(id, "html/answers/quem-liquida.html")))
        is_true(WikiIndex.catalog(id).starts_with("(nenhuma página ainda"))
        Fixture.drop(id)
    }

    describe with_rebuild_notice_replaces_the_notice_of_an_earlier_rebuild {
        var once = WikiActions.with_rebuild_notice("# R\n\ncorpo\n", "2026-01-01")
        var twice = WikiActions.with_rebuild_notice(once, "2026-02-01")
        are_equal(twice, "# R\n\nAviso: resposta arquivada antes da reconstrução da wiki em 2026-02-01 — as páginas que ela cita podem ter mudado ou deixado de existir.\n\ncorpo\n")
    }

    // Conceito apontado pela verificacao: vira pagina em concepts/, entra no
    // indice e no HTML (busca do app) como qualquer conceito ingerido.
    describe commit_concept_writes_the_page_and_indexes_it {
        var id = Fixture.project("spec-test-wiki-commit-concept")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        var r = WikiActions.commit_concept(id, {title: "Settlement", aliases: ["Liquidação"], facts: ["Responsabilidade do backoffice (ver entities/backoffice)"]})
        are_equal(r.slug, "settlement")
        are_equal(r.facts_added, 1)
        is_true(fs.read(Paths.wiki(id, "concepts/settlement.md")).contains("- Responsabilidade do backoffice (ver entities/backoffice)"))
        var search = json.parse(fs.read(Paths.wiki(id, "html/search.json")))
        are_equal(search.find((e) -> e.group == "concepts").aliases, ["Liquidação"])
        Fixture.drop(id)
    }

    // Os alertas ficam até a próxima verificação decidir se o fato novo os
    // resolveu — e continuam no fim, depois do bloco de fatos novo.
    describe ingest_keeps_the_review_alerts_after_the_new_facts {
        var id = Fixture.project("spec-test-wiki-ingest-alerts")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        fs.write(Paths.wiki(id, "concepts/aplicativo.md"), "# Aplicativo\n\n## Fatos (2026-01-01)\n\n- Será mobile\n\n## Alertas da revisão\n\n- Contradição com sources/ata-2: mobile × webapp\n")
        WikiActions.commit_ingest(id, {
            source_title: "Ata 3", source_summary: "Resumo 3", natureza: "pedido_novo", index_summary: "ata 3",
            entities: [],
            concepts: [{title: "Aplicativo", aliases: [], facts: ["Decidido: será webapp"]}],
        })
        var page = fs.read(Paths.wiki(id, "concepts/aplicativo.md"))
        is_true(page.contains("- Será mobile"))
        is_true(page.contains("- Decidido: será webapp"))
        is_true(page.trim().ends_with("- Contradição com sources/ata-2: mobile × webapp"))
        Fixture.drop(id)
    }

    // O codigo da fonte chega a pagina e ao HTML intacto: indentacao e linha
    // em branco preservadas, num bloco <pre> em vez de paragrafos.
    describe ingest_keeps_the_code_snippets_literally_in_the_source_page {
        var id = Fixture.project("spec-test-wiki-ingest-code")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        var code = "def frete(peso):\n\n    return 10 if peso < 5 else 20"
        WikiActions.commit_ingest(id, {
            source_title: "Calculo de frete", source_summary: "Calcula o frete pelo peso.", natureza: "sistema_atual", index_summary: "frete",
            code_snippets: [{language: "python", caption: "Regra do frete", code}],
            entities: [], concepts: [],
        })
        is_true(fs.read(Paths.wiki(id, "sources/calculo-de-frete.md")).contains("Regra do frete\n\n```python\n" + code + "\n```"))
        is_true(fs.read(Paths.wiki(id, "html/sources/calculo-de-frete.html")).contains("<pre><code class=\"language-python\">" + code.replace("<", "&lt;") + "</code></pre>"))
        Fixture.drop(id)
    }

    // O trecho literal de um retrato de repositorio (LiteralBlocks) entra
    // intacto na pagina — com a arvore indentada sobrevivendo ao HTML.
    describe ingest_keeps_the_literal_block_of_the_source_in_the_page {
        var id = Fixture.project("spec-test-wiki-ingest-literal")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        var literal = "## Árvore de pastas\n\n```text\napp/  (3 arquivos)\n  api/  (2 arquivos)\n```"
        WikiActions.commit_ingest(id, {
            source_title: "checkout estrutura", source_summary: "Serviço Go com uma API.", natureza: "sistema_atual", index_summary: "estrutura",
            code_snippets: [], entities: [], concepts: [], literal,
        })
        var page = fs.read(Paths.wiki(id, "sources/checkout-estrutura.md"))
        is_true(page.contains("Serviço Go com uma API.\n\n" + literal))
        var html_page = fs.read(Paths.wiki(id, "html/sources/checkout-estrutura.html"))
        is_true(html_page.contains("app/  (3 arquivos)\n  api/  (2 arquivos)"))
        Fixture.drop(id)
    }

    // Uma segunda fonte que chama o mesmo conceito por um alias ja conhecido
    // acrescenta fatos a pagina existente em vez de criar outra, e o indice
    // de busca do app traz o titulo, os aliases e o texto.
    describe ingest_reuses_the_page_of_a_known_alias_and_feeds_the_search_index {
        var id = Fixture.project("spec-test-wiki-ingest-alias")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        WikiActions.commit_ingest(id, {
            source_title: "Ata 1", source_summary: "Resumo 1", natureza: "pedido_novo", index_summary: "ata 1",
            entities: [],
            concepts: [{title: "Compliance regulatório", aliases: ["Conformidade"], facts: ["Exige trilha de auditoria"]}],
        })
        WikiActions.commit_ingest(id, {
            source_title: "Ata 2", source_summary: "Resumo 2", natureza: "pedido_novo", index_summary: "ata 2",
            entities: [],
            concepts: [{title: "conformidade", aliases: ["Regulação CVM"], facts: ["Relatórios mensais à CVM"]}],
        })
        are_equal(dir.list(Paths.wiki(id, "concepts")).size(), 1)
        var page = fs.read(Paths.wiki(id, "concepts/compliance-regulatorio.md"))
        is_true(page.contains("Exige trilha de auditoria"))
        is_true(page.contains("Relatórios mensais à CVM"))

        var search = json.parse(fs.read(Paths.wiki(id, "html/search.json")))
        var concept = search.find((e) -> e.group == "concepts")
        are_equal(concept.title, "Compliance regulatório")
        are_equal(concept.aliases, ["Conformidade", "Regulação CVM"])
        is_true(concept.text.contains("Relatórios mensais à CVM"))
        are_equal(search.filter((e) -> e.group == "sources").size(), 2)
        Fixture.drop(id)
    }
}
