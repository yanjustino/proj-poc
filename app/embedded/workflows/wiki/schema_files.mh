// Schemas das respostas da wiki. Cada `schema` vale {content, path}: o JSON
// inline (Claude/Devin) e o caminho absoluto do arquivo (Codex).

export schema IngestSchema from "schemas/ingest.schema.json"
export schema QuerySchema from "schemas/query.schema.json"
export schema LintSchema from "schemas/lint.schema.json"

test WikiSchemaFileSpec {
    describe each_schema_carries_its_json_and_an_absolute_path {
        for (var s in [{schema: IngestSchema, file: "ingest"}, {schema: QuerySchema, file: "query"}, {schema: LintSchema, file: "lint"}]) {
            are_equal(json.parse(s.schema.content).type, "object")
            is_true(s.schema.path.ends_with("wiki/schemas/${s.file}.schema.json"))
            is_true(fs.exists(s.schema.path))
        }
    }
}
