// Grava a edicao manual de um artefato de documento unico (brief, atributos,
// requisitos). O editor do app devolve o JSON semantico ja alterado; aqui o
// HTML e re-renderizado pelos mesmos templates dos *Commit de Discovery/
// Delivery, entao JSON e HTML nunca divergem. Ordem de escrita identica a
// ArtifactData: JSON primeiro, HTML por ultimo (o HTML e o marcador de
// disponibilidade que Context usa).
//
// modelo (o modelo arquitetural, ArchModel) e o caminho sem LLM para mudar
// os diagramas de contexto e de conteiner: gravar o modelo redesenha as duas
// visoes em diagramas/ na hora (ArtifactCommit.model_views).
//
// O editor so altera valores de texto e adiciona/remove itens de listas; a
// estrutura (chaves de topo) precisa ser exatamente a do arquivo atual, o que
// impede um cliente de gravar um JSON que os templates nao saberiam renderizar.

import { Paths } from "../shared/core/paths.mh"
import { ArtifactData } from "../shared/artifacts/artifact_data.mh"
import { ArtifactBody } from "../shared/artifacts/artifact_body.mh"
import { PageShell } from "../shared/artifacts/page_shell.mh"
import { ChangesLog } from "../shared/artifacts/changes_log.mh"
import { ArtifactCommit } from "../shared/artifacts/artifact_commit.mh"
import { Fixture } from "../shared/core/fixture.mh"

enum EditableArtifact { brief, atributos, requisitos, modelo }

tool ArtifactEdit {
    title_for(kind: EditableArtifact): string -> match kind {
        EditableArtifact.brief      -> "Brief"
        EditableArtifact.atributos  -> "Atributos de Qualidade"
        EditableArtifact.requisitos -> "Requisitos"
        EditableArtifact.modelo     -> "Modelo arquitetural"
    }

    // Mesmas chaves de topo, sem faltar nem sobrar nenhuma. `optional`: chaves
    // que o editor pode acrescentar a um JSON gravado antes delas (as visoes
    // detalhadas do modelo) — nao contam de nenhum dos lados.
    check_shape(current: any, edited: any, optional: string[] = []): bool {
        var current_keys = current.keys().filter((k) -> !optional.contains(k))
        var edited_keys = edited.keys().filter((k) -> !optional.contains(k))
        if (current_keys.size() != edited_keys.size()) return false
        for (var key in current_keys) {
            if (!edited_keys.contains(key)) return false
        }
        return true
    }

    // Diretiva gravada em changes.jsonl. Toda geracao refaz o artefato do zero
    // a partir dos predecessores e so enxerga estas diretivas (ChangesBlock),
    // nunca o conteudo anterior; por isso o texto editado viaja inteiro aqui.
    // Assim uma regeneracao posterior reaplica a edicao em vez de descarta-la.
    directive(sections: {titulo: string, conteudo: string}[]): string {
        var body = ""
        for (var section in sections) {
            body = body + "\n### " + section.titulo + "\n" + section.conteudo
        }
        return "Edição manual feita pelo usuário. Mantenha o conteúdo abaixo exatamente como está; ele prevalece sobre o que seria gerado para estas seções:" + body
    }

    render(kind: EditableArtifact, data: any): string -> match kind {
        EditableArtifact.brief      -> ArtifactBody.brief(data)
        EditableArtifact.atributos  -> ArtifactBody.atributos(data)
        EditableArtifact.requisitos -> ArtifactBody.requisitos(data)
        EditableArtifact.modelo     -> ArtifactBody.modelo(data)
    }
}

workflow ArtifactSave {
    description: "Grava a edicao manual de um artefato de documento unico (brief | atributos | requisitos | modelo): JSON e HTML re-renderizado; o modelo redesenha as visoes dele em diagramas/ (contexto, conteiner e as detalhadas)."

    input project_id: string
    input artifact: EditableArtifact
    input data: any
    input sections: any = [] // [{titulo, conteudo}] das secoes alteradas, montado pelo editor

    var saved_path = ""
    var redrawn = []

    output: {
        path: saved_path,
        redrawn,
    }

    step Save {
        var html_relative = artifact + ".html"
        var html_path = Paths.artifact(project_id, html_relative)
        var json_path = Paths.artifact(project_id, ArtifactData.json_relative(html_relative))

        if (!fs.exists(html_path) || !fs.exists(json_path)) {
            fail("'${artifact}' ainda nao foi gerado neste work-item")
        }
        var optional = if (artifact == EditableArtifact.modelo) ["detalhes"] else []
        if (!ArtifactEdit.check_shape(json.parse(fs.read(json_path)), data, optional)) {
            fail("estrutura do '${artifact}' diferente da original — edicao recusada")
        }

        var rendered = PageShell(
            title: ArtifactEdit.title_for(artifact),
            body: ArtifactEdit.render(artifact, data),
            meta: "editado em ${time.format(time.now(), "yyyy-MM-dd HH:mm")} · artifacts/${html_relative}"
        )
        ArtifactData.write(project_id, html_relative, data)
        fs.write(html_path, rendered)
        self.saved_path = html_relative
        if (artifact == EditableArtifact.modelo) self.redrawn = ArtifactCommit.model_views(project_id, data)
        if (!sections.is_empty()) {
            ChangesLog.append({
                artifact,
                feature_id: "",
                origem: "edicao_manual",
                secoes: sections.map((section) -> section.titulo),
                feedback: ArtifactEdit.directive(sections)
            })
        }
    }
}

test ArtifactEditSpec {
    describe accepts_the_same_top_level_keys_in_any_order {
        is_true(ArtifactEdit.check_shape({a: 1, b: 2}, {b: "x", a: []}))
    }

    describe rejects_missing_or_extra_keys {
        is_false(ArtifactEdit.check_shape({a: 1, b: 2}, {a: 1}))
        is_false(ArtifactEdit.check_shape({a: 1}, {a: 1, c: 3}))
        is_false(ArtifactEdit.check_shape({a: 1, b: 2}, {a: 1, c: 3}))
    }

    describe optional_keys_may_be_added_or_kept {
        is_true(ArtifactEdit.check_shape({a: 1}, {a: 1, detalhes: []}, ["detalhes"]))
        is_true(ArtifactEdit.check_shape({a: 1, detalhes: []}, {a: 1, detalhes: []}, ["detalhes"]))
        is_false(ArtifactEdit.check_shape({a: 1}, {a: 1, outra: []}, ["detalhes"]))
    }
}

test ArtifactEditDirectiveSpec {
    describe directive_carries_each_edited_section_verbatim {
        var out = ArtifactEdit.directive([
            {titulo: "Resumo executivo", conteudo: "Texto novo"},
            {titulo: "Objetivos", conteudo: "- objetivo: A"}
        ])
        is_true(out.starts_with("Edição manual feita pelo usuário"))
        is_true(out.contains("### Resumo executivo\nTexto novo"))
        is_true(out.contains("### Objetivos\n- objetivo: A"))
    }
}

test ArtifactSaveSpec {
    describe rejects_a_non_editable_artifact_before_running {
        var raised = ""
        try { ArtifactSave.run(inputs: {project_id: "spec-nao-existe", artifact: "adr", data: {}}) } catch (e) { raised = "${e}" }
        is_true(raised.contains("\"adr\" is not a variant of enum EditableArtifact (use brief | atributos | requisitos | modelo)"))
    }

    describe fails_when_the_artifact_was_never_generated {
        var run = ArtifactSave.run(inputs: {project_id: "spec-nao-existe", artifact: "brief", data: {}})
        is_false(run.ok)
        is_true(run.error.contains("ainda nao foi gerado"))
    }

    describe saving_the_model_redraws_the_context_and_container_diagrams {
        var id = Fixture.project("spec-test-save-modelo")
        var modelo = {
            sistema: {nome: "Loja", descricao: "", fontes: ["brief"]},
            contexto: {
                elementos: [{id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "", fontes: ["gap"]}],
                relacoes: [{de: "cliente", para: "sistema", descricao: "Usa", tecnologia: "", fontes: ["gap"]}],
            },
            conteineres: {
                elementos: [
                    {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "", fontes: ["gap"]},
                    {id: "api", nome: "API", tipo: "container", tecnologia: "Java", descricao: "", fontes: ["gap"]},
                ],
                relacoes: [{de: "cliente", para: "api", descricao: "Usa", tecnologia: "HTTPS", fontes: ["gap"]}],
            },
            gaps: [],
        }
        ArtifactData.write(id, "modelo.html", modelo)
        fs.write(Paths.artifact(id, "modelo.html"), "<html></html>")
        dir.create(Paths.artifact(id, "diagramas"))
        ArtifactData.write(id, "diagramas/x.html", {diagram_type: "c4-container", titulo: "x", derivado_do_modelo: true})
        fs.write(Paths.artifact(id, "diagramas/x.html"), "<html></html>")

        var editado = modelo
        var conteineres = modelo.conteineres
        conteineres["elementos"] = [conteineres.elementos[0], {id: "api", nome: "API de Pedidos", tipo: "container", tecnologia: "Java", descricao: "", fontes: ["gap"]}]
        editado["conteineres"] = conteineres
        var run = ArtifactSave.run(inputs: {project_id: id, artifact: "modelo", data: editado})
        is_true(run.ok)
        are_equal(run.vars.redrawn, ["contexto-de-sistema-loja", "conteineres-loja"])
        is_true(fs.read(Paths.artifact(id, "modelo.html")).contains("API de Pedidos"))
        is_true(fs.read(Paths.artifact(id, "diagramas/conteineres-loja.html")).contains("API de Pedidos"))
        is_false(fs.exists(Paths.artifact(id, "diagramas/x.html")))
        Fixture.drop(id)
    }

    // Um modelo gravado antes das visoes detalhadas (sem `detalhes`) aceita
    // a chave nova; cada visao vira um diagrama, e o diagrama de componente
    // da LLM do conteiner detalhado sai do lote. Dois diagramas com o mesmo
    // titulo nao se sobrescrevem.
    describe saving_details_draws_them_and_drops_the_llm_component_diagram {
        var id = Fixture.project("spec-test-save-modelo-detalhes")
        var modelo = {
            sistema: {nome: "Loja", descricao: "", fontes: ["brief"]},
            contexto: {
                elementos: [{id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "", fontes: ["gap"]}],
                relacoes: [{de: "cliente", para: "sistema", descricao: "Usa", tecnologia: "", fontes: ["gap"]}],
            },
            conteineres: {
                fronteiras: [{id: "loja", nome: "Loja", descricao: "", fontes: ["gap"]}],
                elementos: [
                    {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "", fronteira: "", fontes: ["gap"]},
                    {id: "api", nome: "API", tipo: "container", tecnologia: "Java", descricao: "", fronteira: "loja", fontes: ["gap"]},
                ],
                relacoes: [{de: "cliente", para: "api", descricao: "Usa", tecnologia: "HTTPS", fontes: ["gap"]}],
            },
            gaps: [],
        }
        ArtifactData.write(id, "modelo.html", modelo)
        fs.write(Paths.artifact(id, "modelo.html"), "<html></html>")
        dir.create(Paths.artifact(id, "diagramas"))
        ArtifactData.write(id, "diagramas/componentes-api.html", {diagram_type: "c4-component", titulo: "Componentes API", escopo: {nome: "API", descricao: "", fontes: []}, elementos: [], relacoes: []})
        fs.write(Paths.artifact(id, "diagramas/componentes-api.html"), "<html></html>")

        var componentes = {
            id: "DET-001", tipo: "c4-component", titulo: "", descricao: "", fontes: ["gap"],
            origem: {visao: "conteineres", elemento: "api", nome: "API"}, fronteiras: [],
            elementos: [
                {id: "cliente", nome: "Cliente", tipo: "pessoa", tecnologia: "", descricao: "", fronteira: "", fontes: ["gap"]},
                {id: "EL-001", nome: "Controlador", tipo: "componente", tecnologia: "JAX-RS", descricao: "", fronteira: "", fontes: ["gap"]},
            ],
            relacoes: [{de: "cliente", para: "EL-001", descricao: "Usa", tecnologia: "HTTPS", fontes: ["gap"]}],
        }
        var outro = componentes
        outro["id"] = "DET-002"
        var editado = modelo
        editado["detalhes"] = [componentes, outro]
        var run = ArtifactSave.run(inputs: {project_id: id, artifact: "modelo", data: editado})
        is_true(run.ok)
        are_equal(run.vars.redrawn, ["contexto-de-sistema-loja", "conteineres-loja", "componentes-api", "componentes-api-2"])
        is_true(fs.read(Paths.artifact(id, "diagramas/componentes-api.html")).contains("Controlador"))
        is_true(fs.read(Paths.artifact(id, "modelo.html")).contains("Componentes — API"))
        Fixture.drop(id)
    }

    describe rejects_a_path_traversal_project_id {
        var run = ArtifactSave.run(inputs: {project_id: "../x", artifact: "brief", data: {}})
        is_false(run.ok)
        is_true(run.error.contains("project_id invalido"))
    }
}
