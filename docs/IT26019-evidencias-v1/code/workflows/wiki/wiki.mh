// Orquestra ingestao, consulta e saneamento da wiki. A LLM produz apenas
// dados estruturados; componentes determinísticos cuidam de arquivos e índice.

import { Paths } from "../shared/core/paths.mh"
import { Fixture } from "../shared/core/fixture.mh"
import { Writer } from "../shared/agents/agents.mh"
import { RawExtract } from "../shared/wiki/raw_extract.mh"
import { RepoSnapshot } from "../shared/wiki/repo_snapshot.mh"
import { LiteralBlocks } from "../shared/wiki/literal_blocks.mh"
import { WikiContext } from "../shared/wiki/wiki_context.mh"
import { WikiIndex } from "../shared/wiki/wiki_index.mh"
import { WikiActions } from "actions.mh"
import { IngestSchema, QuerySchema, LintSchema, ConceptSchema } from "schema_files.mh"

enum WikiAction { ingest, query, lint, sync_html, create_concept, snapshot_repo }

prompt WikiSchema() from "schema.prompt.md"
prompt IngestInstruction(schema_conventions: prompt, source_name: string, source_text: string, catalog_content: string) from "prompts/ingest.prompt.md"
prompt QueryInstruction(schema_conventions: prompt, question: string, wiki_content: string) from "prompts/query.prompt.md"
prompt LintInstruction(schema_conventions: prompt, wiki_content: string) from "prompts/lint.prompt.md"
prompt ConceptInstruction(schema_conventions: prompt, concept_title: string, concept_description: string, feedback_block: string, wiki_content: string) from "prompts/concept.prompt.md"

workflow Wiki {
    description: "Ingestao, consulta e saneamento da wiki de um work-item (padrao wiki-llm.md)."

    input project_id: string
    input action: WikiAction
    input raw_paths: string[] = []   // ingest: exatamente 1 elemento nesta versao (v1)
    input question: string = ""      // query
    input file_answer: bool = false  // query
    input buddy: bool = false        // ingest: true pausa pra revisao antes de gravar (Modo Buddy)
    input approved: bool = false     // ingest/create_concept: "yes" da revisao, passado no mhl_run_resume
    input concept_title: string = ""        // create_concept: o conceito apontado pela verificacao
    input concept_description: string = ""  // create_concept: onde a verificacao o viu citado
    input feedback: string = ""             // create_concept: pedido de mudanca no resume da pausa
    input repo_path: string = ""            // snapshot_repo: caminho absoluto da pasta do repositorio
    // create_concept: aprovacao de um rascunho revisado. O app envia o
    // pending_concept da run pausada numa run nova, que vai direto ao
    // Commit sem chamar a LLM — retomar a pausa falharia se o workflow
    // mudou desde que ela foi gravada (mesmo padrao de ArtifactFlow).
    input approval_data: any = null

    var wiki_result = null
    var tokens_in = 0
    var tokens_out = 0
    var current_artifact = ""
    var ingest_data = null
    // create_concept: o rascunho em revisao (lido pelo app na pausa) e os
    // pedidos de mudanca acumulados. feedback_consumed garante uma unica
    // regeneracao por pedido (inputs sao somente leitura) — mesmo padrao
    // do Gate de ArtifactFlow.
    var pending_concept = null
    var concept_feedback = []
    var feedback_consumed = false

    output: {
        action,
        current_artifact,
        result: wiki_result,
        tokens_in,
        tokens_out,
    }

    route ActionRouter(action: WikiAction) {
        WikiAction.ingest    -> IngestGenerate
        WikiAction.query     -> Query
        WikiAction.lint      -> Lint
        WikiAction.sync_html -> SyncHtml
        WikiAction.create_concept -> ConceptGenerate
        WikiAction.snapshot_repo -> SnapshotRepo
    }

    step Dispatch {
        Paths.ensure_valid(project_id)
        goto ActionRouter(action)
    }

    // Ingest e 3 steps, nao 1, especificamente pra Modo Buddy (pause/resume)
    // ser barato: IngestGenerate faz a parte cara (le a fonte, chama a LLM) e
    // guarda o resultado em `ingest_data` (pipeline-scoped, sobrevive a um
    // checkpoint); IngestGate so pausa; IngestCommit grava os arquivos. Um
    // `mhl_run_resume` reentra so no step onde parou — nunca refaz a
    // chamada a LLM so porque o usuario demorou pra aprovar.
    step IngestGenerate {
        // Uma fonte por chamada: ingerir e revisar uma de cada vez.
        if (raw_paths.size() != 1) {
            fail("ingest processa uma fonte por vez nesta versao (v1) — recebido ${raw_paths.size()} caminho(s)")
        }
        var source_name = raw_paths[0]
        var abs_path = Paths.raw(project_id, source_name)
        if (!fs.exists(abs_path)) fail("fonte nao encontrada em raw/: '" + source_name + "'")

        var source_text = RawExtract.text(abs_path)
        self.current_artifact = "ingest:" + source_name

        var response = Writer.generate(
            prompt: IngestInstruction(
                schema_conventions: WikiSchema(),
                source_name:,
                source_text:,
                catalog_content: WikiIndex.catalog(project_id)
            ),
            schema_file: IngestSchema,
            project_id:,
            artifact: current_artifact
        )
        self.{tokens_in, tokens_out} = response
        var raw = response.content
        // O trecho literal da fonte (LiteralBlocks — a arvore de um retrato
        // de repositorio, por ex.) vai junto, por codigo: a LLM nao o
        // reproduz, so o le.
        var data = json.parse(raw)
        data["literal"] = LiteralBlocks.extract(source_text)
        self.ingest_data = data
        goto IngestGate
    }

    step IngestGate {
        if (buddy && !approved) {
            pause(
"revise o conteudo extraido de '${self.ingest_data.source_title}' antes de gravar na wiki"
            )
        }
        goto IngestCommit
    }

    step IngestCommit {
        self.wiki_result = WikiActions.commit_ingest(project_id, ingest_data)
        goto Done
    }

    step Query {
        if (question.is_empty()) fail("'question' e obrigatorio para action: \"query\"")
        self.current_artifact = "query"
        var wiki_content = WikiContext.all_pages(project_id)

        var response = Writer.generate(
            prompt: QueryInstruction(
                schema_conventions: WikiSchema(),
                question:,
                wiki_content:
            ),
            schema_file: QuerySchema,
            project_id:,
            artifact: current_artifact
        )
        self.{tokens_in, tokens_out} = response
        var raw = response.content
        var data = json.parse(raw)
        var answer_body = data.answer_body

        var filed_as = null
        if (file_answer) {
            filed_as = WikiActions.file_answer(
                project_id,
                data.answer_title,
                answer_body,
                question
            )
        }

        self.wiki_result = {
            answer_title: data.answer_title,
            answer_body,
            filed_as,
        }
        goto Done
    }

    step Lint {
        self.current_artifact = "lint"
        var wiki_content = WikiContext.for_lint(project_id)

        var response = Writer.generate(
            prompt: LintInstruction(
                schema_conventions: WikiSchema(),
                wiki_content:
            ),
            schema_file: LintSchema,
            project_id:,
            artifact: current_artifact
        )
        self.{tokens_in, tokens_out} = response
        var raw = response.content
        self.wiki_result = WikiActions.record_lint(project_id, json.parse(raw))
        goto Done
    }

    // sync_html regera wiki/html/ (WikiHtmlExport) a partir do estado atual,
    // sem chamar a LLM — usado pela aba Wiki do frontend pra garantir que o
    // HTML exibido esta sempre atualizado antes de abrir uma pagina, mesmo
    // pra work-items cuja wiki foi ingerida antes desta acao existir.
    step SyncHtml {
        self.current_artifact = "sync_html"
        WikiActions.sync_html(project_id)
        self.wiki_result = {synced: true}
        goto Done
    }

    // snapshot_repo grava em raw/ o retrato AS-IS de um repositorio git
    // (RepoSnapshot) — sem LLM. As fontes gravadas sao ingeridas depois,
    // uma a uma, pelo ingest comum; result.sources lista os nomes.
    step SnapshotRepo {
        if (repo_path.trim().is_empty()) fail("'repo_path' e obrigatorio para action: \"snapshot_repo\"")
        self.current_artifact = "snapshot_repo"
        self.wiki_result = RepoSnapshot.write(project_id, repo_path.trim())
        goto Done
    }

    // create_concept: Generate -> Gate (pausa no Modo Buddy) -> Commit, como
    // o ingest. A LLM so recebe o conteudo da wiki: a pagina nasce do que as
    // paginas ja dizem, cada fato citando a de origem.
    step ConceptGenerate {
        if (concept_title.trim().is_empty()) fail("'concept_title' e obrigatorio para action: \"create_concept\"")
        self.current_artifact = "concept:" + concept_title.trim()
        if (approved && approval_data != null) {
            if ((approval_data?.title ?? "").trim().is_empty() || (approval_data?.facts ?? []).is_empty()) fail("approval_data invalido: a pagina aprovada precisa de titulo e fatos")
            self.pending_concept = approval_data
            goto ConceptCommit
        }
        var feedback_block = if (concept_feedback.is_empty()) "" else "\n## Pedidos de mudança do revisor\n\nUma versão anterior foi recusada. Atenda a todos, do mais antigo ao mais novo:\n\n" + concept_feedback.map((f) -> "- " + f).join("\n") + "\n"
        var response = Writer.generate(
            prompt: ConceptInstruction(
                schema_conventions: WikiSchema(),
                concept_title: concept_title.trim(),
                concept_description:,
                feedback_block:,
                wiki_content: WikiContext.all_pages(project_id)
            ),
            schema_file: ConceptSchema,
            project_id:,
            artifact: current_artifact
        )
        self.{tokens_in, tokens_out} = response
        var data = json.parse(response.content)
        if (data.facts.is_empty()) fail("a wiki nao tem fatos verificaveis sobre '${concept_title.trim()}' — adicione uma fonte que fale dele")
        self.pending_concept = data
        goto ConceptGate
    }

    step ConceptGate {
        if (buddy && !approved) {
            if (!feedback.is_empty() && !self.feedback_consumed) {
                self.feedback_consumed = true
                self.concept_feedback = self.concept_feedback + [feedback]
                goto ConceptGenerate
            }
            self.feedback_consumed = false
            pause("revise a pagina de conceito '${self.pending_concept.title}' antes de gravar na wiki")
        }
        goto ConceptCommit
    }

    step ConceptCommit {
        self.wiki_result = WikiActions.commit_concept(project_id, pending_concept)
        goto Done
    }

    step Done { complete() }
}

// Cobre so caminhos que falham antes de chamar a LLM ou gravar em disco
// (ver WorkItemWorkflowSpec em work_item.mh).
test WikiWorkflowSpec {
    describe rejects_an_unknown_action_before_running {
        var raised = ""
        try { Wiki.run(inputs: {project_id: "spec-test-project", action: "bogus"}) } catch (e) { raised = "${e}" }
        is_true(raised.contains("\"bogus\" is not a variant of enum WikiAction (use ingest | query | lint | sync_html | create_concept | snapshot_repo)"))
    }

    describe rejects_an_invalid_project_id_before_touching_anything {
        var run = Wiki.run(inputs: {project_id: "../../etc/passwd", action: "query", question: "oi"})
        is_false(run.ok)
        is_true(run.error.contains("project_id invalido"))
    }

    describe ingest_rejects_zero_raw_paths_before_reading_anything {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: []})
        is_false(run.ok)
        is_true(run.error.contains("uma fonte por vez"))
    }

    describe snapshot_repo_requires_an_absolute_repo_path {
        var missing = Wiki.run(inputs: {project_id: "spec-test-project", action: "snapshot_repo"})
        is_false(missing.ok)
        is_true(missing.error.contains("'repo_path' e obrigatorio"))
        var relative = Wiki.run(inputs: {project_id: "spec-test-project", action: "snapshot_repo", repo_path: "projects/outro"})
        is_false(relative.ok)
        is_true(relative.error.contains("caminho absoluto"))
    }

    describe ingest_rejects_more_than_one_raw_path_before_reading_anything {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: ["a.md", "b.md"]})
        is_false(run.ok)
        is_true(run.error.contains("uma fonte por vez"))
    }

    describe ingest_of_a_source_that_does_not_exist_fails_without_calling_the_llm {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "ingest", raw_paths: ["nao-existe.md"]})
        is_false(run.ok)
        is_true(run.error.contains("fonte nao encontrada"))
    }

    describe create_concept_rejects_an_empty_title_before_calling_the_llm {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "create_concept", concept_title: "  "})
        is_false(run.ok)
        is_true(run.error.contains("'concept_title' e obrigatorio"))
    }

    // Aprovar um rascunho e uma run nova so de gravacao: nenhuma chamada a
    // LLM, e a pagina sai igual ao que foi revisado.
    describe create_concept_commits_an_approved_draft_without_calling_the_llm {
        var id = Fixture.project("spec-test-wiki-approve-concept")
        dir.create(Paths.wiki(id, "sources"))
        dir.create(Paths.wiki(id, "entities"))
        dir.create(Paths.wiki(id, "concepts"))
        var run = Wiki.run(inputs: {
            project_id: id, action: "create_concept", concept_title: "Settlement", approved: true, buddy: true,
            approval_data: {title: "Settlement", aliases: [], facts: ["Feito pelo backoffice (ver entities/backoffice)"]}
        })
        is_true(run.ok)
        are_equal(run.output.result.slug, "settlement")
        is_true(fs.read(Paths.wiki(id, "concepts/settlement.md")).contains("- Feito pelo backoffice (ver entities/backoffice)"))
        Fixture.drop(id)
    }

    describe create_concept_rejects_an_approved_draft_without_facts {
        var run = Wiki.run(inputs: {
            project_id: "spec-test-project", action: "create_concept", concept_title: "X", approved: true, buddy: true,
            approval_data: {title: "X", aliases: [], facts: []}
        })
        is_false(run.ok)
        is_true(run.error.contains("approval_data invalido"))
    }

    describe query_rejects_an_empty_question_before_calling_the_llm {
        var run = Wiki.run(inputs: {project_id: "spec-test-project", action: "query", question: ""})
        is_false(run.ok)
        is_true(run.error.contains("'question' e obrigatorio"))
    }
}
