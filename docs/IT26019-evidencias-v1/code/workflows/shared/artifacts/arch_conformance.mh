// tool ArchConformance — aderencia de um item de backlog (feature de
// negocio ou enabler) a arquitetura de solucao. C3: a LLM declara em
// `aderencia_arquitetural` QUAIS elementos da arquitetura o item usa
// ({tipo, ref, como, mudanca}: conteiner/sistema do C4, entidade do DER,
// ADR, atributo de qualidade ou restricao) e como; o codigo confere cada
// referencia contra o que existe nos artefatos do work-item
// (Traceability.known). Citar "adr" em `fontes` nao prova nada — uma
// referencia tipada a "ADR-003" sim.
//
// Dois niveis, como nas historias:
//   - check (por item): referencia inexistente, componente/entidade novo
//     sem justificativa, enabler de arquitetura sem ADR. Calculado no
//     *Generate (annotate -> avisos_arquitetura), entao entra no
//     ArtifactChecks e a autorrevisao corrige;
//   - coverage (lote): ADR ou restricao arquitetural que nenhum item do
//     backlog cita. So existe com o lote inteiro (as paginas de features
//     tem 3 itens), entao vira aviso do mapa de dependencias, sem
//     autorrevisao.
//
// Item gravado antes do campo (aderencia_arquitetural ausente) nao e
// verificado. Categoria sem artefato (DER opcional, Delivery sem
// atributos) fica sem conferencia: Traceability.missing com pool vazio.

import { Traceability } from "historia_spec.mh"

export tool ArchConformance {
    internal refs_of(f: any, tipo: string): string[] ->
        (f?.aderencia_arquitetural ?? []).filter((r) -> r?.tipo == tipo).map((r) -> r?.ref ?? "")

    // Um item pode introduzir um componente que o C4 ainda nao tem quando
    // isso esta decidido (cita um ADR), quando ele proprio e a fundacao
    // tecnica (enabler de arquitetura/infraestrutura) ou quando a ausencia
    // esta registrada em Lacunas.
    internal justified(f: any): bool -> {
        var subtipo = f?.subtipo_enabler ?? "nao_aplicavel"
        if (!self.refs_of(f, "adr").is_empty()) return true
        if (!(f?.gaps ?? []).is_empty()) return true
        return f?.tipo_item == "enabler" && (subtipo == "arquitetura" || subtipo == "infraestrutura")
    }

    // check: avisos de UM item contra `known` (Traceability.known).
    check(f: any, known: any): string[] -> {
        var refs = f?.aderencia_arquitetural
        if (refs == null) return []
        var subtipo = f?.subtipo_enabler ?? "nao_aplicavel"
        if (refs.is_empty()) {
            // Um spike de exploracao pode existir justamente porque a
            // arquitetura ainda nao decidiu onde a coisa mora.
            if (subtipo == "exploracao") return []
            return ["Item sem aderência arquitetural declarada — diga que contêineres, entidades, ADRs ou atributos de qualidade ele usa."]
        }
        var out = []
        if (refs.any((r) -> (r?.ref ?? "").trim().is_empty())) out += ["Aderência arquitetural com referência vazia."]
        var com_lacuna = !(f?.gaps ?? []).is_empty()

        var conteineres = refs.filter((r) -> r?.tipo == "conteiner")
        var novos_c = Traceability.missing(conteineres.filter((r) -> r?.mudanca == "novo").map((r) -> r.ref), known?.conteineres ?? [], false)
        var outros_c = Traceability.missing(conteineres.filter((r) -> r?.mudanca != "novo").map((r) -> r.ref), known?.conteineres ?? [], false)
        if (!novos_c.is_empty() && !self.justified(f)) out += ["Componente novo fora da arquitetura: " + novos_c.join(", ") + " — justifique com um ADR, com um enabler de arquitetura ou registre em Lacunas."]
        if (!outros_c.is_empty()) out += ["Contêiner citado que não existe no C4: " + outros_c.join(", ") + "."]

        var entidades = refs.filter((r) -> r?.tipo == "entidade")
        var novas_e = Traceability.missing(entidades.filter((r) -> r?.mudanca == "novo").map((r) -> r.ref), known?.entidades ?? [], false)
        var outras_e = Traceability.missing(entidades.filter((r) -> r?.mudanca != "novo").map((r) -> r.ref), known?.entidades ?? [], false)
        if (!novas_e.is_empty() && !com_lacuna) out += ["Entidade nova fora do DER: " + novas_e.join(", ") + " — atualize o DER ou registre em Lacunas."]
        if (!outras_e.is_empty()) out += ["Entidade citada que não existe no DER: " + outras_e.join(", ") + "."]

        var adrs = Traceability.missing(self.refs_of(f, "adr"), known?.adrs ?? [], true)
        if (!adrs.is_empty()) out += ["ADR citado que não existe: " + adrs.join(", ") + "."]

        // Como em Traceability.check: o modelo lista um NFR tambem entre os
        // requisitos — a referencia existe.
        var atributos_known = known?.atributos ?? []
        var pool = if (atributos_known.is_empty()) [] else (known?.requisitos ?? []) + atributos_known
        var atributos = Traceability.missing(self.refs_of(f, "atributo"), pool, false)
        if (!atributos.is_empty()) out += ["Atributo de qualidade citado que não existe: " + atributos.join(", ") + "."]

        if (f?.tipo_item == "enabler" && subtipo == "arquitetura" && self.refs_of(f, "adr").is_empty() && !com_lacuna) {
            out += ["Enabler de arquitetura sem ADR — cite a decisão que ele materializa ou registre a ausência em Lacunas."]
        }
        return out
    }

    annotate_item(f: any, known: any): any -> {
        f["avisos_arquitetura"] = self.check(f, known)
        return f
    }

    annotate(data: any, known: any): any -> {
        var out = []
        for (var f in (data?.features ?? [])) out += [self.annotate_item(f, known)]
        data["features"] = out
        return data
    }

    // coverage: ADRs e restricoes arquiteturais que nenhum item do lote cita
    // em aderencia_arquitetural. Um lote com item anterior ao campo nao e
    // verificado (a ausencia nao seria do backlog, e do formato).
    coverage(features: any[], known: any): string[] -> {
        if (features.is_empty() || features.any((f) -> f?.aderencia_arquitetural == null)) return []
        var adrs_citados = []
        var atributos_citados = []
        for (var f in features) {
            adrs_citados = adrs_citados + self.refs_of(f, "adr")
            atributos_citados = atributos_citados + self.refs_of(f, "atributo")
        }
        var out = []
        var adrs = self.uncited(known?.adrs ?? [], adrs_citados.map((r) -> self.adr_prefix(r)))
        if (!adrs.is_empty()) out += ["ADR que nenhum item do backlog materializa: " + adrs.join(", ") + "."]
        var restricoes = self.uncited(known?.restricoes ?? [], atributos_citados.map((r) -> self.last_segment(r)))
        if (!restricoes.is_empty()) out += ["Restrição arquitetural que nenhum item do backlog respeita explicitamente: " + restricoes.join(", ") + "."]
        return out
    }

    // Os ids de `existentes` que nao estao em `citados`, sem caixa/espacos.
    // (Traceability.missing nao serve: com pool vazio, ele nao confere nada.)
    internal uncited(existentes: string[], citados: string[]): string[] -> {
        var norm = citados.map((c) -> c.to_lower().trim())
        return existentes.filter((e) -> !norm.contains(e.to_lower().trim()))
    }

    // "atributos/RA-001" -> "RA-001" (a forma de citacao, como em
    // Traceability.missing).
    internal last_segment(ref: string): string -> {
        var parts = ref.split("/")
        return parts[parts.size() - 1].trim()
    }

    // "adr/ADR-003-postgres" -> "ADR-003".
    internal adr_prefix(ref: string): string -> {
        var parts = self.last_segment(ref).split("-")
        return if (parts.size() >= 2) parts[0] + "-" + parts[1] else ref.trim()
    }

    // --- HTML ---------------------------------------------------------------

    internal tipo_label(tipo: string): string -> match tipo {
        "conteiner" -> "Contêiner (C4)"
        "entidade"  -> "Entidade (DER)"
        "adr"       -> "ADR"
        "atributo"  -> "Atributo de qualidade"
        _           -> tipo
    }

    internal mudanca_label(mudanca: string): string -> match mudanca {
        "as_is"      -> "já existe"
        "modificado" -> "modificado"
        "removido"   -> "removido"
        _            -> "novo"
    }

    // Tabela da secao "Aderência Arquitetural"; item anterior ao campo nao
    // tem a secao.
    html(f: any): string -> {
        var refs = f?.aderencia_arquitetural
        if (refs == null) return ""
        var body = if (refs.is_empty()) "<p>—</p>" else
            "<table><thead><tr><th>Elemento</th><th>Referência</th><th>Mudança</th><th>Como o item usa/respeita</th></tr></thead><tbody>" +
            refs.map((r) -> "<tr><td>" + self.tipo_label(r?.tipo ?? "") + "</td><td>" + html.escape(r?.ref ?? "") + "</td><td>" + self.mudanca_label(r?.mudanca ?? "") + "</td><td>" + html.escape(r?.como ?? "") + "</td></tr>").join("") +
            "</tbody></table>"
        return "<h2>Aderência Arquitetural</h2>" + body
    }

    coverage_html(avisos: string[]): string -> {
        if (avisos.is_empty()) return ""
        return "<h2>Cobertura da Arquitetura</h2><ul class=\"c4-warnings\">" + avisos.map((a) -> "<li>" + html.escape(a) + "</li>").join("") + "</ul>"
    }
}

// Fixtures dos testes abaixo (mhl nao aceita `var` solto no corpo de um
// `test`, so dentro de cada `describe`).
tool ConformanceFixtures {
    known(): any -> {
        requisitos: ["FR-001"],
        atributos: ["NFR-001", "RA-001"],
        restricoes: ["RA-001"],
        adrs: ["ADR-001", "ADR-002"],
        entidades: ["Pedido", "pedido"],
        conteineres: ["API de Pedidos", "api-pedidos", "Banco de Pedidos"],
    }

    item(refs: any[]): any -> {
        tipo_item: "feature_negocio", subtipo_enabler: "nao_aplicavel", gaps: [],
        aderencia_arquitetural: refs,
    }
}

test ArchConformanceSpec {
    describe a_coherent_item_has_no_warnings {
        var f = ConformanceFixtures.item([
            {tipo: "conteiner", ref: "api-pedidos", como: "expõe o endpoint", mudanca: "modificado"},
            {tipo: "entidade", ref: "Pedido", como: "grava", mudanca: "as_is"},
            {tipo: "adr", ref: "ADR-001-rest", como: "segue REST", mudanca: "as_is"},
            {tipo: "atributo", ref: "atributos/NFR-001", como: "p95 < 300ms", mudanca: "as_is"},
        ])
        are_equal(ArchConformance.check(f, ConformanceFixtures.known()), [])
    }

    describe legacy_items_are_not_checked {
        are_equal(ArchConformance.check({tipo_item: "feature_negocio"}, ConformanceFixtures.known()), [])
        are_equal(ArchConformance.coverage([{tipo_item: "feature_negocio"}], ConformanceFixtures.known()), [])
        are_equal(ArchConformance.html({tipo_item: "feature_negocio"}), "")
    }

    describe an_item_without_declared_adherence_is_flagged_except_exploration {
        is_true(ArchConformance.check(ConformanceFixtures.item([]), ConformanceFixtures.known())[0].contains("sem aderência arquitetural"))
        are_equal(ArchConformance.check({tipo_item: "enabler", subtipo_enabler: "exploracao", gaps: [], aderencia_arquitetural: []}, ConformanceFixtures.known()), [])
    }

    describe invented_references_are_flagged {
        var avisos = ArchConformance.check(ConformanceFixtures.item([
            {tipo: "conteiner", ref: "Fila de Eventos", como: "x", mudanca: "as_is"},
            {tipo: "entidade", ref: "Fatura", como: "x", mudanca: "modificado"},
            {tipo: "adr", ref: "ADR-009", como: "x", mudanca: "as_is"},
            {tipo: "atributo", ref: "NFR-777", como: "x", mudanca: "as_is"},
        ]), ConformanceFixtures.known()).join(" | ")
        is_true(avisos.contains("Contêiner citado que não existe no C4: Fila de Eventos"))
        is_true(avisos.contains("Entidade citada que não existe no DER: Fatura"))
        is_true(avisos.contains("ADR citado que não existe: ADR-009"))
        is_true(avisos.contains("Atributo de qualidade citado que não existe: NFR-777"))
    }

    describe a_new_component_needs_a_justification {
        var novo = {tipo: "conteiner", ref: "Fila de Eventos", como: "publica", mudanca: "novo"}
        is_true(ArchConformance.check(ConformanceFixtures.item([novo]), ConformanceFixtures.known())[0].contains("Componente novo fora da arquitetura"))
        are_equal(ArchConformance.check(ConformanceFixtures.item([novo, {tipo: "adr", ref: "ADR-002", como: "decide a fila", mudanca: "as_is"}]), ConformanceFixtures.known()), [])
        are_equal(ArchConformance.check({tipo_item: "enabler", subtipo_enabler: "infraestrutura", gaps: [], aderencia_arquitetural: [novo]}, ConformanceFixtures.known()), [])
        are_equal(ArchConformance.check({tipo_item: "feature_negocio", subtipo_enabler: "nao_aplicavel", gaps: [{texto: "fila sem ADR", fontes: ["gap"]}], aderencia_arquitetural: [novo]}, ConformanceFixtures.known()), [])
    }

    describe a_new_entity_outside_the_der_needs_a_gap {
        var nova = {tipo: "entidade", ref: "Fatura", como: "cria", mudanca: "novo"}
        is_true(ArchConformance.check(ConformanceFixtures.item([nova]), ConformanceFixtures.known())[0].contains("Entidade nova fora do DER"))
        are_equal(ArchConformance.check({tipo_item: "feature_negocio", subtipo_enabler: "nao_aplicavel", gaps: [{texto: "DER sem Fatura", fontes: ["gap"]}], aderencia_arquitetural: [nova]}, ConformanceFixtures.known()), [])
    }

    describe an_architecture_enabler_must_cite_an_adr {
        var f = {tipo_item: "enabler", subtipo_enabler: "arquitetura", gaps: [], aderencia_arquitetural: [{tipo: "conteiner", ref: "API de Pedidos", como: "x", mudanca: "modificado"}]}
        is_true(ArchConformance.check(f, ConformanceFixtures.known()).join(" ").contains("Enabler de arquitetura sem ADR"))
    }

    describe missing_artifacts_leave_their_category_unchecked {
        var vazio = {requisitos: [], atributos: [], restricoes: [], adrs: [], entidades: [], conteineres: []}
        var f = ConformanceFixtures.item([{tipo: "entidade", ref: "Fatura", como: "x", mudanca: "modificado"}, {tipo: "atributo", ref: "NFR-9", como: "x", mudanca: "as_is"}])
        are_equal(ArchConformance.check(f, vazio), [])
    }

    describe annotate_stores_the_warnings_on_each_item {
        var data = ArchConformance.annotate({features: [ConformanceFixtures.item([])]}, ConformanceFixtures.known())
        are_equal(data.features[0].avisos_arquitetura.size(), 1)
    }

    describe coverage_flags_adrs_and_restrictions_no_item_cites {
        var a = ConformanceFixtures.item([{tipo: "adr", ref: "adr/ADR-001-rest", como: "x", mudanca: "as_is"}])
        var avisos = ArchConformance.coverage([a], ConformanceFixtures.known()).join(" | ")
        is_true(avisos.contains("ADR que nenhum item do backlog materializa: ADR-002"))
        is_false(avisos.contains("ADR-001"))
        is_true(avisos.contains("Restrição arquitetural que nenhum item do backlog respeita explicitamente: RA-001"))
        var b = ConformanceFixtures.item([{tipo: "adr", ref: "ADR-002", como: "x", mudanca: "as_is"}, {tipo: "atributo", ref: "RA-001", como: "x", mudanca: "as_is"}])
        are_equal(ArchConformance.coverage([a, b], ConformanceFixtures.known()), [])
        var nada = ArchConformance.coverage([ConformanceFixtures.item([])], ConformanceFixtures.known()).join(" | ")
        is_true(nada.contains("ADR-001, ADR-002"))
    }

    describe html_renders_the_adherence_table {
        var page = ArchConformance.html(ConformanceFixtures.item([{tipo: "adr", ref: "ADR-001", como: "<segue>", mudanca: "as_is"}]))
        is_true(page.contains("<h2>Aderência Arquitetural</h2>"))
        is_true(page.contains("<td>ADR</td><td>ADR-001</td><td>já existe</td><td>&lt;segue&gt;</td>"))
    }
}
