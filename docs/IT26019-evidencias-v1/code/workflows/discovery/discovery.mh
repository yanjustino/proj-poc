// Discovery gera os artefatos de uma Oportunidade: o fluxo comum
// (artifact_flow.mh) no nivel discovery. O que muda por artefato esta em
// discovery_artifacts.mh.

import { Paths } from "../shared/core/paths.mh"
import { Fixture } from "../shared/core/fixture.mh"
import { ArtifactFlow, Level } from "../artifact_flow/artifact_flow.mh"
import { DiscoveryCommits } from "discovery_artifacts.mh"

// `mode` e do Delivery; fixado aqui so para sair do contrato do Discovery.
workflow Discovery = ArtifactFlow with { level: Level.discovery, mode: "feature" } {
    description: "Artefatos de nivel Oportunidade: brief, atributos, requisitos, adr, der, modelo (arquitetural), diagramas, features (com o mapa de dependencias), historias, plano."
}

// Cobre o que e deterministico: validacao de entrada, a cadeia de
// predecessores (cada gate falha antes de qualquer chamada de LLM) e o
// caminho de aprovacao, que grava sem chamar a LLM.
test DiscoveryWorkflowSpec {
    describe rejects_an_unknown_artifact_before_running {
        var raised = ""
        try { Discovery.run(inputs: {project_id: "spec-test-project", artifact: "bogus"}) } catch (e) { raised = "${e}" }
        is_true(raised.contains("\"bogus\" is not a variant of enum Artifact"))
    }

    describe rejects_an_artifact_of_another_level_listing_its_own {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "feature"})
        is_false(run.ok)
        is_true(run.error.contains("\"feature\" is not a variant of enum DiscoveryArtifact (use brief | atributos | requisitos | adr | der | modelo | diagramas | features | historias | plano)"))
    }

    describe atributos_and_requisitos_require_brief_first {
        for (var artifact in ["atributos", "requisitos"]) {
            var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact})
            is_true(run.error.contains("gere 'brief' antes de '${artifact}'"))
        }
    }

    describe technical_artifacts_require_requisitos_then_atributos_then_adr_then_modelo {
        var id = Fixture.project("spec-test-discovery-tecnicos")
        for (var artifact in ["adr", "der", "modelo", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact})
            is_true(run.error.contains("gere 'requisitos' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "requisitos.html", "<html><body>FR-001</body></html>")
        for (var artifact in ["adr", "der", "modelo", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact})
            is_true(run.error.contains("gere 'atributos' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "atributos.html", "<html><body>NFR-001</body></html>")
        for (var artifact in ["der", "modelo", "diagramas", "features"]) {
            var run = Discovery.run(inputs: {project_id: id, artifact})
            is_true(run.error.contains("gere 'adr' antes de '${artifact}'"))
        }
        Fixture.artifact(id, "adr/ADR-001-titulo.html", "<html><body>ADR-001</body></html>")
        // Contexto e conteiner sao projecoes do modelo aprovado: sem ele nao
        // ha diagramas.
        var diagramas = Discovery.run(inputs: {project_id: id, artifact: "diagramas"})
        is_true(diagramas.error.contains("gere 'modelo' antes de 'diagramas'"))
        var features = Discovery.run(inputs: {project_id: id, artifact: "features"})
        is_true(features.error.contains("gere 'diagramas' antes de 'features'"))
        Fixture.drop(id)
    }

    // O mapa de dependencias e gerado junto com as features, nunca sozinho.
    describe dependencias_is_not_an_artifact_of_its_own {
        var raised = ""
        try { Discovery.run(inputs: {project_id: "spec-test-project", artifact: "dependencias"}) } catch (e) { raised = "${e}" }
        is_true(raised.contains("\"dependencias\" is not a variant of enum Artifact"))
    }

    describe historias_requires_a_feature_id {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "historias"})
        is_true(run.error.contains("'feature_id' e obrigatorio"))
    }

    describe plano_requires_a_feature_and_a_historia_id {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "plano", feature_id: "FT001"})
        is_true(run.error.contains("'feature_id' e 'historia_id' sao obrigatorios"))
    }

    describe the_approval_path_validates_the_required_ids_too {
        var run = Discovery.run(inputs: {project_id: "spec-test-project", artifact: "historias", approved: true, approval_data: {historias: []}})
        is_true(run.error.contains("'feature_id' e obrigatorio"))
    }

    describe approving_a_document_writes_it_without_calling_the_llm {
        var id = Fixture.project("spec-test-discovery-approve")
        var mapa = {features: [], ordem_execucao: [], diagrama_mermaid: "graph LR", gaps: []}
        var run = Discovery.run(inputs: {project_id: id, artifact: "features", approved: true, approval_data: {features: [], dependencias: mapa}, approval_tokens_in: 3, approval_tokens_out: 4})
        is_true(run.ok)
        are_equal(run.executed, ["Dispatch", "Commit"])
        are_equal(run.vars.result.artifact, "features")
        is_true(fs.read(Paths.artifact(id, "dependencias.html")).contains("3 → 4 tokens"))
        Fixture.drop(id)
    }

    // Rascunho de historias sem feature_dir (gerado por uma versao que o
    // perdia): o Commit recalcula a pasta pelo feature_id.
    describe commit_resolves_the_feature_folder_when_the_draft_lacks_it {
        var id = Fixture.project("spec-test-discovery-feature-dir")
        Fixture.artifact(id, "features/FT001-checkout/feature.html", "<html><body>FT001</body></html>")
        are_equal(DiscoveryCommits.feature_dir(id, "FT001", {data: {historias: []}, tokens_in: 0, tokens_out: 0}), "FT001-checkout")
        are_equal(DiscoveryCommits.feature_dir(id, "FT001", {data: {historias: [], feature_dir: "FT001-outro"}, tokens_in: 0, tokens_out: 0}), "FT001-outro")
        Fixture.drop(id)
    }
}
